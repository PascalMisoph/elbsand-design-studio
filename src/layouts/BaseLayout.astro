---
import "@fontsource-variable/inter";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  lang: "de" | "en";
  canonicalPath?: string;
  alternateDePath?: string;
  alternateEnPath?: string;
  schema?: Record<string, unknown>;
  bodyClass?: string;
}
const {
  title,
  description,
  lang,
  canonicalPath = lang === "de" ? "/" : "/en/",
  alternateDePath = "/",
  alternateEnPath = "/en/",
  schema,
  bodyClass
} = Astro.props;
const siteUrl = "https://elbsand.studio";
const canonical = new URL(canonicalPath, siteUrl).toString();
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "ELBSAND Design Studio",
  url: siteUrl,
  email: "pascal.misoph@gmail.com",
  areaServed: ["Dresden", "Sachsen", "Deutschland", "DACH"],
  serviceType: ["Webdesign", "Web development", "SEO", "Local SEO", "GEO optimization"]
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={new URL(alternateDePath, siteUrl).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(alternateEnPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternateDePath, siteUrl).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f5f1ea" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? defaultSchema)} />
  </head>
  <body class={bodyClass}><a class="skip-link" href="#main-content">{lang === "de" ? "Zum Inhalt springen" : "Skip to content"}</a><slot /></body>
</html>
