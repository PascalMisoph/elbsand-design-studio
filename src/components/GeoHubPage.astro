---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";

interface Props { copy: any; lang: "de" | "en" }
const { copy: t, lang } = Astro.props;
const de = lang === "de";
const home = de ? "/" : "/en/";
const processSteps = t.process.steps as readonly (readonly [string, string, string, string])[];
const packageItems = t.packages.items as readonly { number: string; name: string; descriptor: string; cta: string }[];
const canonical = de ? "/geo-optimierung/" : "/en/geo-optimization/";
const alternateDe = "/geo-optimierung/";
const alternateEn = "/en/geo-optimization/";
const serviceGroups = de ? [
  { label: "Diagnose", items: [["GEO Audit", "/geo-audit/"], ["Prompt-Recherche", "/prompt-recherche/"]] },
  { label: "AI-Sichtbarkeit", items: [["AI-Sichtbarkeit", "/ai-sichtbarkeit/"], ["KI-Quellenanalyse", "/ki-quellenanalyse/"], ["KI-Wettbewerbsanalyse", "/ki-wettbewerbsanalyse/"], ["KI-Markenwahrnehmung", "/ki-markenwahrnehmung/"], ["KI-Faktencheck", "/ki-faktencheck/"]] },
  { label: "Technik & Content", items: [["AI-Crawlability", "/ai-crawlability/"], ["Technische GEO-Optimierung", "/technische-geo-optimierung/"], ["GEO-Content", "/geo-content/"], ["Content-Optimierung für AI-Suche", "/content-optimierung-ai-suche/"]] },
  { label: "Begleitung", items: [["GEO-Monitoring", "/geo-monitoring/"], ["GEO-Betreuung", "/geo-betreuung/"]] }
] : [
  { label: "Diagnosis", items: [["GEO audit", "/en/geo-audit/"], ["Prompt research", "/en/prompt-research/"]] },
  { label: "AI visibility", items: [["AI visibility", "/en/ai-visibility/"], ["AI source analysis", "/en/ai-source-analysis/"], ["AI competitor analysis", "/en/ai-competitor-analysis/"], ["AI brand perception", "/en/ai-brand-perception/"], ["AI fact checking", "/en/ai-fact-checking/"]] },
  { label: "Technical & content", items: [["AI crawlability", "/en/ai-crawlability/"], ["Technical GEO optimisation", "/en/technical-geo-optimization/"], ["GEO content", "/en/geo-content/"], ["Content optimisation for AI search", "/en/content-optimization-ai-search/"]] },
  { label: "Ongoing support", items: [["GEO monitoring", "/en/geo-monitoring/"], ["GEO support", "/en/geo-support/"]] }
];
const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "ProfessionalService", name: "ELBSAND Design Studio", url: "https://elbsand.studio/", areaServed: ["Dresden", "Germany", "DACH"] },
  { "@type": "Service", name: t.meta.title, description: t.meta.description, url: new URL(canonical, "https://elbsand.studio").toString() },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: de ? "Start" : "Home", item: new URL(home, "https://elbsand.studio").toString() }, { "@type": "ListItem", position: 2, name: t.hero.eyebrow, item: new URL(canonical, "https://elbsand.studio").toString() }] }
] };
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} canonicalPath={canonical} alternateDePath={alternateDe} alternateEnPath={alternateEn} schema={schema} bodyClass="geo-hub-route">
  <Header lang={lang} nav={t.nav} cta={t.headerCta} page="geo" alternateDePath={alternateDe} alternateEnPath={alternateEn} />
  <main id="main-content" class="hub-page">
    <section class="h-hero h-shell"><div class="h-crumbs"><a href={home}>{de ? "Start" : "Home"}</a><span>/</span><span>{t.hero.eyebrow}</span></div><div class="h-hero-grid"><div class="h-hero-copy"><p class="h-kicker">{t.hero.eyebrow}</p><h1>{de ? "Sichtbarkeit in KI-Antworten beginnt mit Klarheit." : "Visibility in AI answers starts with clarity."}</h1><p>{t.hero.body}</p><div class="h-actions"><a class="h-button" href={t.hero.primaryHref}>{t.hero.primaryCta}</a><a class="h-link" href="#h-services">{t.hero.secondaryCta}<span aria-hidden="true">↓</span></a></div></div><div class="h-signal" aria-label={de ? "Illustrativer GEO-Signalpfad" : "Illustrative GEO signal path"}><div class="h-signal-top"><span>{de ? "Antwortsystem" : "Answer engine"}</span><b>{de ? "Signalpfad" : "Signal path"}</b></div><div class="h-signal-question"><small>{de ? "Frage" : "Question"}</small><strong>{de ? "Wer hilft Unternehmen in Dresden?" : "Who helps businesses in Dresden?"}</strong></div><div class="h-signal-route"><i></i><i></i><i></i></div><div class="h-signal-answer"><small>{de ? "Einordnung" : "Classification"}</small><strong>{de ? "Klares Angebot · lokaler Bezug" : "Clear offer · local context"}</strong><span>{de ? "Illustrative Darstellung" : "Illustrative view"}</span></div></div></div><div class="h-system-line"><span>{de ? "Im Blick:" : "In view:"}</span><b>Google</b><b>ChatGPT</b><b>Claude</b><b>Perplexity</b></div></section>

    <section class="h-capabilities h-shell" data-h-reveal><header><p class="h-kicker">{t.method.eyebrow}</p><h2>{de ? "Vier Signale, die zusammenarbeiten." : "Four signals that work together."}</h2><p>{t.method.body}</p></header><div class="h-cap-grid"><article><span>1</span><h3>{de ? "Fragen" : "Questions"}</h3><p>{de ? "Welche Situationen sind für echte Entscheidungen relevant?" : "Which situations matter to real decisions?"}</p></article><article><span>2</span><h3>{de ? "Antworten" : "Answers"}</h3><p>{de ? "Wie wird dein Angebot in diesen Antworten beschrieben?" : "How is your offer described in those answers?"}</p></article><article><span>3</span><h3>{de ? "Quellen" : "Sources"}</h3><p>{de ? "Welche Seiten und Belege tragen die Einordnung?" : "Which pages and evidence carry the classification?"}</p></article><article><span>4</span><h3>{de ? "Handlungen" : "Actions"}</h3><p>{de ? "Was sollte als Nächstes geschärft, ergänzt oder geprüft werden?" : "What should be sharpened, added or reviewed next?"}</p></article></div></section>

    <section class="h-flow h-shell" data-h-flow><div class="h-flow-copy"><p class="h-kicker">{de ? "Der ELBSAND-Zyklus" : "The ELBSAND cycle"}</p><h2>{de ? "Messen, priorisieren, umsetzen, nachmessen." : "Measure, prioritise, implement, measure again."}</h2><p>{de ? "GEO ist keine einzelne Einstellung. Wir verbinden Beobachtung und Umsetzung in einer nachvollziehbaren Folge." : "GEO is not a single setting. We connect observation and implementation in a sequence you can follow."}</p><div class="h-flow-meter"><i></i></div></div><ol>{processSteps.map((step, index) => <li class:list={{ "is-active": index === 0 }} data-h-step={index}><span>{step[0]}</span><div><h3>{step[1]}</h3><p>{step[2]}</p></div><b>{step[3]}</b></li>)}</ol><div class="h-flow-artifact" aria-hidden="true"><div class="h-artifact-bar"><span>{de ? "Arbeitsstand" : "Working state"}</span><b>{de ? "Beispiel" : "Illustrative"}</b></div><div class="h-artifact-track">{processSteps.map((_step, index) => <i class:list={{ active: index === 0 }} data-h-node={index}></i>)}</div><div class="h-artifact-labels">{processSteps.map((step) => <span>{step[1]}</span>)}</div></div></section>

    <section id="h-services" class="h-services h-shell"><header><p class="h-kicker">{de ? "Service-Netzwerk" : "Service network"}</p><h2>{de ? "Vom ersten Audit bis zur laufenden Betreuung." : "From the first audit to ongoing support."}</h2><p>{de ? "Jede Route hat einen eigenen Zweck. Starte mit der Frage, die gerade am wichtigsten ist." : "Each route has a distinct purpose. Start with the question that matters most right now."}</p></header><div class="h-service-groups">{serviceGroups.map((group) => <section><h3>{group.label}</h3><div>{group.items.map(([label, href]) => <a href={href}><span aria-hidden="true">↗</span><strong>{label}</strong></a>)}</div></section>)}</div></section>

    <section class="h-packages h-shell"><header><p class="h-kicker">{t.packages.eyebrow}</p><h2>{de ? "Ein passender Einstieg, ohne Pakete zu erzwingen." : "A fitting starting point, without forcing a package."}</h2></header><div class="h-package-grid">{packageItems.map((item, index) => <article class:list={{ recommended: index === 0 }}><div class="h-package-top"><span>{item.number}</span>{index === 0 && <b>{t.packages.recommendedLabel}</b>}</div><h3>{item.name}</h3><p>{item.descriptor}</p><strong>{de ? "Auf Anfrage" : "By request"}</strong><a href={`${home}#kontakt`}>{item.cta} ↗</a></article>)}</div><p class="h-package-note">{t.packages.scopeNote}</p></section>

  <SubpageContact lang={lang} source="geo-hub-service" />
</main>
  <Footer {...t.footer} lang={lang} />
</BaseLayout>

<script>
  const hub = document.querySelector(".hub-page");
  const reducedHub = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (hub && !reducedHub.matches) {
    const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: .14, rootMargin: "0px 0px -10%" });
    hub.querySelectorAll("[data-h-reveal]").forEach((el) => reveal.observe(el));
    const steps = [...hub.querySelectorAll("[data-h-step]")]; const nodes = [...hub.querySelectorAll("[data-h-node]")];
    const observer = new IntersectionObserver((entries) => { const active = entries.filter((e) => e.isIntersecting).sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!active) return; const index = Number(active.target.getAttribute("data-h-step")); steps.forEach((step,i) => step.classList.toggle("is-active", i === index)); nodes.forEach((node,i) => node.classList.toggle("active", i <= index)); const meter = hub.querySelector<HTMLElement>(".h-flow-meter i"); if (meter) meter.style.transform = `scaleX(${(index + 1) / steps.length})`; }, { threshold: [.28,.6], rootMargin: "-24% 0px -42%" }); steps.forEach((step) => observer.observe(step));
  } else hub?.querySelectorAll("[data-h-reveal]").forEach((el) => el.classList.add("is-visible"));
</script>

<style>
  .h-shell{box-sizing:border-box}.h-signal{box-sizing:border-box}@media(max-width:860px){.h-hero-grid,.h-capabilities header,.h-flow,.h-services header{grid-template-columns:minmax(0,1fr)}}
  :global(body.geo-hub-route){--h-bg:#171715;--h-surface:#24221f;--h-line:rgba(255,250,244,.15);--h-ink:#fbf8f2;--h-muted:#b7b0a5;--h-accent:#b74622;background:var(--h-bg);color:var(--h-ink);font-family:Inter,system-ui,sans-serif}:global(body.geo-hub-route .site-header),:global(body.geo-hub-route .site-footer){background:var(--h-bg);color:var(--h-ink);border-color:var(--h-line)}:global(body.geo-hub-route .language-switch){background:rgba(255,250,244,.06)}:global(body.geo-hub-route .language-switch a[aria-current="page"]){background:rgba(255,250,244,.12);box-shadow:none}.hub-page{overflow:hidden}.h-shell{width:min(100%,1120px);margin-inline:auto;padding-inline:32px}.h-hero{padding-top:28px}.h-crumbs{display:flex;gap:8px;color:var(--h-muted);font-size:12px}.h-crumbs a:hover{color:var(--h-ink)}.h-hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.75fr);gap:82px;align-items:center;padding:105px 0 84px}.h-kicker{margin:0 0 20px;color:#d37a5c;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.h-hero h1{max-width:680px;margin:0;font-size:clamp(54px,6vw,80px);font-weight:520;line-height:.98;letter-spacing:-.065em}.h-hero-copy>p:not(.h-kicker){max-width:620px;margin:30px 0 0;color:var(--h-muted);font-size:18px;line-height:1.6}.h-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.h-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:8px;background:var(--h-accent);padding:0 18px;color:#fff7ed;font-size:15px;font-weight:650;text-decoration:none;transition:transform 180ms ease,background 180ms ease}.h-button:hover{background:#c9532b;transform:translateY(-2px)}.h-link{display:inline-flex;min-height:48px;align-items:center;gap:18px;border:1px solid rgba(255,250,244,.28);border-radius:8px;padding:0 18px;color:var(--h-ink);font-size:15px;font-weight:600}.h-link span{color:#d37a5c}.h-signal{min-height:430px;border:1px solid var(--h-line);border-radius:14px;background:#10100f;padding:20px;box-shadow:24px 28px 75px rgba(0,0,0,.25);transform:rotate(1deg);transition:transform 600ms ease}.h-signal:hover{transform:rotate(0) translateY(-5px)}.h-signal-top{display:flex;justify-content:space-between;border-bottom:1px solid var(--h-line);padding-bottom:16px;color:#8b857d;font-size:11px}.h-signal-top b{color:#d37a5c;font-weight:600}.h-signal-question,.h-signal-answer{position:relative;display:grid;gap:10px;border:1px solid var(--h-line);background:#23221f;padding:18px}.h-signal-question{margin:49px 24px 0}.h-signal-question small,.h-signal-answer small{color:#8a847b;font-size:10px;letter-spacing:.1em;text-transform:uppercase}.h-signal-question strong,.h-signal-answer strong{font-size:16px;font-weight:550}.h-signal-route{display:grid;grid-template-columns:repeat(3,1fr);height:74px;align-items:center;margin:0 80px;background:linear-gradient(#d37a5c,#d37a5c) center/100% 1px no-repeat}.h-signal-route i{width:14px;height:14px;border:4px solid #d37a5c;border-radius:50%;background:#10100f}.h-signal-route i:nth-child(2){justify-self:center}.h-signal-route i:last-child{justify-self:end}.h-signal-answer{margin:0 24px}.h-signal-answer span{color:#77716a;font-size:11px}.h-system-line{display:flex;align-items:center;gap:25px;border-top:1px solid var(--h-line);border-bottom:1px solid var(--h-line);padding:0 10px;min-height:80px;color:#d7cec2;font-size:14px}.h-system-line>span{margin-right:18px;color:#8c857d;font-size:11px;letter-spacing:.11em;text-transform:uppercase}.h-system-line b{font-weight:550}.h-capabilities{padding-top:125px;padding-bottom:125px}.h-capabilities header{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,.65fr);gap:35px;align-items:end;margin-bottom:52px}.h-capabilities header .h-kicker{grid-column:1/-1;margin-bottom:0}.h-capabilities h2{max-width:670px;margin:0;font-size:clamp(40px,4.6vw,60px);font-weight:520;line-height:1;letter-spacing:-.06em}.h-capabilities header>p:last-child{max-width:360px;margin:0;color:var(--h-muted);font-size:16px;line-height:1.6}.h-cap-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--h-line);border-bottom:1px solid var(--h-line)}.h-cap-grid article{min-height:240px;border-left:1px solid var(--h-line);padding:25px}.h-cap-grid article:first-child{border-left:0}.h-cap-grid article>span{color:#d37a5c;font-size:13px}.h-cap-grid h3{margin:62px 0 12px;font-size:23px;font-weight:530;letter-spacing:-.04em}.h-cap-grid p{margin:0;color:var(--h-muted);font-size:15px;line-height:1.55}.h-flow{display:grid;grid-template-columns:minmax(0,.58fr) minmax(0,1fr);gap:70px;border-top:1px solid var(--h-line);padding-top:130px;padding-bottom:140px}.h-flow-copy{position:sticky;top:125px;align-self:start}.h-flow-copy h2{max-width:430px;margin:0;font-size:clamp(40px,4.5vw,58px);font-weight:520;line-height:1;letter-spacing:-.06em}.h-flow-copy>p:not(.h-kicker){max-width:390px;margin:25px 0;color:var(--h-muted);font-size:16px;line-height:1.6}.h-flow-meter{height:2px;margin-top:60px;background:var(--h-line)}.h-flow-meter i{display:block;width:100%;height:100%;background:#d37a5c;transform:scaleX(.25);transform-origin:left;transition:transform 500ms ease}.h-flow>ol{margin:0;padding:0;list-style:none}.h-flow>ol li{display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:18px;min-height:188px;border-top:1px solid var(--h-line);padding:27px 0;opacity:.35;transition:opacity 500ms ease,transform 500ms ease}.h-flow>ol li.is-active{opacity:1;transform:translateX(8px)}.h-flow>ol li>span{display:grid;width:35px;height:35px;place-items:center;border:1px solid #d37a5c;border-radius:50%;color:#d37a5c;font-size:13px}.h-flow h3{margin:4px 0 12px;font-size:25px;font-weight:530;letter-spacing:-.04em}.h-flow li p{max-width:420px;margin:0;color:var(--h-muted);font-size:16px;line-height:1.58}.h-flow li b{align-self:start;color:#d37a5c;font-size:12px;font-weight:600}.h-flow-artifact{grid-column:1/-1;border:1px solid var(--h-line);background:#10100f;padding:20px}.h-artifact-bar