---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import IconFeaturePanel from "./IconFeaturePanel";
import LinkButton from "./LinkButton";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import type { GeoContent } from "@/content/geo";
import { createServicePageSchema } from "@/lib/seo";

interface Props {
  copy: GeoContent;
  lang: "de" | "en";
}

const { copy: t, lang } = Astro.props;
const isGerman = lang === "de";
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? "/geo-optimierung/" : "/en/geo-optimization/";
const processSteps = t.process.steps.map((step) => ({ title: step[1], text: `${step[2]} ${step[3]}` }));
const packageItems = t.packages.items;
const signalItems = isGerman ? [
  { title: "Fragen", text: "Welche Situationen sind für echte Entscheidungen relevant?" },
  { title: "Antworten", text: "Wie wird dein Angebot in diesen Antworten beschrieben?" },
  { title: "Quellen", text: "Welche Seiten und Belege tragen die Einordnung?" },
  { title: "Handlungen", text: "Was sollte als Nächstes geschärft, ergänzt oder geprüft werden?" },
] : [
  { title: "Questions", text: "Which situations matter to real decisions?" },
  { title: "Answers", text: "How is your offer described in those answers?" },
  { title: "Sources", text: "Which pages and evidence carry the classification?" },
  { title: "Actions", text: "What should be sharpened, added or reviewed next?" },
];
const serviceGroups = isGerman ? [
  { label: "Diagnose", items: [["GEO-Agentur Deutschland", "/geo-agentur-deutschland/"], ["GEO Audit", "/geo-audit/"], ["Prompt-Recherche", "/prompt-recherche/"]] },
  { label: "AI-Sichtbarkeit", items: [["AI-Sichtbarkeit", "/ai-sichtbarkeit/"], ["KI-Quellenanalyse", "/ki-quellenanalyse/"], ["KI-Wettbewerbsanalyse", "/ki-wettbewerbsanalyse/"], ["KI-Markenwahrnehmung", "/ki-markenwahrnehmung/"], ["KI-Faktencheck", "/ki-faktencheck/"]] },
  { label: "Technik & Content", items: [["AI-Crawlability", "/ai-crawlability/"], ["Technische GEO-Optimierung", "/technische-geo-optimierung/"], ["GEO-Content", "/geo-content/"], ["Content-Optimierung für AI-Suche", "/content-optimierung-ai-suche/"]] },
  { label: "Begleitung", items: [["GEO-Monitoring", "/geo-monitoring/"], ["GEO-Betreuung", "/geo-betreuung/"]] },
] : [
  { label: "Diagnosis", items: [["GEO agency Germany", "/en/geo-agency-germany/"], ["GEO audit", "/en/geo-audit/"], ["Prompt research", "/en/prompt-research/"]] },
  { label: "AI visibility", items: [["AI visibility", "/en/ai-visibility/"], ["AI source analysis", "/en/ai-source-analysis/"], ["AI competitor analysis", "/en/ai-competitor-analysis/"], ["AI brand perception", "/en/ai-brand-perception/"], ["AI fact checking", "/en/ai-fact-checking/"]] },
  { label: "Technical & content", items: [["AI crawlability", "/en/ai-crawlability/"], ["Technical GEO optimization", "/en/technical-geo-optimization/"], ["GEO content", "/en/geo-content/"], ["Content optimization for AI search", "/en/content-optimization-ai-search/"]] },
  { label: "Ongoing support", items: [["GEO monitoring", "/en/geo-monitoring/"], ["GEO support", "/en/geo-support/"]] },
];
const breadcrumbItems = [{ name: isGerman ? "Start" : "Home", href: homePath }, { name: t.hero.eyebrow, href: canonicalPath }];
const schema = createServicePageSchema({ lang, title: t.meta.title, description: t.meta.description, path: canonicalPath, serviceName: t.hero.eyebrow, breadcrumbs: breadcrumbItems });
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} canonicalPath={canonicalPath} alternateDePath="/geo-optimierung/" alternateEnPath="/en/geo-optimization/" schema={schema} bodyClass="geo-hub-route ui-dark-page dark">
  <Header lang={lang} nav={t.nav} cta={t.headerCta} page="geo" alternateDePath="/geo-optimierung/" alternateEnPath="/en/geo-optimization/" />
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><nav class="flex gap-2 text-xs text-muted-foreground" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}><a class="text-inherit no-underline hover:text-foreground" href={homePath}>{isGerman ? "Start" : "Home"}</a><span aria-hidden="true">/</span><span aria-current="page">{t.hero.eyebrow}</span></nav><div class="max-w-3xl pt-12"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.hero.eyebrow}</p><h1 class="m-0 mt-6 text-display-mobile font-medium text-foreground md:text-display">{isGerman ? "Sichtbarkeit in KI-Antworten beginnt mit Klarheit" : "Visibility in AI answers starts with clarity"}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{t.hero.body}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={t.hero.primaryHref} label={t.hero.primaryCta} icon="right" /><LinkButton href="#service-network" label={t.hero.secondaryCta} variant="secondary" icon="down" /></div></div></div></section>
    <section class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><div><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.method.eyebrow}</p><h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{isGerman ? "Vier Signale, die zusammenarbeiten" : "Four signals that work together"}</h2></div><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{t.method.body}</p></header><IconFeaturePanel items={signalItems} label={t.method.eyebrow} /></section>
    <section class="border-y border-solid border-border"><div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-2 lg:py-section"><div class="lg:sticky lg:top-24 lg:self-start"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{isGerman ? "Der PATERNOGA-Zyklus" : "The PATERNOGA cycle"}</p><h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{isGerman ? "Messen, priorisieren, umsetzen, nachmessen" : "Measure, prioritise, implement, measure again"}</h2><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{isGerman ? "GEO verbindet Beobachtung und Umsetzung in einer nachvollziehbaren Folge." : "GEO connects observation and implementation in a sequence you can follow."}</p></div><IconFeaturePanel items={processSteps} label={isGerman ? "Arbeitszyklus" : "Working cycle"} /></div></section>
    <section id="service-network" class="h-services mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><h2 class="m-0 text-section-title font-medium text-foreground">{isGerman ? "Vom ersten Audit bis zur laufenden Betreuung" : "From the first audit to ongoing support"}</h2><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{isGerman ? "Jede Route hat einen eigenen Zweck. Starte mit der Frage, die gerade am wichtigsten ist." : "Each route has a distinct purpose. Start with the question that matters most right now."}</p></header><div class="grid grid-cols-1 gap-6 md:grid-cols-2">{serviceGroups.map((group) => <Card className="shadow-none"><CardHeader className="grid gap-6 p-6"><CardTitle className="text-card-title font-medium text-primary">{group.label}</CardTitle><div class="grid gap-3">{group.items.map(([label, href]) => <LinkButton href={href} label={label} variant="outline" icon="external" />)}</div></CardHeader></Card>)}</div></section>
    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.packages.eyebrow}</p><h2 class="m-0 mt-6 max-w-2xl text-section-title font-medium text-foreground">{isGerman ? "Ein passender Einstieg, ohne Pakete zu erzwingen" : "A fitting starting point, without forcing a package"}</h2><div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">{packageItems.map((item, index) => <Card className="min-h-80 shadow-none"><CardHeader className="h-full content-between gap-12 p-6"><div class="flex items-center justify-between gap-6"><span class="text-xs text-primary">{item.number}</span>{index === 0 && <span class="text-xs text-muted-foreground">{t.packages.recommendedLabel}</span>}</div><div class="grid gap-3"><CardTitle className="text-card-title font-medium">{item.name}</CardTitle><CardDescription>{item.descriptor}</CardDescription><span class="text-base font-medium text-foreground">{isGerman ? "Auf Anfrage" : "By request"}</span><LinkButton href={`${homePath}#kontakt`} label={item.cta} variant="outline" icon="right" /></div></CardHeader></Card>)}</div><p class="m-0 mt-6 max-w-xl text-sm leading-copy text-muted-foreground">{t.packages.scopeNote}</p></div></section>
    <SubpageContact lang={lang} source="geo-hub-service" />
  </main>
  <Footer {...t.footer} lang={lang} />
</BaseLayout>
