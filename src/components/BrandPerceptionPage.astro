---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import BrandPerceptionHoverFeatures from "./BrandPerceptionHoverFeatures";
import BrandPerceptionRadarChart from "./BrandPerceptionRadarChart";
import EditorialFeatureList from "./EditorialFeatureList";
import FaqAccordion from "./FaqAccordion.astro";
import LinkButton from "./LinkButton";
import ProcessPillars from "./ui/process-pillars";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const siteContent = content[page.lang];
const isEnglish = page.lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const canonicalPath = isEnglish ? page.alternateEnPath : page.alternateDePath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/" },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath },
];

const ui = isEnglish ? {
  primary: "Discuss perception",
  secondary: "View analysis",
  measure: "Measure brand perception across AI answers",
  measureText: "We read perception at question level, separated by theme, context and answer environment.",
  diagnose: "Diagnose causes and turn perception into action",
  diagnoseText: "The analysis connects what is being said with the pages, facts and external contexts that shape it.",
  insight: "Perception signals",
  measureLabel: "Measurement framework",
  diagnoseLabel: "Action framework",
  method: "From narrative to a controlled next action",
  faq: "Frequently asked questions",
} : {
  primary: "Wahrnehmung besprechen",
  secondary: "Analyse ansehen",
  measure: "Markenwahrnehmung in KI-Antworten messbar lesen",
  measureText: "Wir betrachten Wahrnehmung auf Fragenebene – getrennt nach Thema, Kontext und Antwortumfeld.",
  diagnose: "Ursachen erkennen und Wahrnehmung in Arbeit übersetzen",
  diagnoseText: "Die Analyse verbindet das Gesagte mit den Seiten, Fakten und externen Kontexten, die das Bild prägen.",
  insight: "Signale der Wahrnehmung",
  measureLabel: "Messrahmen",
  diagnoseLabel: "Arbeitsrahmen",
  method: "Von der Erzählung zur kontrollierten nächsten Handlung",
  faq: "Häufig gestellte Fragen",
};

const capabilities = isEnglish ? [
  { title: "Dedicated perception questions", text: "Ask where the brand is understood clearly and where the picture stays generic." },
  { title: "Theme and tone overview", text: "Read recurring traits and the tone connected with the offer." },
  { title: "Themes and root causes", text: "Connect recurring narratives with the sources behind them." },
  { title: "Perception-to-action workflow", text: "Turn the findings into precise work on pages, facts and context." },
] : [
  { title: "Gezielte Wahrnehmungsfragen", text: "Prüfe, wo die Marke klar verstanden wird und wo das Bild austauschbar bleibt." },
  { title: "Themen- und Tonalitätsbild", text: "Lies wiederkehrende Eigenschaften und den Ton, der mit dem Angebot verbunden wird." },
  { title: "Muster und Ursachen", text: "Verbinde wiederkehrende Erzählungen mit den Quellen, die dahinterstehen." },
  { title: "Vom Markenbild zur Arbeit", text: "Übersetze die Befunde in präzise Arbeit an Seiten, Fakten und Kontext." },
];

const diagnoseItems = isEnglish ? [
  { title: "Root cause investigation", text: "Trace evaluations back to owned pages, profiles, editorial mentions and recurring competitor context." },
  { title: "Perception and reality", text: "Separate a communication gap from a genuine gap in the service or customer experience." },
  { title: "Perception monitoring", text: "Selected repeat observations show whether clearer content and new evidence change the answer pattern." },
  { title: "Actionable workflows", text: "Turn findings into precise briefs for website content, sources, editorial work or positioning." },
] : [
  { title: "Ursachen untersuchen", text: "Verfolge Zuschreibungen zurück zu eigenen Seiten, Profilen, redaktionellen Erwähnungen und Wettbewerbskontexten." },
  { title: "Wahrnehmung und Realität", text: "Trenne eine kommunikative Lücke von einer tatsächlichen Lücke im Angebot oder Kundenerlebnis." },
  { title: "Wahrnehmung beobachten", text: "Ausgewählte Wiederholungen zeigen, ob klarere Inhalte und neue Belege das Antwortmuster verändern." },
  { title: "Konkrete Arbeitsabläufe", text: "Übersetze Befunde in präzise Briefings für Website-Inhalte, Quellenarbeit, Redaktion oder Positionierung." },
];

const insightItems = isEnglish ? [
  { title: "Answer picture", text: "See which traits repeatedly appear together." },
  { title: "Tone development", text: "Separate stable perception from short-term variation." },
  { title: "Source influence", text: "Trace which contexts reinforce a narrative." },
  { title: "Reality check", text: "Distinguish communication drift from a real service gap." },
] : [
  { title: "Antwortbild", text: "Erkenne, welche Eigenschaften wiederholt gemeinsam auftreten." },
  { title: "Tonalitätsverlauf", text: "Trenne stabile Wahrnehmung von kurzfristiger Abweichung." },
  { title: "Quelleneinfluss", text: "Verfolge, welche Kontexte eine Erzählung verstärken." },
  { title: "Realitätsprüfung", text: "Unterscheide kommunikative Drift von einer echten Angebotslücke." },
];

const faqItems = [...page.faq.items, ...(isEnglish ? [
  { question: "Which answer environments are included?", answer: "The selection follows the audience and topic. Relevant systems are read through the same set of perception questions." },
  { question: "How are negative themes prioritised?", answer: "Frequency alone is not enough. We combine relevance, source strength, development and the actual impact on a customer decision." },
  { question: "Can the findings guide content work?", answer: "Yes. The analysis identifies where an existing page needs a clearer fact, a better explanation or stronger external context." },
] : [
  { question: "Welche Antwortumfelder werden einbezogen?", answer: "Die Auswahl folgt Zielgruppe und Thema. Relevante Systeme werden mit demselben Satz an Wahrnehmungsfragen gelesen." },
  { question: "Wie werden negative Themen priorisiert?", answer: "Häufigkeit allein reicht nicht. Wir verbinden Relevanz, Quellenstärke, Entwicklung und die tatsächliche Wirkung auf eine Kundenentscheidung." },
  { question: "Kann die Analyse die Content-Arbeit steuern?", answer: "Ja. Sie zeigt, wo eine vorhandene Seite einen klareren Fakt, eine bessere Erklärung oder stärkeren externen Kontext benötigt." },
])];

const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: faqItems });
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="sentiment-reference-page ui-dark-page dark">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border">
      <div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
        <nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isEnglish ? "Breadcrumb" : "Brotkrumen-Navigation"}>
          {breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}
        </nav>
        <div class="max-w-3xl pt-12">
          <h1 class="m-0 text-display-mobile font-medium text-foreground md:text-display">{page.title}</h1>
          <p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{page.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={ui.primary} icon="right" /><LinkButton href="#analyse" label={ui.secondary} variant="secondary" icon="down" /></div>
        </div>
        <div class="mt-20"><p class="m-0 mb-4 text-xs leading-copy text-muted-foreground">{page.demo.note}</p><BrandPerceptionHoverFeatures items={capabilities} client:load /></div>
      </div>
    </section>

    <section id="analyse" class="border-b border-solid border-border">
      <div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-2 lg:py-section">
        <header class="lg:sticky lg:top-[125px] lg:self-start">
          <p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{ui.measureLabel}</p>
          <h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{ui.measure}</h2>
          <p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{ui.measureText}</p>
        </header>
        <div class="flex items-center lg:min-h-[900px]"><BrandPerceptionRadarChart items={insightItems} lang={page.lang} client:load /></div>
      </div>
    </section>

    <section id="ursachen">
      <div class="mx-auto grid max-w-content grid-cols-1 px-5 md:px-12 lg:grid-cols-2">
        <header class="py-16 lg:sticky lg:top-[125px] lg:self-start lg:py-[72px] lg:pr-16">
          <h2 class="m-0 max-w-[430px] text-section-title font-medium text-foreground">{ui.diagnose}</h2>
          <p class="m-0 mt-6 max-w-[390px] text-base leading-copy text-muted-foreground">{ui.diagnoseText}</p>
        </header>
        <EditorialFeatureList items={diagnoseItems} label={ui.diagnoseLabel} client:load />
      </div>
    </section>

    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><h2 class="m-0 max-w-2xl text-section-title font-medium text-foreground">{ui.method}</h2><div class="mt-12 lg:mt-16"><ProcessPillars steps={page.method.steps} client:load /></div></div></section>

    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{ui.faq}</h2><FaqAccordion items={faqItems} theme="dark" className="lg:col-span-2" /></section>

    <SubpageContact lang={page.lang} source="brand-perception-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<style>
  :global(body.sentiment-reference-page main > section) {
    border-right-width: 0;
    border-left-width: 0;
  }
  :global(body.sentiment-reference-page .brand-hover-active-title) {
    font-size: clamp(34px, 4vw, 48px) !important;
    line-height: 1.1 !important;
    letter-spacing: -.035em;
  }
  @media (max-width: 560px) {
    :global(body.sentiment-reference-page .brand-hover-active-title) {
      font-size: 32px !important;
    }
  }
</style>
