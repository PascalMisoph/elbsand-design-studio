---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import ServicePresenceGrid from "./ServicePresenceGrid.astro";
import { ChartNoAxesCombined, ListChecks, Network, SlidersHorizontal } from "@lucide/astro";
import openAiLogo from "@lobehub/icons-static-svg/icons/openai.svg?url";
import perplexityLogo from "@lobehub/icons-static-svg/icons/perplexity.svg?url";
import claudeLogo from "@lobehub/icons-static-svg/icons/claude.svg?url";
import type { ServicePageContent } from "../content/service-pages";
import { content } from "../content/site";
import { createServicePageSchema } from "../lib/seo";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const de = page.lang === "de";
const site = content[page.lang];
const homePath = de ? "/" : "/en/";
const canonical = de ? page.alternateDePath : page.alternateEnPath;
const hub = de ? "/geo-optimierung/" : "/en/geo-optimization/";
const crumbs = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: hub },
  { name: page.breadcrumb.current, href: canonical }
];
const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonical, serviceName: page.eyebrow, breadcrumbs: crumbs, faqs: page.faq.items });
const storyIcons = [SlidersHorizontal, ChartNoAxesCombined, Network, ListChecks];
const answerPlatforms = [
  { name: "ChatGPT", logo: openAiLogo },
  { name: "Perplexity", logo: perplexityLogo },
  { name: "Claude", logo: claudeLogo },
];
const presenceFeatures = de ? [
  { title: "Sichtbarkeits-Scores", text: "Miss mit Sichtbarkeits-Score und Share-of-Voice-Metriken, wie oft du in KI-Antworten erscheinst." },
  { title: "Stimmung & Themen", text: "Analysiere, wie KI deine Marke beschreibt. Erkenne Schlüsselthemen und wiederkehrende Narrative." },
  { title: "Quellenautorität", text: "Sieh, welche Websites KI-generierte Antworten über deine Marke beeinflussen, und verfolge ihre Autorität." },
  { title: "Faktencheck deiner Marke", text: "Verstehe, welche Aussagen KI über deine Marke trifft, welche Quellen Ungenauigkeiten verursachen und wie du sie korrigierst." },
  { title: "Wettbewerbsvergleich", text: "Vergleiche deine Präsenz mit Branchenführern und relevanten Wettbewerbern." },
  { title: "Plattformvergleich", text: "Erkenne Unterschiede bei Sichtbarkeit, Genauigkeit und Darstellung auf den wichtigsten KI-Plattformen." },
] : [
  { title: "Visibility Scores", text: "Measure how often you appear in AI answers with visibility score and share of voice metrics." },
  { title: "Sentiment & Keyword Insights", text: "Analyze how AI describes your brand. Identify key themes, topics, and recurring narratives." },
  { title: "Citation Authority", text: "See which websites influence AI-generated answers about your brand and track their authority." },
  { title: "FactCheck what AI says about your brand", text: "Understand the claims AI makes about your brand, the sources driving inaccuracies, and how to correct them." },
  { title: "Competitive Benchmarking", text: "Compare your presence against industry leaders and competitors." },
  { title: "Platform Comparisons", text: "Uncover differences in visibility, accuracy, and representation across all the major AI engines." },
];
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonical} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="audit-route">
  <Header lang={page.lang} nav={site.nav} cta={site.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />
  <main id="main-content" class="audit-page">
    <section class="a-hero a-shell">
      <nav class="a-crumbs" aria-label={de ? "Brotkrumen-Navigation" : "Breadcrumb"}>{crumbs.map((item, i) => <>{i > 0 && <span aria-hidden="true">/</span>}{i === crumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}</nav>
      <div class="a-hero-grid"><div class="a-hero-copy"><p class="a-kicker">{page.eyebrow}</p><h1>{page.title}</h1><p>{page.lead}</p><div class="a-actions"><a class="a-button" href={`${homePath}#ki-check`}>{page.primaryCta}</a><a class="a-link" href="#audit-story">{page.secondaryCta}<span aria-hidden="true">↓</span></a></div></div><div class="a-report" aria-label={de ? "Illustratives Dashboard zur KI-Sichtbarkeit" : "Illustrative AI visibility dashboard"}><div class="a-report-top"><span><i></i><i></i><i></i></span><b>PATERNOGA / GEO AUDIT</b></div><p class="a-report-provenance">{de ? "Illustratives Audit-Beispiel · keine Kundendaten" : "Illustrative audit example · no client data"}</p></div></div>
    </section>

    <ServicePresenceGrid heading={de ? "Verstehe und ordne deine KI-Präsenz ein" : "Understand and assess your AI presence"} items={presenceFeatures} lang={page.lang} />

    <section id="audit-story" class="a-story a-shell" data-a-story>
      <div class="a-story-copy">
        <h2>{de ? "Erkenne, was KI potenziellen Kunden über dein Unternehmen sagt" : "See what AI tells potential customers about your business"}</h2>
        <p>{de ? "Du erfährst, ob dein Angebot korrekt verstanden wird, welche Quellen das Bild prägen und was du konkret verbessern kannst, um bei relevanten Entscheidungen sichtbarer und vertrauenswürdiger zu werden." : "Find out whether your offer is understood correctly, which sources shape the story and what to improve so your business becomes more visible and credible at relevant decision moments."}</p>
      </div>
      <div class="a-story-list">
        {page.method.steps.map((step, index) => {
          const StepIcon = storyIcons[index] ?? ChartNoAxesCombined;
          return (
            <article class:list={{ "is-active": index === 0 }} data-a-step={index}>
              <StepIcon class="a-step-icon" size={16} stroke-width={1.5} aria-hidden="true" />
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          );
        })}
      </div>
    </section>

    <section class="a-method a-shell" data-platform-story>
      <div class="a-method-copy">
        <h2>{de ? "Gewinne Einblicke aus den wichtigsten KI-Antwortsystemen" : "Gain insight across the major AI answer engines"}</h2>
        <p>{de ? "Wir betrachten Antworten so, wie potenzielle Kunden sie tatsächlich sehen – in der realen Nutzeransicht der Systeme und nicht ausschließlich als isolierte API-Ausgabe." : "We review answers as potential customers actually see them – in the systems’ real consumer experience rather than relying exclusively on isolated API output."}</p>
      </div>
      <div class="a-platform-stack">
        {answerPlatforms.map((platform, index) => (
          <article class:list={{ "is-active": index === 0 }} data-platform-panel>
            <div class="a-platform-brand">
              <img src={platform.logo} alt="" width="52" height="52" loading="lazy" decoding="async" />
              <h3>{platform.name}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="a-faq a-shell"><div><p class="a-kicker">{page.faq.eyebrow}</p><h2>{page.faq.title}</h2></div><div>{page.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
    <SubpageContact lang={page.lang} source="geo-audit-service" />
  </main>
  <Footer {...site.footer} lang={page.lang} />
</BaseLayout>

<script>
  const auditRoot = document.querySelector(".audit-page");
  const reduceAudit = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (auditRoot && !reduceAudit.matches) {
    const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: .14, rootMargin: "0px 0px -10%" });
    auditRoot.querySelectorAll("[data-presence-reveal], [data-a-reveal]").forEach((el) => reveal.observe(el));
    const steps = [...auditRoot.querySelectorAll("[data-a-step]")];
    const observer = new IntersectionObserver((entries) => { const active = entries.filter((e) => e.isIntersecting).sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!active) return; const index = Number(active.target.getAttribute("data-a-step")); steps.forEach((step, i) => step.classList.toggle("is-active", i === index)); }, { threshold: [.28,.6], rootMargin: "-24% 0px -42%" });
    steps.forEach((step) => observer.observe(step));
    const platformPanels = [...auditRoot.querySelectorAll("[data-platform-panel]")];
    const platformObserver = new IntersectionObserver((entries) => { const active = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!active) return; platformPanels.forEach((panel) => panel.classList.toggle("is-active", panel === active.target)); }, { threshold: [.3, .65], rootMargin: "-18% 0px -38%" });
    platformPanels.forEach((panel) => platformObserver.observe(panel));
  } else auditRoot?.querySelectorAll("[data-presence-reveal], [data-a-reveal]").forEach((el) => el.classList.add("is-visible"));
</script>

<style>
  .a-shell{box-sizing:border-box}.a-report{box-sizing:border-box}.a-faq,.a-faq h2,.a-faq summary,.a-faq details p{font-family:Inter,system-ui,sans-serif}@media(max-width:860px){.a-hero-grid,.a-insights>header,.a-story,.a-method,.a-faq{grid-template-columns:minmax(0,1fr)}}
  :global(body.audit-route){--a-bg:#171715;--a-surface:#24221f;--a-line:rgba(255,250,244,.15);--a-ink:#fbf8f2;--a-muted:#b7b0a5;--a-accent:#b74622;background:var(--a-bg);color:var(--a-ink);font-family:Inter,system-ui,sans-serif}:global(body.audit-route .site-header),:global(body.audit-route .site-footer){background:var(--a-bg);color:var(--a-ink);border-color:var(--a-line)}:global(body.audit-route .language-switch){background:rgba(255,250,244,.06)}:global(body.audit-route .language-switch a[aria-current="page"]){background:rgba(255,250,244,.12);box-shadow:none}.audit-page{overflow:hidden}.a-shell{width:min(100%,1120px);margin-inline:auto;padding-inline:32px}.a-hero{padding-top:28px}.a-crumbs{display:flex;flex-wrap:wrap;gap:8px;color:var(--a-muted);font-size:12px}.a-crumbs a:hover{color:var(--a-ink)}.a-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.75fr);gap:85px;align-items:center;padding:100px 0 74px}.a-kicker{margin:0 0 20px;color:#d37a5c;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.a-hero h1{max-width:650px;margin:0;font-size:clamp(54px,6vw,80px);font-weight:520;line-height:.98;letter-spacing:-.065em}.a-hero-copy>p:not(.a-kicker){max-width:610px;margin:30px 0 0;color:var(--a-muted);font-size:18px;line-height:1.6}.a-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.a-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:8px;background:var(--a-accent);padding:0 18px;color:#fff7ed;font-size:15px;font-weight:650;text-decoration:none;transition:transform 180ms ease,background 180ms ease}.a-button:hover{background:#c9532b;transform:translateY(-2px)}.a-link{display:inline-flex;min-height:48px;align-items:center;gap:18px;border:1px solid rgba(255,250,244,.28);border-radius:8px;padding:0 18px;color:var(--a-ink);font-size:15px;font-weight:600}.a-link span{color:#d37a5c}.a-report{min-height:460px;border:1px solid var(--a-line);border-radius:14px;background:#10100f;padding:20px;box-shadow:24px 28px 80px rgba(0,0,0,.24);transform:rotate(-1.3deg);transition:transform 600ms ease}.a-report:hover{transform:rotate(0) translateY(-5px)}.a-report-top{display:flex;justify-content:space-between;border-bottom:1px solid var(--a-line);padding-bottom:16px;color:#88837b;font-size:11px}.a-report-top span{display:flex;gap:6px}.a-report-top span i{width:8px;height:8px;border-radius:50%;background:#45423d}.a-report-top b{font-weight:600;letter-spacing:.08em}.a-report-top em{font-style:normal;color:#d37a5c}.a-report-url{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;margin-top:40px;border:1px solid var(--a-line);padding:13px 14px}.a-report-url small{color:#827c73;font-size:10px;text-transform:uppercase}.a-report-url strong{font-size:13px;font-weight:550}.a-report-url span{color:#9dbb91}.a-report-scan{display:flex;align-items:center;justify-content:space-between;padding:50px 22px 33px}.a-report-score small{display:block;color:#8a847c;font-size:12px}.a-report-score strong{display:block;margin-top:12px;font-size:72px;font-weight:500;letter-spacing:-.08em}.a-report-score strong span{margin-left:5px;color:#d37a5c;font-size:22px;letter-spacing:0}.a-report-ring{display:grid;width:120px;height:120px;place-items:center;border:10px solid #34302b;border-top-color:#d37a5c;border-right-color:#d37a5c;border-radius:50%;transform:rotate(18deg)}.a-report-ring b{transform:rotate(-18deg);font-size:20px;font-weight:500}.a-report-tags{display:grid;gap:6px}.a-report-tags span{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--a-line);padding:12px 4px;color:#b8b0a4;font-size:13px}.a-report-tags b{color:#d37a5c;font-size:12px;font-weight:600}.a-report-tags span.good b{color:#9dbb91}.a-report-note{display:block;margin-top:25px;color:#706b65;font-size:10px}.a-report-strip{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--a-line);border-bottom:1px solid var(--a-line)}.a-report-strip span{display:flex;align-items:center;gap:13px;min-height:80px;border-left:1px solid var(--a-line);padding:0 18px;color:#d6cec4;font-size:13px}.a-report-strip span:first-child{border-left:0}.a-report-strip b{color:#d37a5c;font-weight:600}.a-insights{padding-top:125px;padding-bottom:125px}.a-insights>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,.7fr);gap:35px;align-items:end;margin-bottom:53px}.a-insights>header .a-kicker{grid-column:1/-1;margin-bottom:0}.a-insights h2{max-width:670px;margin:0;font-size:clamp(40px,4.6vw,60px);font-weight:520;line-height:1;letter-spacing:-.06em}.a-insights>header>p:last-child{max-width:350px;margin:0;color:var(--a-muted);font-size:15px;line-height:1.55}.a-insight-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--a-line);border-bottom:1px solid var(--a-line)}.a-insight-grid article{min-height:250px;border-left:1px solid var(--a-line);padding:26px}.a-insight-grid article:first-child{border-left:0}.a-insight-top{display:flex;justify-content:space-between;align-items:center}.a-insight-top>span{color:#d37a5c;font-size:13px}.a-insight-top i{width:11px;height:11px;border:2px solid #d37a5c;border-radius:50%}.a-insight-top i.clear{border-color:#9dbb91;background:#9dbb91}.a-insight-grid h3{margin:65px 0 12px;font-size:23px;font-weight:530;letter-spacing:-.04em}.a-insight-grid p{min-height:67px;margin:0;color:var(--a-muted);font-size:14px;line-height:1.55}.a-insight-grid strong{display:block;margin-top:20px;color:#d37a5c;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.a-story{display:grid;grid-template-columns:minmax(0,.58fr) minmax(0,1fr);gap:70px;border-top:1px solid var(--a-line);padding-top:135px;padding-bottom:145px}.a-story-copy{position:sticky;top:125px;align-self:start}.a-story-copy h2{max-width:390px;margin:0;font-size:clamp(40px,4.6vw,58px);font-weight:520;line-height:1;letter-spacing:-.06em}.a-story-copy>p:not(.a-kicker){max-width:390px;margin:25px 0;color:var(--a-muted);font-size:16px;line-height:1.6}.a-story-meter{height:2px;margin-top:62px;background:var(--a-line)}.a-story-meter i{display:block;width:100%;height:100%;background:#d37a5c;transform:scaleX(.25);transform-origin:left;transition:transform 500ms ease}.a-story-list{grid-column:2}.a-story-list article{display:grid;grid-template-columns:38px minmax(0,1fr) 25px;gap:18px;min-height:205px;border-top:1px solid var(--a-line);padding:28px 0;opacity:.35;transition:opacity 500ms ease,transform 500ms ease}.a-story-list article.is-active{opacity:1;transform:translateX(8px)}.a-story-list article>span{display:grid;width:35px;height:35px;place-items:center;border:1px solid #d37a5c;border-radius:50%;color:#d37a5c;font-size:13px}.a-story-list h3{margin:4px 0 12px;font-size:25px;font-weight:530;letter-spacing:-.04em}.a-story-list p{max-width:430px;margin:0;color:var(--a-muted);font-size:16px;line-height:1.58}.a-story-list b{color:#d37a5c;font-size:19px;font-weight:400}.a-story-artifact{grid-column:1/-1;border:1px solid var(--a-line);background:#10100f;padding:19px 22px}.a-artifact-header{display:flex;justify-content:space-between;color:#8e8980;font-size:12px}.a-artifact-header b{color:#9dbb91;font-weight:600}.a-artifact-line{display:grid;grid-template-columns:repeat(4,1fr);align-items:center;height:90px;background:linear-gradient(#d37a5c,#d37a5c) center/100% 1px no-repeat}.a-artifact-line i{width:17px;height:17px;border:4px solid #d37a5c;border-radius:50%;background:#10100f}.a-artifact-line i:nth-child(2),.a-artifact-line i:nth-child(3){justify-self:center}.a-artifact-line i:last-child{justify-self:end}.a-artifact-labels{display:grid;grid-template-columns:repeat(4,1fr);color:#b7b0a5;font-size:12px}.a-artifact-labels span:nth-child(2),.a-artifact-labels span:nth-child(3){text-align:center}.a-artifact-labels span:last-child{text-align:right}.a-method{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1fr);gap:90px;border-top:1px solid var(--a-line);padding-top:125px;padding-bottom:125px}.a-method h2{max-width:450px;margin:0;font-size:clamp(40px,4.5vw,58px);font-weight:520;line-height:1;letter-spacing:-.06em}.a-method-board{border:1px solid var(--a-line);background:#10100f}.a-board-head{display:flex;justify-content:space-between;border-bottom:1px solid var(--a-line);padding:17px 20px;color:#d6cec4;font-size:13px}.a-board-head small{color:#807970;font-size:11px}.a-board-row{display:grid;grid-template-columns:32px minmax(0,1fr) auto;gap:13px;align-items:center;min-height:72px;border-bottom:1px solid var(--a-line);padding:0 20px}.a-board-row>span{display:grid;width:26px;height:26px;place-items:center;border:1px solid #d37a5c;border-radius:50%;color:#d37a5c;font-size:11px}.a-board-row strong{font-size:14px;font-weight:550}.a-board-row em{color:#d37a5c;font-size:11px;font-style:normal}.a-faq{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:90px;border-top:1px solid var(--a-line);padding-top:110px;padding-bottom:110px}.a-faq h2{max-width:400px;margin:0;font-size:clamp(38px,4vw,56px);font-weight:520;line-height:1;letter-spacing:-.055em}.a-faq details{border-top:1px solid var(--a-line);padding:21px 0}.a-faq details:last-child{border-bottom:1px solid var(--a-line)}.a-faq summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer;font-size:16px;font-weight:600;list-style:none}.a-faq summary::-webkit-details-marker{display:none}.a-faq summary span{color:#d37a5c;font-size:22px;font-weight:400}.a-faq details p{max-width:600px;margin:16px 0 3px;color:var(--a-muted);font-size:16px;line-height:1.6}.a-close{display:grid;justify-items:center;border-top:1px solid var(--a-line);padding-top:120px;padding-bottom:130px;text-align:center}.a-close h2{max-width:760px;margin:0;font-size:clamp(46px,5.4vw,72px);font-weight:520;line-height:1;letter-spacing:-.065em}.a-close>p:not(.a-kicker){max-width:580px;margin:24px 0;color:var(--a-muted);font-size:17px;line-height:1.6}.a-close .a-button{margin-top:8px}@media(max-width:860px){.a