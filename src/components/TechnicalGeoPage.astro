---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import FeatureCardGrid from "./FeatureCardGrid";
import LinkButton from "./LinkButton";
import RelatedLinkGrid from "./RelatedLinkGrid";
import TechnicalArtifactCircuit from "./TechnicalArtifactCircuit";
import TechnicalFoundationBeam from "./TechnicalFoundationBeam";
import TechnicalGeoMacbook from "./TechnicalGeoMacbook";
import { content } from "../content/site";
import { technicalGeoOptimizationPages } from "../content/service-pages/technical-content";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const isGerman = lang === "de";
const siteContent = content[lang];
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? "/technische-geo-optimierung/" : "/en/technical-geo-optimization/";
const meta = technicalGeoOptimizationPages[lang].meta;
const t = isGerman ? {
  title: "Technische GEO-Optimierung für klare, erreichbare Inhalte",
  description: "Technische GEO-Optimierung verbindet semantisches HTML, kurze Ladewege, strukturierte Fakten und eine nachvollziehbare interne Verlinkung.",
  eyebrow: "Technische GEO-Optimierung",
  lead: "Antwortsysteme können nur aufgreifen, was sie erreichen, lesen und einordnen können. Wir prüfen die technische Grundlage deiner Website und machen aus einzelnen Seiten einen verständlichen, belastbaren Pfad.",
  cta: "Technik-Check anfragen",
  jump: "Grundlagen ansehen",
  home: "Start",
  hub: "GEO-Optimierung",
  outcomes: [
    { title: "Semantik statt Oberfläche", text: "Überschriften, Landmarks und Inhalte bilden eine klare Lesereihenfolge." },
    { title: "Kürzere Wege zur Antwort", text: "Serverseitige Inhalte und schlanke Assets reduzieren unnötige Wartezeiten." },
    { title: "Ein flacher, sinnvoller Pfad", text: "Interne Links zeigen, welche Seite welches Thema weiterführt." },
  ],
  methodEyebrow: "Technische Grundlage",
  methodTitle: "Vier Ebenen, die zusammen lesbar werden",
  methodLead: "Jede Ebene beantwortet eine andere technische Frage und wird an der nächsten geprüft.",
  steps: [
    { title: "Semantisches HTML", text: "Ist die wichtigste Aussage in einer nachvollziehbaren Überschriften- und Landmark-Struktur vorhanden?" },
    { title: "Antwortpfad", text: "Können wichtige Seiten ohne Ketten, Umwege oder Sackgassen erreicht werden?" },
    { title: "Performance", text: "Kommt relevanter Inhalt schnell und ohne clientseitige Abhängigkeit im ersten Response an?" },
    { title: "Faktenstruktur", text: "Sind Angebot, Ort, Zuständigkeit und Aktualität in passenden Feldern verbunden?" },
  ],
  artifactTitle: "Eine Seite, die als Struktur lesbar bleibt",
  artifactLead: "Quellstruktur, gerenderte Bedeutung und Faktenkontext werden als zusammenhängender technischer Pfad geprüft.",
  artifactItems: [
    { title: "Quellstruktur", text: "Landmarks und Überschriften tragen die Lesereihenfolge." },
    { title: "Gerenderte Bedeutung", text: "Der Kerninhalt bleibt ohne unnötigen Browser-Umweg verfügbar." },
    { title: "Fakten & Kontext", text: "Angebot, Ort und Aktualität sind eindeutig miteinander verbunden." },
  ],
  relatedTitle: "Technik zwischen Audit und Umsetzung",
  related: [
    { title: "AI Crawlability", text: "Bot-Zugriff, Serverantwort und Reichweite prüfen.", href: "/ai-crawlability/" },
    { title: "GEO Audit", text: "Antworten, Quellen und technische Ausgangslage priorisieren.", href: "/geo-audit/" },
    { title: "GEO-Content", text: "Neue Seiten auf einer klaren, erreichbaren Struktur aufbauen.", href: "/geo-content/" },
  ],
  faqTitle: "Fragen zur technischen GEO-Optimierung",
  faq: [
    { question: "Ist technische GEO-Optimierung etwas anderes als technisches SEO?", answer: "Die Grundlagen überschneiden sich stark. Der zusätzliche Fokus liegt darauf, dass Antwortsysteme relevante Inhalte direkt erreichen, lesen und im Kontext einordnen können." },
    { question: "Brauche ich eine eigene Markdown-Version meiner Website?", answer: "Nicht automatisch. Zuerst werden HTML-Struktur, serverseitige Auslieferung und der tatsächliche Informationspfad geprüft." },
    { question: "Kann strukturierte Daten eine Empfehlung garantieren?", answer: "Nein. Strukturierte Daten helfen, Fakten eindeutig zu benennen, ersetzen aber keine guten, erreichbaren Inhalte." },
    { question: "Was erhalte ich nach dem Check?", answer: "Eine priorisierte technische Sicht mit Befund, betroffenen Seiten, konkreter Änderung und klarer Reihenfolge." },
    { question: "Welche Zugänge oder Mitarbeit braucht ihr?", answer: "Für die erste Prüfung reichen Domain und wichtigste Seitentypen. Wenn Befunde tiefer geprüft oder umgesetzt werden, stimmen wir benötigte CMS-, Hosting- oder Code-Zugänge gezielt ab. PATERNOGA analysiert und dokumentiert; technische Änderungen erfolgen nur im vereinbarten System und nach deiner Freigabe." },
  ],
} : {
  title: "Technical GEO optimization for content that stays clear and reachable",
  description: "Technical GEO optimization connects semantic HTML, fast delivery, structured facts and a purposeful internal link path.",
  eyebrow: "Technical GEO Optimization",
  lead: "Answer systems can only use what they can reach, read and place in context. We review the technical foundation and turn individual pages into a clear, dependable path.",
  cta: "Request a technical check",
  jump: "See the foundations",
  home: "Home",
  hub: "GEO Optimization",
  outcomes: [
    { title: "Semantics over surface", text: "Headings, landmarks and content create a clear reading order." },
    { title: "Shorter routes to the answer", text: "Server-rendered content and lean assets remove unnecessary waiting." },
    { title: "A shallow, useful path", text: "Internal links show which page carries the topic forward." },
  ],
  methodEyebrow: "Technical foundation",
  methodTitle: "Four layers that become readable together",
  methodLead: "Each layer answers a different technical question and is tested against the next.",
  steps: [
    { title: "Semantic HTML", text: "Is the main statement present in a coherent heading and landmark structure?" },
    { title: "Answer path", text: "Can priority pages be reached without chains, detours or dead ends?" },
    { title: "Performance", text: "Does relevant content arrive quickly in the first response without a client-side dependency?" },
    { title: "Fact structure", text: "Are offer, location, ownership and currency connected in suitable fields?" },
  ],
  artifactTitle: "A page that remains readable as structure",
  artifactLead: "Source structure, rendered meaning and fact context are reviewed as one technical path.",
  artifactItems: [
    { title: "Source structure", text: "Landmarks and headings carry the reading order." },
    { title: "Rendered meaning", text: "Core content remains available without an unnecessary browser detour." },
    { title: "Facts & context", text: "Offer, location and currency are connected unambiguously." },
  ],
  relatedTitle: "Technical work between audit and delivery",
  related: [
    { title: "AI crawlability", text: "Review bot access, server response and reach.", href: "/en/ai-crawlability/" },
    { title: "GEO audit", text: "Prioritise answers, sources and technical foundations.", href: "/en/geo-audit/" },
    { title: "GEO content", text: "Build new pages on a clear, reachable structure.", href: "/en/geo-content/" },
  ],
  faqTitle: "Questions about technical GEO optimization",
  faq: [
    { question: "Is technical GEO optimization different from technical SEO?", answer: "The foundations overlap heavily. The additional emphasis is helping answer systems reach, read and understand relevant content." },
    { question: "Do I need a Markdown version of my website?", answer: "Not automatically. HTML structure, server delivery and the actual information path are reviewed first." },
    { question: "Can structured data guarantee a recommendation?", answer: "No. Structured data helps name facts clearly but cannot replace useful, reachable content." },
    { question: "What do I receive after the check?", answer: "A prioritised technical view with finding, affected pages, concrete change and clear implementation order." },
    { question: "Which access or input do you need?", answer: "For the initial review, the domain and priority page types are enough. If findings need deeper investigation or implementation, we agree the required CMS, hosting or code access specifically. PATERNOGA analyses and documents; technical changes are made only in the agreed system and after your approval." },
  ],
};

const breadcrumbItems = [{ name: t.home, href: homePath }, { name: t.hub, href: isGerman ? "/geo-optimierung/" : "/en/geo-optimization/" }, { name: t.eyebrow, href: canonicalPath }];
const schema = createServicePageSchema({ lang, title: meta.title, description: meta.description, path: canonicalPath, serviceName: t.eyebrow, breadcrumbs: breadcrumbItems, faqs: t.faq });
---

<BaseLayout title={meta.title} description={meta.description} lang={lang} canonicalPath={canonicalPath} alternateDePath="/technische-geo-optimierung/" alternateEnPath="/en/technical-geo-optimization/" schema={schema} bodyClass="technical-page ui-dark-page dark">
  <Header lang={lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath="/technische-geo-optimierung/" alternateEnPath="/en/technical-geo-optimization/" />
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}</nav><div class="grid grid-cols-1 items-center gap-10 xl:w-[calc(100%+min(11vw,160px))] xl:grid-cols-[minmax(0,1fr)_430px] xl:gap-8"><div class="max-w-3xl pt-12"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.eyebrow}</p><h1 class="m-0 mt-6 text-display-mobile font-medium text-foreground md:text-display">{t.title}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{t.lead}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={t.cta} icon="right" /><LinkButton href="#technical-foundations" label={t.jump} variant="secondary" icon="down" /></div></div><div class="pt-4 xl:pt-12"><TechnicalGeoMacbook lang={lang} client:load /></div></div><div class="mt-20"><FeatureCardGrid items={t.outcomes} columns={3} /></div></div></section>
    <section id="technical-foundations" class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-2 lg:py-section"><div class="lg:sticky lg:top-24 lg:self-start"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.methodEyebrow}</p><h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{t.methodTitle}</h2><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{t.methodLead}</p></div><TechnicalFoundationBeam items={t.steps} label={t.methodEyebrow} client:load /></section>
    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><h2 class="m-0 text-section-title font-medium text-foreground">{t.artifactTitle}</h2><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{t.artifactLead}</p></header><TechnicalArtifactCircuit lang={lang} client:load /></div></section>
    <section class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><h2 class="m-0 max-w-2xl text-section-title font-medium text-foreground">{t.relatedTitle}</h2><div class="mt-12"><RelatedLinkGrid items={t.related} /></div></section>
    <section class="border-t border-solid border-border"><div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{t.faqTitle}</h2><FaqAccordion items={t.faq} theme="dark" className="lg:col-span-2" /></div></section>
    <SubpageContact lang={lang} source="technical-geo-service" />
  </main>
  <Footer {...siteContent.footer} lang={lang} />
</BaseLayout>
