---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const siteContent = content[page.lang];
const isEnglish = page.lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const canonicalPath = isEnglish ? page.alternateEnPath : page.alternateDePath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/" },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath },
];
const labels = isEnglish ? {
  primary: "Start fact check",
  secondary: "Contact us",
  accuracy: "Accuracy score",
  improvement: "+5%",
  update: "What's new",
  updateTitle: "Accuracy is becoming clearer",
  updateText: "A concise summary of the statements that need a maintained source.",
  inaccurate: "Top statements to review",
  references: "Relevant answer systems in the review",
  statement: "Statement to review",
  reason: "Why it needs review",
  sourceList: "Statements and source status",
  highlight: "Show source path",
  tableClaim: "Statement",
  tableOccurrence: "Priority",
  tableAction: "Suggested action",
  learn: "View service",
  questions: "Frequently asked questions",
  actions: ["Confirm source", "Update page", "Request correction", "Observe"],
} : {
  primary: "Faktencheck starten",
  secondary: "Kontakt aufnehmen",
  accuracy: "Genauigkeitswert",
  improvement: "+5%",
  update: "Was ist neu?",
  updateTitle: "Die Faktenlage wird klarer",
  updateText: "Eine kompakte Zusammenfassung der Aussagen, die eine gepflegte Quelle benötigen.",
  inaccurate: "Wichtigste Aussagen zur Prüfung",
  references: "Relevante Antwortsysteme in der Prüfung",
  statement: "Zu prüfende Aussage",
  reason: "Warum sie geprüft wird",
  sourceList: "Aussagen und Quellenstatus",
  highlight: "Quellenpfad anzeigen",
  tableClaim: "Aussage",
  tableOccurrence: "Priorität",
  tableAction: "Empfohlene Maßnahme",
  learn: "Leistung ansehen",
  questions: "Häufige Fragen",
  actions: ["Quelle bestätigen", "Seite aktualisieren", "Korrektur anstoßen", "Beobachten"],
};
const answerSystems = ["ChatGPT", "Gemini", "Perplexity", "Claude"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: page.eyebrow,
      description: page.meta.description,
      url: new URL(canonicalPath, "https://elbsand.studio").toString(),
      provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio", url: "https://elbsand.studio/" },
      areaServed: ["Deutschland", "DACH"],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.href, "https://elbsand.studio").toString(),
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: page.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  lang={page.lang}
  canonicalPath={canonicalPath}
  alternateDePath={page.alternateDePath}
  alternateEnPath={page.alternateEnPath}
  schema={schema}
  bodyClass="fact-reference-page"
>
  <Header
    lang={page.lang}
    nav={siteContent.nav}
    cta={siteContent.cta}
    page="service"
    alternateDePath={page.alternateDePath}
    alternateEnPath={page.alternateEnPath}
  />

  <main id="main-content">
    <section class="pf-hero">
      <div class="pf-shell">
        <div class="pf-hero-copy" data-pf-reveal>
          <h1>{page.title}</h1>
          <p>{page.lead}</p>
          <div class="pf-actions">
            <a class="pf-button pf-button-primary" href={`${homePath}#ki-check`}>{labels.primary}</a>
            <a class="pf-button pf-button-secondary" href={`${homePath}#kontakt`}>{labels.secondary}</a>
          </div>
        </div>

        <div class="pf-overview" aria-label={page.demo.note} data-pf-reveal>
          <div class="pf-accuracy-panel">
            <header><span>{labels.accuracy}</span><b>73% <i>{labels.improvement}</i></b></header>
            <div class="pf-chart">
              <span>100%</span><span>80%</span><span>60%</span><span>40%</span><span>20%</span><span>0%</span>
              <svg viewBox="0 0 620 260" role="presentation" aria-hidden="true">
                <path class="pf-chart-area" d="M18 36 L64 62 L105 67 L146 108 L188 136 L228 158 L270 186 L311 210 L352 231 L394 238 L436 241 L478 137 L520 88 L562 94 L603 94 L603 250 L18 250 Z" />
                <path class="pf-chart-line" d="M18 36 L64 62 L105 67 L146 108 L188 136 L228 158 L270 186 L311 210 L352 231 L394 238 L436 241 L478 137 L520 88 L562 94 L603 94" />
              </svg>
              <div class="pf-chart-dates"><span>Apr 12</span><span>Apr 15</span><span>Apr 18</span></div>
            </div>
          </div>

          <div class="pf-update-panel">
            <p>{labels.update}</p>
            <h2>{labels.updateTitle}</h2>
            <span>{labels.updateText}</span>
            <div class="pf-split-bar"><i></i><b></b></div>
            <div class="pf-split-labels"><span>73%</span><span>27%</span></div>
            <h3>{labels.inaccurate}</h3>
            <ol>
              {page.demo.checks.slice(0, 3).map((check, index) => <li><span>{index + 1}</span><b>{check.label}</b></li>)}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="pf-references" aria-labelledby="pf-reference-title">
      <div class="pf-shell">
        <h2 id="pf-reference-title">{labels.references}</h2>
        <div class="pf-logo-grid">
          {answerSystems.map((system, index) => <div><span>{index + 1}</span><b>{system}</b></div>)}
        </div>
      </div>
    </section>

    <section class="pf-features" aria-label={page.method.title}>
      <div class="pf-feature-row">
        <div class="pf-feature-copy">
          <h2>{page.narratives[0].title}</h2>
          <p>{page.narratives[0].text}</p>
          <a class="pf-button pf-button-secondary" href={page.related.items[0].href}>{labels.learn}</a>
        </div>
        <div class="pf-feature-ui pf-claim-ui" data-pf-reveal>
          <div class="pf-claim-card">
            <span class="pf-alert"><i></i>{labels.statement}</span>
            <h3>{page.demo.checks[1].label}</h3>
            <p>{page.demo.checks[1].detail}</p>
          </div>
          <div class="pf-reason-card">
            <span><i></i>{labels.reason}</span>
            <p>{page.narratives[0].points.join(" · ")}</p>
          </div>
        </div>
      </div>

      <div class="pf-feature-row">
        <div class="pf-feature-copy">
          <h2>{page.narratives[1].title}</h2>
          <p>{page.narratives[1].text}</p>
          <a class="pf-button pf-button-secondary" href={page.related.items[1].href}>{labels.learn}</a>
        </div>
        <div class="pf-feature-ui pf-source-ui" data-pf-reveal>
          <header><h3>{labels.sourceList} <span>{page.demo.checks.length}</span></h3><button type="button">{labels.highlight}</button></header>
          <div>
            {page.demo.checks.map((check, index) => (
              <article data-status={check.status}>
                <span>{index + 1}</span>
                <div><b>{check.label}</b><p>{check.detail}</p></div>
                <i></i>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="pf-feature-row">
        <div class="pf-feature-copy">
          <h2>{page.method.title}</h2>
          <p>{page.closing.text}</p>
          <a class="pf-button pf-button-secondary" href={`${homePath}#kontakt`}>{labels.secondary}</a>
        </div>
        <div class="pf-feature-ui pf-action-ui" data-pf-reveal>
          <header><span>{labels.tableClaim}</span><span>{labels.tableOccurrence}</span><span>{labels.tableAction}</span></header>
          <div>
            {page.method.steps.map((step, index) => (
              <article>
                <div><b>{step.title}</b><p>{step.text}</p></div>
                <strong class:list={{ "is-high": index < 2 }}>{index < 2 ? (isEnglish ? "High" : "Hoch") : (isEnglish ? "Medium" : "Mittel")}</strong>
                <a href={`${homePath}#kontakt`}><span aria-hidden="true">▶</span>{labels.actions[index]}</a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pf-faq">
      <div class="pf-shell pf-faq-grid">
        <h2>{labels.questions}</h2>
        <div>
          {page.faq.items.map((item) => (
            <details>
              <summary><span>{item.question}</span><i aria-hidden="true">⌄</i></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <SubpageContact lang={page.lang} source="fact-check-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reducePfMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const pfTargets = document.querySelectorAll<HTMLElement>("[data-pf-reveal]");
  if (reducePfMotion.matches) {
    pfTargets.forEach((target) => target.classList.add("is-visible"));
  } else {
    document.documentElement.classList.add("pf-motion");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14 });
    pfTargets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  :global(body.fact-reference-page) { --pf-bg: #050504; --pf-panel: #161614; --pf-panel-2: #1d1c19; --pf-ink: #fffaf4; --pf-muted: #9e9a92; --pf-line: rgba(255,250,244,.13); --pf-accent: #b74622; --pf-green: #81b36c; overflow-x: clip; background: var(--pf-bg); color: var(--pf-ink); }
  :global(.fact-reference-page .site-header) { border-color: var(--pf-line); background: rgba(5,5,4,.94); color: var(--pf-ink); }
  :global(.fact-reference-page .language-switch) { background: rgba(255,250,244,.06); }
  :global(.fact-reference-page .language-switch a[aria-current="page"]) { background: rgba(255,250,244,.13); box-shadow: none; }
  :global(.fact-reference-page .mobile-menu nav) { background: var(--pf-panel); }
  :global(.fact-reference-page .site-footer) { border-color: var(--pf-line); background: var(--pf-bg); color: var(--pf-ink); }
  :global(.fact-reference-page main h1), :global(.fact-reference-page main h2), :global(.fact-reference-page main h3) { font-family: var(--sans); }
  .pf-shell { width: min(calc(100% - 40px), 1056px); margin-inline: auto; }
  .pf-hero { min-height: 1088px; border-bottom: 1px solid var(--pf-line); padding-top: 116px; }
  .pf-hero-copy { max-width: 700px; }
  .pf-hero h1 { max-width: 700px; margin: 0; font-size: 56px; font-weight: 500; letter-spacing: -.055em; line-height: 64px; }
  .pf-hero-copy > p { max-width: 560px; margin: 20px 0 0; color: var(--pf-muted); font-size: 16px; line-height: 24px; }
  .pf-actions { display: flex; gap: 8px; margin-top: 32px; }
  .pf-button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; border: 1px solid rgba(255,250,244,.2); border-radius: 8px; padding: 0 22px; font-family: var(--sans); font-size: 15px; font-weight: 650; text-decoration: none; transition: border-color 180ms ease, background 180ms ease, transform 180ms ease; }
  .pf-button:hover { transform: translateY(-1px); }
  .pf-button-primary { border-color: var(--pf-accent); background: var(--pf-accent); color: #fffaf4; }
  .pf-button-secondary { background: #33322f; color: var(--pf-ink); }
  .pf-overview { position: relative; height: 515px; margin-top: 58px; }
  .pf-accuracy-panel, .pf-update-panel { position: absolute; overflow: hidden; border: 1px solid var(--pf-line); border-radius: 14px; background: linear-gradient(145deg, #131311, #1a1916); box-shadow: 0 26px 80px rgba(0,0,0,.36); }
  .pf-accuracy-panel { top: 76px; left: 0; width: 660px; height: 390px; padding: 28px 30px; }
  .pf-accuracy-panel header { display: flex; align-items: center; justify-content: space-between; color: var(--pf-muted); font-size: 13px; }
  .pf-accuracy-panel header b { color: var(--pf-ink); font-size: 18px; }
  .pf-accuracy-panel header i { color: var(--pf-green); font-style: normal; }
  .pf-chart { position: relative; height: 300px; margin-top: 24px; border-bottom: 1px solid rgba(255,250,244,.08); background-image: linear-gradient(rgba(255,250,244,.06) 1px, transparent 1px); background-size: 100% 50px; }
  .pf-chart > span { position: absolute; left: 0; color: #6f6b64; font-size: 10px; transform: translateY(-50%); }
  .pf-chart > span:nth-child(1) { top: 0; }.pf-chart > span:nth-child(2) { top: 20%; }.pf-chart > span:nth-child(3) { top: 40%; }.pf-chart > span:nth-child(4) { top: 60%; }.pf-chart > span:nth-child(5) { top: 80%; }.pf-chart > span:nth-child(6) { top: 100%; }
  .pf-chart svg { position: absolute; inset: 10px 4px 24px 42px; width: calc(100% - 46px); height: calc(100% - 34px); overflow: visible; }
  .pf-chart-area { fill: rgba(233,135,100,.035); stroke: none; }
  .pf-chart-line { fill: none; stroke: var(--pf-accent); stroke-dasharray: 900; stroke-dashoffset: 900; stroke-width: 2; transition: stroke-dashoffset 1.4s cubic-bezier(.2,.8,.2,1) 300ms; }
  .is-visible .pf-chart-line { stroke-dashoffset: 0; }
  .pf-chart-dates { position: absolute; right: 0; bottom: -22px; left: 42px; display: flex; justify-content: space-between; color: #615e58; font-size: 10px; }
  .pf-update-panel { z-index: 2; top: 0; right: 0; width: 550px; min-height: 350px; padding: 28px; }
  .pf-update-panel > p, .pf-update-panel > span { margin: 0; color: var(--pf-muted); font-size: 12px; line-height: 18px; }
  .pf-update-panel h2 { margin: 12px 0 8px; font-size: 18px; font-weight: 600; letter-spacing: -.025em; }
  .pf-update-panel > span { display: block; max-width: 420px; }
  .pf-split-bar { display: grid; grid-template-columns: 73fr 27fr; gap: 5px; margin-top: 22px; }
  .pf-split-bar i, .pf-split-bar b { height: 4px; border-radius: 5px; transform: scaleX(0); transform-origin: left; transition: transform 900ms cubic-bezier(.2,.8,.2,1) 450ms; }
  .pf-split-bar i { background: var(--pf-green); }.pf-split-bar b { background: var(--pf-accent); }
  .is-visible .pf-split-bar i, .is-visible .pf-split-bar b { transform: scaleX(1); }
  .pf-split-labels { display: flex; justify-content: space-between; margin-top: 7px; color: var(--pf-muted); font-size: 10px; }
  .pf-update-panel h3 { margin: 22px 0 8px; color: var(--pf-muted); font-size: 12px; font-weight: 500; }
  .pf-update-panel ol { margin: 0; padding: 0; list-style: none; }
  .pf-update-panel li { display: grid; min-height: 46px; grid-template-columns: 24px 1fr; gap: 10px; align-items: center; border-top: 1px solid var(--pf-line); font-size: 12px; }
  .pf-update-panel li span { color: var(--pf-muted); }.pf-update-panel li b { font-weight: 520; }
  .pf-references { min-height: 418px; }
  .pf-references .pf-shell { border-right: 1px solid var(--pf-line); border-left: 1px solid var(--pf-line); }
  .pf-references h2 { min-height: 170px; margin: 0; border-bottom: 1px solid var(--pf-line); padding-top: 88px; font-size: 24px; font-weight: 500; line-height: 32px; text-align: center; }
  .pf-logo-grid { display: grid; min-height: 168px; grid-template-columns: repeat(4, 1fr); }
  .pf-logo-grid > div { display: grid; place-items: center; border-right: 1px solid var(--pf-line); padding: 30px; }
  .pf-logo-grid > div:last-child { border-right: 0; }
  .pf-logo-grid > div { gap: 12px; }.pf-logo-grid span { color: #817d75; font-size: 12px; }.pf-logo-grid b { font-size: 16px; font-weight: 560; }
  .pf-features { border-top: 1px solid var(--pf-line); border-bottom: 1px solid var(--pf-line); }
  .pf-feature-row { display: grid; width: min(calc(100% - 40px), 1056px); min-height: 593px; grid-template-columns: 352px minmax(0, 704px); margin-inline: auto; border-right: 1px solid var(--pf-line); border-bottom: 1px solid var(--pf-line); border-left: 1px solid var(--pf-line); }
  .pf-feature-row:last-child { border-bottom: 0; }
  .pf-feature-copy { padding: 48px 32px; }
  .pf-feature-copy h2 { margin: 0; font-size: 18px; font-weight: 500; line-height: 24px; }
  .pf-feature-copy p { margin: 16px 0 28px; color: var(--pf-muted); font-size: 14px; line-height: 21px; }
  .pf-feature-ui { position: relative; overflow: hidden; border-left: 1px solid var(--pf-line); background: radial-gradient(circle at 70% 40%, rgba(233,135,100,.055), transparent 38%); padding: 56px 42px; }
  .pf-claim-ui { display: grid; align-content: center; gap: 14px; }
  .pf-claim-card, .pf-reason-card { border: 1px solid var(--pf-line); border-radius: 12px; background: rgba(29,28,25,.92); padding: 24px; box-shadow: 0 18px 54px rgba(0,0,0,.28); }
  .pf-alert { display: inline-flex; min-height: 28px; align-items: center; gap: 9px; border-radius: 999px; background: rgba(233,135,100,.12); padding: 0 12px; color: var(--pf-accent); font-size: 11px; }
  .pf-alert i, .pf-reason-card span i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .pf-claim-card h3 { margin: 20px 0 8px; font-size: 24px; font-weight: 520; }
  .pf-claim-card p, .pf-reason-card p { margin: 0; color: var(--pf-muted); font-size: 14px; line-height: 21px; }
  .pf-reason-card span { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; color: var(--pf-ink); font-size: 12px; font-weight: 600; }
  .pf-source-ui { display: grid; align-content: center; }
  .pf-source-ui > header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .pf-source-ui h3 { margin: 0; font-size: 18px; font-weight: 520; }.pf-source-ui h3 span { color: var(--pf-muted); }
  .pf-source-ui button { min-height: 32px; border: 1px solid var(--pf-line); border-radius: 8px; background: #33322f; padding: 0 12px; color: var(--pf-ink); font: inherit; font-size: 11px; }
  .pf-source-ui article { display: grid; min-height: 88px; grid-template-columns: 28px minmax(0, 1fr) 9px; gap: 14px; align-items: center; border-top: 1px solid var(--pf-line); padding: 12px; background: linear-gradient(90deg, rgba(255,250,244,.02), transparent); }
  .pf-source-ui article > span { color: var(--pf-muted); font-size: 11px; }.pf-source-ui article b { font-size: 13px; font-weight: 560; }.pf-source-ui article p { margin: 5px 0 0; color: var(--pf-muted); font-size: 12px; line-height: 17px; }
  .pf-source-ui article > i { width: 8px; height: 8px; border-radius: 50%; background: var(--pf-accent); }.pf-source-ui article[data-status="clear"] > i { background: var(--pf-green); }
  .pf-action-ui { display: grid; align-content: center; padding-inline: 24px; }
  .pf-action-ui > header, .pf-action-ui article { display: grid; grid-template-columns: minmax(0, 1.4fr) 110px 150px; gap: 16px; align-items: center; }
  .pf-action-ui > header { min-height: 52px; border: 1px solid rgba(255,250,244,.22); border-radius: 12px 12px 0 0; background: linear-gradient(#34332f, #24231f); padding: 0 18px; color: var(--pf-muted); font-size: 11px; }
  .pf-action-ui article { min-height: 82px; border-right: 1px solid var(--pf-line); border-bottom: 1px solid var(--pf-line); border-left: 1px solid var(--pf-line); padding: 12px 18px; }
  .pf-action-ui article b { font-size: 13px; font-weight: 550; }.pf-action-ui article p { overflow: hidden; margin: 4px 0 0; color: var(--pf-muted); font-size: 11px; line-height: 15px; text-overflow: ellipsis; white-space: nowrap; }
  .pf-action-ui article strong { color: #d8aa6b; font-size: 12px; font-weight: 600; }.pf-action-ui article strong.is-high { color: var(--pf-green); }
  .pf-action-ui article a { display: inline-flex; min-height: 32px; align-items: center; gap: 8px; border: 1px solid rgba(255,250,244,.25); border-radius: 8px; background: #33322f; padding: 0 11px; font-size: 11px; text-decoration: none; }.pf-action-ui article a span { font-size: 8px; }
  .pf-faq { min-height: 732px; }
  .pf-faq-grid { display: grid; min-height: 732px; grid-template-columns: 280px minmax(0, 1fr); border-right: 1px solid var(--pf-line); border-left: 1px solid var(--pf-line); padding-top: 120px; }
  .pf-faq h2 { margin: 0; padding: 0 32px; font-size: 24px; font-weight: 500; line-height: 32px; }
  .pf-faq details { border-top: 1px solid var(--pf-line); }.pf-faq details:last-child { border-bottom: 1px solid var(--pf-line); }
  .pf-faq summary { display: grid; min-height: 73px; grid-template-columns: 1fr auto; gap: 20px; align-items: center; padding: 0 32px; cursor: pointer; font-size: 16px; list-style: none; }.pf-faq summary::-webkit-details-marker { display: none; }.pf-faq summary i { color: var(--pf-muted); font-style: normal; transition: transform 180ms ease; }.pf-faq details[open] summary i { transform: rotate(180deg); }
  .pf-faq details p { margin: 0; padding: 0 32px 28px; color: var(--pf-muted); font-size: 14px; line-height: 22px; }
  .pf-footer { min-height: 700px; border-top: 1px solid var(--pf-line); background: var(--pf-bg); padding: 88px max(20px, calc((100% - 1056px) / 2)) 36px; }
  .pf-footer-grid { display: grid; grid-template-columns: 1.35fr repeat(4, 1fr); gap: 54px; }
  .pf-footer-brand { display: flex; min-height: 430px; flex-direction: column; justify-content: space-between; }
  .pf-footer-brand img { width: 170px; height: auto; }
