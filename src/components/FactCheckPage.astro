---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import LinkButton from "./LinkButton";
import AiCitation from "./ui/ai-citation";
import FactCheckPromptDiff from "./FactCheckPromptDiff";
import GlowTree from "./ui/glow-tree";
import HowItWorksTimeline from "./ui/how-it-works-2";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const siteContent = content[page.lang];
const isEnglish = page.lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const canonicalPath = isEnglish ? page.alternateEnPath : page.alternateDePath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/" },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath },
];

const labels = isEnglish ? {
  primary: "Start fact check",
  secondary: "Contact us",
  answer: "Answer",
  citationHelper: "Select a citation to inspect its source.",
  source: "Source",
  openSource: "Open source",
  accuracy: "Accuracy score",
  update: "What changed",
  updateTitle: "Accuracy is becoming clearer",
  updateText: "Statements that need a maintained source become visible and actionable.",
  review: "Top statements to review",
  references: "Relevant answer systems in the review",
  learn: "View service",
  questions: "Frequently asked questions",
  findings: "Structured findings",
} : {
  primary: "Faktencheck starten",
  secondary: "Kontakt aufnehmen",
  answer: "Antwort",
  citationHelper: "Zitat auswählen, um die Quelle zu prüfen.",
  source: "Quelle",
  openSource: "Quelle öffnen",
  accuracy: "Genauigkeitswert",
  update: "Was sich verändert",
  updateTitle: "Die Faktenlage wird klarer",
  updateText: "Aussagen mit fehlender oder veralteter Quelle werden sichtbar und bearbeitbar.",
  review: "Wichtigste Aussagen zur Prüfung",
  references: "Relevante Antwortsysteme in der Prüfung",
  learn: "Leistung ansehen",
  questions: "Häufige Fragen",
  findings: "Strukturierte Befunde",
};

const citationSegments = isEnglish ? [
  { text: "Paternoga combines technical GEO optimisation" },
  { text: "", citation: 1 },
  { text: " with structured source work" },
  { text: "", citation: 2 },
  { text: " so companies are understood more clearly in AI answers" },
  { text: "", citation: 3 },
  { text: ", classified correctly and connected more often with reliable sources." },
] : [
  { text: "Paternoga verbindet technische GEO-Optimierung" },
  { text: "", citation: 1 },
  { text: " mit strukturierter Quellenarbeit" },
  { text: "", citation: 2 },
  { text: ", damit Unternehmen in KI-Antworten" },
  { text: "", citation: 3 },
  { text: " klarer verstanden, korrekt eingeordnet und häufiger mit belastbaren Quellen verknüpft werden." },
];
const citationSources = isEnglish ? [
  { title: "Technical GEO optimisation", domain: "Own website", type: "Relevant service page", snippet: "The service page provides current technical context for crawlability, structure and machine-readable information.", href: isEnglish ? "/en/technical-geo-optimization/" : "/technische-geo-optimierung/" },
  { title: "AI source analysis", domain: "Own website", type: "Structured service information", snippet: "The page explains how claims, sources and editorial decisions are linked in a traceable workflow.", href: isEnglish ? "/en/ai-source-analysis/" : "/ki-quellenanalyse/" },
  { title: "AI visibility", domain: "Own website", type: "Current factual context", snippet: "The current page content describes how companies become clearer and more reliably sourced in AI answer environments.", href: isEnglish ? "/en/ai-visibility/" : "/ai-sichtbarkeit/" },
] : [
  { title: "Technische GEO-Optimierung", domain: "Eigene Website", type: "Relevante Leistungsseite", snippet: "Die Leistungsseite liefert aktuellen technischen Kontext zu Crawlability, Struktur und maschinenlesbaren Informationen.", href: "/technische-geo-optimierung/" },
  { title: "KI-Quellenanalyse", domain: "Eigene Website", type: "Strukturierte Leistungsinformation", snippet: "Die Seite erklärt, wie Aussagen, Quellen und redaktionelle Entscheidungen nachvollziehbar verbunden werden.", href: "/ki-quellenanalyse/" },
  { title: "AI-Sichtbarkeit", domain: "Eigene Website", type: "Aktueller Seitenkontext", snippet: "Der aktuelle Seiteninhalt beschreibt, wie Unternehmen in KI-Antwortumfeldern klarer und belastbarer belegt werden.", href: "/ai-sichtbarkeit/" },
];
const promptDiffCases = isEnglish ? [
  { label: "Service profile", before: "Strategy and design", after: "Strategy, design and technical GEO optimisation" },
  { label: "Location signal", before: "Active throughout Germany", after: "Dresden, Saxony and remote across DACH" },
  { label: "Offer clarity", before: "We help with visibility", after: "We improve how companies are found, understood and supported by reliable sources in search and AI answers" },
] : [
  { label: "Leistungsbild", before: "Strategie und Design", after: "Strategie, Design und technische GEO-Optimierung" },
  { label: "Standortsignal", before: "Deutschlandweit tätig", after: "Dresden, Sachsen und remote im DACH-Raum" },
  { label: "Angebotsklarheit", before: "Wir helfen bei Sichtbarkeit", after: "Wir verbessern, wie Unternehmen in der Suche und in KI-Antworten gefunden, verstanden und durch belastbare Quellen eingeordnet werden" },
];
const ownershipTree = isEnglish ? [
  { id: "service-page", name: "Service page", type: "folder" as const, glow: true, children: [{ id: "service-scope", name: "Scope of services", type: "file" as const }] },
  { id: "location-contact", name: "Location / Contact", type: "folder" as const, glow: true, children: [{ id: "location-detail", name: "Location information", type: "file" as const }] },
  { id: "references-about", name: "References / About", type: "folder" as const, glow: true, children: [{ id: "experience-detail", name: "Experience statement", type: "file" as const }] },
  { id: "contact-page", name: "Contact page", type: "folder" as const, glow: true, children: [{ id: "contact-path", name: "Contact path", type: "file" as const }] },
] : [
  { id: "service-page", name: "Leistungsseite", type: "folder" as const, glow: true, children: [{ id: "service-scope", name: "Leistungsumfang", type: "file" as const }] },
  { id: "location-contact", name: "Standort / Kontakt", type: "folder" as const, glow: true, children: [{ id: "location-detail", name: "Standortangabe", type: "file" as const }] },
  { id: "references-about", name: "Referenzen / Über uns", type: "folder" as const, glow: true, children: [{ id: "experience-detail", name: "Erfahrungswert", type: "file" as const }] },
  { id: "contact-page", name: "Kontaktseite", type: "folder" as const, glow: true, children: [{ id: "contact-path", name: "Kontaktweg", type: "file" as const }] },
];

const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: page.faq.items });
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  lang={page.lang}
  canonicalPath={canonicalPath}
  alternateDePath={page.alternateDePath}
  alternateEnPath={page.alternateEnPath}
  schema={schema}
  bodyClass="fact-reference-page ui-dark-page dark"
>
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border">
      <div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
        <nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isEnglish ? "Breadcrumb" : "Brotkrumen-Navigation"}>
          {breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}
        </nav>

        <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2">
          <div class="flex min-w-0 flex-col justify-center">
            <h1 class="m-0 max-w-2xl text-display-mobile font-medium text-foreground md:text-display">{page.title}</h1>
            <p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{page.lead}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <LinkButton href={`${homePath}#kontakt`} label={labels.primary} icon="right" />
              <LinkButton href={`${homePath}#kontakt`} label={labels.secondary} variant="secondary" />
            </div>
          </div>

          <div class="flex min-w-0 flex-col items-stretch lg:justify-center lg:pl-4">
            <p class="m-0 mb-4 text-xs leading-copy text-muted-foreground">{page.demo.note}</p>
            <AiCitation segments={citationSegments} sources={citationSources} answerLabel={labels.answer} helperText={labels.citationHelper} sourceLabel={labels.source} openLabel={labels.openSource} client:load />
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-solid border-border">
      <div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
        <header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20">
          <div>
            <p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{labels.review}</p>
            <h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{page.narratives[0].title}</h2>
          </div>
          <div>
            <p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{page.narratives[0].text}</p>
            <div class="mt-8"><LinkButton href={page.related.items[0].href} label={labels.learn} variant="outline" icon="external" /></div>
          </div>
        </header>
        <FactCheckPromptDiff cases={promptDiffCases} unifiedLabel={isEnglish ? "Unified" : "Vereinheitlicht"} selectorLabel={isEnglish ? "Select comparison" : "Vergleich auswählen"} client:load />
      </div>
    </section>

    <section class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
      <header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20">
        <h2 class="m-0 max-w-xl text-section-title font-medium text-foreground">{page.narratives[1].title}</h2>
        <p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{page.narratives[1].text}</p>
      </header>
      <div class="mx-auto w-full max-w-2xl">
        <GlowTree data={ownershipTree} defaultExpanded={ownershipTree.map((node) => node.id)} defaultSelectedId="service-page" client:load />
      </div>
    </section>

    <section class="border-y border-solid border-border">
      <div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
        <h2 class="m-0 max-w-2xl text-section-title font-medium text-foreground">{page.method.title}</h2>
        <div class="mt-12"><HowItWorksTimeline steps={page.method.steps} client:load /></div>
      </div>
    </section>

    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section">
      <h2 class="m-0 text-section-title font-medium text-foreground">{labels.questions}</h2>
      <FaqAccordion items={page.faq.items} theme="dark" className="lg:col-span-2" />
    </section>

    <SubpageContact lang={page.lang} source="fact-check-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>
