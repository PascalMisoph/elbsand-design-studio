---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
interface Props { page: ServicePageContent }
const { page } = Astro.props;
const de = page.lang === "de";
const site = content[page.lang];
const home = de ? "/" : "/en/";
const path = de ? page.alternateDePath : page.alternateEnPath;
const crumbs = [{ name: page.breadcrumb.home, href: home }, { name: page.breadcrumb.hub, href: de ? "/geo-optimierung/" : "/en/geo-optimization/" }, { name: page.breadcrumb.current, href: path }];
const copy = de ? {
  title: "GEO-Content entwickeln, das eine echte Frage vollständig beantwortet.", lead: "Wir entwickeln neue Seiten und Content-Systeme aus den Fragen deiner Zielgruppe. Jede Aussage bekommt Kontext, eine passende Struktur und – wo sinnvoll – eine sichtbare Quelle.", label: "GEO content / create", cta: "GEO-Content besprechen", method: "Content von der Frage bis zur Veröffentlichung", methodLead: "Eine neue Seite entsteht als nachvollziehbarer Arbeitsweg: Frage, Briefing, Text, Prüfung und Anschluss an dein bestehendes Angebot.", handoff: "Von der Recherche zum belastbaren Inhalt", handoffLead: "Ein gutes Briefing macht redaktionelle Arbeit schneller, ohne aus jedem Thema eine austauschbare Vorlage zu machen.", trust: "Arbeitsgrundlage statt Versprechen", trustLead: "Diese Oberfläche zeigt die Logik illustrativ. Inhalte, Werte und Beispiele sind keine Kundenergebnisse.", faq: "Fragen zu GEO-Content", close: "Aus einer Kundenfrage wird eine Seite, die weiterhilft."
} : {
  title: "Build GEO content that answers a real question completely.", lead: "We develop new pages and content systems from the questions your audience actually asks. Every statement receives context, a fitting structure and, where useful, a visible source.", label: "GEO content / create", cta: "Discuss GEO content", method: "Content from question to publication", methodLead: "A new page becomes a traceable working path: question, brief, draft, review and a useful connection to your existing offer.", handoff: "From research to dependable content", handoffLead: "A good brief makes editorial work faster without turning every topic into an interchangeable template.", trust: "A working basis, not a promise", trustLead: "This interface shows the logic illustratively. Content, values and examples are not client results.", faq: "Questions about GEO content", close: "Turn a customer question into a page that helps."
};
const capability = de ? [["Frage & Wissen", "Fragen aus Kundensprache und Angebot in ein klares Thema übersetzen."], ["Antwort-Architektur", "Definition, Kontext, Beleg und Handlung in eine lesbare Reihenfolge bringen."], ["Prompt-Set", "Die Seite an den Formulierungen ausrichten, die Menschen an KI-Systeme stellen."], ["End-to-End", "Briefing, Redaktion und Veröffentlichung mit einem nachvollziehbaren Übergang verbinden."]] : [["Brand Kits & Knowledge Bases", "Turn customer language and your offer into a focused topic."], ["Answer architecture", "Place definition, context, evidence and action in a readable order."], ["Prompt set", "Align the page with the wording people use when asking AI."], ["End-to-end", "Connect brief, editorial work and publication with a traceable handoff."]];
const createSteps = de ? [["Research → Brief", "Fragen, Quellen und Ziel der Seite in einem kurzen Briefing bündeln."], ["Keyword → Brief", "Die Suchsprache als Kontext nutzen, nicht als Ersatz für die eigentliche Frage."], ["Blog Post aus Video", "Vorhandenes Wissen in eine neue, zitierfähige Form überführen."], ["Brand-Kit-Integration", "Ton, Begriffe und Grenzen des Angebots im Entwurf sichtbar halten."], ["Audience Definition", "Zielgruppe und Entscheidungssituation präzise beschreiben."], ["Target & Custom Instructions", "Prompts, Quellen und fachliche Anforderungen für den Entwurf festlegen."], ["Format auswählen", "Das Format nach Frage, Belegbedarf und Lesesituation wählen."], ["Briefing & Draft", "Briefing und Entwurf so verbinden, dass Prüfung und Veröffentlichung anschließen können."]] : [["Research → Brief", "Bring questions, sources and the page job into one focused brief."], ["Keyword → Brief", "Use search language as context, never as a substitute for the actual question."], ["Blog Post from Video", "Turn existing knowledge into a new, citation-ready format."], ["Brand Kit Integration", "Keep tone, terminology and boundaries visible in the draft."], ["Audience Definition", "Describe the audience and decision moment with precision."], ["Target & Custom Instructions", "Set prompts, sources and specialist requirements for the draft."], ["Format Selection", "Choose the format around the question, evidence need and reading context."], ["Content Brief & Draft Generation", "Connect brief and draft so review and publication can follow."]];
const artifacts = de ? [["Frage", "Welche Entscheidung soll diese Seite erleichtern?"], ["Beleg", "Welche Aussage braucht eine Quelle oder fachliche Freigabe?"], ["Verbindung", "Welche Leistung oder nächste Frage schließt sinnvoll an?"]] : [["Question", "Which decision should this page make easier?"], ["Evidence", "Which statement needs a source or expert approval?"], ["Connection", "Which service or next question should follow naturally?"]];
const schema = { "@context":"https://schema.org", "@graph":[ {"@type":"Service", name:page.eyebrow, description:page.meta.description, url:new URL(path,"https://elbsand.studio").toString(), provider:{"@type":"ProfessionalService",name:"ELBSAND Design Studio"}}, {"@type":"BreadcrumbList",itemListElement:crumbs.map((x,i)=>({"@type":"ListItem",position:i+1,name:x.name,item:new URL(x.href,"https://elbsand.studio").toString()}))}, {"@type":"FAQPage",mainEntity:page.faq.items.map(x=>({"@type":"Question",name:x.question,acceptedAnswer:{"@type":"Answer",text:x.answer}}))} ] };
---
<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={path} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="geo-content-page">
  <Header lang={page.lang} nav={site.nav} cta={site.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />
  <main id="main-content">
    <section class="gc-hero gc-shell"><nav class="gc-crumbs" aria-label={de ? "Brotkrumen-Navigation" : "Breadcrumb"}>{crumbs.map((x,i)=><span><span aria-hidden="true">{i ? "/" : ""}</span>{i===crumbs.length-1?<b aria-current="page">{x.name}</b>:<a href={x.href}>{x.name}</a>}</span>)}</nav><div class="gc-hero-copy"><p class="gc-label">{copy.label}</p><h1>{copy.title}</h1><p class="gc-lead">{copy.lead}</p><div class="gc-actions"><a class="gc-button" href={`${home}#kontakt`}>{copy.cta}</a><a href="#gc-method" class="gc-text-link">{page.secondaryCta}<span aria-hidden="true">↓</span></a></div></div><div class="gc-capabilities">{capability.map((x,i)=><article><span>{i+1}</span><h2>{x[0]}</h2><p>{x[1]}</p></article>)}</div></section>
    <section class="gc-trust gc-shell"><p>{de ? "Illustrative ELBSAND content system" : "Illustrative ELBSAND content system"}</p><div>{(de ? ["Frage", "Quelle", "Struktur", "Freigabe", "Veröffentlichung", "Pflege"] : ["Question", "Source", "Structure", "Approval", "Publication", "Maintenance"]).map((x,i)=><span><b>{i+1}</b>{x}</span>)}</div></section>
    <section class="gc-work gc-shell" id="gc-method"><div class="gc-work-intro"><p class="gc-label">{copy.method}</p><h2>{de ? "Neue Inhalte mit einem klaren redaktionellen Auftrag." : "New content with a clear editorial job."}</h2><p>{copy.methodLead}</p></div><div class="gc-work-list">{createSteps.slice(0,4).map((x,i)=><article><span>{i+1}</span><div><h3>{x[0]}</h3><p>{x[1]}</p></div></article>)}</div></section>
    <section class="gc-work gc-work-second gc-shell"><div class="gc-work-intro"><p class="gc-label">{copy.handoff}</p><h2>{de ? "Von der Arbeitsgrundlage bis zum fertigen Seitenentwurf." : "From working basis to a publishable page draft."}</h2><p>{copy.handoffLead}</p></div><div class="gc-work-list">{createSteps.slice(4).map((x,i)=><article><span>{i+5}</span><div><h3>{x[0]}</h3><p>{x[1]}</p></div></article>)}</div></section>
    <section class="gc-artifact gc-shell"><div><p class="gc-label">{de ? "Redaktionelle Übergabe" : "Editorial handoff"}</p><h2>{de ? "Jede Seite trägt ihre eigene Belegspur." : "Every page carries its own evidence trail."}</h2><p>{copy.trustLead}</p></div><div class="gc-artifact-panel"><header><span>ELBSAND / CONTENT BRIEF</span><i>{copy.trust}</i></header>{artifacts.map((x,i)=><div class="gc-artifact-row"><b>{i+1}</b><strong>{x[0]}</strong><span>{x[1]}</span><i aria-hidden="true">↗</i></div>)}</div></section>
    <section class="gc-faq gc-shell" id="faq"><header><p class="gc-label">FAQ</p><h2>{copy.faq}</h2></header><div>{page.faq.items.map(x=><details><summary>{x.question}<span>+</span></summary><p>{x.answer}</p></details>)}</div></section>
    <section class="gc-related gc-shell"><header><p class="gc-label">{page.related.eyebrow}</p><h2>{page.related.title}</h2></header><div>{page.related.items.map(x=><a href={x.href}><span>↗</span><h3>{x.title}</h3><p>{x.text}</p></a>)}</div></section>
    <SubpageContact lang={page.lang} source="geo-content-service" />
  </main><Footer {...site.footer} lang={page.lang} />
</BaseLayout>
<script>
  const reduce=window.matchMedia("(prefers-reduced-motion: reduce)"); const els=document.querySelectorAll<HTMLElement>(".gc-work,.gc-artifact,.gc-faq,.gc-related,.gc-close"); if(reduce.matches) els.forEach(x=>x.classList.add("is-visible")); else { const o=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("is-visible");o.unobserve(e.target)}}),{threshold:.12,rootMargin:"-10% 0px"}); els.forEach(x=>o.observe(x)); }
</script>
<style is:global>
  .geo-content-page{--gc-bg:#090908;--gc-ink:#f7f3eb;--gc-muted:#a4a099;--gc-dim:#716d66;--gc-line:rgba(247,243,235,.14);--gc-accent:#d56036;background:var(--gc-bg);color:var(--gc-ink);font-family:Inter,system-ui,sans-serif}.geo-content-page header.site-header,.geo-content-page footer.site-footer{background:var(--gc-bg);color:var(--gc-ink)}.gc-shell{width:min(1056px,calc(100% - 40px));margin:0 auto}.gc-hero{min-height:760px;padding-top:27px}.gc-crumbs{display:flex;gap:10px;color:var(--gc-dim);font-size:10px}.gc-crumbs span{display:flex;gap:10px}.gc-crumbs a:hover,.gc-crumbs b{color:var(--gc-ink)}.gc-crumbs b{font-weight:500}.gc-hero-copy{max-width:680px;padding-top:112px}.gc-label{margin:0 0 16px;color:var(--gc-accent);font-size:11px;font-weight:650;letter-spacing:.12em;text-transform:uppercase}.gc-hero h1{max-width:650px;margin:0;font-size:clamp(50px,5.2vw,72px);font-weight:520;letter-spacing:-.075em;line-height:.98}.gc-lead{max-width:530px;margin:26px 0 0;color:var(--gc-muted);font-size:17px;line-height:1.55}.gc-actions{display:flex;align-items:center;gap:22px;margin-top:30px}.gc-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:7px;background:#b74622;color:#fff9f3;padding:0 17px;font-size:15px;font-weight:650;text-decoration:none;transition:transform 220ms ease,background 180ms ease}.gc-button:hover{background:#d05a32;transform:translateY(-2px)}.gc-text-link{display:flex;align-items:center;gap:10px;color:var(--gc-ink);font-size:15px;text-decoration:none}.gc-text-link span{color:var(--gc-accent);font-size:18px}.gc-capabilities{display:grid;grid-template-columns:repeat(4,1fr);margin-top:116px;border-top:1px solid var(--gc-line);border-left:1px solid var(--gc-line)}.gc-capabilities article{min-height:178px;border-right:1px solid var(--gc-line);border-bottom:1px solid var(--gc-line);padding:18px}.gc-capabilities article>span{color:var(--gc-accent);font-size:11px}.gc-capabilities h2{margin:35px 0 10px;font-size:16px;font-weight:520;letter-spacing:-.03em}.gc-capabilities p{margin:0;color:var(--gc-muted);font-size:13px;line-height:1.45}.gc-trust{border-top:1px solid var(--gc-line);padding:38px 0 50px}.gc-trust>p{text-align:center;color:var(--gc-muted);font-size:14px}.gc-trust>div{display:grid;grid-template-columns:repeat(6,1fr);margin-top:24px;border:1px solid var(--gc-line)}.gc-trust span{display:flex;min-height:83px;align-items:center;justify-content:center;gap:8px;border-right:1px solid var(--gc-line);color:var(--gc-muted);font-size:12px}.gc-trust span:last-child{border-right:0}.gc-trust b{color:var(--gc-accent);font-size:10px;font-weight:500}.gc-work,.gc-artifact,.gc-faq,.gc-related,.gc-close{border-top:1px solid var(--gc-line);padding-top:118px;padding-bottom:122px;opacity:1;transform:none;transition:opacity 700ms ease,transform 700ms cubic-bezier(.2,.8,.2,1)}.gc-work:not(.is-visible),.gc-artifact:not(.is-visible),.gc-faq:not(.is-visible),.gc-related:not(.is-visible),.gc-close:not(.is-visible){opacity:.2;transform:translateY(18px)}.gc-work-intro{display:grid;grid-template-columns:1fr 1.2fr;gap:70px}.gc-work-intro h2{grid-column:2;grid-row:1;margin:0;font-size:clamp(44px,4.5vw,66px);font-weight:520;letter-spacing:-.075em;line-height:.98}.gc-work-intro>p:last-child{grid-column:2;max-width:510px;margin:24px 0 0;color:var(--gc-muted);font-size:17px;line-height:1.6}.gc-work-list{display:grid;grid-column:2;margin-left:calc(100% / 2 + 35px);margin-top:75px;border-top:1px solid var(--gc-line)}.gc-work-list article{display:grid;grid-template-columns:44px 1fr;gap:18px;min-height:111px;border-bottom:1px solid var(--gc-line);padding:23px 0}.gc-work-list article>span{display:grid;width:30px;height:30px;place-items:center;border:1px solid var(--gc-accent);border-radius:50%;color:var(--gc-accent);font-size:11px}.gc-work-list h3{margin:2px 0 8px;font-size:17px;font-weight:520}.gc-work-list p{max-width:500px;margin:0;color:var(--gc-muted);font-size:14px;line-height:1.5}.gc-work-second{padding-top:95px}.gc-artifact{display:grid;grid-template-columns:1fr 1.2fr;gap:85px;align-items:center}.gc-artifact h2{max-width:460px;margin:0;font-size:clamp(43px,4.5vw,62px);font-weight:520;letter-spacing:-.075em;line-height:.98}.gc-artifact>div:first-child>p:not(.gc-label){max-width:430px;margin:26px 0 0;color:var(--gc-muted);font-size:16px;line-height:1.6}.gc-artifact-panel{border:1px solid var(--gc-line);background:#10100f}.gc-artifact-panel header{display:flex;justify-content:space-between;border-bottom:1px solid var(--gc-line);padding:18px 20px;color:var(--gc-muted);font-size:10px}.gc-artifact-panel header i{color:var(--gc-accent);font-style:normal}.gc-artifact-row{display:grid;grid-template-columns:32px 130px 1fr 20px;gap:14px;align-items:center;min-height:86px;border-bottom:1px solid var(--gc-line);padding:14px 20px}.gc-artifact-row:last-child{border-bottom:0}.gc-artifact-row>b{display:grid;width:24px;height:24px;place-items:center;border:1px solid var(--gc-line);border-radius:50%;color:var(--gc-accent);font-size:10px}.gc-artifact-row strong{font-size:14px;font-weight:500}.gc-artifact-row span{color:var(--gc-muted);font-size:13px}.gc-artifact-row i{color:var(--gc-accent);font-style:normal}.gc-faq,.gc-related{display:grid;grid-template-columns:1fr 1.5fr;gap:80px}.gc-faq h2,.gc-related h2{margin:0;font-size:clamp(43px,4.5vw,64px);font-weight:520;letter-spacing:-.075em;line-height:.98}.gc-faq details{border-top:1px solid var(--gc-line)}.gc-faq details:last-child{border-bottom:1px solid var(--gc-line)}.gc-faq summary{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;min-height:78px;cursor:pointer;font-size:16px;font-weight:500;list-style:none}.gc-faq summary::-webkit-details-marker{display:none}.gc-faq summary span{color:var(--gc-accent);font-size:21px;transition:transform 180ms ease}.gc-faq details[open] summary span{transform:rotate(45deg)}.gc-faq details p{max-width:650px;margin:0 0 28px;color:var(--gc-muted);font-size:15px;line-height:1.6}.gc-related{display:block}.gc-related header{display:grid;grid-template-columns:1fr 1.2fr;margin-bottom:56px}.gc-related>div{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--gc-line)}.gc-related a{display:grid;min-height:220px;align-content:end;border-right:1px solid var(--gc-line);padding:22px;text-decoration:none}.gc-related a:last-child{border-right:0}.gc-related a>span{align-self:start;justify-self:end;color:var(--gc-accent);font-size:19px}.gc-related h3{margin:0 0 9px;color:var(--gc-ink);font-size:20px;font-weight:500}.gc-related p{margin:0;color:var(--gc-muted);font-size:14px;line-height:1.5}.gc-close{display:grid;min-height:510px;justify-items:center;align-content:center;padding-top:95px;padding-bottom:95px;text-align:center}.gc-close h2{max-width:760px;margin:0 0 23px;font-size:clamp(48px,5.4vw,74px);font-weight:520;letter-spacing:-.08em;line-height:.98}.gc-close>p:not(.gc-label){max-width:600px;margin:0;color:var(--gc-muted);font-size:17px;line-height:1.6}.gc-close .gc-button{margin-top:29px}@media(max-width:800px){.gc-shell{width:calc(100% - 40px)}.gc-hero{min-height:0;padding-top:22px;padding-bottom:73px}.gc-hero-copy{padding-top:90px}.gc-hero h1{font-size:clamp(43px,11vw,55px)}.gc-lead{font-size:16px}.gc-actions{align-items:stretch;flex-direction:column;gap:17px}.gc-actions a{justify-content:center}.gc-capabilities{grid-template-columns:1fr 1fr;margin-top:74px}.gc-capabilities article{min-height:195px;padding:15px}.gc-capabilities h2{margin-top:36px;font-size:15px}.gc-capabilities p{font-size:12px}.gc-trust{padding:28px 0 46px}.gc-trust>div{grid-template-columns:repeat(3,1fr)}.gc-trust span{min-height:66px;font-size:10px}.gc-work,.gc-artifact,.gc-faq,.gc-related,.gc-close{padding-top:80px;padding-bottom:82px}.gc-work-intro,.gc-artifact,.gc-faq{display:block}.gc-work-intro h2,.gc-artifact h2,.gc-faq h2,.gc-related h2{margin-top:10px;font-size:43px}.gc-work-intro>p:last-child,.gc-artifact>div:first-child>p:not(.gc-label){margin-top:22px;font-size:16px}.gc-work-list{margin-left:0;margin-top:48px}.gc-work-list article{min-height:112px}.gc-work-second{padding-top:80px}.gc-artifact-panel{margin-top:45px}.gc-artifact-row{grid-template-columns:28px 1fr 20px;gap:11px;padding:13px 14px}.gc-artifact-row strong{font-size:13px}.gc-artifact-row span{grid-column:2;font-size:13px}.gc-artifact-row i{grid-column:3;grid-row:1}.gc-related header{display:block;margin-bottom:44px}.gc-related>div{grid-template-columns:1fr}.gc-related a{min-height:180px;border-right:0;border-bottom:1px solid var(--gc-line)}.gc-related a:last-child{border-bottom:0}.gc-faq{gap:44px}.gc-close{min-height:460px}.gc-close h2{font-size:49px}}@media(max-width:380px){.gc-shell{width:calc(100% - 32px)}.gc-hero-copy{padding-top:70px}.gc-hero h1{font-size:41px}.gc-capabilities article{min-height:220px;padding:12px 10px}.gc-capabilities h2{font-size:14px}.gc-trust span{font-size:9px}.gc-work-list p{font-size:13px}.gc-close h2{font-size:43px}}@media(prefers-reduced-motion:reduce){.gc-work,.gc-artifact,.gc-faq,.gc-related,.gc-close,.gc-button,.gc-faq summary span{transition:none!important}.gc-work:not(.is-visible),.gc-artifact:not(.is-visible),.gc-faq:not(.is-visible),.gc-related:not(.is-visible),.gc-close:not(.is-visible){opacity:1;transform:none}}
</style>
<style is:global>.geo-content-page .gc-work,.geo-content-page .gc-artifact,.geo-content-page .gc-faq,.geo-content-page .gc-related,.geo-content-page .gc-close{opacity:1;transform:none}</style>
