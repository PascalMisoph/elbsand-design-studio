---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import ContentBriefStatusList from "./ContentBriefStatusList";
import EditorialBriefBrowser from "./EditorialBriefBrowser";
import GeoContentPlanning from "./GeoContentPlanning";
import InteractiveHoverLinks from "./InteractiveHoverLinks";
import LinkButton from "./LinkButton";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const isGerman = page.lang === "de";
const siteContent = content[page.lang];
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? page.alternateDePath : page.alternateEnPath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isGerman ? "/geo-optimierung/" : "/en/geo-optimization/" },
  { name: page.breadcrumb.current, href: canonicalPath },
];

const copy = isGerman ? {
  title: "GEO-Content entwickeln, der eine echte Frage vollständig beantwortet",
  lead: "Wir entwickeln neue Seiten und Content-Systeme aus den Fragen deiner Zielgruppe. Jede Aussage bekommt Kontext, eine passende Struktur und – wo sinnvoll – eine sichtbare Quelle.",
  label: "GEO Content / Create",
  cta: "GEO-Content besprechen",
  method: "Content von der Frage bis zur Veröffentlichung",
  methodTitle: "Neue Inhalte mit einem klaren redaktionellen Auftrag",
  methodLead: "Eine neue Seite entsteht als nachvollziehbarer Arbeitsweg: Frage, Briefing, Text, Prüfung und Anschluss an dein bestehendes Angebot.",
  handoff: "Von der Recherche zum belastbaren Inhalt",
  handoffTitle: "Von der Arbeitsgrundlage bis zum fertigen Seitenentwurf",
  handoffLead: "Ein gutes Briefing macht redaktionelle Arbeit schneller, ohne aus jedem Thema eine austauschbare Vorlage zu machen.",
  faq: "Fragen zu GEO-Content",
} : {
  title: "Build GEO content that answers a real question completely",
  lead: "We develop new pages and content systems from the questions your audience actually asks. Every statement receives context, a fitting structure and, where useful, a visible source.",
  label: "GEO Content / Create",
  cta: "Discuss GEO content",
  method: "Content from question to publication",
  methodTitle: "New content with a clear editorial job",
  methodLead: "A new page becomes a traceable working path: question, brief, draft, review and a useful connection to your existing offer.",
  handoff: "From research to dependable content",
  handoffTitle: "From working basis to a publishable page draft",
  handoffLead: "A good brief makes editorial work faster without turning every topic into an interchangeable template.",
  faq: "Questions about GEO content",
};

const capabilities = isGerman ? [
  { title: "Frage & Wissen", text: "Fragen aus Kundensprache und Angebot in ein klares Thema übersetzen." },
  { title: "Antwort-Architektur", text: "Definition, Kontext, Beleg und Handlung in eine lesbare Reihenfolge bringen." },
  { title: "Prompt-Set", text: "Die Seite an den Formulierungen ausrichten, die Menschen an KI-Systeme stellen." },
  { title: "End-to-End", text: "Briefing, Redaktion und Veröffentlichung mit einem nachvollziehbaren Übergang verbinden." },
] : [
  { title: "Questions & knowledge", text: "Turn customer language and your offer into a focused topic." },
  { title: "Answer architecture", text: "Place definition, context, evidence and action in a readable order." },
  { title: "Prompt set", text: "Align the page with the wording people use when asking AI." },
  { title: "End-to-end", text: "Connect brief, editorial work and publication with a traceable handoff." },
];

const createSteps = isGerman ? [
  { title: "Research → Brief", text: "Fragen, Quellen und Ziel der Seite in einem kurzen Briefing bündeln." },
  { title: "Keyword → Brief", text: "Die Suchsprache als Kontext nutzen, nicht als Ersatz für die eigentliche Frage." },
  { title: "Vorhandenes Wissen", text: "Bestehendes Material in eine neue, zitierfähige Form überführen." },
  { title: "Brand-Kit-Integration", text: "Ton, Begriffe und Grenzen des Angebots im Entwurf sichtbar halten." },
  { title: "Audience Definition", text: "Zielgruppe und Entscheidungssituation präzise beschreiben." },
  { title: "Fachliche Anforderungen", text: "Prompts, Quellen und fachliche Grenzen für den Entwurf festlegen." },
  { title: "Format auswählen", text: "Das Format nach Frage, Belegbedarf und Lesesituation wählen." },
  { title: "Briefing & Draft", text: "Briefing und Entwurf so verbinden, dass Prüfung und Veröffentlichung anschließen können." },
] : [
  { title: "Research → Brief", text: "Bring questions, sources and the page job into one focused brief." },
  { title: "Keyword → Brief", text: "Use search language as context, never as a substitute for the actual question." },
  { title: "Existing knowledge", text: "Turn existing material into a new, citation-ready format." },
  { title: "Brand kit integration", text: "Keep tone, terminology and boundaries visible in the draft." },
  { title: "Audience definition", text: "Describe the audience and decision moment with precision." },
  { title: "Specialist requirements", text: "Set prompts, sources and specialist boundaries for the draft." },
  { title: "Format selection", text: "Choose the format around the question, evidence need and reading context." },
  { title: "Briefing & draft", text: "Connect brief and draft so review and publication can follow." },
];

const planningSteps = capabilities.map((item, index) => ({
  id: String(index + 1),
  title: item.title,
  text: item.text,
  status: index < 2 ? "success" as const : index === 2 ? "active" as const : "pending" as const,
}));

const briefInputs = createSteps.slice(0, 4).map((item, index) => ({
  id: String(index + 1),
  title: item.title,
  text: item.text,
  status: index < 2 ? "completed" as const : index === 2 ? "updates-found" as const : "syncing" as const,
}));

const editorialInputs = createSteps.slice(4).map((item, index) => ({ id: String(index + 1), ...item }));
const editorialPreview = isGerman ? [
  { heading: "Inhalte für eine klare Entscheidung", intro: "Die Seite beginnt mit der Situation der Zielgruppe und ordnet das Angebot genau dort ein, wo eine Entscheidung vorbereitet wird.", section: "Zielgruppe & Situation", body: "Kontext, Sprache und nächster Schritt bleiben eng mit der eigentlichen Frage verbunden.", source: "Arbeitsstand · Audience Definition" },
  { heading: "Fachlich präzise, sichtbar belegt", intro: "Aussagen erhalten den Kontext, die Quellen und die Grenzen, die für einen belastbaren Entwurf notwendig sind.", section: "Fachliche Anforderungen", body: "Prompts und Belege führen durch den Inhalt, ohne die Lesbarkeit der Seite zu überlagern.", source: "Quelle · redaktionell geprüft" },
  { heading: "Das passende Format für die Frage", intro: "Umfang und Struktur folgen der Lesesituation statt einer austauschbaren Seitenvorlage.", section: "Format & Lesefluss", body: "Definition, Kontext, Beleg und Handlung werden in einer ruhigen redaktionellen Folge sichtbar.", source: "Arbeitsstand · Format ausgewählt" },
  { heading: "Vom Briefing zum Seitenentwurf", intro: "Der Entwurf verbindet die redaktionelle Grundlage mit einem prüfbaren Weg bis zur Veröffentlichung.", section: "Briefing & Draft", body: "Inhalt, Quellen und Tonalität bleiben im Übergang nachvollziehbar und anschlussfähig.", source: "Entwurf · bereit zur Prüfung" },
] : [
  { heading: "Content for a clear decision", intro: "The page starts with the audience situation and places the offer where it supports a real decision.", section: "Audience & situation", body: "Context, language and the next step stay closely connected to the underlying question.", source: "Working state · Audience definition" },
  { heading: "Precise, grounded and evidenced", intro: "Statements receive the context, sources and boundaries required for a dependable draft.", section: "Specialist requirements", body: "Prompts and evidence guide the content without overwhelming the reading experience.", source: "Source · editorially reviewed" },
  { heading: "The right format for the question", intro: "Scope and structure follow the reading situation rather than an interchangeable template.", section: "Format & reading flow", body: "Definition, context, evidence and action become a calm editorial sequence.", source: "Working state · Format selected" },
  { heading: "From brief to page draft", intro: "The draft connects its editorial foundation to a reviewable path toward publication.", section: "Briefing & draft", body: "Content, sources and tone remain traceable and ready for the next step.", source: "Draft · ready for review" },
];

const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: page.faq.items });
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="geo-content-page ui-dark-page dark">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border">
      <div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
        <nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}</nav>
        <div class="max-w-3xl pt-12"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{copy.label}</p><h1 class="m-0 mt-6 text-display-mobile font-medium text-foreground md:text-display">{copy.title}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{copy.lead}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={copy.cta} icon="right" /><LinkButton href="#content-method" label={page.secondaryCta} variant="secondary" icon="down" /></div></div>
        <div class="mt-20"><p class="m-0 mb-4 text-xs leading-copy text-muted-foreground">{page.demo.note}</p><GeoContentPlanning title={isGerman ? "GEO-Content Planung" : "GEO content planning"} steps={planningSteps} client:load /></div>
      </div>
    </section>

    <section id="content-method" class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-2 lg:py-section">
      <div class="lg:sticky lg:top-24 lg:self-start"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{copy.method}</p><h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{copy.methodTitle}</h2><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{copy.methodLead}</p></div>
      <ContentBriefStatusList
        title="Content Brief"
        subtitle={isGerman ? "4 Inputs werden zusammengeführt" : "4 inputs are being consolidated"}
        resultTitle={isGerman ? "Brief bereit" : "Brief ready"}
        resultSummary={isGerman ? "Frage · Struktur · Quellen · Tonalität" : "Question · Structure · Sources · Tone"}
        items={briefInputs}
        labels={isGerman ? { completed: "abgeschlossen", syncing: "wird synchronisiert", "updates-found": "Updates gefunden" } : { completed: "completed", syncing: "syncing", "updates-found": "updates found" }}
        client:load
      />
    </section>

    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="max-w-2xl pb-12 lg:pb-16"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{copy.handoff}</p><h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{copy.handoffTitle}</h2><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{copy.handoffLead}</p></header><EditorialBriefBrowser panelLabel={isGerman ? "Briefing / Arbeitsgrundlage" : "Briefing / working basis"} address={isGerman ? "Seitenentwurf" : "Page draft"} items={editorialInputs} preview={editorialPreview} client:load /></div></section>

    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{page.related.eyebrow}</p><h2 class="m-0 mt-6 max-w-2xl text-section-title font-medium text-foreground">{page.related.title}</h2><div class="mt-12"><InteractiveHoverLinks items={page.related.items} client:load /></div></div></section>

    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{copy.faq}</h2><FaqAccordion items={page.faq.items} theme="dark" className="lg:col-span-2" /></section>

    <SubpageContact lang={page.lang} source="geo-content-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>
