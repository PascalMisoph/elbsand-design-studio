---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
interface Props { page: ServicePageContent }
const { page }=Astro.props; const site=content[page.lang]; const en=page.lang==="en"; const home=en?"/en/":"/"; const canonical=en?page.alternateEnPath:page.alternateDePath;
const crumbs=[{name:page.breadcrumb.home,href:home},{name:page.breadcrumb.hub,href:en?"/en/geo-optimization/":"/geo-optimierung/"},...(page.breadcrumb.parent?[{name:page.breadcrumb.parent.label,href:page.breadcrumb.parent.href}]:[]),{name:page.breadcrumb.current,href:canonical}];
const labels=en?{live:"Observation active",field:"Monitoring field",cycle:"Cycle",stable:"Stable",review:"Review",act:"Act",signals:"Changes that deserve context",method:"A repeatable monitoring rhythm",faq:"Frequently asked questions",secondary:"View the method"}:{live:"Beobachtung aktiv",field:"Monitoring-Feld",cycle:"Zyklus",stable:"Stabil",review:"Prüfen",act:"Handeln",signals:"Veränderungen, die Kontext verdienen",method:"Ein wiederholbarer Monitoring-Rhythmus",faq:"Häufige Fragen",secondary:"Methode ansehen"};
const extraFaq=en?[{question:"Which systems can be observed?",answer:"The field follows your audience and topic. Relevant answer environments are compared through one stable question logic."},{question:"Do I receive a dashboard?",answer:"You receive a readable working view and a prioritised interpretation. The format follows the agreed scope rather than adding reporting for its own sake."}]:[{question:"Welche Systeme können beobachtet werden?",answer:"Das Feld folgt Zielgruppe und Thema. Relevante Antwortumfelder werden über eine stabile Fragenlogik verglichen."},{question:"Erhalte ich ein Dashboard?",answer:"Du erhältst eine verständliche Arbeitsansicht und eine priorisierte Einordnung. Das Format folgt dem vereinbarten Umfang statt Reporting um des Reportings willen."}];
const faqs=[...page.faq.items,...extraFaq];
const schema={"@context":"https://schema.org","@graph":[{"@type":"Service",name:page.eyebrow,description:page.meta.description,url:new URL(canonical,"https://elbsand.studio").toString(),provider:{"@type":"ProfessionalService",name:"ELBSAND Design Studio"}},{"@type":"BreadcrumbList",itemListElement:crumbs.map((x,i)=>({"@type":"ListItem",position:i+1,name:x.name,item:new URL(x.href,"https://elbsand.studio").toString()}))},{"@type":"FAQPage",mainEntity:faqs.map(x=>({"@type":"Question",name:x.question,acceptedAnswer:{"@type":"Answer",text:x.answer}}))}]};
---
<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonical} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="monitor-reference-page">
 <Header lang={page.lang} nav={site.nav} cta={site.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath}/>
 <main id="main-content">
  <section class="mo-hero"><div class="mo-shell mo-hero-grid"><div class="mo-hero-copy"><nav aria-label={en?"Breadcrumb":"Brotkrumen-Navigation"}>{crumbs.map((x,i)=><>{i>0&&<span>/</span>}{i===crumbs.length-1?<span aria-current="page">{x.name}</span>:<a href={x.href}>{x.name}</a>}</>)}</nav><h1>{page.title}</h1><p>{page.lead}</p><div class="mo-actions"><a class="mo-button mo-primary" href={`${home}#kontakt`}>{page.primaryCta}</a><a class="mo-button mo-secondary" href="#verlauf">{labels.secondary}</a></div></div>
   <div class="mo-live" aria-label={page.demo.note}><header><span><i></i>{labels.live}</span><b>{labels.cycle} 6</b></header><div class="mo-live-score"><span>{page.demo.scoreLabel}</span><strong>{page.demo.score}</strong></div><div class="mo-chart"><svg viewBox="0 0 620 260" aria-hidden="true"><path class="mo-area" d="M0 220L70 195L140 201L210 142L280 154L350 92L420 112L490 58L560 75L620 42V260H0Z"/><path class="mo-line" d="M0 220L70 195L140 201L210 142L280 154L350 92L420 112L490 58L560 75L620 42"/></svg><i style="--x:34%;--y:44%"></i><i style="--x:68%;--y:30%"></i><i style="--x:91%;--y:16%"></i></div><footer><span>W1</span><span>W2</span><span>W4</span><span>W6</span></footer></div>
  </div><div class="mo-capabilities mo-shell">{page.outcomes.map((x,i)=><article><span>{i+1}</span><h2>{x.title}</h2><p>{x.text}</p></article>)}</div></section>
  <section class="mo-field mo-shell" id="verlauf"><div class="mo-field-head"><h2>{page.narratives[0].title}</h2><p>{page.narratives[0].text}</p></div><div class="mo-field-body"><ol>{page.demo.checks.map((x,i)=><li data-mo-step={i} class:list={{"is-active":i===0}} tabindex="0"><span>{i+1}</span><div><h3>{x.label}</h3><p>{x.detail}</p></div><b data-status={x.status}>{x.status==="clear"?labels.stable:x.status==="review"?labels.review:labels.act}</b></li>)}</ol><div class="mo-stage" data-mo-stage data-active="0"><header><span>{labels.field}</span><b>{labels.live}</b></header><div class="mo-stage-scenes">{page.method.visual.scenes.map((x,i)=><article data-scene={i}><strong>{x.metric}</strong><p>{x.label}</p><div>{x.items.map((item,j)=><span style={`--delay:${j*70}ms`}>{item}<i></i></span>)}</div></article>)}</div><footer><span data-mo-count>1 / 4</span><i><b data-mo-progress></b></i></footer></div></div></section>
  <section class="mo-signals mo-shell"><header><h2>{labels.signals}</h2><p>{page.narratives[1].text}</p></header><div>{page.method.steps.map((x,i)=><article><span>{i+1}</span><h3>{x.title}</h3><p>{x.text}</p><i style={`--width:${42+i*14}%`}></i></article>)}</div></section>
  <section class="mo-method"><div class="mo-shell"><h2>{labels.method}</h2><div>{page.method.steps.map((x,i)=><article><span>{i+1}</span><h3>{x.title}</h3><p>{x.text}</p></article>)}</div></div></section>
  <section class="mo-faq mo-shell"><h2>{labels.faq}</h2><div>{faqs.map(x=><details><summary><span>{x.question}</span><i>⌄</i></summary><p>{x.answer}</p></details>)}</div></section>
  <SubpageContact lang={page.lang} source="geo-monitoring-service" />
 </main><Footer {...site.footer} lang={page.lang}/>
</BaseLayout>
<script>
 const steps=[...document.querySelectorAll<HTMLElement>("[data-mo-step]")],stage=document.querySelector<HTMLElement>("[data-mo-stage]"),count=document.querySelector<HTMLElement>("[data-mo-count]"),progress=document.querySelector<HTMLElement>("[data-mo-progress]");
 const activate=(i:number)=>{steps.forEach((x,j)=>x.classList.toggle("is-active",j===i));stage?.setAttribute("data-active",String(i));if(count)count.textContent=`${i+1} / ${steps.length}`;progress?.style.setProperty("width",`${((i+1)/steps.length)*100}%`)};
 steps.forEach((x,i)=>{x.addEventListener("focus",()=>activate(i));x.addEventListener("mouseenter",()=>activate(i))});
 if(!matchMedia("(prefers-reduced-motion: reduce)").matches){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)activate(steps.indexOf(e.target as HTMLElement))}),{rootMargin:"-42% 0px -42% 0px"});steps.forEach(x=>io.observe(x))}
</script>
<style>
 :global(body.monitor-reference-page){--mbg:#050504;--mink:#fffaf4;--mmuted:#b9b4aa;--mline:rgba(255,250,244,.13);--maccent:#b74622;overflow-x:clip;background:var(--mbg);color:var(--mink)}:global(.monitor-reference-page .site-header){border-color:var(--mline);background:rgba(5,5,4,.94);color:var(--mink)}:global(.monitor-reference-page .site-footer){border-color:var(--mline);background:var(--mbg);color:var(--mink)}:global(.monitor-reference-page main h1),:global(.monitor-reference-page main h2),:global(.monitor-reference-page main h3){font-family:var(--sans)}.mo-shell{width:min(calc(100% - 40px),1056px);margin-inline:auto}
 .mo-hero{min-height:1160px}.mo-hero-grid{display:grid;min-height:820px;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);border-inline:1px solid var(--mline)}.mo-hero-grid>*{min-width:0}.mo-hero-copy{padding:120px 32px 40px}.mo-hero-copy nav{display:flex;gap:8px;overflow:hidden;color:#807c75;font-size:11px;white-space:nowrap}.mo-hero-copy nav a{color:inherit;text-decoration:none}.mo-hero h1{margin:54px 0 0;font-size:56px;font-weight:500;letter-spacing:-.055em;line-height:64px}.mo-hero-copy>p{margin:20px 0 0;color:var(--mmuted);font-size:17px;line-height:26px}.mo-actions{display:flex;gap:8px;margin-top:32px}.mo-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border:1px solid rgba(255,250,244,.28);border-radius:var(--radius-sm);padding:0 22px;font-size:15px;font-weight:650;text-decoration:none}.mo-primary{border-color:var(--maccent);background:var(--maccent);color:#fffaf4}.mo-secondary{background:#33322f;color:var(--mink)}.mo-live{min-width:0;align-self:center;overflow:hidden;border:1px solid var(--mline);border-radius:14px;background:#141412;box-shadow:0 30px 80px rgba(0,0,0,.38)}.mo-live>header,.mo-live>footer{display:flex;height:58px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--mline);padding:0 24px;color:var(--mmuted);font-size:13px}.mo-live>header span{display:flex;align-items:center;gap:9px}.mo-live>header i{width:8px;height:8px;border-radius:50%;background:#81b36c;box-shadow:0 0 0 5px rgba(129,179,108,.1)}.mo-live-score{display:flex;align-items:end;justify-content:space-between;padding:28px 26px 8px}.mo-live-score span{color:var(--mmuted);font-size:14px}.mo-live-score strong{font-size:34px;font-weight:520}.mo-chart{position:relative;height:300px;margin:0 26px;background-image:linear-gradient(var(--mline) 1px,transparent 1px);background-size:100% 60px}.mo-chart svg{width:100%;height:100%}.mo-area{fill:rgba(183,70,34,.1)}.mo-line{fill:none;stroke:#e47b57;stroke-width:2;stroke-dasharray:1000;animation:mo-draw 2s ease both}.mo-chart>i{position:absolute;top:var(--y);left:var(--x);width:10px;height:10px;border:2px solid #e47b57;border-radius:50%;background:#141412}.mo-live>footer{border-top:1px solid var(--mline);border-bottom:0}.mo-capabilities{display:grid;height:260px;grid-template-columns:repeat(3,1fr);border:1px solid var(--mline)}.mo-capabilities article{border-right:1px solid var(--mline);padding:28px}.mo-capabilities article:last-child{border:0}.mo-capabilities span{color:#858078;font-size:12px}.mo-capabilities h2{margin:42px 0 10px;font-size:19px}.mo-capabilities p{margin:0;color:var(--mmuted);font-size:15px;line-height:22px}
 .mo-field{margin-top:180px;border:1px solid var(--mline)}.mo-field-head{display:grid;min-height:300px;grid-template-columns:1fr 1fr;padding:52px 32px}.mo-field-head h2{margin:0;font-size:34px;font-weight:500;line-height:42px}.mo-field-head p{margin:0;color:var(--mmuted);font-size:17px;line-height:26px}.mo-field-body{display:grid;grid-template-columns:.82fr 1.18fr;border-top:1px solid var(--mline)}.mo-field-body ol{margin:0;padding:0;list-style:none}.mo-field-body li{display:grid;min-height:235px;grid-template-columns:30px 1fr auto;gap:16px;border-bottom:1px solid var(--mline);padding:30px 26px;transition:background .25s ease}.mo-field-body li.is-active{background:linear-gradient(90deg,rgba(183,70,34,.1),transparent)}.mo-field-body li>span{color:#858078;font-size:12px}.mo-field-body li h3{margin:0;font-size:19px}.mo-field-body li p{margin:10px 0 0;color:var(--mmuted);font-size:15px;line-height:23px}.mo-field-body li>b{height:max-content;border:1px solid var(--mline);border-radius:999px;padding:5px 9px;color:var(--mmuted);font-size:11px}.mo-stage{position:sticky;top:92px;height:700px;overflow:hidden;border-left:1px solid var(--mline);background:radial-gradient(circle at 60% 48%,rgba(183,70,34,.09),transparent 36%)}.mo-stage>header,.mo-stage>footer{display:flex;height:58px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--mline);padding:0 24px;color:var(--mmuted);font-size:12px}.mo-stage-scenes{position:relative;height:584px}.mo-stage-scenes article{position:absolute;display:grid;inset:0;align-content:center;padding:50px;opacity:0;filter:blur(8px);transform:translateY(25px);transition:.55s ease}.mo-stage[data-active="0"] [data-scene="0"],.mo-stage[data-active="1"] [data-scene="1"],.mo-stage[data-active="2"] [data-scene="2"],.mo-stage[data-active="3"] [data-scene="3"]{opacity:1;filter:none;transform:none}.mo-stage-scenes strong{font-size:92px;font-weight:500;letter-spacing:-.07em}.mo-stage-scenes p{max-width:280px;margin:10px 0 34px;color:var(--mmuted);font-size:17px;line-height:25px}.mo-stage-scenes article>div{display:grid;grid-template-columns:1fr 1fr}.mo-stage-scenes article span{display:flex;min-height:76px;align-items:center;justify-content:space-between;border-top:1px solid var(--mline);padding:0 12px;font-size:15px}.mo-stage-scenes article span i{width:8px;height:8px;border-radius:50%;background:#e47b57}.mo-stage>footer{border-top:1px solid var(--mline);border-bottom:0}.mo-stage>footer>i{width:70%;height:2px;background:var(--mline)}.mo-stage>footer>i b{display:block;width:25%;height:100%;background:#e47b57;transition:width .45s ease}
 .mo-signals{margin-top:200px;border:1px solid var(--mline)}.mo-signals>header{display:grid;min-height:240px;grid-template-columns:1fr 1fr;padding:46px 32px}.mo-signals h2{margin:0;font-size:30px;font-weight:500}.mo-signals header p{margin:0;color:var(--mmuted);font-size:17px;line-height:26px}.mo-signals>div{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--mline)}.mo-signals article{position:relative;min-height:250px;border-right:1px solid var(--mline);border-bottom:1px solid var(--mline);padding:28px}.mo-signals article:nth-child(even){border-right:0}.mo-signals article>span{color:#858078;font-size:12px}.mo-signals article h3{margin:28px 0 10px;font-size:19px}.mo-signals article p{margin:0;color:var(--mmuted);font-size:15px;line-height:22px}.mo-signals article>i{position:absolute;right:28px;bottom:28px;left:28px;height:2px;background:linear-gradient(90deg,#b74622 var(--width),var(--mline) var(--width))}.mo-method{margin-top:200px;border-block:1px solid var(--mline)}.mo-method .mo-shell{padding:80px 0}.mo-method h2{margin:0 0 60px;font-size:34px}.mo-method .mo-shell>div{display:grid;grid-template-columns:repeat(4,1fr)}.mo-method article{min-height:300px;border:1px solid var(--mline);border-right:0;padding:28px}.mo-method article:last-child{border-right:1px solid var(--mline)}.mo-method article span{color:#e47b57;font-size:13px}.mo-method article h3{margin:70px 0 12px;font-size:19px}.mo-method article p{margin:0;color:var(--mmuted);font-size:15px;line-height:23px}.mo-faq{display:grid;min-height:700px;grid-template-columns:280px 1fr;padding-top:140px}.mo-faq h2{margin:0;font-size:28px}.mo-faq>div{border-left:1px solid var(--mline)}.mo-faq details{border-top:1px solid var(--mline)}.mo-faq details:last-child{border-bottom:1px solid var(--mline)}.mo-faq summary{display:grid;min-height:76px;grid-template-columns:1fr auto;align-items:center;padding:0 28px;cursor:pointer;font-size:15px;list-style:none}.mo-faq summary i{font-style:normal}.mo-faq details p{margin:0;padding:0 28px 26px;color:var(--mmuted);font-size:15px;line-height:23px}.mo-close{min-height:430px;border:1px solid var(--mline);padding:80px 40px}.mo-close h2{max-width:650px;margin:0;font-size:34px}.mo-close p{max-width:600px;margin:16px 0 30px;color:var(--mmuted);font-size:17px;line-height:26px}
 @keyframes mo-draw{from{stroke-dashoffset:1000}to{stroke-dashoffset:0}}@media(max-width:760px){.mo-shell{width:min(calc(100% - 32px),1056px)}.mo-hero{min-height:1800px}.mo-hero-grid{grid-template-columns:minmax(0,1fr)}.mo-hero-copy{min-width:0;padding:80px 20px}.mo-hero-copy nav a,.mo-hero-copy nav span:not([aria-current]){display:none}.mo-hero-copy nav span[aria-current]{max-width:100%;overflow:hidden;text-overflow:ellipsis}.mo-hero h1{font-size:44px;line-height:48px}.mo-actions{flex-direction:column}.mo-live{width:auto;max-width:100%;margin:0 14px}.mo-capabilities{height:auto;grid-template-columns:1fr}.mo-capabilities article{min-height:230px;border-right:0;border-bottom:1px solid var(--mline);padding:26px 20px}.mo-field{margin-top:120px}.mo-field-head{min-height:420px;grid-template-columns:minmax(0,1fr);gap:24px;padding:42px 22px}.mo-field-head h2{font-size:30px;line-height:37px}.mo-field-body{grid-template-columns:minmax(0,1fr)}.mo-field-body>*{min-width:0}.mo-field-body li{min-height:250px}.mo-stage{position:relative;top:auto;width:100%;height:650px;border-top:1px solid var(--mline);border-left:0}.mo-stage-scenes{height:534px}.mo-stage-scenes article{padding:32px 22px}.mo-stage-scenes article>div{grid-template-columns:minmax(0,1fr)}.mo-stage-scenes article span{min-width:0}.mo-stage-scenes strong{font-size:70px}.mo-signals{margin-top:120px}.mo-signals>header{min-height:400px;grid-template-columns:1fr;gap:24px;padding:42px 22px}.mo-signals>div{grid-template-columns:1fr}.mo-signals article{min-height:270px;border-right:0}.mo-method{margin-top:120px}.mo-method .mo-shell>div{grid-template-columns:1fr}.mo-method article{min-height:260px;border-right:1px solid var(--mline);border-bottom:0}.mo-method article:last-child{border-bottom:1px solid var(--mline)}.mo-method article h3{margin-top:50px}.mo-faq{grid-template-columns:1fr;padding-top:100px}.mo-faq h2{margin-bottom:48px}.mo-faq>div{border-left:0}.mo-close{min-height:500px;padding:70px 22px}}@media(prefers-reduced-motion:reduce){.mo-line{animation:none}.mo-stage-scenes article,.mo-stage>footer>i b{transition:none}}
  .mo-capabilities p, .mo-field-body li p, .mo-signals article p, .mo-method article p, .mo-faq details p { font-size:16px; line-height:1.55; }
</style>
