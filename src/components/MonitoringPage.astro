---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import FeatureCardGrid from "./FeatureCardGrid";
import FlatAreaChart from "./FlatAreaChart";
import LinkButton from "./LinkButton";
import MonitoringSequence from "./MonitoringSequence";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const site = content[page.lang];
const isEnglish = page.lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const canonicalPath = isEnglish ? page.alternateEnPath : page.alternateDePath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/" },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath },
];

const labels = isEnglish ? {
  live: "Observation active",
  field: "Monitoring field",
  cycle: "Cycle",
  stable: "Stable",
  review: "Review",
  act: "Act",
  signals: "Changes that deserve context",
  method: "A repeatable monitoring rhythm",
  faq: "Frequently asked questions",
  secondary: "View the method",
} : {
  live: "Beobachtung aktiv",
  field: "Monitoring-Feld",
  cycle: "Zyklus",
  stable: "Stabil",
  review: "Prüfen",
  act: "Handeln",
  signals: "Veränderungen, die Kontext verdienen",
  method: "Ein wiederholbarer Monitoring-Rhythmus",
  faq: "Häufige Fragen",
  secondary: "Methode ansehen",
};

const extraFaq = isEnglish ? [
  { question: "Which systems can be observed?", answer: "The field follows your audience and topic. Relevant answer environments are compared through one stable question logic." },
  { question: "Do I receive a dashboard?", answer: "You receive a readable working view and a prioritised interpretation. The format follows the agreed scope rather than adding reporting for its own sake." },
] : [
  { question: "Welche Systeme können beobachtet werden?", answer: "Das Feld folgt Zielgruppe und Thema. Relevante Antwortumfelder werden über eine stabile Fragenlogik verglichen." },
  { question: "Erhalte ich ein Dashboard?", answer: "Du erhältst eine verständliche Arbeitsansicht und eine priorisierte Einordnung. Das Format folgt dem vereinbarten Umfang statt Reporting um des Reportings willen." },
];

const faqItems = [...page.faq.items, ...extraFaq];
const chartData = [
  { label: "W1.1", value: 42 },
  { label: "W1.2", value: 48 },
  { label: "W2.1", value: 46 },
  { label: "W2.2", value: 59 },
  { label: "W3.1", value: 56 },
  { label: "W3.2", value: 70 },
  { label: "W4.1", value: 65 },
  { label: "W4.2", value: 79 },
  { label: "W5", value: 74 },
  { label: "W6", value: 84 },
];

const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: faqItems });
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  lang={page.lang}
  canonicalPath={canonicalPath}
  alternateDePath={page.alternateDePath}
  alternateEnPath={page.alternateEnPath}
  schema={schema}
  bodyClass="monitor-reference-page ui-dark-page dark"
>
  <Header lang={page.lang} nav={site.nav} cta={site.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border">
      <div class="mx-auto grid max-w-content grid-cols-1 px-5 py-section-mobile md:px-12 lg:grid-cols-2 lg:gap-12 lg:py-section">
        <div class="flex min-w-0 flex-col justify-center">
          <nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isEnglish ? "Breadcrumb" : "Brotkrumen-Navigation"}>
            {breadcrumbItems.map((item, index) => (
              <>
                {index > 0 && <span aria-hidden="true">/</span>}
                {index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}
              </>
            ))}
          </nav>
          <h1 class="m-0 mt-12 max-w-2xl text-display-mobile font-medium text-foreground md:text-display">{page.title}</h1>
          <p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{page.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <LinkButton href={`${homePath}#kontakt`} label={page.primaryCta} icon="right" />
            <LinkButton href="#verlauf" label={labels.secondary} variant="secondary" icon="down" />
          </div>
        </div>

        <Card className="mt-12 overflow-hidden shadow-none lg:mt-0">
          <CardHeader className="flex-row items-center justify-between border-b border-solid border-border p-6">
            <span class="text-xs text-muted-foreground">{labels.live}</span>
            <span class="text-xs text-muted-foreground">{labels.cycle} 6</span>
          </CardHeader>
          <CardContent className="p-6">
            <p class="m-0 mb-4 text-xs leading-copy text-muted-foreground">{page.demo.note}</p>
            <div class="flex items-end justify-between gap-6">
              <span class="text-sm text-muted-foreground">{page.demo.scoreLabel}</span>
              <span class="text-section-title font-medium text-card-foreground">{page.demo.score}</span>
            </div>
            <FlatAreaChart data={chartData} label={page.demo.note} className="mt-6 h-64 w-full" client:load />
            <div class="mt-3 flex justify-between text-xs text-muted-foreground"><span>W1</span><span>W2</span><span>W4</span><span>W6</span></div>
          </CardContent>
        </Card>
      </div>
    </section>

    <section class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section" aria-label={isEnglish ? "Outcomes" : "Ergebnisse"}>
      <FeatureCardGrid items={page.outcomes} columns={3} headingLevel={2} />
    </section>

    <section id="verlauf" class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
      <header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20">
        <h2 class="m-0 max-w-xl text-section-title font-medium text-foreground">{page.narratives[0].title}</h2>
        <p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{page.narratives[0].text}</p>
      </header>
      <MonitoringSequence checks={page.demo.checks} scenes={page.method.visual.scenes} labels={labels} client:load />
    </section>

    <section class="border-y border-solid border-border">
      <div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section">
        <header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20">
          <h2 class="m-0 max-w-xl text-section-title font-medium text-foreground">{labels.signals}</h2>
          <p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{page.narratives[1].text}</p>
        </header>
        <FeatureCardGrid items={page.method.steps} columns={2} />
      </div>
    </section>

    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section">
      <h2 class="m-0 text-section-title font-medium text-foreground">{labels.faq}</h2>
      <FaqAccordion items={faqItems} theme="dark" className="lg:col-span-2" />
    </section>

    <SubpageContact lang={page.lang} source="geo-monitoring-service" />
  </main>

  <Footer {...site.footer} lang={page.lang} />
</BaseLayout>
