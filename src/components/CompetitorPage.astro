---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const siteContent = content[page.lang];
const isEnglish = page.lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const canonicalPath = isEnglish ? page.alternateEnPath : page.alternateDePath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/" },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath },
];

const labels = isEnglish ? {
  primary: "Discuss the analysis",
  secondary: "Get started",
  trust: "Comparison across the relevant AI answer environments",
  benchmarkTitle: "Benchmark and analyse the competitors that shape the answer field",
  benchmarkIntro: "We compare the same questions, answer patterns and source signals across relevant offers. This reveals where competitors are understood more clearly and where your position can become more precise.",
  processTitle: "Your working model for a meaningful comparison",
  processIntro: "From a defined field to a credible next step: the analysis stays tied to real customer questions and evidence.",
  cases: "From observation to a usable competitive finding",
  read: "View project",
  faq: "Frequently asked questions",
  closingTitle: "Find the position your customers can understand immediately",
  closingText: "We show which answer fields matter, what others currently occupy and where your own offer can become clearer without artificial claims.",
  status: "Studio systems operational",
} : {
  primary: "Analyse besprechen",
  secondary: "Jetzt starten",
  trust: "Vergleich über die relevanten KI-Antwortumfelder hinweg",
  benchmarkTitle: "Die Wettbewerber analysieren, die das Antwortfeld tatsächlich prägen",
  benchmarkIntro: "Wir vergleichen dieselben Fragen, Antwortmuster und Quellensignale über relevante Angebote hinweg. So wird sichtbar, wo andere klarer verstanden werden und wo deine Position präziser werden kann.",
  processTitle: "Dein Arbeitsmodell für einen aussagekräftigen Vergleich",
  processIntro: "Vom sauber definierten Feld bis zum glaubwürdigen nächsten Schritt bleibt die Analyse an realen Kundenfragen und Belegen orientiert.",
  cases: "Von der Beobachtung zum nutzbaren Wettbewerbsbefund",
  read: "Projekt ansehen",
  faq: "Häufige Fragen",
  closingTitle: "Finde die Position, die Kunden sofort verstehen",
  closingText: "Wir zeigen, welche Antwortfelder zählen, was andere dort bereits besetzen und wo dein eigenes Angebot ohne künstliche Behauptungen klarer werden kann.",
  status: "Studio-Systeme erreichbar",
};

const capabilityItems = [
  { title: page.outcomes[0].title, text: page.outcomes[0].text },
  { title: page.outcomes[1].title, text: page.outcomes[1].text },
  { title: isEnglish ? "Compare across answer systems" : "Antwortsysteme vergleichen", text: page.demo.checks[2].detail },
  { title: page.outcomes[2].title, text: page.outcomes[2].text },
];

const benchmarkItems = isEnglish ? [
  ["Define true competitors", "We identify the businesses that repeatedly appear for the same customer questions instead of relying on a fixed list of familiar names."],
  ["Read the visibility position", "The comparison shows where your offer appears, where it disappears and which context makes the difference."],
  ["Compare answer systems", "ChatGPT, Gemini, Perplexity and other relevant environments are read through one consistent question frame."],
  ["Analyse source patterns", "We trace which owned pages, profiles and editorial sources make competitor claims easier to verify."],
  ["Inspect questions individually", "A broad average can hide the important gap. We therefore compare the decision questions that actually matter."],
  ["Observe meaningful changes", "Repeated snapshots separate a stable pattern from a temporary answer variation."],
  ["Compare content directly", "Pages are assessed by clarity, evidence and structure, not by superficial word counts."],
  ["Translate the gap into work", "Every observation leads to a concrete decision for positioning, page structure, content or sources."],
] : [
  ["Reale Wettbewerber bestimmen", "Wir erfassen die Unternehmen, die bei denselben Kundenfragen wiederholt erscheinen, statt nur eine bekannte Namensliste abzuarbeiten."],
  ["Sichtbarkeitsposition einordnen", "Der Vergleich zeigt, wo dein Angebot erscheint, wo es fehlt und welcher Kontext den Unterschied macht."],
  ["Antwortsysteme vergleichen", "ChatGPT, Gemini, Perplexity und weitere relevante Umfelder werden mit demselben Fragenrahmen gelesen."],
  ["Quellenmuster analysieren", "Wir verfolgen, welche eigenen Seiten, Profile und redaktionellen Quellen Aussagen über Wettbewerber belegbarer machen."],
  ["Einzelfragen untersuchen", "Ein Durchschnitt kann die wichtige Lücke verdecken. Deshalb vergleichen wir konkrete Entscheidungssituationen."],
  ["Relevante Veränderungen beobachten", "Wiederholte Momentaufnahmen trennen ein stabiles Muster von einer kurzfristigen Antwortabweichung."],
  ["Inhalte direkt gegenüberstellen", "Seiten werden nach Klarheit, Beleg und Struktur beurteilt – nicht nach oberflächlichen Wortmengen."],
  ["Lücke in Arbeit übersetzen", "Jede Beobachtung führt zu einer konkreten Entscheidung für Positionierung, Seitenstruktur, Inhalt oder Quellen."],
];

const evidenceCards = isEnglish ? [
  { signal: "Question gap", text: "A relevant decision question is occupied by broad competitor explanations while the own difference stays invisible." },
  { signal: "Source advantage", text: "External sources describe competing offers more consistently and give their claims a clearer context." },
  { signal: "Content direction", text: "One precise service page can close the gap more credibly than a volume of generic new content." },
] : [
  { signal: "Fragenlücke", text: "Eine relevante Entscheidungssituation wird von allgemeinen Wettbewerbserklärungen besetzt, während der eigene Unterschied unsichtbar bleibt." },
  { signal: "Quellenvorteil", text: "Externe Quellen beschreiben vergleichbare Angebote konsistenter und geben ihren Aussagen einen klareren Kontext." },
  { signal: "Inhaltsrichtung", text: "Eine präzise Leistungsseite kann die Lücke glaubwürdiger schließen als eine große Menge allgemeiner neuer Inhalte." },
];
const engineNames = ["ChatGPT", "Gemini", "Perplexity", "Claude", "Google AI", "Copilot"];
const faqItems = [
  ...page.faq.items,
  ...(isEnglish ? [
    { question: "Which answer systems can be included?", answer: "The selection follows the audience and topic. ChatGPT, Gemini, Perplexity, Google AI and other relevant environments can be read through one consistent question frame." },
    { question: "How often should the comparison be repeated?", answer: "That depends on the market and the pace of change. A baseline followed by selected repeat observations is often more useful than continuous reporting without a clear decision." },
    { question: "Which signals are compared?", answer: "We look at presence, description, recurring traits, source patterns and the questions in which an offer is presented as a fitting option." },
    { question: "Can the findings guide content work?", answer: "Yes. Gaps are translated into concrete decisions for existing pages, new topics, clearer evidence or a sharper information structure." },
    { question: "Is the analysis difficult to prepare?", answer: "No. A concise view of your offer, region and important customer decisions is enough for the first definition of the field." },
  ] : [
    { question: "Welche Antwortsysteme können einbezogen werden?", answer: "Die Auswahl folgt Zielgruppe und Thema. ChatGPT, Gemini, Perplexity, Google AI und weitere relevante Umfelder können mit einem konsistenten Fragenrahmen gelesen werden." },
    { question: "Wie oft sollte der Vergleich wiederholt werden?", answer: "Das hängt von Markt und Veränderungstempo ab. Eine belastbare Ausgangslage mit ausgewählten Wiederholungen ist meist nützlicher als Dauerreporting ohne konkrete Entscheidung." },
    { question: "Welche Signale werden miteinander verglichen?", answer: "Wir betrachten Präsenz, Beschreibung, wiederkehrende Merkmale, Quellenmuster und die Fragen, in denen ein Angebot als passende Option erscheint." },
    { question: "Kann das Ergebnis die Content-Arbeit steuern?", answer: "Ja. Lücken werden in konkrete Entscheidungen für bestehende Seiten, neue Themen, klarere Belege oder eine präzisere Informationsstruktur übersetzt." },
    { question: "Ist die Vorbereitung aufwendig?", answer: "Nein. Ein kompakter Überblick über Angebot, Region und wichtige Kundenentscheidungen reicht, um das erste Vergleichsfeld gemeinsam festzulegen." },
  ]),
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", name: page.eyebrow, description: page.meta.description, url: new URL(canonicalPath, "https://elbsand.studio").toString(), provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio", url: "https://elbsand.studio/" }, areaServed: ["Deutschland", "DACH"] },
    { "@type": "BreadcrumbList", itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: new URL(item.href, "https://elbsand.studio").toString() })) },
    { "@type": "FAQPage", mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
  ],
};
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="competitor-reference-page">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content">
    <section class="cp-hero">
      <div class="cp-shell cp-hero-inner">
        <nav class="cp-breadcrumb" aria-label={isEnglish ? "Breadcrumb" : "Brotkrumen-Navigation"}>
          {breadcrumbItems.map((item, index) => <>{index > 0 && <span>/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}
        </nav>
        <div class="cp-hero-copy" data-cp-reveal>
          <h1>{page.title}</h1>
          <p>{page.lead}</p>
          <div class="cp-actions"><a class="cp-button cp-primary" href={`${homePath}#kontakt`}>{labels.primary}</a><a class="cp-button cp-secondary" href="#benchmark">{labels.secondary}</a></div>
        </div>
        <div class="cp-capabilities">
          {capabilityItems.map((item, index) => <article data-cp-reveal><span>{index + 1}</span><h2>{item.title}</h2><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="cp-trust">
      <div class="cp-shell">
        <h2>{labels.trust}</h2>
        <div class="cp-logo-grid">{engineNames.map((name, index) => <div><span>{index + 1}</span><b>{name}</b></div>)}</div>
      </div>
    </section>

    <div class="cp-gap cp-gap-a" aria-hidden="true"></div>

    <section class="cp-benchmark cp-shell" id="benchmark">
      <div class="cp-benchmark-block cp-benchmark-main">
        <div class="cp-sticky-copy">
          <h2>{labels.benchmarkTitle}</h2>
          <p>{labels.benchmarkIntro}</p>
        </div>
        <div class="cp-feature-list">
          {benchmarkItems.map(([title, text], index) => <article data-cp-reveal><span>{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div><i aria-hidden="true">↗</i></article>)}
        </div>
      </div>
      <div class="cp-benchmark-block cp-process-block">
        <div class="cp-sticky-copy"><h2>{labels.processTitle}</h2><p>{labels.processIntro}</p></div>
        <ol class="cp-process-list">
          {page.method.steps.map((step, index) => <li data-cp-reveal><span>{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
        </ol>
      </div>
    </section>

    <div class="cp-gap cp-gap-b" aria-hidden="true"></div>

    <section class="cp-cases cp-shell">
      <h2>{labels.cases}</h2>
      <div class="cp-case-grid">
        {evidenceCards.map((card, index) => <article data-cp-reveal><div class="cp-case-signal"><span>{index + 1}</span><strong>{card.signal}</strong><i aria-hidden="true"></i></div><div class="cp-case-copy"><span>{index + 1}</span><h3>{card.text}</h3><p>{isEnglish ? "Analysis output" : "Analysebefund"}</p></div></article>)}
      </div>
    </section>

    <div class="cp-gap cp-gap-c" aria-hidden="true"></div>

    <section class="cp-faq cp-shell">
      <h2>{labels.faq}</h2>
      <div class="cp-faq-list">{faqItems.map((item) => <details><summary><span>{item.question}</span><i aria-hidden="true">⌄</i></summary><p>{item.answer}</p></details>)}</div>
    </section>

    <SubpageContact lang={page.lang} source="competitor-analysis-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reduceCpMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const cpTargets = document.querySelectorAll<HTMLElement>("[data-cp-reveal]");
  if (reduceCpMotion.matches) cpTargets.forEach((target) => target.classList.add("is-visible"));
  else {
    document.documentElement.classList.add("cp-motion");
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }), { threshold: 0, rootMargin: "180px 0px" });
    cpTargets.forEach((target) => observer.observe(target));
    let revealFrame = 0;
    const revealPassedTargets = () => {
      cancelAnimationFrame(revealFrame);
      revealFrame = requestAnimationFrame(() => cpTargets.forEach((target) => {
        if (target.getBoundingClientRect().top < window.innerHeight + 180) target.classList.add("is-visible");
      }));
    };
    revealPassedTargets();
    window.addEventListener("scroll", revealPassedTargets, { passive: true });
    const benchmarkRows = document.querySelectorAll<HTMLElement>(".cp-feature-list article, .cp-process-list li");
    const rowObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
      entry.target.classList.toggle("is-current", entry.isIntersecting);
    }), { threshold: 0, rootMargin: "-46% 0px -46% 0px" });
    benchmarkRows.forEach((row) => rowObserver.observe(row));
  }
</script>

<style>
  :global(body.competitor-reference-page) { --cp-bg:#050504; --cp-ink:#fffaf4; --cp-muted:#b9b4aa; --cp-line:rgba(255,250,244,.13); --cp-accent:#b74622; --cp-accent-hover:#7b2f18; --cp-green:#81b36c; overflow-x:clip; background:var(--cp-bg); color:var(--cp-ink); }
  :global(.competitor-reference-page .site-header) { border-color:var(--cp-line); background:rgba(5,5,4,.94); color:var(--cp-ink); }
  :global(.competitor-reference-page .language-switch) { background:rgba(255,250,244,.06); }
  :global(.competitor-reference-page .language-switch a[aria-current="page"]) { background:rgba(255,250,244,.13); box-shadow:none; }
  :global(.competitor-reference-page .mobile-menu nav) { background:#161614; }
  :global(.competitor-reference-page main h1), :global(.competitor-reference-page main h2), :global(.competitor-reference-page main h3) { font-family:var(--sans); }
  .cp-shell { width:min(calc(100% - 40px), 1056px); margin-inline:auto; }
  .cp-hero { min-height:1032px; border-bottom:1px solid var(--cp-line); }
  .cp-hero-inner { position:relative; min-height:1032px; border-right:1px solid var(--cp-line); border-left:1px solid var(--cp-line); padding-top:98px; }
  .cp-breadcrumb { display:flex; gap:8px; padding-inline:32px; color:#6d6a64; font-size:10px; }
  .cp-breadcrumb a { color:inherit; text-decoration:none; }.cp-breadcrumb a:hover { color:var(--cp-ink); }
  .cp-hero-copy { max-width:790px; margin:42px 0 0; padding-inline:32px; }
  .cp-hero h1 { max-width:790px; margin:0; font-size:56px; font-weight:500; letter-spacing:-.055em; line-height:64px; }
  .cp-hero-copy > p { max-width:610px; margin:20px 0 0; color:var(--cp-muted); font-size:16px; line-height:24px; }
  .cp-actions { display:flex; gap:8px; margin-top:32px; }
  .cp-button { display:inline-flex; min-height:48px; align-items:center; justify-content:center; border:1px solid rgba(255,250,244,.28); border-radius:var(--radius-sm); padding:0 22px; font-family:var(--sans); font-size:15px; font-weight:650; line-height:1.2; text-decoration:none; transition:transform 180ms ease, background 180ms ease, border-color 180ms ease; }
  .cp-button:hover { transform:translateY(-1px); }.cp-primary { border-color:var(--cp-accent); background:var(--cp-accent); color:#fffaf4; }.cp-primary:hover { border-color:var(--cp-accent-hover); background:var(--cp-accent-hover); }.cp-secondary { background:#33322f; color:var(--cp-ink); }.cp-secondary:hover { border-color:#fffaf4; background:#45433e; }
  .cp-capabilities { position:absolute; right:0; bottom:0; left:0; display:grid; min-height:260px; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--cp-line); }
  .cp-capabilities article { position:relative; border-right:1px solid var(--cp-line); padding:28px 24px 24px; }.cp-capabilities article:last-child { border-right:0; }
  .cp-capabilities span { color:#8b877f; font-size:12px; }.cp-capabilities h2 { margin:30px 0 12px; font-size:17px; font-weight:560; line-height:24px; }.cp-capabilities p { margin:0; color:var(--cp-muted); font-size:14px; line-height:21px; }
  .cp-trust { min-height:379px; }
  .cp-trust .cp-shell { min-height:379px; border-right:1px solid var(--cp-line); border-left:1px solid var(--cp-line); }
  .cp-trust h2 { display:grid; min-height:210px; place-items:end center; margin:0; border-bottom:1px solid var(--cp-line); padding:0 20px 72px; font-size:24px; font-weight:500; line-height:32px; text-align:center; }
  .cp-logo-grid { display:grid; min-height:168px; grid-template-columns:repeat(4,1fr); }.cp-logo-grid div { display:flex; min-height:84px; align-items:center; gap:12px; border-right:1px solid var(--cp-line); border-bottom:1px solid var(--cp-line); padding:16px 26px; }.cp-logo-grid div:nth-child(4n) { border-right:0; }.cp-logo-grid div:nth-child(n+5) { border-bottom:0; }.cp-logo-grid span{color:#858078;font-size:11px}.cp-logo-grid b{font-size:16px;font-weight:560}
  .cp-gap { width:100%; }.cp-gap-a { height:200px; }.cp-gap-b { height:241px; }.cp-gap-c { height:200px; }.cp-gap-d { height:160px; }
  .cp-benchmark { min-height:2029px; border-right:1px solid var(--cp-line); border-left:1px solid var(--cp-line); }
  .cp-benchmark-block { display:grid; grid-template-columns:1fr 1fr; }
  .cp-benchmark-main { min-height:1415px; border-top:1px solid var(--cp-line); border-bottom:1px solid var(--cp-line); }
  .cp-sticky-copy { position:sticky; top:96px; align-self:start; padding:32px; }.cp-sticky-copy h2 { max-width:463px; margin:0; font-size:25px; font-weight:500; line-height:34px; }.cp-sticky-copy p { max-width:430px; margin:18px 0 0; color:var(--cp-muted); font-size:16px; line-height:24px; }
  .cp-feature-list { border-left:1px solid var(--cp-line); }
  .cp-feature-list article { position:relative; display:grid; min-height:176px; grid-template-columns:28px minmax(0,1fr) 24px; gap:18px; align-items:start; overflow:hidden; border-bottom:1px solid var(--cp-line); padding:28px 24px; transition:background 360ms ease; }.cp-feature-list article::before { position:absolute; top:0; bottom:0; left:0; width:2px; background:#e47b57; content:""; transform:scaleY(0); transform-origin:center; transition:transform 420ms cubic-bezier(.2,.8,.2,1); }.cp-feature-list article.is-current { background:linear-gradient(90deg,rgba(183,70,34,.08),transparent 55%); }.cp-feature-list article.is-current::before { transform:scaleY(1); }.cp-feature-list article:last-child { border-bottom:0; }
  .cp-feature-list article > span { color:#8b877f; font-size:12px; }.cp-feature-list h3 { margin:0; font-size:17px; font-weight:560; line-height:24px; }.cp-feature-list p { margin:9px 0 0; color:var(--cp-muted); font-size:15px; line-height:22px; }.cp-feature-list article > i { color:#8b877f; font-size:14px; font-style:normal; transition:color 180ms ease, transform 180ms ease; }.cp-feature-list article:hover > i { color:var(--cp-accent); transform:translate(2px,-2px); }
  .cp-process-block { min-height:614px; }.cp-process-block .cp-sticky-copy { padding-top:48px; }.cp-process-list { margin:0; border-left:1px solid var(--cp-line); padding:0; list-style:none; }
  .cp-process-list li { position:relative; display:grid; min-height:153.5px; grid-template-columns:32px 1fr; gap:18px; overflow:hidden; border-bottom:1px solid var(--cp-line); padding:25px 24px; transition:background 360ms ease; }.cp-process-list li::before { position:absolute; top:0; bottom:0; left:0; width:2px; background:#e47b57; content:""; transform:scaleY(0); transform-origin:center; transition:transform 420ms cubic-bezier(.2,.8,.2,1); }.cp-process-list li.is-current { background:linear-gradient(90deg,rgba(183,70,34,.08),transparent 55%); }.cp-process-list li.is-current::before { transform:scaleY(1); }.cp-process-list li:last-child { border-bottom:0; }.cp-process-list span { color:#e47b57; font-size:12px; }.cp-process-list h3 { margin:0; font-size:17px; font-weight:560; line-height:24px; }.cp-process-list p { margin:8px 0 0; color:var(--cp-muted); font-size:15px; line-height:22px; }
  .cp-cases { min-height:842px; border-top:1px solid var(--cp-line); border-right:1px solid var(--cp-line); border-left:1px solid var(--cp-line); }
  .cp-cases > h2 { min-height:132px; margin:0; border-bottom:1px solid var(--cp-line); padding:48px 32px; font-size:24px; font-weight:500; line-height:32px; }
  .cp-case-grid { display:grid; grid-template-columns:1fr 1fr; }.cp-case-grid > article { display:grid; height:354px; grid-template-rows:175px 179px; border-right:1px solid var(--cp-line); border-bottom:1px solid var(--cp-line); }.cp-case-grid > article:nth-child(2) { border-right:0; }
  .cp-case-signal{position:relative;display:flex;min-height:175px;align-items:flex-end;gap:14px;padding:32px}.cp-case-signal>span{color:#858078;font-size:12px}.cp-case-signal strong{font-size:22px;font-weight:520}.cp-case-signal i{position:absolute;top:32px;right:32px;width:72px;height:72px;border:1px solid var(--cp-line);border-radius:50%}.cp-case-signal i::before,.cp-case-signal i::after{position:absolute;background:#e47b57;content:""}.cp-case-signal i::before{top:50%;left:15px;width:40px;height:1px}.cp-case-signal i::after{top:15px;left:50%;width:1px;height:40px}
