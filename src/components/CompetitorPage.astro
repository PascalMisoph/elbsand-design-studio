---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import CompetitorExpandingCards from "./CompetitorExpandingCards";
import CompetitorFindingStack from "./CompetitorFindingStack";
import CompetitorLogoCloud from "./CompetitorLogoCloud";
import EditorialFeatureList from "./EditorialFeatureList";
import LinkButton from "./LinkButton";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const siteContent = content[page.lang];
const isEnglish = page.lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const canonicalPath = isEnglish ? page.alternateEnPath : page.alternateDePath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/" },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath },
];

const labels = isEnglish ? {
  primary: "Discuss the analysis",
  secondary: "View benchmark",
  trust: "Comparison across relevant AI answer environments",
  benchmarkTitle: "Analyse the competitors that shape the answer field",
  benchmarkIntro: "We compare the same questions, answer patterns and source signals across relevant offers. This reveals where competitors are understood more clearly and where your position can become more precise.",
  processTitle: "A working model for a meaningful comparison",
  processIntro: "From a defined field to a credible next step, the analysis stays tied to real customer questions and evidence.",
  cases: "From observation to a usable competitive finding",
  findings: "Comparison findings",
  faq: "Frequently asked questions",
} : {
  primary: "Analyse besprechen",
  secondary: "Benchmark ansehen",
  trust: "Vergleich über relevante KI-Antwortumfelder hinweg",
  benchmarkTitle: "Die Wettbewerber analysieren, die das Antwortfeld tatsächlich prägen",
  benchmarkIntro: "Wir vergleichen dieselben Fragen, Antwortmuster und Quellensignale über relevante Angebote hinweg. So wird sichtbar, wo andere klarer verstanden werden und wo deine Position präziser werden kann.",
  processTitle: "Ein Arbeitsmodell für einen aussagekräftigen Vergleich",
  processIntro: "Vom sauber definierten Feld bis zum glaubwürdigen nächsten Schritt bleibt die Analyse an realen Kundenfragen und Belegen orientiert.",
  cases: "Von der Beobachtung zum nutzbaren Wettbewerbsbefund",
  findings: "Vergleichsbefunde",
  faq: "Häufige Fragen",
};

const benchmarkItems = isEnglish ? [
  { title: "Define true competitors", text: "Identify the businesses that repeatedly appear for the same customer questions instead of relying on a fixed list." },
  { title: "Read the visibility position", text: "See where your offer appears, where it disappears and which context makes the difference." },
  { title: "Compare answer systems", text: "Read ChatGPT, Gemini, Perplexity and other relevant environments through one consistent question frame." },
  { title: "Analyse source patterns", text: "Trace which owned pages, profiles and editorial sources make competitor claims easier to verify." },
  { title: "Inspect questions individually", text: "Compare the concrete decision questions that a broad average can hide." },
  { title: "Observe meaningful changes", text: "Separate a stable pattern from temporary answer variation through selected repeat snapshots." },
  { title: "Compare content directly", text: "Assess pages by clarity, evidence and structure rather than superficial word counts." },
  { title: "Translate gaps into work", text: "Turn every relevant observation into a decision for positioning, structure, content or sources." },
] : [
  { title: "Reale Wettbewerber bestimmen", text: "Erfasse Unternehmen, die bei denselben Kundenfragen wiederholt erscheinen, statt nur bekannte Namen abzuarbeiten." },
  { title: "Sichtbarkeitsposition einordnen", text: "Zeige, wo dein Angebot erscheint, wo es fehlt und welcher Kontext den Unterschied macht." },
  { title: "Antwortsysteme vergleichen", text: "Lies ChatGPT, Gemini, Perplexity und weitere Umfelder mit demselben Fragenrahmen." },
  { title: "Quellenmuster analysieren", text: "Verfolge, welche Seiten, Profile und redaktionellen Quellen Aussagen über Wettbewerber belegbarer machen." },
  { title: "Einzelfragen untersuchen", text: "Vergleiche konkrete Entscheidungssituationen, die ein Durchschnitt verdecken kann." },
  { title: "Relevante Veränderungen beobachten", text: "Trenne stabile Muster mit ausgewählten Wiederholungen von kurzfristigen Antwortabweichungen." },
  { title: "Inhalte direkt gegenüberstellen", text: "Beurteile Seiten nach Klarheit, Beleg und Struktur statt nach oberflächlichen Wortmengen." },
  { title: "Lücken in Arbeit übersetzen", text: "Führe jede relevante Beobachtung zu einer Entscheidung für Positionierung, Struktur, Inhalt oder Quellen." },
];

const faqItems = [...page.faq.items, ...(isEnglish ? [
  { question: "Which answer systems can be included?", answer: "The selection follows the audience and topic. Relevant environments are read through one consistent question frame." },
  { question: "How often should the comparison be repeated?", answer: "A dependable baseline followed by selected observations is usually more useful than continuous reporting without a decision." },
  { question: "Can the findings guide content work?", answer: "Yes. Gaps become decisions for existing pages, new topics, clearer evidence or a sharper information structure." },
] : [
  { question: "Welche Antwortsysteme können einbezogen werden?", answer: "Die Auswahl folgt Zielgruppe und Thema. Relevante Umfelder werden mit einem konsistenten Fragenrahmen gelesen." },
  { question: "Wie oft sollte der Vergleich wiederholt werden?", answer: "Eine belastbare Ausgangslage mit ausgewählten Wiederholungen ist meist nützlicher als Dauerreporting ohne konkrete Entscheidung." },
  { question: "Kann das Ergebnis die Content-Arbeit steuern?", answer: "Ja. Lücken werden zu Entscheidungen für bestehende Seiten, neue Themen, klarere Belege oder eine präzisere Informationsstruktur." },
])];

const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: faqItems });
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="competitor-reference-page ui-dark-page dark">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isEnglish ? "Breadcrumb" : "Brotkrumen-Navigation"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}</nav><div class="max-w-3xl pt-12"><h1 class="m-0 text-display-mobile font-medium text-foreground md:text-display">{page.title}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{page.lead}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={labels.primary} icon="right" /><LinkButton href="#benchmark" label={labels.secondary} variant="secondary" icon="down" /></div></div><div class="mt-20"><p class="m-0 mb-4 text-xs leading-copy text-muted-foreground">{page.demo.note}</p><CompetitorExpandingCards lang={page.lang} client:load /></div></div></section>

    <section class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><h2 class="m-0 max-w-2xl text-section-title font-medium text-foreground">{labels.trust}</h2><CompetitorLogoCloud client:load /></section>

    <section id="benchmark"><div class="mx-auto grid max-w-content grid-cols-1 px-5 md:px-12 lg:grid-cols-2"><div class="py-16 lg:sticky lg:top-[125px] lg:self-start lg:py-[72px] lg:pr-16"><h2 class="m-0 max-w-[390px] text-section-title font-medium text-foreground">{labels.benchmarkTitle}</h2><p class="m-0 mt-6 max-w-[390px] text-base leading-copy text-muted-foreground">{labels.benchmarkIntro}</p></div><EditorialFeatureList items={benchmarkItems} label={labels.findings} client:load /></div></section>

    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><h2 class="m-0 max-w-2xl text-section-title font-medium text-foreground">{labels.cases}</h2><div class="mt-14"><CompetitorFindingStack lang={page.lang} client:load /></div></div></section>

    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{labels.faq}</h2><FaqAccordion items={faqItems} theme="dark" borderless className="lg:col-span-2" /></section>

    <SubpageContact lang={page.lang} source="competitor-analysis-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<style>
  :global(body.competitor-reference-page) {
    --ui-background: #000;
    --ui-card: #0d0d0d;
    --ui-foreground: #fbf8f2;
    background: #000;
    color: #fbf8f2;
  }
  :global(body.competitor-reference-page .site-header),
  :global(body.competitor-reference-page .site-footer) {
    background: #000;
    color: #fbf8f2;
  }

  /* Match the GEO Audit sticky reading column and prevent section dividers from becoming side frames. */
  :global(body.competitor-reference-page main > section) {
    border-right-width: 0;
    border-left-width: 0;
  }
  :global(body.competitor-reference-page #benchmark > div > div:first-child h2) {
    max-width: 390px !important;
    margin: 0;
    font-size: clamp(34px, 3vw, 40px) !important;
    font-weight: 560;
    line-height: 1.05 !important;
    letter-spacing: -.045em !important;
  }
  :global(body.competitor-reference-page #benchmark > div > div:first-child p) {
    max-width: 390px !important;
    margin-top: var(--section-heading-copy-gap) !important;
    font-size: 16px;
    line-height: 1.62 !important;
  }
  @media (max-width: 560px) {
    :global(body.competitor-reference-page main > section:nth-of-type(4) h2) {
      font-size: clamp(28px, 8vw, 40px) !important;
      line-height: .98 !important;
      letter-spacing: -.055em !important;
      hyphens: none !important;
    }
  }
</style>
