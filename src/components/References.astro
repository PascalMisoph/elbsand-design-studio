---
interface Project {
  name: string;
  category: string;
  description: string;
  url: string;
  image: string;
  mobileImage?: string;
  imageAlt: string;
}
interface Props {
  eyebrow: string;
  title: string;
  featured: Project;
  projects: readonly Project[];
  linkLabel: string;
}
const { eyebrow, title, featured, projects, linkLabel } = Astro.props;
---
<section class="section-shell references" id="projekte">
  <header class="reference-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </header>

  <article class="featured-project">
    <a class="featured-art" href={featured.url ?? undefined} target="_blank" rel="noreferrer" aria-label={`${featured.name}: ${linkLabel}`}>
      <picture>
        {featured.mobileImage && <source media="(max-width: 640px)" srcset={featured.mobileImage} />}
        <img src={featured.image} alt={featured.imageAlt} width="2880" height="1024" loading="lazy" decoding="async" />
      </picture>
      <span class="project-index">1</span>
    </a>
    <div class="featured-copy">
      <div>
        <h3>{featured.name}</h3>
        <p class="project-category">{featured.category}</p>
      </div>
      <p>{featured.description}</p>
      {featured.url && <a class="project-link" href={featured.url} target="_blank" rel="noreferrer">{linkLabel}<span aria-hidden="true">↗</span></a>}
    </div>
  </article>

  <div class="project-row">
    {projects.map((project, index) => (
      <article class="project-card">
        <a class="project-art" href={project.url} target="_blank" rel="noreferrer" aria-label={`${project.name}: ${linkLabel}`}>
          <img src={project.image} alt={project.imageAlt} width="1440" height="900" loading="lazy" decoding="async" />
          <span>{index + 2}</span>
          <b class="project-art-link" aria-hidden="true">↗</b>
        </a>
        <div class="project-copy">
          <h3>{project.name}</h3>
          <p class="project-category">{project.category}</p>
          <p>{project.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
