---
import type { Locale } from "../content/site";
import { ChevronDown } from "lucide-react";

interface Props {
  lang: Locale;
  nav: readonly string[];
  cta: string;
  page?: "home" | "geo" | "service";
  alternateDePath?: string;
  alternateEnPath?: string;
  primaryHref?: string;
  revenueOffer?: "geo_audit" | "page_sprint";
}

const { lang, cta, page = "home", alternateDePath, alternateEnPath, primaryHref, revenueOffer } = Astro.props;
const de = lang === "de";
const homePath = de ? "/" : "/en/";
const local = (dePath: string, enPath: string) => de ? dePath : enPath;
const homeLink = (anchor: string) => `${homePath}${anchor}`;
// The free technical check stays reachable under Resources; the header button carries the paid path.
const checkHref = homeLink("#ki-check");
const ctaHref = homeLink("#kontakt");
const languagePaths = alternateDePath && alternateEnPath
  ? { de: alternateDePath, en: alternateEnPath }
  : page === "geo"
    ? { de: "/geo-optimierung/", en: "/en/geo-optimization/" }
    : { de: "/", en: "/en/" };

const services = {
  label: de ? "Leistungen" : "Services",
  feature: {
    eyebrow: de ? "Leistungsübersicht" : "Service overview",
    title: de ? "GEO & KI-Sichtbarkeit" : "GEO & AI visibility",
    text: de ? "Von der ersten Diagnose bis zur laufenden Weiterentwicklung." : "From the first diagnosis to ongoing improvement.",
    href: local("/geo-optimierung/", "/en/geo-optimization/"),
  },
  groups: de ? [
    { label: "Audit & Analyse", items: [["Prompt Recherche", "/prompt-recherche/"]] },
    { label: "KI-Sichtbarkeit", items: [["KI-Sichtbarkeit", "/ai-sichtbarkeit/"], ["KI-Quellenanalyse", "/ki-quellenanalyse/"], ["KI-Wettbewerbsanalyse", "/ki-wettbewerbsanalyse/"], ["KI Markenwahrnehmung", "/ki-markenwahrnehmung/"], ["KI-Faktencheck", "/ki-faktencheck/"]] },
    { label: "Technik & Content", items: [["KI-Crawlability", "/ai-crawlability/"], ["Technische GEO Optimierung", "/technische-geo-optimierung/"], ["GEO Content", "/geo-content/"], ["Content-Optimierung für KI-Suche", "/content-optimierung-ai-suche/"]] },
    { label: "Begleitung & Agentur", items: [["GEO Audit", "/geo-audit/"], ["GEO Monitoring", "/geo-monitoring/"], ["GEO Betreuung", "/seo-betreuung/"]] },
  ] : [
    { label: "Audits & analysis", items: [["Prompt research", "/en/prompt-research/"]] },
    { label: "AI visibility", items: [["AI visibility", "/en/ai-visibility/"], ["AI source analysis", "/en/ai-source-analysis/"], ["AI competitor analysis", "/en/ai-competitor-analysis/"], ["AI brand perception", "/en/ai-brand-perception/"], ["AI fact checking", "/en/ai-fact-checking/"]] },
    { label: "Technical & content", items: [["AI crawlability", "/en/ai-crawlability/"], ["Technical GEO optimisation", "/en/technical-geo-optimization/"], ["GEO content", "/en/geo-content/"], ["Content optimisation for AI search", "/en/content-optimization-ai-search/"]] },
    { label: "Support & agency", items: [["GEO audit", "/en/geo-audit/"], ["GEO monitoring", "/en/geo-monitoring/"], ["GEO support", "/en/seo-support/"]] },
  ],
};

const resources = {
  label: de ? "Ressourcen" : "Resources",
  feature: {
    eyebrow: de ? "Kostenfreier Einstieg" : "Free starting point",
    title: de ? "KI-Website-Check" : "AI website check",
    text: de ? "Eine kompakte technische Einordnung Ihrer Website." : "A compact technical assessment of your website.",
    href: checkHref,
  },
  groups: de ? [
    { label: "Analysieren", items: [["Kostenfreier KI-Check", checkHref], ["GEO Audit", "/geo-audit/"], ["DAX-40-Crawler-Studie", "/research/ki-crawler-readiness-dax-40-2026/"]] },
    { label: "Verstehen", items: [["GEO-Grundlagen", "/geo-optimierung/"], ["KI-Crawler & robots.txt", "/wissen/ki-crawler-robots-txt/"], ["KI-Crawlability", "/ai-crawlability/"]] },
    { label: "Weiterarbeiten", items: [["GEO Content", "/geo-content/"], ["Content-Optimierung", "/content-optimierung-ai-suche/"], ["GEO-Monitoring", "/geo-monitoring/"]] },
  ] : [
    { label: "Analyse", items: [["Free AI check", checkHref], ["GEO audit", "/en/geo-audit/"], ["DAX 40 crawler study", "/en/research/dax-40-ai-crawler-readiness-2026/"]] },
    { label: "Understand", items: [["GEO foundations", "/en/geo-optimization/"], ["AI crawlers & robots.txt", "/en/knowledge/ai-crawlers-robots-txt/"], ["AI crawlability", "/en/ai-crawlability/"]] },
    { label: "Improve", items: [["GEO content", "/en/geo-content/"], ["Content optimisation", "/en/content-optimization-ai-search/"], ["GEO monitoring", "/en/geo-monitoring/"]] },
  ],
};

const solutions = {
  label: de ? "Lösungen" : "Solutions",
  feature: {
    eyebrow: de ? "Passender Einstieg" : "Choose your starting point",
    title: de ? "Was soll sich verbessern?" : "What needs to improve?",
    text: de ? "Starten Sie mit Ihrem konkreten Ziel statt mit einem Fachbegriff." : "Start with your concrete goal instead of a technical term.",
    href: "#kontakt",
  },
  groups: de ? [
    { label: "Website", items: [["Bestehende Seiten verbessern", "/content-optimierung-ai-suche/"], ["SEO in Dresden verbessern", "/seo-dresden/"], ["Neue Website entwickeln", homeLink("#leistungen")], ["Referenzen ansehen", homeLink("#projekte")]] },
    { label: "Sichtbarkeit", items: [["In KI-Antworten sichtbar werden", "/ai-sichtbarkeit/"], ["Quellen und Nennungen verstehen", "/ki-quellenanalyse/"], ["Wettbewerb einordnen", "/ki-wettbewerbsanalyse/"]] },
    { label: "Zusammenarbeit", items: [["Mit einem Audit starten", "/geo-audit/"], ["Content aufbauen", "/geo-content/"], ["Laufende SEO- und GEO-Betreuung", "/seo-betreuung/"]] },
  ] : [
    { label: "Website", items: [["Improve existing pages", "/en/content-optimization-ai-search/"], ["Improve SEO in Dresden", "/en/seo-agency-dresden/"], ["Build a new website", homeLink("#leistungen")], ["View selected work", homeLink("#projekte")]] },
    { label: "Visibility", items: [["Become visible in AI answers", "/en/ai-visibility/"], ["Understand sources and mentions", "/en/ai-source-analysis/"], ["Benchmark competitors", "/en/ai-competitor-analysis/"]] },
    { label: "Collaboration", items: [["Start with an audit", "/en/geo-audit/"], ["Build content", "/en/geo-content/"], ["Ongoing SEO and GEO support", "/en/seo-support/"]] },
  ],
};

const directLinks = de ? [
  ["Referenzen", homeLink("#projekte")],
  ["Ablauf", homeLink("#ablauf")],
  ["Kontakt", "#kontakt"],
] : [
  ["Work", homeLink("#projekte")],
  ["Process", homeLink("#ablauf")],
  ["Contact", "#kontakt"],
];
const navigationItems = [
  { kind: "menu" as const, menu: services, menuIndex: 0 },
  { kind: "menu" as const, menu: solutions, menuIndex: 2 },
  { kind: "link" as const, label: directLinks[0][0], href: directLinks[0][1] },
  { kind: "link" as const, label: directLinks[1][0], href: directLinks[1][1] },
  { kind: "menu" as const, menu: resources, menuIndex: 1 },
  { kind: "link" as const, label: directLinks[2][0], href: directLinks[2][1] },
];
const menuLabel = de ? "Menü" : "Menu";
---

<header class="site-header" data-site-header data-nosnippet>
  <a class="wordmark" href={homePath} aria-label="Paternoga SEO & GEO Agentur home">
    <span class="wordmark-brand">PATERNOGA</span>
    <span class="wordmark-descriptor">SEO &amp; GEO AGENTUR</span>
  </a>

  <nav class="desktop-nav" aria-label={de ? "Hauptnavigation" : "Main navigation"}>
    {navigationItems.map((item, itemIndex) => item.kind === "menu" ? (
      <details class="header-menu" data-header-menu>
        <summary id={`header-menu-trigger-${lang}-${itemIndex}`} aria-controls={`header-menu-panel-${lang}-${itemIndex}`} aria-expanded="false">
          <span>{item.menu.label}</span>
          <ChevronDown aria-hidden="true" />
        </summary>
        <div id={`header-menu-panel-${lang}-${itemIndex}`} class:list={["header-mega-panel", `header-mega-${item.menuIndex + 1}`]}>
          <div class="header-mega-inner">
            <a class="header-mega-feature" href={item.menu.feature.href}>
              <span class="header-mega-feature-eyebrow">{item.menu.feature.eyebrow}</span>
              <span class="header-mega-feature-title">{item.menu.feature.title}</span>
              <p>{item.menu.feature.text}</p>
              <i aria-hidden="true">↗</i>
            </a>
            <div class="header-mega-groups">
              {item.menu.groups.map((group) => (
                <section>
                  <p class="header-nav-group-label">{group.label}</p>
                  <div>{group.items.map(([label, href]) => <a href={href}>{label}</a>)}</div>
                </section>
              ))}
            </div>
          </div>
        </div>
      </details>
    ) : (
      <a class="header-direct-link" href={item.href}>{item.label}</a>
    ))}
  </nav>

  <div class="header-actions">
    <nav class="language-switch" aria-label={de ? "Sprachauswahl" : "Language selection"}>
      <a href={languagePaths.de} hreflang="de" lang="de" aria-current={de ? "page" : undefined} data-astro-prefetch="viewport">DE</a>
      <a href={languagePaths.en} hreflang="en" lang="en" aria-current={!de ? "page" : undefined} data-astro-prefetch="viewport">EN</a>
    </nav>
    <a class="button button-small" href={primaryHref ?? ctaHref} data-revenue-cta={revenueOffer ? "header_desktop" : undefined} data-offer={revenueOffer}>{cta}</a>
    <details class="mobile-menu" data-mobile-menu>
      <summary id={`mobile-menu-trigger-${lang}`} aria-controls={`mobile-menu-panel-${lang}`} aria-expanded="false" aria-label={menuLabel}><span></span><span></span></summary>
      <nav id={`mobile-menu-panel-${lang}`} aria-label={de ? "Mobile Navigation" : "Mobile navigation"}>
        {navigationItems.map((item, itemIndex) => item.kind === "menu" ? (
          <details class="mobile-nav-group">
            <summary id={`mobile-menu-group-trigger-${lang}-${itemIndex}`} aria-controls={`mobile-menu-group-panel-${lang}-${itemIndex}`} aria-expanded="false">{item.menu.label}<span aria-hidden="true">⌄</span></summary>
            <div id={`mobile-menu-group-panel-${lang}-${itemIndex}`}>
              <a class="mobile-feature-link" href={item.menu.feature.href}>{item.menu.feature.title}</a>
              {item.menu.groups.map((group) => (
                <section>
                  <p class="header-nav-group-label">{group.label}</p>
                  {group.items.map(([label, href]) => <a href={href}>{label}</a>)}
                </section>
              ))}
            </div>
          </details>
        ) : (
          <a class="mobile-direct-link" href={item.href}>{item.label}</a>
        ))}
        <a class="button" href={primaryHref ?? ctaHref} data-revenue-cta={revenueOffer ? "header_mobile" : undefined} data-offer={revenueOffer}>{cta}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const focusableSelector = "a[href], button:not([disabled]), summary, input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex='-1'])";
  const isVisibleFocusable = (element: HTMLElement) => !element.closest("[hidden]") && element.getClientRects().length > 0;
  const getFocusable = (root: ParentNode) => [...root.querySelectorAll<HTMLElement>(focusableSelector)].filter(isVisibleFocusable);

  const headers = document.querySelectorAll<HTMLElement>("[data-site-header]");
  headers.forEach((header) => {
    const menus = [...header.querySelectorAll<HTMLDetailsElement>("[data-header-menu]")];
    const mobileMenu = header.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
    const mobileTrigger = mobileMenu?.querySelector<HTMLElement>(":scope > summary");
    const mobileNav = mobileMenu?.querySelector<HTMLElement>(":scope > nav");
    const mobileGroups = mobileMenu ? [...mobileMenu.querySelectorAll<HTMLDetailsElement>(".mobile-nav-group")] : [];
    const backgroundTargets = [
      document.querySelector<HTMLElement>("main#main-content"),
      document.querySelector<HTMLElement>(".site-footer"),
    ].filter((element): element is HTMLElement => element !== null);

    const syncExpanded = (details: HTMLDetailsElement) => {
      details.querySelector<HTMLElement>(":scope > summary")?.setAttribute("aria-expanded", String(details.open));
    };
    const setBackgroundInert = (inert: boolean) => backgroundTargets.forEach((element) => element.toggleAttribute("inert", inert));
    const closeDesktopMenu = (menu: HTMLDetailsElement, returnFocus = false) => {
      const wasOpen = menu.open;
      menu.open = false;
      syncExpanded(menu);
      if (returnFocus && wasOpen) menu.querySelector<HTMLElement>(":scope > summary")?.focus({ preventScroll: true });
    };
    const closeMobileGroup = (group: HTMLDetailsElement, returnFocus = false) => {
      const wasOpen = group.open;
      group.open = false;
      syncExpanded(group);
      if (returnFocus && wasOpen) group.querySelector<HTMLElement>(":scope > summary")?.focus({ preventScroll: true });
    };
    const closeMobileMenu = (returnFocus = false) => {
      if (!mobileMenu) return;
      mobileGroups.forEach((group) => closeMobileGroup(group));
      const wasOpen = mobileMenu.open;
      mobileMenu.open = false;
      syncExpanded(mobileMenu);
      document.documentElement.classList.remove("mobile-nav-open");
      setBackgroundInert(false);
      if (returnFocus && wasOpen) mobileTrigger?.focus({ preventScroll: true });
    };

    menus.forEach((menu) => {
      syncExpanded(menu);
      menu.addEventListener("toggle", () => {
        syncExpanded(menu);
        if (menu.open) menus.forEach((other) => { if (other !== menu) closeDesktopMenu(other); });
      });
    });
    mobileGroups.forEach((group) => {
      syncExpanded(group);
      group.addEventListener("toggle", () => syncExpanded(group));
    });
    mobileMenu?.addEventListener("toggle", () => {
      syncExpanded(mobileMenu);
      document.documentElement.classList.toggle("mobile-nav-open", mobileMenu.open);
      setBackgroundInert(mobileMenu.open);
      if (mobileMenu.open) {
        menus.forEach((menu) => closeDesktopMenu(menu));
        requestAnimationFrame(() => getFocusable(mobileNav ?? mobileMenu).find((element) => element !== mobileTrigger)?.focus({ preventScroll: true }));
      }
    });
    mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      closeMobileMenu();
    }));
    document.addEventListener("keydown", (event) => {
      if (mobileMenu?.open && event.key === "Tab") {
        const focusable = getFocusable(mobileNav ?? mobileMenu).filter((element) => element !== mobileTrigger);
        if (focusable.length === 0) {
          event.preventDefault();
          return;
        }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
      if (event.key !== "Escape") return;
      const openGroup = [...mobileGroups].reverse().find((group) => group.open && group.contains(document.activeElement));
      if (openGroup) {
        event.preventDefault();
        closeMobileGroup(openGroup, true);
        return;
      }
      if (mobileMenu?.open) {
        event.preventDefault();
        closeMobileMenu(true);
        return;
      }
      const activeMenu = menus.find((menu) => menu.open);
      if (activeMenu) {
        event.preventDefault();
        closeDesktopMenu(activeMenu, true);
      }
    });
    document.addEventListener("click", (event) => {
      if (!header.contains(event.target as Node)) {
        menus.forEach((menu) => closeDesktopMenu(menu));
        if (mobileMenu?.open) closeMobileMenu();
      }
    });
  });

  document.querySelectorAll<HTMLElement>(".language-switch").forEach((switcher) => {
    switcher.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (link.getAttribute("aria-current") === "page") {
          event.preventDefault();
          return;
        }
        switcher.querySelectorAll("a").forEach((item) => item.classList.remove("is-pending"));
        link.classList.add("is-pending");
        switcher.setAttribute("aria-busy", "true");
      });
    });
  });
</script>
