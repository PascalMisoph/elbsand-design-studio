---
import googleLogo from "@lobehub/icons-static-svg/icons/google-color.svg?url";
import openAiLogo from "@lobehub/icons-static-svg/icons/openai.svg?url";
import claudeLogo from "@lobehub/icons-static-svg/icons/claude-color.svg?url";
import perplexityLogo from "@lobehub/icons-static-svg/icons/perplexity-color.svg?url";
import { Braces, Building2, FileText } from "@lucide/astro";

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  leadTitle: string;
  leadBody: string;
  systems: readonly {
    name: string;
    detail: string;
    checksLabel: string;
    checks: readonly string[];
    evidence: string;
    sourcesLabel: string;
    sources: readonly (readonly [string, string])[];
  }[];
  systemsIntro: string;
  systemsLabel: string;
  note: string;
}

const { eyebrow, title, body, leadTitle, leadBody, systems, systemsIntro, systemsLabel, note } = Astro.props;
const icons = [FileText, Building2, Braces];
const isEnglish = Astro.url.pathname.startsWith("/en/");
const slideLabels = [leadTitle, ...systems.map((system) => system.name)];
const platforms = [
  { name: "Google", logo: googleLogo },
  { name: "ChatGPT", logo: openAiLogo },
  { name: "Claude", logo: claudeLogo },
  { name: "Perplexity", logo: perplexityLogo },
];
---

<section class="geo-method-band" aria-labelledby="geo-method-title">
  <div class="geo-method section-shell">
    <header class="geo-method-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="geo-method-title">{title}</h2>
      <p>{body}</p>
    </header>

    <div class="geo-method-carousel" data-geo-method-carousel>
      <div class="geo-method-carousel-controls">
        <div class="geo-method-dots" aria-label={isEnglish ? "Select topic" : "Thema auswählen"}>
          {slideLabels.map((label, index) => (
            <button
              type="button"
              class:list={["geo-method-dot", { "is-active": index === 0 }]}
              aria-label={`${label} ${isEnglish ? "show" : "anzeigen"}`}
              aria-current={index === 0 ? "true" : undefined}
              data-geo-method-dot={index}
            ><span></span></button>
          ))}
        </div>
        <div class="geo-method-arrows">
          <button type="button" aria-label={isEnglish ? "Previous topic" : "Vorheriges Thema"} data-geo-method-prev disabled>←</button>
          <button type="button" aria-label={isEnglish ? "Next topic" : "Nächstes Thema"} data-geo-method-next>→</button>
        </div>
      </div>

      <div class="geo-method-track" data-geo-method-track tabindex="0" aria-label={isEnglish ? "GEO topics" : "GEO-Themen"}>
        <article class="geo-method-lead-card geo-method-slide">
          <img src="/images/geo-visibility-stock.webp" alt="" width="1400" height="2100" loading="lazy" decoding="async" />
          <h3>{leadTitle}</h3>
          <p>{leadBody}</p>
        </article>

        {systems.map((system, index) => {
          const Icon = icons[index];
          return (
            <article class="geo-method-signal-card geo-method-slide">
              <div class="geo-method-signal-main">
                <div class="geo-method-signal-heading">
                  <Icon aria-hidden="true" />
                  <h3>{system.name}</h3>
                </div>
                <p class="geo-method-signal-intro">{system.detail}</p>
              </div>
              <div class="geo-method-signal-detail">
                <div class="geo-method-checks">
                  <h4>{system.checksLabel}</h4>
                  <ul>
                    {system.checks.map((check) => <li>{check}</li>)}
                  </ul>
                </div>
                <p class="geo-method-evidence">{system.evidence}</p>
                <footer class="geo-method-sources">
                  <span>{system.sourcesLabel}</span>
                  <ul>
                    {system.sources.map(([label, href]) => (
                      <li><a href={href} target="_blank" rel="noreferrer">{label}<span aria-hidden="true">↗</span></a></li>
                    ))}
                  </ul>
                </footer>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div class="geo-platform-strip" aria-label={systemsLabel}>
      <p>{systemsIntro}</p>
      <ul>
        {platforms.map((platform) => (
          <li><img src={platform.logo} alt="" width="26" height="26" loading="lazy" /><span>{platform.name}</span></li>
        ))}
      </ul>
    </div>

    <p class="geo-method-note">{note}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-geo-method-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-geo-method-track]");
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".geo-method-slide"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-geo-method-dot]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-geo-method-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-geo-method-next]");
    if (!track || slides.length === 0) return;

    let activeIndex = 0;
    let scrollFrame = 0;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const syncTrackHeight = () => {
      const activeSlide = slides[activeIndex];
      if (activeSlide) track.style.height = `${activeSlide.offsetHeight}px`;
    };

    const update = (index: number) => {
      activeIndex = Math.max(0, Math.min(index, slides.length - 1));
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === activeIndex;
        dot.classList.toggle("is-active", active);
        if (active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      if (previous) previous.disabled = activeIndex === 0;
      if (next) next.disabled = activeIndex === slides.length - 1;
      requestAnimationFrame(syncTrackHeight);
    };

    const goTo = (index: number) => {
      const targetIndex = Math.max(0, Math.min(index, slides.length - 1));
      track.scrollTo({ left: slides[targetIndex].offsetLeft, behavior: reducedMotion.matches ? "auto" : "smooth" });
      update(targetIndex);
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => goTo(index)));
    previous?.addEventListener("click", () => goTo(activeIndex - 1));
    next?.addEventListener("click", () => goTo(activeIndex + 1));
    track.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      goTo(activeIndex + (event.key === "ArrowRight" ? 1 : -1));
    });
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        const nearest = slides.reduce((best, slide, index) =>
          Math.abs(slide.offsetLeft - track.scrollLeft) < Math.abs(slides[best].offsetLeft - track.scrollLeft) ? index : best, 0);
        update(nearest);
      });
    }, { passive: true });
    window.addEventListener("resize", () => goTo(activeIndex), { passive: true });
    document.fonts?.ready.then(syncTrackHeight);
    update(0);
  });
</script>
