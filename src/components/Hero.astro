---
import googleLogo from "@lobehub/icons-static-svg/icons/google-color.svg?url";
import openAiLogo from "@lobehub/icons-static-svg/icons/openai.svg?url";
import claudeLogo from "@lobehub/icons-static-svg/icons/claude-color.svg?url";
import perplexityLogo from "@lobehub/icons-static-svg/icons/perplexity-color.svg?url";
import geminiLogo from "@lobehub/icons-static-svg/icons/gemini-color.svg?url";
import { LiquidChrome } from "./ui/liquid-chrome";

interface Props {
  eyebrow: string;
  title: readonly [string, string];
  body: string;
  imageAlt: string;
  cta: string;
  secondaryCta: string;
}

const { eyebrow, title, body, imageAlt, cta, secondaryCta } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en/");
const videoPath = isEnglish ? "/video/paternoga-search-shift-en.mp4" : "/video/paternoga-search-shift-de.mp4";
const posterPath = isEnglish ? "/video/paternoga-search-shift-poster-en.png" : "/video/paternoga-search-shift-poster-de.png";
const systems = [
  { name: "ChatGPT", logo: openAiLogo, inverse: true },
  { name: "Claude", logo: claudeLogo },
  { name: "Perplexity", logo: perplexityLogo },
  { name: "Gemini", logo: geminiLogo },
  { name: "Google AI", logo: googleLogo }
];
---

<section class:list={["hero", "section-shell", { "hero--en": isEnglish }]}>
  <div class="hero-liquid-chrome" aria-hidden="true">
    <LiquidChrome baseColor={[0.18, 0.075, 0.03]} speed={0.32} amplitude={0.52} interactive={false} client:load />
  </div>
  <div class="hero-liquid-overlay" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-trust-badge">{eyebrow}</p>
      <h1>{title.map((line) => <span>{line}</span>)}</h1>
      <p class="lead">{body}</p>
      <div class="cta-row">
        <a class="button" href="#ki-check">{cta}</a>
        <a class="hero-secondary-cta" href="#projekte">{secondaryCta}<span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div
      class="hero-system"
      data-system-rotator
      data-systems={JSON.stringify(systems)}
    >
      <p>{isEnglish ? "Built to be understood by" : "Gemacht für Sichtbarkeit in"}</p>
      <div class="hero-system-window" aria-hidden="true">
        <span class="hero-system-value" data-system-value>
          <img class="is-inverted" src={systems[0].logo} alt="" width="72" height="72" />
          <strong>{systems[0].name}</strong>
        </span>
      </div>
      <span class="sr-only">
        {isEnglish ? "Relevant systems:" : "Relevante Systeme:"} {systems.map(({ name }) => name).join(", ")}
      </span>
    </div>

    <figure class="hero-media">
      <video
        data-landing-video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={posterPath}
        aria-label={imageAlt}
      >
        <source src={videoPath} type="video/mp4" />
      </video>
    </figure>
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLVideoElement>("[data-landing-video]").forEach((video) => {
    const applyPreference = () => {
      if (reducedMotion.matches) {
        video.pause();
        video.currentTime = 0;
      } else {
        void video.play().catch(() => undefined);
      }
    };

    applyPreference();
    reducedMotion.addEventListener("change", applyPreference);
  });

  document.querySelectorAll<HTMLElement>("[data-system-rotator]").forEach((rotator) => {
    const value = rotator.querySelector<HTMLElement>("[data-system-value]");
    const rawSystems = rotator.dataset.systems;
    if (!value || !rawSystems) return;

    const systems = JSON.parse(rawSystems) as Array<{ name: string; logo: string; inverse?: boolean }>;
    let activeIndex = 0;
    let timer: number | undefined;

    const systemMarkup = (system: { name: string; logo: string; inverse?: boolean }) =>
      `<img class="${system.inverse ? "is-inverted" : ""}" src="${system.logo}" alt="" width="72" height="72"><strong>${system.name}</strong>`;

    const renderSystem = (system: { name: string; logo: string; inverse?: boolean }) => {
      if (reducedMotion.matches) {
        value.innerHTML = systemMarkup(system);
        return;
      }
      value.classList.add("is-leaving");
      window.setTimeout(() => {
        value.innerHTML = systemMarkup(system);
        value.classList.remove("is-leaving");
        value.classList.add("is-entering");
        requestAnimationFrame(() => value.classList.remove("is-entering"));
      }, 230);
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (document.hidden) return;
      timer = window.setInterval(() => {
        activeIndex = (activeIndex + 1) % systems.length;
        renderSystem(systems[activeIndex]);
      }, reducedMotion.matches ? 3000 : 1900);
    };

    document.addEventListener("visibilitychange", start);
    reducedMotion.addEventListener("change", start);
    start();
  });
</script>
