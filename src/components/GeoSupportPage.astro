---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";

interface Props { lang: "de" | "en" }
const { lang } = Astro.props;
const de = lang === "de";
const siteContent = content[lang];
const homePath = de ? "/" : "/en/";
const path = de ? "/geo-betreuung/" : "/en/geo-support/";
const t = de ? {
  eyebrow: "GEO-Betreuung",
  title: "Deine AI-Sichtbarkeit bleibt in Bewegung.",
  lead: "ELBSAND begleitet dich nach dem ersten Audit: mit klaren Prioritäten, regelmäßigen Checks und einer festen Ansprechperson für die technische und inhaltliche Weiterentwicklung.",
  cta: "Betreuung besprechen", second: "Arbeitsweise ansehen", home: "Start", hub: "GEO-Optimierung", parent: "GEO-Betreuung",
  band: "Betreuung für lokale Unternehmen, die sichtbar bleiben wollen",
  featureIntro: "Drei Dinge, die im Alltag zählen",
  features: [["Orientierung", "Wissen, was jetzt zählt", "Befunde werden nicht zu einer langen Liste. Wir ordnen sie nach Relevanz, Aufwand und dem nächsten sinnvollen Schritt."], ["Kontinuität", "Veränderung im Blick behalten", "Antworten, Quellen und technische Zugänge verändern sich. Wir prüfen regelmäßig, was sich tatsächlich verschoben hat."], ["Verantwortung", "Eine Person, ein klarer Faden", "Pascal bleibt dein Ansprechpartner – von der Einordnung bis zur Umsetzung und dem nächsten Review."]],
  workspaceEyebrow: "Illustrativer Betreuungs-Workspace", workspaceTitle: "Aus Beobachtung wird eine nächste Entscheidung.", workspaceNote: "Illustratives Beispiel – keine Kundenanalyse und keine echten Messwerte.", tabs: ["AI-Sichtbarkeit", "Prompt-Recherche", "Crawlability", "Content"],
  workspaceLabels: ["Aktuelle Beobachtung", "Nächste Aktion", "Verantwortlich"], workspaceData: [
    ["Antworten", "Eine Kernfrage wird häufiger ohne deine Seite beantwortet.", "Prompt prüfen", "Pascal"],
    ["Fragen", "Zwei wiederkehrende Fragen verdienen eine eigene, klare Antwort.", "Thema priorisieren", "Pascal"],
    ["Zugriff", "Eine wichtige Seite antwortet langsam auf einen geprüften Bot-Request.", "Serverpfad prüfen", "Pascal"],
    ["Inhalt", "Ein Abschnitt ist fachlich richtig, aber ohne Zeitbezug schwer einzuordnen.", "Refresh planen", "Pascal"]
  ],
  supportEyebrow: "So bleibt es handhabbar", supportTitle: "Betreuung ist ein Rhythmus, kein Dauerprojekt.", supportLead: "Du erhältst einen überschaubaren Arbeitsrahmen. Wir entscheiden gemeinsam, was beobachtet, verändert oder bewusst nicht angefasst wird.", supportRows: [["Check-in", "Ein kurzer Blick auf die relevanten Signale."], ["Priorisierung", "Eine Entscheidung statt zehn offene Aufgaben."], ["Umsetzung", "Konkrete Änderungen an Inhalt, Struktur oder Technik."], ["Review", "Prüfen, was sich nach der Änderung tatsächlich bewegt."]],
  methodTitle: "Direkter Kontakt statt Übergabe an ein Portal.", methodText: "Du sprichst mit Pascal über das, was sich auf deiner Website und in KI-Suchen verändert. Betreuung kann klein beginnen und wächst nur, wenn es für dein Unternehmen sinnvoll ist.", methodLabel: "ELBSAND / persönliche Betreuung", methodStatus: "im Austausch", methodPoints: ["Ein fester Ansprechpartner", "Ein gemeinsamer Prioritätenfaden", "Eine nachvollziehbare Änderungslogik"],
  closeEyebrow: "Nächster Schritt", closeTitle: "Lass uns den nächsten sinnvollen Schritt finden.", closeText: "Bring einen Befund, eine offene Frage oder einfach den Wunsch nach regelmäßiger Begleitung mit. Wir klären, welcher Betreuungsrahmen zu dir passt.", closeCta: "Betreuung besprechen",
  faqTitle: "Fragen zur GEO-Betreuung", faq: [["Ab wann ist laufende Betreuung sinnvoll?", "Wenn sich Inhalte, Angebote oder technische Grundlagen regelmäßig verändern oder du nicht jede Entwicklung selbst beobachten möchtest. Wir starten mit einem klaren Umfang statt mit einer offenen Daueraufgabe."], ["Muss ich monatlich ein großes Paket buchen?", "Nein. Der Rhythmus richtet sich nach deinem Bedarf. Möglich sind einzelne Reviews, regelmäßige Check-ins oder eine begleitete Umsetzung über einen vereinbarten Zeitraum."], ["Garantiert Betreuung eine Platzierung in ChatGPT oder Google?", "Nein. Keine externe Antwort- oder Suchplattform kann garantiert werden. Betreuung sorgt dafür, dass Befunde erkannt und technische sowie inhaltliche Grundlagen konsequent gepflegt werden."], ["Kann ich Änderungen selbst umsetzen?", "Ja. ELBSAND kann Empfehlungen, konkrete Änderungsbriefings oder die Umsetzung übernehmen. Zuständigkeiten werden vor jedem Schritt transparent geklärt."]]
} : {
  eyebrow: "GEO support", title: "Your AI visibility keeps moving.", lead: "ELBSAND stays with you after the first audit: with clear priorities, regular reviews and one direct contact for the technical and editorial work that follows.", cta: "Discuss ongoing support", second: "See how it works", home: "Home", hub: "GEO optimisation", parent: "GEO support", band: "Support for local businesses that want to stay visible", featureIntro: "Three things that matter in the day-to-day", features: [["Direction", "Know what matters now", "Findings do not become a long task list. We order them by relevance, effort and the next useful step."], ["Continuity", "Keep change in view", "Answers, sources and technical access change. We review what has actually shifted over time."], ["Responsibility", "One person, one thread", "Pascal remains your contact – from interpretation to implementation and the next review."]], workspaceEyebrow: "Illustrative support workspace", workspaceTitle: "Turn observation into the next decision.", workspaceNote: "Illustrative example – not a client analysis or measured result.", tabs: ["AI visibility", "Prompt research", "Crawlability", "Content"], workspaceLabels: ["Current observation", "Next action", "Owner"], workspaceData: [["Answers", "A core question is more often answered without your page.", "Review prompt", "Pascal"], ["Questions", "Two recurring questions deserve a clear page of their own.", "Prioritise topic", "Pascal"], ["Access", "An important page responds slowly to a reviewed bot request.", "Review server path", "Pascal"], ["Content", "A section is correct but hard to place without time context.", "Plan refresh", "Pascal"]], supportEyebrow: "Keep it workable", supportTitle: "Support is a rhythm, not a permanent project.", supportLead: "You receive a manageable working frame. Together we decide what to observe, change or deliberately leave alone.", supportRows: [["Check-in", "A short look at the signals that matter."], ["Prioritisation", "One decision instead of ten open tasks."], ["Implementation", "Concrete changes to content, structure or technology."], ["Review", "Check what actually moved after the change."]], methodTitle: "Direct contact instead of a portal hand-off.", methodText: "You speak with Pascal about what changes on your website and in AI search. Support can start small and only grows when it makes sense for your business.", methodLabel: "ELBSAND / personal support", methodStatus: "in conversation", methodPoints: ["One direct contact", "One shared priority thread", "One traceable change logic"], closeEyebrow: "Next step", closeTitle: "Find the next useful step together.", closeText: "Bring a finding, an open question or simply the wish for regular guidance. We will clarify which support frame fits your business.", closeCta: "Discuss ongoing support", faqTitle: "Questions about GEO support", faq: [["When does ongoing support make sense?", "When content, offers or technical foundations change regularly, or you do not want to monitor every development yourself. We start with a defined scope rather than an open-ended task."], ["Do I have to book a large monthly package?", "No. The rhythm follows your need. It can be a single review, regular check-ins or guided implementation over an agreed period."], ["Does support guarantee a placement in ChatGPT or Google?", "No. No external answer or search platform can be guaranteed. Support makes sure findings are noticed and technical and editorial foundations are consistently maintained."], ["Can I implement the changes myself?", "Yes. ELBSAND can provide recommendations, a concrete change brief or implementation. Ownership is made clear before each step."]]
};
const crumbs = [{ name: t.home, href: homePath }, { name: t.hub, href: de ? "/geo-optimierung/" : "/en/geo-optimization/" }, { name: t.parent, href: path }];
const schema = { "@context": "https://schema.org", "@graph": [{ "@type": "Service", name: t.eyebrow, description: t.lead, url: `https://elbsand.studio${path}`, provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio" } }, { "@type": "BreadcrumbList", itemListElement: crumbs.map((item, i) => ({ "@type": "ListItem", position: i + 1, name: item.name, item: `https://elbsand.studio${item.href}` })) }, { "@type": "FAQPage", mainEntity: t.faq.map((x) => ({ "@type": "Question", name: x[0], acceptedAnswer: { "@type": "Answer", text: x[1] } })) }] };
---
<BaseLayout title={`${t.eyebrow} | ELBSAND`} description={t.lead} lang={lang} canonicalPath={path} alternateDePath="/geo-betreuung/" alternateEnPath="/en/geo-support/" schema={schema} bodyClass="geo-support-page">
  <Header lang={lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath="/geo-betreuung/" alternateEnPath="/en/geo-support/" />
  <main id="main-content" class="support-main">
    <section class="support-hero support-shell"><nav class="support-crumbs" aria-label={de ? "Brotkrumen-Navigation" : "Breadcrumb"}>{crumbs.map((item, i) => <>{i > 0 && <span aria-hidden="true">/</span>}{i === crumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}</nav><div class="support-hero-copy"><p class="support-eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p>{t.lead}</p><div class="support-actions"><a class="button" href={`${homePath}#ki-check`}>{t.cta}</a><a class="support-secondary" href="#workspace">{t.second}<span aria-hidden="true">↓</span></a></div></div></section>
    <section class="support-band support-shell"><p>{t.band}</p><div class="band-rule" aria-hidden="true"></div><span>ELBSAND / DRESDEN</span></section>
    <section class="support-features support-shell"><header><p class="support-eyebrow">{t.featureIntro}</p></header><div class="feature-grid">{t.features.map((feature, i) => <article><div class="feature-visual" data-feature={i}><span>{i + 1}</span>{i === 0 && <div class="feature-rings"><i></i><b></b><em></em></div>}{i === 1 && <div class="feature-pulse"><i></i><i></i><i></i><b></b></div>}{i === 2 && <div class="feature-thread"><span></span><i></i><b></b><em></em></div>}</div><h2>{feature[0]}</h2><h3>{feature[1]}</h3><p>{feature[2]}</p></article>)}</div></section>
    <section class="support-workspace support-shell" id="workspace"><header class="workspace-heading"><p class="support-eyebrow">{t.workspaceEyebrow}</p><h2>{t.workspaceTitle}</h2><p>{t.workspaceNote}</p></header><div class="workspace-tabs" role="tablist" aria-label={de ? "Betreuungsbereiche" : "Support areas"}>{t.tabs.map((tab, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-support-tab={i}>{tab}</button>)}</div><div class="workspace-panel" data-workspace-panel><div class="workspace-panel-top"><span>ELBSAND / SUPPORT LOG</span><b><i></i><span data-workspace-state>{de ? "Priorität offen" : "Priority open"}</span></b></div><div class="workspace-panel-body"><div class="workspace-summary"><small>{t.workspaceLabels[0]}</small><strong data-workspace-title>{t.workspaceData[0][0]}</strong><p data-workspace-observation>{t.workspaceData[0][1]}</p></div><div class="workspace-actions"><div><small>{t.workspaceLabels[1]}</small><strong data-workspace-action>{t.workspaceData[0][2]}</strong></div><div><small>{t.workspaceLabels[2]}</small><strong data-workspace-owner>{t.workspaceData[0][3]}</strong></div></div><div class="workspace-trace"><span></span><i></i><b></b><em></em><small>{de ? "Beobachtung" : "Observation"}</small><small>{de ? "Einordnung" : "Interpretation"}</small><small>{de ? "Entscheidung" : "Decision"}</small><small>{de ? "Review" : "Review"}</small></div></div><div class="workspace-panel-foot"><span data-workspace-count>1 / 4</span><span>{t.workspaceNote}</span></div></div></section>
    <section class="support-method support-shell"><header><p class="support-eyebrow">{t.supportEyebrow}</p><h2>{t.supportTitle}</h2><p>{t.supportLead}</p></header><div class="support-rows">{t.supportRows.map((row, i) => <article><span>{i + 1}</span><h3>{row[0]}</h3><p>{row[1]}</p><i aria-hidden="true">↗</i></article>)}</div></section>
    <section class="support-contact support-shell"><div class="contact-frame"><div class="contact-top"><span>{t.methodLabel}</span><b><i></i>{t.methodStatus}</b></div><div class="contact-body"><div><p class="support-eyebrow">Pascal Misoph</p><h2>{t.methodTitle}</h2><p>{t.methodText}</p></div><ul>{t.methodPoints.map((point, i) => <li><span>{i + 1}</span><strong>{point}</strong></li>)}</ul></div></div></section>
    <section class="support-faq support-shell"><header><p class="support-eyebrow">FAQ</p><h2>{t.faqTitle}</h2></header><div>{t.faq.map((item) => <details><summary>{item[0]}<span aria-hidden="true">+</span></summary><p>{item[1]}</p></details>)}</div></section>
    <SubpageContact lang={lang} source="geo-support-service" />
  </main>
  <Footer {...siteContent.footer} lang={lang} />
</BaseLayout>
<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const panel = document.querySelector<HTMLElement>("[data-workspace-panel]");
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-support-tab]"));
  const data = [
    ["Antworten", "Eine Kernfrage wird häufiger ohne deine Seite beantwortet.", "Prompt prüfen", "Pascal"],
    ["Fragen", "Zwei wiederkehrende Fragen verdienen eine eigene, klare Antwort.", "Thema priorisieren", "Pascal"],
    ["Zugriff", "Eine wichtige Seite antwortet langsam auf einen geprüften Bot-Request.", "Serverpfad prüfen", "Pascal"],
    ["Inhalt", "Ein Abschnitt ist fachlich richtig, aber ohne Zeitbezug schwer einzuordnen.", "Refresh planen", "Pascal"]
  ];
  const copy = document.documentElement.lang === "en" ? [["Answers", "A core question is more often answered without your page.", "Review prompt", "Pascal"], ["Questions", "Two recurring questions deserve a clear page of their own.", "Prioritise topic", "Pascal"], ["Access", "An important page responds slowly to a reviewed bot request.", "Review server path", "Pascal"], ["Content", "A section is correct but hard to place without time context.", "Plan refresh", "Pascal"]] : data;
  const setTab = (i: number) => { const item = copy[i]; tabs.forEach((tab, n) => tab.setAttribute("aria-selected", String(n === i))); if (!panel) return; panel.dataset.active = String(i); panel.querySelector<HTMLElement>("[data-workspace-title]")!.textContent = item[0]; panel.querySelector<HTMLElement>("[data-workspace-observation]")!.textContent = item[1]; panel.querySelector<HTMLElement>("[data-workspace-action]")!.textContent = item[2]; panel.querySelector<HTMLElement>("[data-workspace-owner]")!.textContent = item[3]; panel.querySelector<HTMLElement>("[data-workspace-count]")!.textContent = `${i + 1} / 4`; panel.querySelector<HTMLElement>("[data-workspace-state]")!.textContent = document.documentElement.lang === "en" ? (i === 2 ? "Needs review" : "Priority open") : (i === 2 ? "Prüfung offen" : "Priorität offen"); };
  tabs.forEach((tab, i) => tab.addEventListener("click", () => setTab(i))); if (reduced.matches) setTab(0);
</script>
<style>
  :global(body.geo-support-page) { --s-bg:#0d0d0c; --s-surface:#161614; --s-surface-2:#1e1d1a; --s-text:#f7f3eb; --s-muted:#aaa59b; --s-line:rgba(247,243,235,.13); --s-accent:#b74622; --s-accent-soft:#e98764; background:var(--s-bg); color:var(--s-text); }
  :global(.geo-support-page .site-header),:global(.geo-support-page .site-footer) { border-color:var(--s-line); background:rgba(13,13,12,.94); color:var(--s-text); } :global(.geo-support-page .language-switch) { background:rgba(247,243,235,.06); } :global(.geo-support-page .language-switch a[aria-current="page"]) { background:rgba(247,243,235,.12); box-shadow:none; color:var(--s-text); } :global(.geo-support-page .mobile-menu nav) { background:var(--s-surface); }
  .support-main { overflow:hidden; } .support-shell { width:min(100%,calc(1056px + 40px)); margin-inline:auto; padding-inline:20px; } .support-hero { min-height:680px; padding-top:22px; border-left:1px solid rgba(247,243,235,.08); border-right:1px solid rgba(247,243,235,.08); } .support-crumbs { display:flex; flex-wrap:wrap; gap:9px; color:var(--s-muted); font-size:12px; } .support-crumbs a:hover { color:var(--s-text); } .support-hero-copy { max-width:760px; margin:130px auto 0; text-align:center; } .support-eyebrow { margin:0 0 17px; color:var(--s-accent-soft); font-size:11px; font-weight:720; letter-spacing:.14em; text-transform:uppercase; } .support-hero h1 { max-width:740px; margin:0 auto 22px; color:var(--s-text); font-family:var(--sans); font-size:clamp(53px,5.8vw,76px); font-weight:540; letter-spacing:-.06em; line-height:.97; text-wrap:balance; } .support-hero-copy > p:not(.support-eyebrow) { max-width:580px; margin:0 auto; color:var(--s-muted); font-size:17px; line-height:1.58; } .support-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:26px; } .support-secondary { display:inline-flex; min-height:48px; align-items:center; gap:14px; border:1px solid rgba(247,243,235,.3); border-radius:7px; padding:0 16px; font-size:14px; font-weight:620; } .support-secondary span { color:var(--s-accent-soft); font-size:18px; transition:transform 180ms ease; } .support-secondary:hover span { transform:translateY(3px); }
  .support-band { display:grid; grid-template-columns:1fr minmax(140px,.5fr) auto; min-height:114px; align-items:center; border:1px solid var(--s-line); border-left:0; border-right:0; gap:24px; } .support-band p { margin:0; color:var(--s-muted); font-size:13px; } .support-band span { color:var(--s-muted); font-size:10px; letter-spacing:.12em; } .band-rule { height:1px; background:var(--s-line); }
  .support-features { border-left:1px solid rgba(247,243,235,.08); border-right:1px solid rgba(247,243,235,.08); padding-top:108px; padding-bottom:120px; } .support-features > header { margin-bottom:45px; text-align:center; } .feature-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--s-line); border-bottom:1px solid var(--s-line); } .feature-grid article { min-height:420px; padding:0 25px 31px; } .feature-grid article + article { border-left:1px solid var(--s-line); } .feature-visual { position:relative; height:230px; border-bottom:1px solid var(--s-line); } .feature-visual > span { position:absolute; top:25px; left:0; display:grid; width:25px; height:25px; place-items:center; border:1px solid var(--s-line); border-radius:50%; color:var(--s-muted); font-size:11px; } .feature-rings { position:absolute; top:55px; left:50%; width:113px; height:113px; border:9px solid rgba(247,243,235,.1); border-radius:50%; transform:translateX(-50%); } .feature-rings::after { position:absolute; inset:-9px; border:9px solid transparent; border-top-color:var(--s-accent); border-right-color:#758f37; border-radius:50%; content:""; transform:rotate(-32deg); } .feature-rings i,.feature-rings b,.feature-rings em { position:absolute; z-index:2; display:block; border-radius:50%; background:var(--s-accent-soft); } .feature-rings i { top:-15px; right:18px; width:9px; height:9px; } .feature-rings b { bottom:-12px; left:14px; width:6px; height:6px; opacity:.7; } .feature-rings em { right:-19px; bottom:20px; width:7px; height:7px; opacity:.42; } .feature-pulse { position:absolute; top:70px; left:50%; display:flex; width:150px; height:88px; align-items:center; justify-content:space-between; transform:translateX(-50%); } .feature-pulse i { width:8px; height:8px; border-radius:50%; background:var(--s-accent-soft); box-shadow:0 0 0 8px rgba(183,70,34,.1); animation:support-pulse 2.4s ease-in-out infinite alternate; } .feature-pulse i:nth-child(2) { animation-delay:.4s