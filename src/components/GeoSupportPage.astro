---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import FeatureCardGrid from "./FeatureCardGrid";
import IconFeaturePanel from "./IconFeaturePanel";
import LinkButton from "./LinkButton";
import SupportWorkspace from "./SupportWorkspace";
import { content } from "../content/site";
import { geoSupportPages } from "../content/service-pages/research-support";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const isGerman = lang === "de";
const siteContent = content[lang];
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? "/geo-betreuung/" : "/en/geo-support/";
const meta = geoSupportPages[lang].meta;

const t = isGerman ? {
  eyebrow: "GEO-Betreuung",
  title: "Deine AI-Sichtbarkeit bleibt in Bewegung",
  lead: "PATERNOGA begleitet dich nach dem ersten Audit: mit klaren Prioritäten, regelmäßigen Checks und einer festen Ansprechperson für die technische und inhaltliche Weiterentwicklung.",
  cta: "Betreuung besprechen",
  second: "Arbeitsweise ansehen",
  home: "Start",
  hub: "GEO-Optimierung",
  featureIntro: "Drei Dinge, die im Alltag zählen",
  features: [
    { title: "Wissen, was jetzt zählt", text: "Befunde werden nach Relevanz, Aufwand und dem nächsten sinnvollen Schritt geordnet." },
    { title: "Veränderung im Blick behalten", text: "Antworten, Quellen und technische Zugänge werden regelmäßig auf echte Verschiebungen geprüft." },
    { title: "Eine Person, ein klarer Faden", text: "Pascal bleibt dein Ansprechpartner – von der Einordnung bis zur Umsetzung und dem nächsten Review." },
  ],
  workspaceEyebrow: "Illustrativer Betreuungs-Workspace",
  workspaceTitle: "Aus Beobachtung wird eine nächste Entscheidung",
  workspaceNote: "Illustratives Beispiel – keine Kundenanalyse und keine echten Messwerte.",
  tabs: ["AI-Sichtbarkeit", "Prompt-Recherche", "Crawlability", "Content"],
  workspaceLabels: ["Aktuelle Beobachtung", "Nächste Aktion", "Verantwortlich"] as const,
  workspaceData: [
    ["Antworten", "Eine Kernfrage wird häufiger ohne deine Seite beantwortet.", "Prompt prüfen", "Pascal"],
    ["Fragen", "Zwei wiederkehrende Fragen verdienen eine eigene, klare Antwort.", "Thema priorisieren", "Pascal"],
    ["Zugriff", "Eine wichtige Seite antwortet langsam auf einen geprüften Bot-Request.", "Serverpfad prüfen", "Pascal"],
    ["Inhalt", "Ein Abschnitt ist fachlich richtig, aber ohne Zeitbezug schwer einzuordnen.", "Refresh planen", "Pascal"],
  ] as const,
  supportTitle: "Betreuung ist ein Rhythmus, kein Dauerprojekt",
  supportLead: "Du erhältst einen überschaubaren Arbeitsrahmen. Gemeinsam wird entschieden, was beobachtet, verändert oder bewusst nicht angefasst wird.",
  supportRows: [
    { title: "Check-in", text: "Ein kurzer Blick auf die relevanten Signale." },
    { title: "Priorisierung", text: "Eine Entscheidung statt zehn offene Aufgaben." },
    { title: "Umsetzung", text: "Konkrete Änderungen an Inhalt, Struktur oder Technik." },
    { title: "Review", text: "Prüfen, was sich nach der Änderung tatsächlich bewegt." },
  ],
  methodTitle: "Direkter Kontakt statt Übergabe an ein Portal",
  methodText: "Du sprichst mit Pascal über das, was sich auf deiner Website und in KI-Suchen verändert. Betreuung kann klein beginnen und wächst nur, wenn es für dein Unternehmen sinnvoll ist.",
  methodPoints: ["Ein fester Ansprechpartner", "Ein gemeinsamer Prioritätenfaden", "Eine nachvollziehbare Änderungslogik"],
  faqTitle: "Fragen zur GEO-Betreuung",
  faq: [
    ["Ab wann ist laufende Betreuung sinnvoll?", "Wenn sich Inhalte, Angebote oder technische Grundlagen regelmäßig verändern oder du nicht jede Entwicklung selbst beobachten möchtest."],
    ["Muss ich monatlich ein großes Paket buchen?", "Nein. Der Rhythmus richtet sich nach deinem Bedarf: einzelne Reviews, regelmäßige Check-ins oder begleitete Umsetzung."],
    ["Garantiert Betreuung eine Platzierung?", "Nein. Keine externe Antwort- oder Suchplattform kann garantiert werden. Betreuung pflegt technische und inhaltliche Grundlagen konsequent."],
    ["Kann ich Änderungen selbst umsetzen?", "Ja. PATERNOGA kann Empfehlungen, konkrete Briefings oder die Umsetzung übernehmen. Zuständigkeiten werden transparent geklärt."],
    ["Was brauchen wir für den Start und was erhältst du?", "Wir klären gemeinsam die wichtigsten Angebote, Seiten, Fragen und bereits vorhandenen Daten oder Befunde. Du erhältst einen vereinbarten Arbeitsrhythmus, eine priorisierte Aufgabenliste und eine nachvollziehbare Einordnung der Veränderungen. Fachliche Freigaben bleiben bei dir; PATERNOGA übernimmt Beobachtung, Vorbereitung und auf Wunsch die vereinbarte Umsetzung."],
  ],
} : {
  eyebrow: "GEO Support",
  title: "Your AI visibility keeps moving",
  lead: "PATERNOGA stays with you after the first audit: with clear priorities, regular reviews and one direct contact for the technical and editorial work that follows.",
  cta: "Discuss ongoing support",
  second: "See how it works",
  home: "Home",
  hub: "GEO Optimization",
  featureIntro: "Three things that matter day to day",
  features: [
    { title: "Know what matters now", text: "Findings are ordered by relevance, effort and the next useful step." },
    { title: "Keep change in view", text: "Answers, sources and technical access are reviewed for meaningful shifts." },
    { title: "One person, one thread", text: "Pascal remains your contact from interpretation through implementation and review." },
  ],
  workspaceEyebrow: "Illustrative support workspace",
  workspaceTitle: "Turn observation into the next decision",
  workspaceNote: "Illustrative example – not a client analysis or measured result.",
  tabs: ["AI visibility", "Prompt research", "Crawlability", "Content"],
  workspaceLabels: ["Current observation", "Next action", "Owner"] as const,
  workspaceData: [
    ["Answers", "A core question is more often answered without your page.", "Review prompt", "Pascal"],
    ["Questions", "Two recurring questions deserve a clear page of their own.", "Prioritise topic", "Pascal"],
    ["Access", "An important page responds slowly to a reviewed bot request.", "Review server path", "Pascal"],
    ["Content", "A section is correct but hard to place without time context.", "Plan refresh", "Pascal"],
  ] as const,
  supportTitle: "Support is a rhythm, not a permanent project",
  supportLead: "You receive a manageable working frame. Together we decide what to observe, change or deliberately leave alone.",
  supportRows: [
    { title: "Check-in", text: "A short look at the signals that matter." },
    { title: "Prioritisation", text: "One decision instead of ten open tasks." },
    { title: "Implementation", text: "Concrete changes to content, structure or technology." },
    { title: "Review", text: "Check what actually moved after the change." },
  ],
  methodTitle: "Direct contact instead of a portal hand-off",
  methodText: "You speak with Pascal about what changes on your website and in AI search. Support can start small and only grows when it makes sense.",
  methodPoints: ["One direct contact", "One shared priority thread", "One traceable change logic"],
  faqTitle: "Questions about GEO support",
  faq: [
    ["When does ongoing support make sense?", "When content, offers or technical foundations change regularly, or you do not want to monitor every development yourself."],
    ["Do I have to book a large monthly package?", "No. The rhythm follows your need: individual reviews, regular check-ins or guided implementation."],
    ["Does support guarantee a placement?", "No. No external answer or search platform can be guaranteed. Support maintains technical and editorial foundations consistently."],
    ["Can I implement changes myself?", "Yes. PATERNOGA can provide recommendations, concrete briefs or implementation. Ownership is clarified transparently."],
    ["What do we need to begin and what do I receive?", "Together we clarify the core offers, pages, questions and any existing data or findings. You receive an agreed working rhythm, a prioritised task list and a traceable interpretation of change. Subject-matter approval remains with you; PATERNOGA handles observation, preparation and, where agreed, implementation."],
  ],
};

const breadcrumbItems = [{ name: t.home, href: homePath }, { name: t.hub, href: isGerman ? "/geo-optimierung/" : "/en/geo-optimization/" }, { name: t.eyebrow, href: canonicalPath }];
const faqItems = t.faq.map(([question, answer]) => ({ question, answer }));
const methodItems = t.methodPoints.map((title) => ({ title, text: t.methodText }));
const schema = createServicePageSchema({ lang, title: meta.title, description: meta.description, path: canonicalPath, serviceName: t.eyebrow, breadcrumbs: breadcrumbItems, faqs: faqItems });
---

<BaseLayout title={meta.title} description={meta.description} lang={lang} canonicalPath={canonicalPath} alternateDePath="/geo-betreuung/" alternateEnPath="/en/geo-support/" schema={schema} bodyClass="geo-support-page ui-dark-page dark">
  <Header lang={lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath="/geo-betreuung/" alternateEnPath="/en/geo-support/" />
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}</nav><div class="max-w-3xl pt-12"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.eyebrow}</p><h1 class="m-0 mt-6 text-display-mobile font-medium text-foreground md:text-display">{t.title}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{t.lead}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={t.cta} icon="right" /><LinkButton href="#workspace" label={t.second} variant="secondary" icon="down" /></div></div><div class="mt-20"><FeatureCardGrid items={t.features} columns={3} /></div></div></section>
    <section id="workspace" class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="pb-12 lg:pb-20"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.workspaceEyebrow}</p><h2 class="m-0 mt-6 max-w-2xl text-section-title font-medium text-foreground">{t.workspaceTitle}</h2></header><SupportWorkspace tabs={t.tabs} data={t.workspaceData} labels={t.workspaceLabels} note={t.workspaceNote} client:load /></section>
    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><h2 class="m-0 text-section-title font-medium text-foreground">{t.supportTitle}</h2><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{t.supportLead}</p></header><FeatureCardGrid items={t.supportRows} columns={4} /></div></section>
    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-2 lg:py-section"><div><h2 class="m-0 text-section-title font-medium text-foreground">{t.methodTitle}</h2><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{t.methodText}</p></div><IconFeaturePanel items={methodItems} label={t.eyebrow} /></section>
    <section class="border-t border-solid border-border"><div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{t.faqTitle}</h2><FaqAccordion items={faqItems} theme="dark" className="lg:col-span-2" /></div></section>
    <SubpageContact lang={lang} source="geo-support-service" />
  </main>
  <Footer {...siteContent.footer} lang={lang} />
</BaseLayout>
