---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const siteContent = content[page.lang];
const isGerman = page.lang === "de";
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? page.alternateDePath : page.alternateEnPath;
const hubPath = isGerman ? "/geo-optimierung/" : "/en/geo-optimization/";
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: hubPath },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath }
];
const cycle = isGerman ? {
  eyebrow: "Der PATERNOGA-Zyklus",
  title: "Kontinuierliche Absicherung statt punktueller Momentaufnahmen",
  lead: "KI-Systeme verändern ihre Datenbasis und Gewichtungen. Um Veränderungen in deinem Share of Model regelmäßig einzuordnen und die zugrunde liegenden Signale gezielt weiterzuentwickeln, arbeiten wir in einem Betreuungs- und Optimierungszyklus. Wir übernehmen die technische Komplexität und machen die nächsten Schritte nachvollziehbar.",
  items: [
    ["MONITORING", "Fortlaufendes Messen", "Wir messen deine Marke kontinuierlich in kaufrelevanten Prompt-Szenarien auf den für dein Marktsegment relevanten Plattformen. So werden Verschiebungen in Präsenz und Einordnung früh sichtbar."],
    ["ANALYSE", "Validierung und Datenintegrität", "Wir prüfen auftauchende Zitationslücken und inhaltliche Fehlinterpretationen der Sprachmodelle im Detail. Dabei lokalisieren wir die Quellen, auf die die KI zugreift, und priorisieren relevante Lücken."],
    ["OPTIMIERUNG", "Gezielte Anpassung", "Wir verbessern Inhalte, Quellenkontext und technische Grundlagen auf deiner Website. So werden wichtige Aussagen klarer zugänglich und die Voraussetzungen für belastbare Nennungen nachvollziehbar gestärkt."],
    ["REPORTING", "Reporting und Roadmap", "Du erhältst ein verständliches Reporting zur Entwicklung deines Share of Model sowie eine klare Reihenfolge für die nächsten Maßnahmen an Seiten, Quellen und technischer Grundlage."]
  ]
} : {
  eyebrow: "The PATERNOGA cycle",
  title: "Continuous assurance instead of isolated snapshots",
  lead: "AI systems change their data basis and weighting over time. To assess changes in your share of model regularly and improve the underlying signals deliberately, we work in an ongoing support and optimisation cycle. We take on the technical complexity and make the next actions understandable.",
  items: [
    ["MONITORING", "Continuous measurement", "We continuously measure your brand in purchase-relevant prompt scenarios across the platforms relevant to your market segment. This makes shifts in presence and interpretation visible early."],
    ["ANALYSIS", "Validation and data integrity", "We review emerging citation gaps and content misinterpretations in detail. We trace the sources AI systems draw on and prioritise the gaps that matter."],
    ["OPTIMISATION", "Targeted adjustments", "We adjust content, sources and technical foundations on your website. This makes important claims easier to access and strengthens the basis for future mentions."],
    ["REPORTING", "Reporting and roadmap", "You receive an understandable report on the development of your share of model and a clear order for the next actions across pages, sources and technical foundations."]
  ]
};
const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: page.faq.items });
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="visibility-route">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />
  <main id="main-content" class="visibility-page">
    <section class="v-hero v-shell">
      <nav class="v-crumbs" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>
        {breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}
      </nav>
      <div class="v-hero-grid">
        <div class="v-hero-copy">
          <p class="v-kicker">{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p class="v-lead">{page.lead}</p>
          <div class="v-actions"><a class="v-button" href={`${homePath}#ki-check`}>{page.primaryCta}</a><a class="v-link" href="#visibility-evidence">{page.secondaryCta}<span aria-hidden="true">↓</span></a></div>
        </div>
      </div>
      <div class="v-feature-rail" aria-label={isGerman ? "Was die Analyse sichtbar macht" : "What the analysis reveals"}>
        {[
          ["1", isGerman ? "Die Sichtbarkeit messen" : "Measure visibility", isGerman ? "Wir messen kontinuierlich, wie oft dein Angebot bei kaufrelevanten Prompts im Vergleich zum Wettbewerb genannt wird. Wir machen sichtbar, welche Plattformen gut laufen und wo es noch Potenziale gibt." : "We continuously measure how often your offer is mentioned for purchase-relevant prompts compared with competitors. We make clear which platforms perform well and where potential remains."],
          ["2", isGerman ? "Die Einordnung prüfen" : "Review the interpretation", isGerman ? "Wir prüfen, ob Systeme deine Dienstleistungen, deinen Standort und deine Merkmale korrekt verknüpfen, und markieren Informationslücken, die zu unklaren oder falschen Einordnungen beitragen." : "We review whether systems connect your services, location and characteristics correctly and flag information gaps that contribute to unclear or incorrect interpretations."],
          ["3", isGerman ? "Den Antwortpfad sichern" : "Secure the answer path", isGerman ? "Jede KI-Antwort baut auf Quellen auf. Wir entschlüsseln, welche Foren, Fachmedien oder technischen Dokumente die Algorithmen im Hintergrund heranziehen, damit wir diese gezielt bespielen können." : "Every AI answer is built on sources. We decode which forums, specialist publications and technical documents the systems draw on in the background, so we can strengthen those paths deliberately."],
          ["4", isGerman ? "Datenbasierte Priorisierung" : "Data-based prioritisation", isGerman ? "Aus den gesammelten KI-Signalen leiten wir eine genaue Roadmap für deine Website ab. Kein Rätselraten mehr: Du weißt exakt, welche Seite als nächstes technisch oder inhaltlich angepasst werden muss, um deine digitale Sichtbarkeit zu steigern." : "We turn the collected AI signals into a precise roadmap for your website. No more guesswork: you know exactly which page needs the next technical or content adjustment to increase your digital visibility."]
        ].map(([number, title, text], index) => <article class:list={{ "is-active": index === 0 }} data-v-feature={index}><span>{number}</span><h2>{title}</h2><p>{text}</p></article>)}
      </div>
    </section>

    <section id="visibility-evidence" class="v-evidence v-shell" data-v-reveal>
      <div class="v-section-intro"><p class="v-kicker">{page.demo.eyebrow}</p><h2>{isGerman ? "Sichtbarkeit wird erst über deinen Share of Model messbar" : "Visibility only becomes measurable through your share of model"}</h2><p>{page.demo.note}</p><a class="v-source-link" href="https://arxiv.org/abs/2311.09735" target="_blank" rel="noopener noreferrer">{isGerman ? "Wissenschaftliche Referenz: GEO: Generative Engine Optimization (KDD 2024)" : "Scientific reference: GEO: Generative Engine Optimization (KDD 2024)"}<span aria-hidden="true">↗</span></a></div>
      <figure class="v-browser v-answer-index-figure" aria-label={isGerman ? "Illustrativer Antwortindex" : "Illustrative answer index"}>
        <img class="v-answer-index-image" src="/images/ai-visibility-answer-index.webp" alt={isGerman ? "Illustrativer PATERNOGA-Antwortindex mit Verlauf, Plattformvergleich und Antwortsignalen" : "Illustrative PATERNOGA answer index with trend, platform comparison and response signals"} width="1552" height="1013" loading="lazy" decoding="async" />
        <figcaption class="v-answer-index-caption">{isGerman ? "Modellhafte Darstellung. Die Datenpunkte und Plattformvergleiche werden im Rahmen des Projekts individuell für Ihr Marktsegment erhoben." : "Illustrative representation. Data points and platform comparisons are collected individually for your market segment as part of the project."}</figcaption>
      </figure>
    </section>

    <section class="v-cycle v-shell">
      <div class="v-cycle-grid">
        <div class="v-cycle-intro">
          <p class="v-kicker">{cycle.eyebrow}</p>
          <h2>{cycle.title}</h2>
          <p>{cycle.lead}</p>
        </div>
        <div class="v-cycle-list" aria-label={isGerman ? "Vier Schritte im PATERNOGA-Zyklus" : "Four steps in the PATERNOGA cycle"}>
          {cycle.items.map(([label, title, text], index) => <article class:list={{ "is-active": index === 0 }} data-v-cycle-step={index}><span>{label}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}
        </div>
      </div>
    </section>

    <section class="v-faq v-shell"><div><p class="v-kicker">{page.faq.eyebrow}</p><h2>{page.faq.title}</h2></div><div>{page.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
    <SubpageContact lang={page.lang} source="visibility-service" />
  </main>
  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.querySelector(".visibility-page");
  if (root && !reduced.matches) {
    const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.16, rootMargin: "0px 0px -12%" });
    root.querySelectorAll("[data-v-reveal]").forEach((el) => reveal.observe(el));
    const steps = [...root.querySelectorAll("[data-v-step]")];
    const stepObserver = new IntersectionObserver((entries) => { const current = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!current) return; const index = Number(current.target.getAttribute("data-v-step")); steps.forEach((step, i) => step.classList.toggle("is-active", i === index)); const progress = root.querySelector<HTMLElement>(".v-method-progress i"); if (progress) progress.style.transform = `scaleX(${(index + 1) / steps.length})`; }, { threshold: [0.25, 0.6], rootMargin: "-25% 0px -40%" });
    steps.forEach((step) => stepObserver.observe(step));
    const cycleSteps = [...root.querySelectorAll<HTMLElement>("[data-v-cycle-step]")];
    if (cycleSteps.length) {
      const cycleObserver = new IntersectionObserver((entries) => { const current = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!current) return; const index = Number(current.target.getAttribute("data-v-cycle-step")); cycleSteps.forEach((step, i) => step.classList.toggle("is-active", i === index)); }, { threshold: [0.28, 0.6], rootMargin: "-24% 0px -42%" });
      cycleSteps.forEach((step) => cycleObserver.observe(step));
    }
  } else root?.querySelectorAll("[data-v-reveal]").forEach((el) => el.classList.add("is-visible"));
</script>

<style>
  :global(body.visibility-route .site-header),:global(body.visibility-route .site-footer){background:#151513;color:#fbf8f2;border-color:rgba(255,250,244,.14)}:global(body.visibility-route .language-switch){background:rgba(255,250,244,.06)}:global(body.visibility-route .language-switch a[aria-current="page"]){background:rgba(255,250,244,.12);box-shadow:none}
  :global(body.visibility-route){--v-bg:#151513;--v-surface:#22211e;--v-line:rgba(255,250,244,.14);--v-ink:#fbf8f2;--v-muted:#b6b0a4;--v-accent:#b74622;--v-soft:#dfd1c0;background:var(--v-bg);color:var(--v-ink);font-family:Inter,system-ui,sans-serif}.v-shell{width:min(100%,1120px);margin-inline:auto;padding-inline:32px}.visibility-page{overflow:hidden}.v-hero{padding-top:28px;padding-bottom:0}.v-crumbs{display:flex;flex-wrap:wrap;gap:8px;color:var(--v-muted);font-size:12px}.v-crumbs a:hover{color:var(--v-ink)}.v-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(250px,.65fr);gap:80px;align-items:end;min-height:610px;padding:110px 0 106px}.v-kicker{margin:0 0 20px;color:#d37a5c;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.v-hero h1{max-width:760px;margin:0;font-size:clamp(52px,6.3vw,82px);font-weight:520;line-height:.98;letter-spacing:-.065em;text-wrap:balance}.v-lead{max-width:640px;margin:30px 0 0;color:var(--v-muted);font-size:18px;line-height:1.6}.v-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.v-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:8px;background:var(--v-accent);padding:0 18px;color:#fff7ed;font-size:15px;font-weight:650;text-decoration:none;transition:transform 180ms ease,background 180ms ease}.v-button:hover{background:#c9532b;transform:translateY(-2px)}.v-link{display:inline-flex;min-height:48px;align-items:center;gap:18px;border:1px solid rgba(255,250,244,.28);border-radius:8px;padding:0 18px;color:var(--v-ink);font-size:15px;font-weight:600}.v-link span{color:#d37a5c}.v-hero-index{position:relative;min-height:270px;border:1px solid var(--v-line);border-radius:16px;background:linear-gradient(145deg,#292824,#1b1a18);padding:28px 26px;overflow:hidden}.v-hero-index::before{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.8%,rgba(255,250,244,.08) 50%,transparent 50.2%),linear-gradient(0deg,transparent 49.8%,rgba(255,250,244,.08) 50%,transparent 50.2%);background-size:70px 70px;content:"";opacity:.55}.v-index-label,.v-index-unit,.v-hero-index strong,.v-index-bars,.v-hero-index small{position:relative;z-index:1}.v-index-label{display:block;color:var(--v-muted);font-size:13px}.v-hero-index strong{display:inline-block;margin-top:52px;font-size:74px;font-weight:500;letter-spacing:-.08em}.v-index-unit{margin-left:8px;color:#d37a5c;font-size:20px}.v-index-bars{position:absolute;right:24px;bottom:44px;left:24px;display:flex;height:82px;align-items:end;gap:7px}.v-index-bars i{height:var(--height);flex:1;border-radius:3px 3px 0 0;background:linear-gradient(#d37a5c,#7a3824);opacity:.86;transform-origin:bottom;animation:v-bars 4s ease-in-out infinite alternate}.v-index-bars i:nth-child(2n){animation-delay:.4s}.v-hero-index small{position:absolute;bottom:18px;left:26px;color:#8f8a80;font-size:11px}.v-feature-rail{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--v-line);border-bottom:1px solid var(--v-line)}.v-feature-rail article{min-height:210px;padding:28px 25px 26px;border-left:1px solid var(--v-line);transition:background 260ms ease,transform 260ms ease}.v-feature-rail article:first-child{border-left:0}.v-feature-rail article.is-active,.v-feature-rail article:hover{background:#1f1e1b}.v-feature-rail span{color:#d37a5c;font-size:12px}.v-feature-rail h2{margin:56px 0 12px;font-size:17px;font-weight:650}.v-feature-rail p{margin:0;color:var(--v-muted);font-size:14px;line-height:1.5}.v-evidence{padding-top:120px;padding-bottom:120px}.v-section-intro{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:32px;align-items:end;margin-bottom:48px}.v-section-intro .v-kicker{grid-column:1/-1;margin-bottom:0}.v-section-intro h2{max-width:680px;margin:0;font-size:clamp(38px,4.6vw,60px);font-weight:520;line-height:1.02;letter-spacing:-.055em}.v-section-intro>p:not(.v-kicker){max-width:340px;margin:0 0 3px;color:var(--v-muted);font-size:15px;line-height:1.55}.v-browser{border:1px solid var(--v-line);border-radius:14px;background:#10100f;box-shadow:0 22px 60px rgba(0,0,0,.25);overflow:hidden}.v-browser-bar{display:flex;min-height:46px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--v-line);padding:0 18px;color:#8e8a82;font-size:11px}.v-browser-bar span{display:flex;gap:6px}.v-browser-bar span i{width:8px;height:8px;border-radius:50%;background:#484641}.v-browser-bar b{font-weight:600;letter-spacing:.08em}.v-browser-bar em{font-style:normal;color:#d37a5c}.v-browser-body{display:grid;grid-template-columns:170px minmax(0,1fr);min-height:520px}.v-browser-body aside{display:grid;align-content:start;gap:3px;border-right:1px solid var(--v-line);padding:26px 14px}.v-browser-body aside strong{margin:0 10px 27px;color:#f6eee3;font-size:12px;letter-spacing:.1em}.v-browser-body aside a{padding:10px;color:#77736d;font-size:13px;border-radius:6px}.v-browser-body aside a.selected{background:#252420;color:var(--v-ink)}.v-dashboard{padding:30px 34px}.v-dashboard-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--v-line);padding-bottom:22px}.v-dashboard-head span{display:block;color:#918d83;font-size:13px}.v-dashboard-head strong{display:block;margin-top:10px;font-size:38px;font-weight:500;letter-spacing:-.06em}.v-dashboard-head label{border:1px solid var(--v-line);border-radius:5px;padding:9px 10px;color:#aaa59b;font-size:12px}.v-chart{position:relative;height:200px;border-bottom:1px solid var(--v-line);padding-top:25px}.v-chart svg{width:100%;height:170px;overflow:visible}.v-chart path{fill:none;stroke:#d37a5c;stroke-width:2.5}.v-chart .v-chart-fill{fill:rgba(183,70,34,.12);stroke:none}.v-chart-labels{display:flex;justify-content:space-between;color:#77736d;font-size:11px}.v-platform-table{margin-top:25px}.v-table-head,.v-table-row{display:grid;grid-template-columns:1.5fr .8fr .8fr;gap:12px;align-items:center}.v-table-head{padding:0 12px 10px;color:#747069;font-size:11px;text-transform:uppercase;letter-spacing:.09em}.v-table-row{min-height:48px;border-top:1px solid var(--v-line);padding:0 12px;color:#ddd5ca;font-size:13px}.v-table-row span:first-child{display:flex;align-items:center;gap:8px}.v-table-row i{width:8px;height:8px;border-radius:50%;background:#79766f}.v-table-row i.is-warm{background:#d37a5c}.v-table-row span:last-child{color:#c5bcb1}.v-table-row span:last-child.up{color:#96b18d}.v-outcomes{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--v-line);border-bottom:1px solid var(--v-line)}.v-outcomes article{min-height:250px;padding:28px 26px 34px}.v-outcomes article+article{border-left:1px solid var(--v-line)}.v-outcomes article>span{display:block;color:#d37a5c;font-size:13px}.v-outcomes p{margin:64px 0 12px;color:#d37a5c;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.v-outcomes h2{margin:0 0 14px;font-size:26px;font-weight:520;letter-spacing:-.04em}.v-outcomes article>div{color:var(--v-muted);font-size:15px;line-height:1.55}.v-method{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:90px;padding-top:140px;padding-bottom:130px}.v-method-copy{position:sticky;top:130px;align-self:start}.v-method-copy h2{max-width:420px;margin:0;font-size:clamp(38px,4vw,56px);font-weight:520;line-height:1.02;letter-spacing:-.055em}.v-method-copy>p:not(.v-kicker){max-width:410px;margin:24px 0;color:var(--v-muted);font-size:16px;line-height:1.6}.v-method-progress{width:100%;height:2px;margin-top:64px;background:var(--v-line)}.v-method-progress i{display:block;width:100%;height:100%;background:#d37a5c;transform:scaleX(.25);transform-origin:left;transition:transform 500ms ease}.v-method-list{margin:0;padding:0;list-style:none}.v-method-list li{display:grid;grid-template-columns:44px minmax(0,1fr) 30px;gap:20px;align-items:start;min-height:280px;border-top:1px solid var(--v-line);padding:28px 0;opacity:.36;transition:opacity 500ms ease,transform 500ms ease}.v-