---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const siteContent = content[page.lang];
const isGerman = page.lang === "de";
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? page.alternateDePath : page.alternateEnPath;
const hubPath = isGerman ? "/geo-optimierung/" : "/en/geo-optimization/";
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: hubPath },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath }
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", name: page.eyebrow, description: page.meta.description, url: new URL(canonicalPath, "https://elbsand.studio").toString(), provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio" } },
    { "@type": "BreadcrumbList", itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: new URL(item.href, "https://elbsand.studio").toString() })) },
    { "@type": "FAQPage", mainEntity: page.faq.items.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) }
  ]
};
const systems = ["ChatGPT", "Claude", "Perplexity", "Google AI"];
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="visibility-route">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />
  <main id="main-content" class="visibility-page">
    <section class="v-hero v-shell">
      <nav class="v-crumbs" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>
        {breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}
      </nav>
      <div class="v-hero-grid">
        <div class="v-hero-copy">
          <p class="v-kicker">{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p class="v-lead">{page.lead}</p>
          <div class="v-actions"><a class="v-button" href={`${homePath}#ki-check`}>{page.primaryCta}</a><a class="v-link" href="#visibility-evidence">{page.secondaryCta}<span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="v-hero-index" aria-label={isGerman ? "Illustrativer Sichtbarkeitsindex" : "Illustrative visibility index"}>
          <span class="v-index-label">{isGerman ? "Antwortpräsenz" : "Answer presence"}</span>
          <strong>21</strong><span class="v-index-unit">/ 32</span>
          <div class="v-index-bars" aria-hidden="true"><i style="--height:72%"></i><i style="--height:58%"></i><i style="--height:81%"></i><i style="--height:46%"></i><i style="--height:65%"></i><i style="--height:52%"></i><i style="--height:78%"></i></div>
          <small>{isGerman ? "Illustrative Werte · keine Kundendaten" : "Illustrative values · no client data"}</small>
        </div>
      </div>
      <div class="v-feature-rail" aria-label={isGerman ? "Was die Analyse sichtbar macht" : "What the analysis reveals"}>
        {[
          ["1", isGerman ? "Präsenz verfolgen" : "Track presence", isGerman ? "Wie oft dein Angebot in Antworten auftaucht." : "How often your offer appears in answers."],
          ["2", isGerman ? "Antworten lesen" : "Read responses", isGerman ? "Welche Einordnung hinter einer Nennung steht." : "What context sits behind a mention."],
          ["3", isGerman ? "Quellen verbinden" : "Connect sources", isGerman ? "Welche Belege den Antwortpfad tragen." : "Which evidence carries the answer path."],
          ["4", isGerman ? "Nächsten Hebel wählen" : "Choose the next lever", isGerman ? "Was aus dem Signal konkret folgt." : "What the signal should change next."]
        ].map(([number, title, text], index) => <article class:list={{ "is-active": index === 0 }} data-v-feature={index}><span>{number}</span><h2>{title}</h2><p>{text}</p></article>)}
      </div>
    </section>

    <section id="visibility-evidence" class="v-evidence v-shell" data-v-reveal>
      <div class="v-section-intro"><p class="v-kicker">{page.demo.eyebrow}</p><h2>{isGerman ? "Sichtbarkeit wird erst im Antwortbild verständlich." : "Visibility only becomes useful inside the answer picture."}</h2><p>{page.demo.note}</p></div>
      <div class="v-browser" aria-label={isGerman ? "Illustrative Antwortübersicht" : "Illustrative answer overview"}>
        <div class="v-browser-bar"><span><i></i><i></i><i></i></span><b>ELBSAND / ANSWER INDEX</b><em>{isGerman ? "Beispielansicht" : "Illustrative view"}</em></div>
        <div class="v-browser-body">
          <aside><strong>ELBSAND</strong><a class="selected">{isGerman ? "Übersicht" : "Overview"}</a><a>{isGerman ? "Fragen" : "Questions"}</a><a>{isGerman ? "Präsenz" : "Presence"}</a><a>{isGerman ? "Quellen" : "Sources"}</a></aside>
          <div class="v-dashboard"><div class="v-dashboard-head"><div><span>{isGerman ? "Antwortindex" : "Answer index"}</span><strong>21 / 32</strong></div><label>{isGerman ? "Letzte 7 Tage" : "Last 7 days"}⌄</label></div><div class="v-chart"><svg viewBox="0 0 640 200" role="img" aria-label={isGerman ? "Illustrativer Verlauf der Antwortpräsenz" : "Illustrative answer presence trend"}><path d="M0 158 C55 150 70 120 125 132 S185 170 236 126 S296 72 350 98 S408 152 465 88 S530 66 640 42" /><path class="v-chart-fill" d="M0 158 C55 150 70 120 125 132 S185 170 236 126 S296 72 350 98 S408 152 465 88 S530 66 640 42 V200 H0 Z" /></svg><div class="v-chart-labels"><span>1</span><span>4</span><span>7</span></div></div><div class="v-platform-table"><div class="v-table-head"><span>{isGerman ? "System" : "System"}</span><span>{isGerman ? "Antworten" : "Answers"}</span><span>{isGerman ? "Richtung" : "Direction"}</span></div>{systems.map((system, index) => <div class="v-table-row"><span><i class:list={{ "is-warm": index === 0 }}></i>{system}</span><span>{["8 / 12", "5 / 8", "4 / 7", "4 / 5"][index]}</span><span class:list={{ "up": index !== 1 }}>{index === 1 ? "− 3%" : `+ ${index + 2}%`}</span></div>)}</div></div>
        </div>
      </div>
    </section>

    <section class="v-outcomes v-shell">
      {page.outcomes.map((outcome, index) => <article data-v-reveal><span>{index + 1}</span><p>{outcome.label}</p><h2>{outcome.title}</h2><div>{outcome.text}</div></article>)}
    </section>

    <section class="v-method v-shell" data-v-method>
      <div class="v-method-copy"><p class="v-kicker">{page.method.eyebrow}</p><h2>{isGerman ? "Ein ruhiger Zyklus für verlässliche Signale." : "A steady cycle for dependable signals."}</h2><p>{isGerman ? "Wir lesen nicht nur eine Momentaufnahme. Fragen, Systeme und Quellen werden über eine klare Arbeitsfolge miteinander verbunden." : "We do not read a single snapshot in isolation. Questions, systems and sources are connected through a clear working sequence."}</p><div class="v-method-progress" aria-hidden="true"><i></i></div></div>
      <ol class="v-method-list">{page.method.steps.map((step, index) => <li class:list={{ "is-active": index === 0 }} data-v-step={index}><span>{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div><b aria-hidden="true">↗</b></li>)}</ol>
    </section>

    <section class="v-faq v-shell"><div><p class="v-kicker">{page.faq.eyebrow}</p><h2>{page.faq.title}</h2></div><div>{page.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
    <SubpageContact lang={page.lang} source="visibility-service" />
  </main>
  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.querySelector(".visibility-page");
  if (root && !reduced.matches) {
    const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.16, rootMargin: "0px 0px -12%" });
    root.querySelectorAll("[data-v-reveal]").forEach((el) => reveal.observe(el));
    const steps = [...root.querySelectorAll("[data-v-step]")];
    const stepObserver = new IntersectionObserver((entries) => { const current = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!current) return; const index = Number(current.target.getAttribute("data-v-step")); steps.forEach((step, i) => step.classList.toggle("is-active", i === index)); const progress = root.querySelector<HTMLElement>(".v-method-progress i"); if (progress) progress.style.transform = `scaleX(${(index + 1) / steps.length})`; }, { threshold: [0.25, 0.6], rootMargin: "-25% 0px -40%" });
    steps.forEach((step) => stepObserver.observe(step));
  } else root?.querySelectorAll("[data-v-reveal]").forEach((el) => el.classList.add("is-visible"));
</script>

<style>
  :global(body.visibility-route .site-header),:global(body.visibility-route .site-footer){background:#151513;color:#fbf8f2;border-color:rgba(255,250,244,.14)}:global(body.visibility-route .language-switch){background:rgba(255,250,244,.06)}:global(body.visibility-route .language-switch a[aria-current="page"]){background:rgba(255,250,244,.12);box-shadow:none}
  :global(body.visibility-route){--v-bg:#151513;--v-surface:#22211e;--v-line:rgba(255,250,244,.14);--v-ink:#fbf8f2;--v-muted:#b6b0a4;--v-accent:#b74622;--v-soft:#dfd1c0;background:var(--v-bg);color:var(--v-ink);font-family:Inter,system-ui,sans-serif}.v-shell{width:min(100%,1120px);margin-inline:auto;padding-inline:32px}.visibility-page{overflow:hidden}.v-hero{padding-top:28px;padding-bottom:0}.v-crumbs{display:flex;flex-wrap:wrap;gap:8px;color:var(--v-muted);font-size:12px}.v-crumbs a:hover{color:var(--v-ink)}.v-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(250px,.65fr);gap:80px;align-items:end;min-height:610px;padding:110px 0 106px}.v-kicker{margin:0 0 20px;color:#d37a5c;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.v-hero h1{max-width:760px;margin:0;font-size:clamp(52px,6.3vw,82px);font-weight:520;line-height:.98;letter-spacing:-.065em;text-wrap:balance}.v-lead{max-width:640px;margin:30px 0 0;color:var(--v-muted);font-size:18px;line-height:1.6}.v-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.v-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:8px;background:var(--v-accent);padding:0 18px;color:#fff7ed;font-size:15px;font-weight:650;text-decoration:none;transition:transform 180ms ease,background 180ms ease}.v-button:hover{background:#c9532b;transform:translateY(-2px)}.v-link{display:inline-flex;min-height:48px;align-items:center;gap:18px;border:1px solid rgba(255,250,244,.28);border-radius:8px;padding:0 18px;color:var(--v-ink);font-size:15px;font-weight:600}.v-link span{color:#d37a5c}.v-hero-index{position:relative;min-height:270px;border:1px solid var(--v-line);border-radius:16px;background:linear-gradient(145deg,#292824,#1b1a18);padding:28px 26px;overflow:hidden}.v-hero-index::before{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.8%,rgba(255,250,244,.08) 50%,transparent 50.2%),linear-gradient(0deg,transparent 49.8%,rgba(255,250,244,.08) 50%,transparent 50.2%);background-size:70px 70px;content:"";opacity:.55}.v-index-label,.v-index-unit,.v-hero-index strong,.v-index-bars,.v-hero-index small{position:relative;z-index:1}.v-index-label{display:block;color:var(--v-muted);font-size:13px}.v-hero-index strong{display:inline-block;margin-top:52px;font-size:74px;font-weight:500;letter-spacing:-.08em}.v-index-unit{margin-left:8px;color:#d37a5c;font-size:20px}.v-index-bars{position:absolute;right:24px;bottom:44px;left:24px;display:flex;height:82px;align-items:end;gap:7px}.v-index-bars i{height:var(--height);flex:1;border-radius:3px 3px 0 0;background:linear-gradient(#d37a5c,#7a3824);opacity:.86;transform-origin:bottom;animation:v-bars 4s ease-in-out infinite alternate}.v-index-bars i:nth-child(2n){animation-delay:.4s}.v-hero-index small{position:absolute;bottom:18px;left:26px;color:#8f8a80;font-size:11px}.v-feature-rail{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--v-line);border-bottom:1px solid var(--v-line)}.v-feature-rail article{min-height:210px;padding:28px 25px 26px;border-left:1px solid var(--v-line);transition:background 260ms ease,transform 260ms ease}.v-feature-rail article:first-child{border-left:0}.v-feature-rail article.is-active,.v-feature-rail article:hover{background:#1f1e1b}.v-feature-rail span{color:#d37a5c;font-size:12px}.v-feature-rail h2{margin:56px 0 12px;font-size:17px;font-weight:650}.v-feature-rail p{margin:0;color:var(--v-muted);font-size:14px;line-height:1.5}.v-evidence{padding-top:120px;padding-bottom:120px}.v-section-intro{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:32px;align-items:end;margin-bottom:48px}.v-section-intro .v-kicker{grid-column:1/-1;margin-bottom:0}.v-section-intro h2{max-width:680px;margin:0;font-size:clamp(38px,4.6vw,60px);font-weight:520;line-height:1.02;letter-spacing:-.055em}.v-section-intro>p:last-child{max-width:340px;margin:0 0 3px;color:var(--v-muted);font-size:15px;line-height:1.55}.v-browser{border:1px solid var(--v-line);border-radius:14px;background:#10100f;box-shadow:0 22px 60px rgba(0,0,0,.25);overflow:hidden}.v-browser-bar{display:flex;min-height:46px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--v-line);padding:0 18px;color:#8e8a82;font-size:11px}.v-browser-bar span{display:flex;gap:6px}.v-browser-bar span i{width:8px;height:8px;border-radius:50%;background:#484641}.v-browser-bar b{font-weight:600;letter-spacing:.08em}.v-browser-bar em{font-style:normal;color:#d37a5c}.v-browser-body{display:grid;grid-template-columns:170px minmax(0,1fr);min-height:520px}.v-browser-body aside{display:grid;align-content:start;gap:3px;border-right:1px solid var(--v-line);padding:26px 14px}.v-browser-body aside strong{margin:0 10px 27px;color:#f6eee3;font-size:12px;letter-spacing:.1em}.v-browser-body aside a{padding:10px;color:#77736d;font-size:13px;border-radius:6px}.v-browser-body aside a.selected{background:#252420;color:var(--v-ink)}.v-dashboard{padding:30px 34px}.v-dashboard-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--v-line);padding-bottom:22px}.v-dashboard-head span{display:block;color:#918d83;font-size:13px}.v-dashboard-head strong{display:block;margin-top:10px;font-size:38px;font-weight:500;letter-spacing:-.06em}.v-dashboard-head label{border:1px solid var(--v-line);border-radius:5px;padding:9px 10px;color:#aaa59b;font-size:12px}.v-chart{position:relative;height:200px;border-bottom:1px solid var(--v-line);padding-top:25px}.v-chart svg{width:100%;height:170px;overflow:visible}.v-chart path{fill:none;stroke:#d37a5c;stroke-width:2.5}.v-chart .v-chart-fill{fill:rgba(183,70,34,.12);stroke:none}.v-chart-labels{display:flex;justify-content:space-between;color:#77736d;font-size:11px}.v-platform-table{margin-top:25px}.v-table-head,.v-table-row{display:grid;grid-template-columns:1.5fr .8fr .8fr;gap:12px;align-items:center}.v-table-head{padding:0 12px 10px;color:#747069;font-size:11px;text-transform:uppercase;letter-spacing:.09em}.v-table-row{min-height:48px;border-top:1px solid var(--v-line);padding:0 12px;color:#ddd5ca;font-size:13px}.v-table-row span:first-child{display:flex;align-items:center;gap:8px}.v-table-row i{width:8px;height:8px;border-radius:50%;background:#79766f}.v-table-row i.is-warm{background:#d37a5c}.v-table-row span:last-child{color:#c5bcb1}.v-table-row span:last-child.up{color:#96b18d}.v-outcomes{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--v-line);border-bottom:1px solid var(--v-line)}.v-outcomes article{min-height:250px;padding:28px 26px 34px}.v-outcomes article+article{border-left:1px solid var(--v-line)}.v-outcomes article>span{display:block;color:#d37a5c;font-size:13px}.v-outcomes p{margin:64px 0 12px;color:#d37a5c;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.v-outcomes h2{margin:0 0 14px;font-size:26px;font-weight:520;letter-spacing:-.04em}.v-outcomes article>div{color:var(--v-muted);font-size:15px;line-height:1.55}.v-method{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:90px;padding-top:140px;padding-bottom:130px}.v-method-copy{position:sticky;top:130px;align-self:start}.v-method-copy h2{max-width:420px;margin:0;font-size:clamp(38px,4vw,56px);font-weight:520;line-height:1.02;letter-spacing:-.055em}.v-method-copy>p:not(.v-kicker){max-width:410px;margin:24px 0;color:var(--v-muted);font-size:16px;line-height:1.6}.v-method-progress{width:100%;height:2px;margin-top:64px;background:var(--v-line)}.v-method-progress i{display:block;width:100%;height:100%;background:#d37a5c;transform:scaleX(.25);transform-origin:left;transition:transform 500ms ease}.v-method-list{margin:0;padding:0;list-style:none}.v-method-list li{display:grid;grid-template-columns:44px minmax(0,1fr) 30px;gap:20px;align-items:start;min-height:280px;border-top:1px solid var(--v-line);padding:28px 0;opacity:.36;transition:opacity 500ms ease,transform 500ms ease}.v-meth