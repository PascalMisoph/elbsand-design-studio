---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const siteContent = content[page.lang];
const homePath = page.lang === "de" ? "/" : "/en/";
const hubPath = page.lang === "de" ? "/geo-optimierung/" : "/en/geo-optimization/";
const canonicalPath = page.lang === "de" ? page.alternateDePath : page.alternateEnPath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: hubPath },
  ...(page.breadcrumb.parent
    ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }]
    : []),
  { name: page.breadcrumb.current, href: canonicalPath }
];
const statusLabels = page.lang === "de"
  ? { clear: "Klar", review: "Prüfen", open: "Offen" }
  : { clear: "Clear", review: "Review", open: "Open" };
const narrativeVisualLabels = page.lang === "de"
  ? { signalCore: "Antwortbild", signals: "3 Signale", actionCore: "Maßnahmenplan", priority: "Priorisiert" }
  : { signalCore: "Answer model", signals: "3 signals", actionCore: "Action plan", priority: "Prioritised" };

const composition = {
  audit: "audit",
  "visibility-index": "index",
  "source-map": "network",
  "competitor-split": "comparison",
  "perception-orbit": "orbit",
  "factcheck-tilt": "document",
  "prompt-constellation": "orbit",
  "technical-graph": "network",
  "crawl-path": "sequence",
  "citation-document": "document",
  "content-refresh": "comparison",
  "monitoring-timeline": "index",
  "action-queue": "sequence"
}[page.demo.variant];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: page.eyebrow,
      description: page.meta.description,
      url: new URL(canonicalPath, "https://elbsand.studio").toString(),
      provider: {
        "@type": "ProfessionalService",
        name: "ELBSAND Design Studio",
        url: "https://elbsand.studio/"
      },
      areaServed: ["Deutschland", "DACH"]
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.href, "https://elbsand.studio").toString()
      }))
    },
    {
      "@type": "FAQPage",
      mainEntity: page.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer }
      }))
    }
  ]
};
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  lang={page.lang}
  canonicalPath={canonicalPath}
  alternateDePath={page.alternateDePath}
  alternateEnPath={page.alternateEnPath}
  schema={schema}
  bodyClass="service-page"
>
  <Header
    lang={page.lang}
    nav={siteContent.nav}
    cta={siteContent.cta}
    page="service"
    alternateDePath={page.alternateDePath}
    alternateEnPath={page.alternateEnPath}
  />

  <main id="main-content" class="service-main" data-service-composition={composition}>
    <section class="service-hero service-shell">
      <nav class="service-breadcrumb" aria-label={page.lang === "de" ? "Brotkrumen-Navigation" : "Breadcrumb"}>
        {breadcrumbItems.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === breadcrumbItems.length - 1
              ? <span aria-current="page">{item.name}</span>
              : <a href={item.href}>{item.name}</a>}
          </>
        ))}
      </nav>
      <div class="service-hero-copy">
        <p class="service-eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p>{page.lead}</p>
        <div class="service-actions">
          <a class="button" href={`${homePath}#ki-check`}>{page.primaryCta}</a>
          <a class="service-secondary" href="#methode">{page.secondaryCta}<span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="service-outcomes service-shell" aria-label={page.lang === "de" ? "Ergebnisse" : "Outcomes"}>
      {page.outcomes.map((outcome) => (
        <article>
          <p>{outcome.label}</p>
          <h2>{outcome.title}</h2>
          <span>{outcome.text}</span>
        </article>
      ))}
    </section>

    <section class="service-demo-section service-shell" data-service-reveal>
      <header class="service-section-heading">
        <p class="service-eyebrow">{page.demo.eyebrow}</p>
        <h2>{page.demo.title}</h2>
        <span>{page.demo.note}</span>
      </header>
      <div class="audit-demo" data-audit-demo data-demo-variant={page.demo.variant}>
        <div class="audit-demo-topbar">
          <div><i></i><i></i><i></i></div>
          <span>ELBSAND / GEO SYSTEM</span>
          <b><i></i>{page.lang === "de" ? "Analyse" : "Analysis"}</b>
        </div>
        {page.demo.variant === "audit" ? (
          <>
            <div class="audit-demo-summary">
              <div>
                <p>{page.demo.scoreLabel}</p>
                <strong>{page.demo.score}</strong>
              </div>
              <div class="audit-demo-distribution">
                <span style="--bar-size: 75%"><i></i></span>
                <span style="--bar-size: 48%"><i></i></span>
                <span style="--bar-size: 28%"><i></i></span>
              </div>
            </div>
            <div class="audit-demo-checks">
              {page.demo.checks.map((check, index) => (
                <article data-status={check.status} style={`--audit-stagger: ${index * 110}ms`}>
                  <span class="audit-status-marker"><i></i></span>
                  <div><h3>{check.label}</h3><p>{check.detail}</p></div>
                  <small>{statusLabels[check.status]}</small>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="service-variant-demo">
            <div class="service-variant-metric">
              <p>{page.demo.scoreLabel}</p>
              <strong>{page.demo.score}</strong>
            </div>
            <div class="service-variant-canvas">
              <i class="service-variant-axis"></i>
              <i class="service-variant-orbit service-variant-orbit-a"></i>
              <i class="service-variant-orbit service-variant-orbit-b"></i>
              <svg viewBox="0 0 720 380" role="presentation">
                <path d="M80 76 C210 76 225 190 360 190" />
                <path d="M640 76 C510 76 495 190 360 190" />
                <path d="M80 304 C210 304 225 190 360 190" />
                <path d="M640 304 C510 304 495 190 360 190" />
              </svg>
              <ul>
                {page.demo.checks.map((check, index) => (
                  <li data-status={check.status} data-variant-item={index} style={`--variant-stagger: ${index * 110}ms`}>
                    <span>{index + 1}</span>
                    <div><h3>{check.label}</h3><p>{check.detail}</p></div>
                    <small>{statusLabels[check.status]}</small>
                  </li>
                ))}
              </ul>
            </div>
            <div class="service-variant-progress"><i></i><b></b><span></span><em></em></div>
          </div>
        )}
        <span class="audit-scan-line" aria-hidden="true"></span>
      </div>
    </section>

    <section class="service-narratives service-shell">
      {page.narratives.map((narrative, index) => (
        <article class:list={["service-narrative-story", { "is-reversed": index % 2 === 1 }]} data-service-reveal>
          <div class="service-narrative-copy">
            <span class="service-narrative-index">{index + 1}</span>
            <p class="service-eyebrow">{narrative.eyebrow}</p>
            <h2>{narrative.title}</h2>
            <p>{narrative.text}</p>
          </div>
          <div class="service-narrative-artifact" data-narrative-artifact>
            <div class="service-narrative-topbar">
              <span>ELBSAND / GEO</span>
              <b><i></i>{index === 0 ? narrativeVisualLabels.signals : narrativeVisualLabels.priority}</b>
            </div>
            {index === 0 ? (
              <div class="narrative-signal-map">
                <svg viewBox="0 0 620 440" role="presentation">
                  <path d="M310 220 C250 150 190 124 102 106" />
                  <path d="M310 220 C370 150 430 124 518 106" />
                  <path d="M310 220 C310 286 310 320 310 364" />
                </svg>
                <div class="narrative-signal-core"><i></i><strong>{narrativeVisualLabels.signalCore}</strong></div>
                <ul>
                  {narrative.points.map((point, pointIndex) => (
                    <li style={`--point-index: ${pointIndex}`}><span>{pointIndex + 1}</span><b>{point}</b></li>
                  ))}
                </ul>
              </div>
            ) : (
              <div class="narrative-action-plan">
                <header><strong>{narrativeVisualLabels.actionCore}</strong><span>3 / 3</span></header>
                <ol>
                  {narrative.points.map((point, pointIndex) => (
                    <li style={`--point-index: ${pointIndex}`}>
                      <span>{pointIndex + 1}</span><b>{point}</b><i><em></em></i>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="service-method service-shell" id="methode" data-service-reveal data-method-story>
      <header class="service-section-heading">
        <p class="service-eyebrow">{page.method.eyebrow}</p>
        <h2>{page.method.title}</h2>
      </header>
      <div class="method-experience">
        <div class="method-visual" data-method-visual data-active-step="0" aria-hidden="true">
          <div class="method-visual-topbar">
            <span>{page.method.visual.frameLabel}</span>
            <b><i></i>{page.method.visual.statusLabel}</b>
          </div>
          <div class="method-visual-stage">
            {page.method.visual.scenes.map((scene, sceneIndex) => (
              <div class="method-scene" data-scene={sceneIndex}>
                <div class="method-scene-summary">
                  <strong>{scene.metric}</strong>
                  <span>{scene.label}</span>
                </div>

                {sceneIndex === 0 && (
                  <div class="method-question-field">
                    {scene.items.map((item, itemIndex) => (
                      <span style={`--item-index: ${itemIndex}`}>{item}</span>
                    ))}
                    <i class="method-question-focus"></i>
                  </div>
                )}

                {sceneIndex === 1 && (
                  <div class="method-platform-field">
                    {scene.items.map((item, itemIndex) => (
                      <span style={`--item-index: ${itemIndex}`}><i></i>{item}<b>{82 - itemIndex * 9}%</b></span>
                    ))}
                  </div>
                )}

                {sceneIndex === 2 && (
                  <div class="method-signal-field">
                    <svg viewBox="0 0 520 250" role="presentation">
                      <path d="M62 54 C158 54 154 125 260 125" />
                      <path d="M62 196 C158 196 154 125 260 125" />
                      <path d="M458 54 C362 54 366 125 260 125" />
                      <path d="M458 196 C362 196 366 125 260 125" />
                      <circle cx="260" cy="125" r="25" />
                    </svg>
                    {scene.items.map((item, itemIndex) => (
                      <span data-node={itemIndex}>{item}</span>
                    ))}
                    <i class="method-signal-core"></i>
                  </div>
                )}

                {sceneIndex === 3 && (
                  <div class="method-action-field">
                    {scene.items.map((item, itemIndex) => (
                      <span style={`--item-index: ${itemIndex}`}><b>{itemIndex + 1}</b>{item}<i></i></span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
          <div class="method-visual-footer">
            <span data-method-count>1 / {page.method.steps.length}</span>
            <i><b></b></i>
          </div>
        </div>

        <ol>
          {page.method.steps.map((step, index) => (
            <li data-method-step data-step={index} class:list={{ "is-active": index === 0 }}>
              <span>{index + 1}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="service-related service-shell" data-service-reveal>
      <header class="service-section-heading">
        <p class="service-eyebrow">{page.related.eyebrow}</p>
        <h2>{page.related.title}</h2>
      </header>
      <div>
        {page.related.items.map((item) => (
          <a
            href={item.href}
            class:list={{ "has-image": Boolean(item.image) }}
            style={item.image ? `--service-related-image: url(${item.image}); --service-related-position: ${item.imagePosition ?? "center"}` : undefined}
          >
            <span aria-hidden="true">↗</span><h3>{item.title}</h3><p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="service-faq service-shell" data-service-reveal>
      <header class="service-section-heading">
        <p class="service-eyebrow">{page.faq.eyebrow}</p>
        <h2>{page.faq.title}</h2>
      </header>
      <div>
        {page.faq.items.map((item) => (
          <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>
        ))}
      </div>
    </section>

    <SubpageContact lang={page.lang} source="service-page" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reducedMotion.matches) {
    document.documentElement.classList.add("service-motion");
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.18, rootMargin: "0px 0px -7%" });
    document.querySelectorAll("[data-service-reveal]").forEach((element) => observer.observe(element));

    document.querySelectorAll<HTMLElement>("[data-method-story]").forEach((story) => {
      const visual = story.querySelector<HTMLElement>("[data-method-visual]");
      const count = story.querySelector<HTMLElement>("[data-method-count]");
      const steps = Array.from(story.querySelectorAll<HTMLElement>("[data-method-step]"));
      if (!visual || !count || steps.length === 0) return;

      const setActiveStep = (activeIndex: number) => {
        visual.dataset.activeStep = String(activeIndex);
        visual.style.setProperty("--method-progress", String((activeIndex + 1) / steps.length));
        count.textContent = `${activeIndex + 1} / ${steps.length}`;
        steps.forEach((step, index) => step.classList.toggle("is-active", index === activeIndex));
      };

      const methodObserver = new IntersectionObserver((entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visibleEntry) return;
        const activeIndex = Number((visibleEntry.target as HTMLElement).dataset.step ?? 0);
        setActiveStep(activeIndex);
      }, { threshold: [0.2, 0.45, 0.7], rootMargin: "-30% 0px -36%" });

      steps.forEach((step) => methodObserver.observe(step));
      setActiveStep(0);
    });
  }
</script>

<style>
  :global(body.service-page) {
    --paper: #171715;
    --paper-soft: #201f1c;
    --ink: #fffaf4;
    --muted: #b9b4aa;
    --line: rgba(255, 250, 244, .16);
    --control-line: rgba(255, 250, 244, .34);
    --surface: #282621;
    --accent-dark: #e98764;
    background: var(--paper);
  }
  :global(.service-page .site-header) { border-color: var(--line); background: rgba(23, 23, 21, .9); color: var(--ink); }
  :global(.service-page .language-switch) { background: rgba(255, 250, 244, .06); }
  :global(.service-page .language-switch a[aria-current="page"]) { background: rgba(255, 250, 244, .12); box-shadow: none; }
  :global(.service-page .mobile-menu nav) { background: #201f1c; }
  :global(.service-page .site-footer) { border-color: var(--line); }
  .service-main { display: flex; flex-direction: column; }
  .service-hero { order: 1; }
  .service-outcomes { order: 2; }
  .service-demo-section { order: 3; }
  .service-narratives { order: 4; }
  .service-method { order: 5; }
  .service-related { order: 6; }
  .service-faq { order: 7; }
  .service-closing { order: 8; }
  .service-shell { width: min(100%, calc(var(--container) + var(--gutter) * 2)); margin-inline: auto; padding-inline: var(--gutter); }
  .service-eyebrow { margin: 0 0 18px; color: var(--accent-dark); font-size: 11px; font-weight: 720; letter-spacing: .14em; text-transform: uppercase; }
  .service-hero { min-height: 720px; padding-top: 34px; padding-bottom: 104px; }
  .service-breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 11px; }
  .service-breadcrumb a:hover { color: var(--ink); }
  .service-hero-copy { display: grid; max-width: 990px; justify-items: start; margin-top: clamp(100px, 11vw, 148px); }
  .service-hero h1 { max-width: 980px; margin-bottom: 28px; font-size: clamp(64px, 7vw, 94px); font-weight: 540; line-height: .96; text-wrap: balance; }
  .service-hero-copy > p:not(.service-eyebrow) { max-width: 720px; color: var(--muted); font-size: clamp(18px, 1.55vw, 21px); line-height: 1.6; }
  .service-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 18px; }
  .service-secondary { display: inline-flex; min-height: 48px; align-items: center; gap: 16px; border: 1px solid var(--control-line); border-radius: 8px; padding: 0 18px; font-size: 14px; font-weight: 620; }
  .service-secondary span { color: var(--accent-dark); }
  .service-outcomes { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-top: 0; padding-bottom: 0; }
  .service-outcomes article { min-height: 250px; padding: 38px 34px 42px; }
  .service-outcomes article + article { border-left: 1px solid var(--line); }
  .service-outcomes p { color: var(--accent-dark); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .service-outcomes h2 { margin: 70px 0 12px; font-family: var(--sans); font-size: 28px; font-weight: 530; letter-spacing: -.04em; }
  .service-outcomes span { display: block; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .service-demo-section, .service-method, .service-related, .service-faq { padding-top: 112px; padding-bottom: 112px; }
  .service-section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .58fr); column-gap: 70px; margin-bottom: 58px; }
  .service-section-heading .service-eyebrow { grid-column: 1 / -1; }
  .service-section-heading h2 { max-width: 740px; margin: 0; font-family: var(--sans); font-size: clamp(46px, 5vw, 66px); font-weight: 530; letter-spacing: -.055em; }
  .service-section-heading > span { align-self: end; color: var(--muted); font-size: 14px; }
  .audit-demo { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: #201f1c; box-shadow: 0 30px 80px rgba(0, 0, 0, .28); }
  .audit-demo-topbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 58px; border-bottom: 1px solid var(--line); padding: 0 22px; }
  .audit-demo-topbar > div { display: flex; gap: 7px; }
  .audit-demo-topbar > div i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 250, 244, .24); }
  .audit-demo-topbar > div i:first-child { background: var(--accent); }
  .audit-demo-topbar > span { color: var(--muted); font-size: 11px; font-weight: 650; letter-spacing: .1em; }
  .audit-demo-topbar > b { display: flex; align-items: center; gap: 7px; justify-self: end; font-size: 11px; font-weight: 650; }
  .audit-demo-topbar > b i { width: 7px; height: 7px; border-radius: 50%; background: #82a464; box-shadow: 0 0 0 5px rgba(130, 164, 100, .1); }
  .audit-demo-summary { display: grid; grid-template-columns: .7fr 1.3fr; gap: 60px; align-items: end; padding: 56px clamp(30px, 5vw, 64px); }
  .audit-demo-summary p { margin: 0 0 8px; color: var(--muted); font-size: 14px; }
  .audit-demo-summary strong { font-size: clamp(54px, 6vw, 82px); font-weight: 520; letter-spacing: -.06em; line-height: 1; }
  .audit-demo-distribution { display: grid; gap: 14px; }
  .audit-demo-distribution span { display: block; height: 9px; overflow: hidden; border-radius: 6px; background: rgba(255, 250, 244, .08); }
  .audit-demo-distribution i { display: block; width: var(--bar-size); height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), #e98764); transform-origin: left; }
  [data-service-reveal]:not(.is-visible) .audit-demo-distribution i { transform: scaleX(0); }
  .is-visible .audit-demo-distribution i { transition: transform 900ms var(--motion-ease) 220ms; }
  .audit-demo-checks { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }
  .audit-demo-checks article { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 15px; align-items: start; min-height: 150px; padding: 30px 34px; }
  .audit-demo-checks article:nth-child(even) { border-left: 1px solid var(--line); }
  .audit-demo-checks article:nth-child(n+3) { border-top: 1px solid var(--line); }
  .audit-status-marker { display: grid; width: 28px; height: 28px; place-items: center; border: 1px solid currentColor; border-radius: 50%; color: var(--muted); }
  .audit-status-marker i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  [data-status="clear"] .audit-status-marker { border-color: #82a464; background: #82a464; color: #171715; }
  [data-status="review"] .audit-status-marker { color: #d89a50; }
  [data-status="open"] .audit-status-marker { color: var(--accent-dark); }
  .audit-demo-checks h3 { margin: 1px 0 7px; font-family: var(--sans); font-size: 20px; font-weight: 540; letter-spacing: -.025em; }
  .audit-demo-checks p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .audit-demo-checks small { color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .service-variant-demo { position: relative; min-height: 640px; overflow: hidden; background: radial-gradient(circle at 50% 58%, rgba(183, 70, 34, .11), transparent 31%); }
  .service-variant-metric { position: absolute; z-index: 5; top: 48px; left: clamp(28px, 5vw, 64px); display: flex; align-items: end; gap: 19px; }
  .service-variant-metric p { max-width: 190px; margin: 0 0 6px; color: var(--muted); font-size: 15px; line-height: 1.3; }
  .service-variant-metric strong { order: -1; font-size: clamp(66px, 7vw, 98px); font-weight: 510; letter-spacing: -.075em; line-height: .8; }
  .service-variant-canvas { position: absolute; z-index: 2; inset: 158px clamp(28px, 4vw, 54px) 50px; }
  .service-variant-canvas > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
