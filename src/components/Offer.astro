---
interface Props {
  eyebrow: string;
  title: string;
  detailLinkLabel: string;
  items: readonly OfferItem[];
}

interface OfferItem {
  title: string;
  lead: string;
  text: string;
  features?: readonly { label: string; href?: string }[];
  detailLink?: { label: string; href: string };
  visual: "google" | "ai" | "conversion" | "implementation";
}

const { eyebrow, title, detailLinkLabel, items } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en/");
const detailHref = isEnglish ? "/en/geo-optimization/" : "/geo-optimierung/";
const titleLines = title.match(/^(.+?\.)\s+(.+)$/);
const conversionLabels = isEnglish
  ? ["Home", "Service", "Proof", "Contact"]
  : ["Start", "Leistung", "Belege", "Kontakt"];
---

<section class="section-shell offer" id="leistungen">
  <div class="section-heading compact offer-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2>
      {titleLines ? (
        <>
          <span class="offer-heading-line">{titleLines[1]}</span>
          {" "}
          <span class="offer-heading-line">{titleLines[2]}</span>
        </>
      ) : title}
    </h2>
  </div>

  <div class="offer-list">
    {items.map((item, index) => (
      <article class="offer-item" data-offer-row style={`--check-stagger: ${index * 150}ms`}>
        <span class="offer-check" data-offer-check aria-hidden="true">
          <span class="offer-check-number">{index + 1}</span>
          <svg viewBox="0 0 28 28" focusable="false">
            <path class="offer-check-circle" pathLength="1" d="M14 1.75a12.25 12.25 0 0 1 0 24.5 12.25 12.25 0 0 1 0-24.5"></path>
            <path class="offer-check-mark" pathLength="1" d="M8.5 14.2 12.2 18l7.5-8.2"></path>
          </svg>
        </span>

        <div class="offer-story-copy">
          <h3>{item.title}</h3>
          <div class="offer-item-copy">
            <p class="offer-item-lead">{item.lead}</p>
            <p>{item.text}</p>
            {item.detailLink ? (
              <a class="offer-detail-link" href={item.detailLink.href} data-astro-prefetch>
                {item.detailLink.label}<span aria-hidden="true">→</span>
              </a>
            ) : (
              <ul class="offer-feature-list" aria-label={isEnglish ? "Included focus areas" : "Enthaltene Schwerpunkte"}>
                {item.features?.map((feature) => (
                  <li>
                    {feature.href ? <a href={feature.href} data-astro-prefetch>{feature.label}</a> : <span>{feature.label}</span>}
                  </li>
                ))}
              </ul>
            )}
            {item.visual === "ai" && (
              <a class="offer-detail-link" href={detailHref} data-astro-prefetch>
                {detailLinkLabel}<span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>

        <div class:list={["offer-story-visual", `offer-story-visual--${index + 1}`]} aria-hidden="true">
          {item.visual === "conversion" && (
            <div class="structure-demo">
              <div class="demo-browser-bar"><i></i><i></i><i></i><span>{isEnglish ? "Company website" : "Unternehmenswebsite"}</span></div>
              <div class="structure-demo-body">
                <p>{isEnglish ? "Clear path to enquiry" : "Klarer Weg zur Anfrage"}</p>
                <ol>
                  {conversionLabels.map((label, labelIndex) => (
                    <li><span class="structure-demo-step">{labelIndex + 1}</span><span class="structure-demo-label">{label}</span><i></i></li>
                  ))}
                </ol>
                <span class="structure-demo-cursor" aria-hidden="true"></span>
              </div>
            </div>
          )}

          {(item.visual === "google" || item.visual === "implementation") && (
            <div class="responsive-demo">
              <div class="responsive-demo-desktop">
                <span class="responsive-demo-nav"></span>
                <span class="responsive-demo-heading">
                  {item.visual === "implementation"
                    ? (isEnglish ? "Changes, implemented." : "Änderungen, umgesetzt.")
                    : (isEnglish ? "Visible in search." : "In der Suche sichtbar.")}
                </span>
                <i></i><i></i><i></i>
              </div>
              <div class="responsive-demo-mobile">
                <span class="responsive-demo-notch"></span><span class="responsive-demo-heading">
                  {item.visual === "implementation"
                    ? (isEnglish ? "Request advice" : "Beratung anfragen")
                    : (isEnglish ? "When demand starts." : "Wenn Bedarf entsteht.")}
                </span><i></i><i></i>
              </div>
              <p>
                {item.visual === "implementation" ? (
                  <><span>{isEnglish ? "Structure" : "Struktur"}</span><span>{isEnglish ? "Content" : "Inhalte"}</span><span>{isEnglish ? "Technology" : "Technik"}</span></>
                ) : (
                  <><span>{isEnglish ? "Search" : "Suche"}</span><span>{isEnglish ? "Page" : "Seite"}</span><span>{isEnglish ? "Result" : "Ergebnis"}</span></>
                )}
              </p>
            </div>
          )}

          {item.visual === "ai" && (
            <div class="search-intent-demo">
              <p>{isEnglish ? "How AI systems classify your offer" : "Wie KI-Systeme Ihr Angebot einordnen"}</p>
              <div class="search-intent-field">
                <span class="search-intent-query">{isEnglish ? "advice on business succession" : "Beratung Unternehmensnachfolge"}</span>
                <div><span class="search-intent-meta"><i></i>{isEnglish ? "Answer analysis" : "Antwortanalyse"}</span><span class="search-intent-action">{isEnglish ? "Review" : "Prüfen"}</span></div>
              </div>
              <small>{isEnglish ? "Answer signals" : "Antwortsignale"}</small>
              <ol>
                <li><span class="search-intent-question">{isEnglish ? "Which providers are recommended?" : "Welche Anbieter werden empfohlen?"}</span><span class="search-intent-number">1</span></li>
                <li><span class="search-intent-question">{isEnglish ? "How is the service described?" : "Wie wird die Leistung beschrieben?"}</span><span class="search-intent-number">2</span></li>
                <li><span class="search-intent-question">{isEnglish ? "Which sources are named?" : "Welche Quellen werden genannt?"}</span><span class="search-intent-number">3</span></li>
              </ol>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotion.matches) {
    document.documentElement.classList.add("offer-check-animation");

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.3, rootMargin: "0px 0px -8% 0px" }
    );

    document.querySelectorAll("[data-offer-row]").forEach((row) => observer.observe(row));
  }
</script>
