---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  primaryCta: string;
  primaryHref: string;
  secondaryCta: string;
  imageAlt: string;
}

const { eyebrow, title, body, primaryCta, primaryHref, secondaryCta, imageAlt } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en/");
const videoPath = isEnglish ? "/video/elbsand-geo-en.mp4" : "/video/elbsand-geo-de.mp4";
const posterPath = isEnglish ? "/video/elbsand-geo-poster-en.png" : "/video/elbsand-geo-poster.png";
---

<section class="geo-hero section-shell">
  <div class="geo-hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{body}</p>
    <div class="cta-row">
      <a class="button" href={primaryHref}>{primaryCta}</a>
      <a class="text-link" href="#geo-pakete">{secondaryCta}</a>
    </div>
  </div>
  <figure class="geo-hero-media">
    <video
      class="geo-native-video"
      data-geo-video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={posterPath}
      aria-label={imageAlt}
    >
      <source src={videoPath} type="video/mp4" />
    </video>
  </figure>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLVideoElement>("[data-geo-video]").forEach((video) => {
    const applyPreference = () => {
      if (reducedMotion.matches) {
        video.pause();
        video.currentTime = 0;
      } else {
        void video.play().catch(() => undefined);
      }
    };

    applyPreference();
    reducedMotion.addEventListener("change", applyPreference);
  });
</script>
