---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import { content } from "../content/site";
import { localSeoContent, localOffers, type LocalLocale } from "../content/local-seo";
import { createServicePageSchema } from "../lib/seo";

interface Props { lang: LocalLocale }
const { lang } = Astro.props;
const de = lang === "de";
const t = localSeoContent[lang];
const site = content[lang];
const homePath = de ? "/" : "/en/";
const dePath = "/seo-dresden/";
const enPath = "/en/seo-agency-dresden/";
const canonicalPath = de ? dePath : enPath;
const packages = localOffers(lang);
const s = t.sections;

const breadcrumbs = [
  { name: t.breadcrumb.home, href: homePath },
  { name: t.breadcrumb.current, href: canonicalPath },
];

// Extends the existing Organization entity rather than declaring a second
// business: only the served area is narrowed for this local page.
const schema = createServicePageSchema({
  lang,
  title: t.meta.title,
  description: t.meta.description,
  path: canonicalPath,
  serviceName: t.eyebrow,
  breadcrumbs,
  faqs: t.faq.items,
  areaServed: de ? "Dresden, Sachsen" : "Dresden, Saxony",
});

const related = de ? [
  ["GEO Audit", "/geo-audit/"],
  ["Seiten-Sprint für bestehende Seiten", "/content-optimierung-ai-suche/"],
  ["Laufende Betreuung", "/seo-betreuung/"],
  ["KI-Sichtbarkeit prüfen", "/ai-sichtbarkeit/"],
  ["Technische GEO-Optimierung", "/technische-geo-optimierung/"],
  ["GEO-Agentur Deutschland", "/geo-agentur-deutschland/"],
] : [
  ["GEO audit", "/en/geo-audit/"],
  ["Page sprint for existing pages", "/en/content-optimization-ai-search/"],
  ["Ongoing support", "/en/seo-support/"],
  ["Review AI visibility", "/en/ai-visibility/"],
  ["Technical GEO optimisation", "/en/technical-geo-optimization/"],
  ["GEO agency Germany", "/en/geo-agency-germany/"],
];
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang} canonicalPath={canonicalPath} alternateDePath={dePath} alternateEnPath={enPath} schema={schema} bodyClass="local-seo-page">
  <Header lang={lang} nav={site.nav} cta={t.primaryCta} primaryHref="#kontakt" page="service" alternateDePath={dePath} alternateEnPath={enPath} />

  <main id="main-content" class="local-page">
    <section class="l-shell l-hero">
      <nav class="l-crumbs" aria-label={de ? "Brotkrumen-Navigation" : "Breadcrumb"}>
        <a href={homePath}>{t.breadcrumb.home}</a><span aria-hidden="true">/</span><span aria-current="page">{t.breadcrumb.current}</span>
      </nav>
      <div class="l-hero-grid">
        <div class="l-hero-copy">
          <p class="l-kicker">{t.eyebrow}</p>
          <h1>{t.title}</h1>
          <p class="l-lead">{t.lead}</p>
          <div class="l-actions">
            <a class="l-button" href="#kontakt" data-revenue-cta="local_hero">{t.primaryCta}</a>
            <a class="l-link" href="#leistungen">{t.secondaryCta}<span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <figure class="l-surfaces" data-local-surfaces aria-label={t.visual.label}>
          <figcaption class="l-surfaces-label">{t.visual.label}</figcaption>
          <div class="l-surface-query" aria-hidden="true"><span></span><b>{de ? "steuerberater dresden" : "tax advisor dresden"}</b></div>
          <ol class="l-surface-list">
            {t.visual.steps.map((step, index) => (
              <li class:list={["l-surface", `l-surface-${index + 1}`]} data-local-surface style={`--surface-delay:${index * 220}ms`}>
                <p class="l-surface-tag">{step.tag}</p>
                <strong>{step.title}</strong>
                <span>{step.text}</span>
              </li>
            ))}
          </ol>
          <p class="l-surfaces-note">{t.visual.note}</p>
        </figure>
      </div>
    </section>

    <section class="l-shell l-block">
      <h2>{s.fit.heading}</h2>
      <p class="l-answer">{s.fit.answer}</p>
      <p>{s.fit.body}</p>
      <p class="l-muted">{s.fit.notFor}</p>
    </section>

    <section class="l-shell l-block l-block-bordered">
      <h2>{s.problem.heading}</h2>
      <p class="l-answer">{s.problem.answer}</p>
      <p>{s.problem.body}</p>
      <ol class="l-readers">
        {s.problem.points.map(([title, text], index) => (
          <li><span aria-hidden="true">{index + 1}</span><strong>{title}</strong><p>{text}</p></li>
        ))}
      </ol>
    </section>

    <section class="l-shell l-block" id="leistungen">
      <h2>{s.services.heading}</h2>
      <p class="l-answer">{s.services.answer}</p>
      <div class="l-service-grid">
        {s.services.items.map((item) => (
          <article><h3>{item.title}</h3><p>{item.text}</p></article>
        ))}
      </div>
    </section>

    <section class="l-shell l-block l-block-bordered">
      <h2>{s.geo.heading}</h2>
      <p class="l-answer">{s.geo.answer}</p>
      <p>{s.geo.body}</p>
      <p><a class="l-inline-link" href={de ? "/geo-audit/" : "/en/geo-audit/"}>{s.geo.linkLabel}<span aria-hidden="true">→</span></a></p>
    </section>

    <section class="l-shell l-block" id="preise">
      <h2>{s.pricing.heading}</h2>
      <p class="l-answer">{s.pricing.answer}</p>
      <p>{s.pricing.body}</p>
      <div class="l-price-grid">
        {packages.map((offer) => (
          <article>
            <h3>{offer.name}</h3>
            <p class="l-price-fit">{offer.fitFor}</p>
            <p class="l-price-value">{offer.price} <span>{offer.priceSuffix}</span></p>
            <p class="l-price-duration">{offer.duration}</p>
            <a class="l-price-link" href={offer.cardHref}>{offer.cta}<span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <p class="l-muted">{s.pricing.note}</p>
    </section>

    <section class="l-shell l-block l-block-bordered">
      <h2>{s.process.heading}</h2>
      <p class="l-answer">{s.process.answer}</p>
      <ol class="l-steps">
        {s.process.steps.map(([title, text], index) => (
          <li><span aria-hidden="true">{index + 1}</span><div><strong>{title}</strong><p>{text}</p></div></li>
        ))}
      </ol>
    </section>

    <section class="l-shell l-block">
      <h2>{s.local.heading}</h2>
      <p class="l-answer">{s.local.answer}</p>
      <p>{s.local.body}</p>
      <p class="l-proof-label">{s.local.proofLabel}</p>
      <dl class="l-proof">
        {s.local.proof.map(([title, text]) => (<div><dt>{title}</dt><dd>{text}</dd></div>))}
      </dl>
      <p class="l-muted">{s.local.disclaimer}</p>
    </section>

    <section class="l-shell l-block l-block-bordered">
      <h2>{s.retainer.heading}</h2>
      <p class="l-answer">{s.retainer.answer}</p>
      <p>{s.retainer.body}</p>
      <p class="l-muted">{s.retainer.note}</p>
      <p><a class="l-inline-link" href={de ? "/seo-betreuung/" : "/en/seo-support/"}>{s.retainer.linkLabel}<span aria-hidden="true">→</span></a></p>
    </section>

    <section class="l-shell l-block">
      <h2>{t.faq.heading}</h2>
      <FaqAccordion items={t.faq.items} />
    </section>

    <section class="l-shell l-block l-block-bordered">
      <h2>{t.relatedLabel}</h2>
      <ul class="l-related">
        {related.map(([label, href]) => (<li><a href={href}>{label}<span aria-hidden="true">→</span></a></li>))}
      </ul>
    </section>

    <section class="l-shell l-closing">
      <h2>{t.closing.heading}</h2>
      <p>{t.closing.text}</p>
      <a class="l-button" href="#kontakt" data-revenue-cta="local_closing">{t.closing.cta}<span aria-hidden="true">→</span></a>
    </section>

    <SubpageContact lang={lang} source="seo-dresden-local" offerType="general" />
  </main>

  <Footer {...site.footer} lang={lang} />
</BaseLayout>

<style>
  .local-page{background:var(--paper);color:var(--ink);font-family:var(--sans)}
  .l-shell{width:min(100%,1120px);box-sizing:border-box;margin-inline:auto;padding-inline:32px}
  .l-hero{padding-block:40px 72px}
  .l-crumbs{display:flex;flex-wrap:wrap;gap:8px;color:var(--muted);font-size:13px}
  .l-crumbs a{color:inherit;text-underline-offset:3px}
  .l-hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:64px;align-items:start;margin-top:44px}
  .l-kicker{margin:0;color:var(--accent);font-size:12px;font-weight:680;letter-spacing:.09em;text-transform:uppercase}
  .l-hero-copy h1{margin:20px 0 0;font-size:clamp(34px,3.6vw,54px);font-weight:600;letter-spacing:-.035em;line-height:1.08}
  .l-lead{margin:24px 0 0;max-width:44ch;color:var(--muted);font-size:17px;line-height:1.62}
  .l-actions{display:flex;flex-wrap:wrap;gap:20px;align-items:center;margin-top:32px}
  .l-button{display:inline-flex;gap:8px;align-items:center;justify-content:center;max-width:100%;min-height:48px;padding:12px 26px;border-radius:6px;background:var(--accent);color:#fffaf4;font-size:15px;font-weight:650;line-height:1.3;text-decoration:none}
  .l-button:hover{filter:brightness(.93)}
  .l-button:focus-visible,.l-link:focus-visible,.l-inline-link:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .l-link,.l-inline-link{display:inline-flex;gap:8px;align-items:center;color:var(--accent);font-size:15px;font-weight:600;text-underline-offset:4px}

  /* Signature visual: the three surfaces one local search actually ends on. */
  .l-surfaces{margin:0;padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--paper-soft)}
  .l-surfaces-label{margin:0 0 16px;color:var(--muted);font-size:11px;font-weight:680;letter-spacing:.09em;text-transform:uppercase}
  .l-surface-query{display:flex;gap:12px;align-items:center;padding:12px 16px;border:1px solid var(--control-line);border-radius:999px;background:var(--paper)}
  .l-surface-query span{width:14px;height:14px;border:2px solid var(--muted);border-radius:50%;flex:none}
  .l-surface-query b{color:var(--ink);font-size:15px;font-weight:500}
  .l-surface-list{display:grid;gap:12px;margin:16px 0 0;padding:0;list-style:none}
  .l-surface{padding:16px 18px;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;background:var(--paper);opacity:1;transform:none}
  .l-surface-tag{margin:0;color:var(--accent);font-size:11px;font-weight:680;letter-spacing:.08em;text-transform:uppercase}
  .l-surface strong{display:block;margin-top:6px;font-size:16px;font-weight:600}
  .l-surface span{display:block;margin-top:6px;color:var(--muted);font-size:14px;line-height:1.55}
  .l-surfaces-note{margin:16px 0 0;color:var(--muted);font-size:12px;line-height:1.5}

  .l-block{padding-block:56px}
  .l-block-bordered{border-top:1px solid var(--line)}
  .l-block h2{margin:0;max-width:24ch;font-size:clamp(26px,2.5vw,36px);font-weight:600;letter-spacing:-.03em;line-height:1.15}
  .l-block p{margin:18px 0 0;max-width:70ch;color:var(--muted);font-size:16px;line-height:1.68}
  .l-answer{color:var(--ink)!important;font-size:18px!important;font-weight:550}
  .l-muted{font-size:14px!important}

  .l-readers{display:grid;gap:16px;margin:28px 0 0;padding:0;list-style:none;counter-reset:none}
  .l-readers li{padding:20px;border:1px solid var(--line);border-radius:10px;background:var(--paper-soft)}
  .l-readers span{display:grid;width:26px;height:26px;place-items:center;border:1px solid var(--control-line);border-radius:50%;color:var(--muted);font-size:13px}
  .l-readers strong{display:block;margin-top:10px;font-size:16px}
  .l-readers p{margin-top:6px;font-size:15px}

  .l-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:32px}
  .l-service-grid article{padding:22px;border:1px solid var(--line);border-radius:10px;background:var(--paper-soft)}
  .l-service-grid h3{margin:0;font-size:16px;font-weight:620}
  .l-service-grid p{margin-top:8px;font-size:15px}

  .l-price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:32px}
  .l-price-grid article{display:flex;flex-direction:column;padding:24px;border:1px solid var(--line);border-radius:10px;background:var(--paper-soft)}
  .l-price-grid h3{margin:0;font-size:18px;font-weight:620}
  .l-price-fit{margin-top:10px!important;font-size:14px!important;flex:1}
  .l-price-value{margin-top:16px!important;color:var(--ink)!important;font-size:24px!important;font-weight:620;letter-spacing:-.02em}
  .l-price-value span{color:var(--muted);font-size:14px;font-weight:400}
  .l-price-duration{margin-top:6px!important;font-size:13px!important}
  .l-price-link{display:inline-flex;gap:8px;align-items:center;margin-top:18px;color:var(--accent);font-size:15px;font-weight:600;text-underline-offset:4px}
  .l-price-link:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

  .l-steps{display:grid;gap:14px;margin:28px 0 0;padding:0;list-style:none}
  .l-steps li{display:grid;grid-template-columns:36px minmax(0,1fr);gap:18px;padding:18px 0;border-top:1px solid var(--line)}
  .l-steps span{display:grid;width:28px;height:28px;place-items:center;border:1px solid var(--control-line);border-radius:50%;color:var(--muted);font-size:13px}
  .l-steps strong{font-size:16px}
  .l-steps p{margin-top:6px;font-size:15px}

  .l-proof-label{margin-top:32px!important;color:var(--ink)!important;font-weight:620}
  .l-proof{display:grid;gap:0;margin:12px 0 0}
  .l-proof>div{display:grid;grid-template-columns:240px minmax(0,1fr);gap:28px;padding:18px 0;border-top:1px solid var(--line)}
  .l-proof dt{font-weight:620}
  .l-proof dd{margin:0;color:var(--muted);font-size:15px;line-height:1.62}

  .l-related{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:28px 0 0;padding:0;list-style:none}
  .l-related a{display:flex;gap:8px;justify-content:space-between;align-items:center;padding:16px 18px;border:1px solid var(--line);border-radius:10px;background:var(--paper-soft);color:var(--ink);font-size:15px;font-weight:550;text-decoration:none}
  .l-related a:hover{border-color:var(--accent);color:var(--accent)}
  .l-related a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

  .l-closing{padding-block:64px;border-top:1px solid var(--line)}
  .l-closing h2{margin:0;font-size:clamp(24px,2.2vw,32px);font-weight:600;letter-spacing:-.03em}
  .l-closing p{margin:16px 0 26px;max-width:60ch;color:var(--muted);font-size:16px;line-height:1.65}

  @media(max-width:1024px){
    .l-hero-grid{grid-template-columns:minmax(0,1fr);gap:44px}
    .l-service-grid,.l-price-grid,.l-related{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:720px){
    .l-shell{padding-inline:20px}
    /* Reclaim vertical space so the hero CTA stays inside small first viewports. */
    .l-hero{padding-block:24px 56px}
    .l-hero-grid{margin-top:24px;gap:32px}
    .l-lead{margin-top:16px;font-size:16px;line-height:1.55}
    .l-actions{margin-top:24px}
    .l-service-grid,.l-price-grid,.l-related{grid-template-columns:minmax(0,1fr)}
    .l-proof>div{grid-template-columns:minmax(0,1fr);gap:8px}
    .l-block{padding-block:44px}
  }

  /* Motion only reveals the surfaces in sequence; content is readable without it. */
  @media(prefers-reduced-motion:no-preference){
    :global(.local-surfaces-motion) .l-surface{opacity:0;transform:translateY(10px);transition:opacity .5s ease var(--surface-delay),transform .5s ease var(--surface-delay)}
    :global(.local-surfaces-motion) [data-local-surfaces].is-visible .l-surface{opacity:1;transform:none}
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const groups = document.querySelectorAll<HTMLElement>("[data-local-surfaces]");
  if (groups.length && !reduced.matches) {
    document.documentElement.classList.add("local-surfaces-motion");
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.25 });
    groups.forEach((group) => observer.observe(group));
  }
</script>
