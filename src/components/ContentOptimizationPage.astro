---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
interface Props { page: ServicePageContent }
const { page } = Astro.props; const de=page.lang === "de"; const site=content[page.lang]; const home=de?"/":"/en/"; const path=de?page.alternateDePath:page.alternateEnPath;
const crumbs=[{name:page.breadcrumb.home,href:home},{name:page.breadcrumb.hub,href:de?"/geo-optimierung/":"/en/geo-optimization/"},{name:page.breadcrumb.current,href:path}];
const copy=de?{label:"Content optimization / refresh",title:"Bestehende Inhalte klarer, aktueller und hilfreicher machen.",lead:"Nicht jede GEO-Maßnahme braucht eine neue Seite. Wir lesen deine Inhalte wie eine Antwort: Was ist sofort klar, was fehlt, was ist veraltet und welche Überarbeitung bringt wirklich mehr Orientierung?",cta:"Content-Check anfragen",intro:"Content-Optimierung mit einem klaren Prüfpfad",introLead:"Ein Refresh beginnt nicht mit blindem Umschreiben. Er beginnt mit einem Befund, einer Entscheidung pro Abschnitt und einer sichtbaren Verantwortung für die nächste Pflege.",audit:"Dein End-to-End-Content-Check",auditLead:"Bestehende Seiten werden entlang von Antwortklarheit, Aktualität, Quellen und Verbindungen gelesen.",proof:"Prüfen, entscheiden, pflegen",proofLead:"Die Oberfläche ist illustrativ – keine Analyse einer realen Kunden- oder ELBSAND-Seite.",faq:"Fragen zur Content-Optimierung für AI-Suche",close:"Erhalte mehr Klarheit aus dem Inhalt, den du schon hast."}:{label:"Content optimization / refresh",title:"Make existing content clearer, current and more useful.",lead:"Not every GEO task needs a new page. We read your content like an answer: what is immediately clear, what is missing, what has aged and which revision genuinely adds orientation?",cta:"Request a content check",intro:"Content optimization with a clear review path",introLead:"A refresh does not begin with blind rewriting. It begins with a finding, a decision for each section and visible ownership for later maintenance.",audit:"Your end-to-end content check",auditLead:"Existing pages are read for answer clarity, currency, sources and connections.",proof:"Review, decide, maintain",proofLead:"This interface is illustrative – not an analysis of an ELBSAND or client page.",faq:"Questions about content optimization for AI search",close:"Get more clarity from the content you already have."};
const modules=de?[["Content-Optimization-Vorschläge","H2, Einstieg und Aussagen nach Klarheit und Bedarf priorisieren."],["AEO-optimierter FAQ-Generator","Fragen aus dem Bestand in präzise, eigenständige Antworten überführen."],["Metadaten-Optimierung","Titel, Beschreibungen und interne Verweise mit dem tatsächlichen Seitenauftrag verbinden."],["SEO & AEO Workflow","Änderungen vom Befund bis zur Veröffentlichung in einem klaren Ablauf dokumentieren."]]:[["Content optimization suggestions","Prioritise openings, headings and statements by clarity and need."],["AEO-optimized FAQ generator","Turn questions in the inventory into precise, self-contained answers."],["Metadata optimization","Connect titles, descriptions and internal links to the page's actual job."],["SEO & AEO workflow","Document changes from finding to publication in one clear path."]];
const audit=de?[["Benchmark","Seite im Kontext ihrer wichtigsten Antwortfragen lesen."],["Score","Klarheit, Quellen und Aktualität als getrennte Signale markieren."],["Diagnose","Strukturelle, redaktionelle und technische Ursachen unterscheiden."],["Priorisieren","Änderungen nach Wirkung und Aufwand ordnen."],["Fix","Prüfbare Überarbeitungen an Redaktion oder Entwicklung übergeben."]]:[["Benchmark","Read the page around its most important answer questions."],["Score","Mark clarity, sources and currency as separate signals."],["Diagnose","Separate structural, editorial and technical causes."],["Prioritise","Order changes by impact and effort."],["Fix","Hand traceable revisions to editorial or development."]];
const proof=de?[["Behalten","Starke Passagen und belastbare Belege schützen."],["Präzisieren","Unklare Einstiege und Begriffe auf die Frage ausrichten."],["Belegen","Zahlen, Quellen und Zeitbezug sichtbar machen."],["Verschieben","Wiederholungen und Nebenpfade aus dem Hauptfluss nehmen."]]:[["Keep","Protect strong passages and dependable evidence."],["Sharpen","Align unclear openings and terms with the question."],["Support","Make figures, sources and time context visible."],["Move","Remove repetition and side paths from the main flow."]];
const schema={"@context":"https://schema.org","@graph":[{"@type":"Service",name:page.eyebrow,description:page.meta.description,url:new URL(path,"https://elbsand.studio").toString(),provider:{"@type":"ProfessionalService",name:"ELBSAND Design Studio"}},{"@type":"BreadcrumbList",itemListElement:crumbs.map((x,i)=>({"@type":"ListItem",position:i+1,name:x.name,item:new URL(x.href,"https://elbsand.studio").toString()}))},{"@type":"FAQPage",mainEntity:page.faq.items.map(x=>({"@type":"Question",name:x.question,acceptedAnswer:{"@type":"Answer",text:x.answer}}))}]};
---
<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={path} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="content-optimization-page">
  <Header lang={page.lang} nav={site.nav} cta={site.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath}/>
  <main id="main-content">
    <section class="co-hero co-shell"><nav class="co-crumbs" aria-label={de?"Brotkrumen-Navigation":"Breadcrumb"}>{crumbs.map((x,i)=><span><span aria-hidden="true">{i?"/":""}</span>{i===crumbs.length-1?<b aria-current="page">{x.name}</b>:<a href={x.href}>{x.name}</a>}</span>)}</nav><div class="co-hero-copy"><p class="co-label">{copy.label}</p><h1>{copy.title}</h1><p class="co-lead">{copy.lead}</p><div class="co-actions"><a class="co-button" href={`${home}#kontakt`}>{copy.cta}</a><a class="co-text-link" href="#co-review">{page.secondaryCta}<span>↓</span></a></div></div><div class="co-capabilities">{(de?["Klarheit","Aktualität","Quellen","Verbindungen"]:["Clarity","Currency","Sources","Connections"]).map((x,i)=><article><span>{i+1}</span><h2>{x}</h2><p>{[...modules][i][1]}</p></article>)}</div></section>
    <section class="co-signal co-shell"><p>{de?"Illustrative content review system":"Illustrative content review system"}</p><div>{(de?["Bestand","Frage","Beleg","Datum","Owner","Recheck"]:["Inventory","Question","Evidence","Date","Owner","Recheck"]).map((x,i)=><span><b>{i+1}</b>{x}</span>)}</div></section>
    <section class="co-review co-shell" id="co-review"><div class="co-review-intro"><p class="co-label">{copy.intro}</p><h2>{de?"Mit Vorschlägen arbeiten, die an der bestehenden Seite ansetzen.":"Work with suggestions that start from the existing page."}</h2><p>{copy.introLead}</p></div><div class="co-module-list">{modules.map((x)=><article><div><h3>{x[0]}</h3><p>{x[1]}</p></div><span aria-hidden="true">↗</span></article>)}</div></section>
    <section class="co-review co-review-second co-shell"><div class="co-review-intro"><p class="co-label">{copy.audit}</p><h2>{de?"Ein Content-Check, der von der Diagnose bis zum Fix reicht.":"A content check that runs from diagnosis to fix."}</h2><p>{copy.auditLead}</p></div><div class="co-audit-list">{audit.map((x,i)=><article><span>{i+1}</span><div><h3>{x[0]}</h3><p>{x[1]}</p></div></article>)}</div></section>
    <section class="co-proof co-shell"><div class="co-proof-intro"><p class="co-label">{copy.proof}</p><h2>{de?"Keine Punktzahl ohne Entscheidung.":"No score without a decision."}</h2><p>{copy.proofLead}</p></div><div class="co-proof-grid">{proof.map((x,i)=><article><span>{i+1}</span><h3>{x[0]}</h3><p>{x[1]}</p><i style={`--fill:${[82,64,46,28][i]}%`}></i></article>)}</div></section>
    <section class="co-faq co-shell" id="faq"><header><p class="co-label">FAQ</p><h2>{copy.faq}</h2></header><div>{page.faq.items.map(x=><details><summary>{x.question}<span>+</span></summary><p>{x.answer}</p></details>)}</div></section>
    <section class="co-related co-shell"><header><p class="co-label">{page.related.eyebrow}</p><h2>{page.related.title}</h2></header><div>{page.related.items.map(x=><a href={x.href}><span>↗</span><h3>{x.title}</h3><p>{x.text}</p></a>)}</div></section>
    <SubpageContact lang={page.lang} source="content-optimization-service" />
  </main><Footer {...site.footer} lang={page.lang}/>
</BaseLayout>
<script>
  const reduce=window.matchMedia("(prefers-reduced-motion: reduce)");const els=document.querySelectorAll<HTMLElement>(".co-review,.co-proof,.co-faq,.co-related,.co-close");if(reduce.matches)els.forEach(x=>x.classList.add("is-visible"));else{const o=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("is-visible");o.unobserve(e.target)}}),{threshold:.12,rootMargin:"-10% 0px"});els.forEach(x=>o.observe(x))}
</script>
<style is:global>
  .content-optimization-page{--co-bg:#090908;--co-ink:#f7f3eb;--co-muted:#a4a099;--co-dim:#716d66;--co-line:rgba(247,243,235,.14);--co-accent:#d56036;background:var(--co-bg);color:var(--co-ink);font-family:Inter,system-ui,sans-serif}.content-optimization-page header.site-header,.content-optimization-page footer.site-footer{background:var(--co-bg);color:var(--co-ink)}.co-shell{width:min(1056px,calc(100% - 40px));margin:0 auto}.co-hero{min-height:760px;padding-top:27px}.co-crumbs{display:flex;gap:10px;color:var(--co-dim);font-size:10px}.co-crumbs span{display:flex;gap:10px}.co-crumbs a:hover,.co-crumbs b{color:var(--co-ink)}.co-crumbs b{font-weight:500}.co-hero-copy{max-width:680px;padding-top:112px}.co-label{margin:0 0 16px;color:var(--co-accent);font-size:11px;font-weight:650;letter-spacing:.12em;text-transform:uppercase}.co-hero h1{max-width:650px;margin:0;font-size:clamp(50px,5.2vw,72px);font-weight:520;letter-spacing:-.075em;line-height:.98}.co-lead{max-width:540px;margin:26px 0 0;color:var(--co-muted);font-size:17px;line-height:1.55}.co-actions{display:flex;align-items:center;gap:22px;margin-top:30px}.co-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:7px;background:#b74622;color:#fff9f3;padding:0 17px;font-size:15px;font-weight:650;text-decoration:none;transition:transform 220ms ease,background 180ms ease}.co-button:hover{background:#d05a32;transform:translateY(-2px)}.co-text-link{display:flex;align-items:center;gap:10px;color:var(--co-ink);font-size:15px;text-decoration:none}.co-text-link span{color:var(--co-accent);font-size:18px}.co-capabilities{display:grid;grid-template-columns:repeat(4,1fr);margin-top:116px;border-top:1px solid var(--co-line);border-left:1px solid var(--co-line)}.co-capabilities article{min-height:178px;border-right:1px solid var(--co-line);border-bottom:1px solid var(--co-line);padding:18px}.co-capabilities article>span{color:var(--co-accent);font-size:11px}.co-capabilities h2{margin:35px 0 10px;font-size:16px;font-weight:520;letter-spacing:-.03em}.co-capabilities p{margin:0;color:var(--co-muted);font-size:13px;line-height:1.45}.co-signal{border-top:1px solid var(--co-line);padding:38px 0 50px}.co-signal>p{text-align:center;color:var(--co-muted);font-size:14px}.co-signal>div{display:grid;grid-template-columns:repeat(6,1fr);margin-top:24px;border:1px solid var(--co-line)}.co-signal span{display:flex;min-height:83px;align-items:center;justify-content:center;gap:8px;border-right:1px solid var(--co-line);color:var(--co-muted);font-size:12px}.co-signal span:last-child{border:0}.co-signal b{color:var(--co-accent);font-size:10px;font-weight:500}.co-review,.co-proof,.co-faq,.co-related,.co-close{border-top:1px solid var(--co-line);padding-top:118px;padding-bottom:122px;opacity:1;transform:none;transition:opacity 700ms ease,transform 700ms cubic-bezier(.2,.8,.2,1)}.co-review:not(.is-visible),.co-proof:not(.is-visible),.co-faq:not(.is-visible),.co-related:not(.is-visible),.co-close:not(.is-visible){opacity:.2;transform:translateY(18px)}.co-review-intro{display:grid;grid-template-columns:1fr 1.2fr;gap:70px}.co-review-intro h2{grid-column:2;grid-row:1;margin:0;font-size:clamp(44px,4.5vw,66px);font-weight:520;letter-spacing:-.075em;line-height:.98}.co-review-intro>p:last-child{grid-column:2;max-width:510px;margin:24px 0 0;color:var(--co-muted);font-size:17px;line-height:1.6}.co-module-list,.co-audit-list{display:grid;grid-column:2;margin-left:calc(100% / 2 + 35px);margin-top:75px;border-top:1px solid var(--co-line)}.co-module-list article{display:grid;grid-template-columns:1fr 20px;gap:15px;min-height:105px;border-bottom:1px solid var(--co-line);padding:22px 0}.co-module-list h3,.co-audit-list h3{margin:0 0 7px;font-size:16px;font-weight:520}.co-module-list p,.co-audit-list p{max-width:510px;margin:0;color:var(--co-muted);font-size:14px;line-height:1.5}.co-module-list article>span{color:var(--co-accent);font-size:18px}.co-review-second{padding-top:96px}.co-audit-list article{display:grid;grid-template-columns:38px 1fr;gap:18px;min-height:95px;border-bottom:1px solid var(--co-line);padding:20px 0}.co-audit-list article>span{display:grid;width:28px;height:28px;place-items:center;border:1px solid var(--co-accent);border-radius:50%;color:var(--co-accent);font-size:10px}.co-proof{display:grid;grid-template-columns:1fr 1.2fr;gap:85px;align-items:center}.co-proof h2{max-width:470px;margin:0;font-size:clamp(44px,4.5vw,63px);font-weight:520;letter-spacing:-.075em;line-height:.98}.co-proof-intro>p:not(.co-label){max-width:420px;margin:26px 0 0;color:var(--co-muted);font-size:16px;line-height:1.6}.co-proof-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--co-line)}.co-proof-grid article{position:relative;min-height:190px;border-right:1px solid var(--co-line);border-bottom:1px solid var(--co-line);padding:18px}.co-proof-grid article:nth-child(2n){border-right:0}.co-proof-grid article:nth-child(n+3){border-bottom:0}.co-proof-grid span{color:var(--co-accent);font-size:10px}.co-proof-grid h3{margin:41px 0 9px;font-size:17px;font-weight:520}.co-proof-grid p{margin:0;color:var(--co-muted);font-size:13px;line-height:1.45}.co-proof-grid i{position:absolute;right:18px;bottom:18px;left:18px;height:1px;background:var(--co-line);font-style:normal}.co-proof-grid i:after{display:block;width:var(--fill);height:2px;background:var(--co-accent);content:""}.co-faq,.co-related{display:grid;grid-template-columns:1fr 1.5fr;gap:80px}.co-faq h2,.co-related h2{margin:0;font-size:clamp(43px,4.5vw,64px);font-weight:520;letter-spacing:-.075em;line-height:.98}.co-faq details{border-top:1px solid var(--co-line)}.co-faq details:last-child{border-bottom:1px solid var(--co-line)}.co-faq summary{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;min-height:78px;cursor:pointer;font-size:16px;font-weight:500;list-style:none}.co-faq summary::-webkit-details-marker{display:none}.co-faq summary span{color:var(--co-accent);font-size:21px;transition:transform 180ms ease}.co-faq details[open] summary span{transform:rotate(45deg)}.co-faq details p{max-width:650px;margin:0 0 28px;color:var(--co-muted);font-size:15px;line-height:1.6}.co-related{display:block}.co-related header{display:grid;grid-template-columns:1fr 1.2fr;margin-bottom:56px}.co-related>div{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--co-line)}.co-related a{display:grid;min-height:220px;align-content:end;border-right:1px solid var(--co-line);padding:22px;text-decoration:none}.co-related a:last-child{border:0}.co-related a>span{align-self:start;justify-self:end;color:var(--co-accent);font-size:19px}.co-related h3{margin:0 0 9px;color:var(--co-ink);font-size:20px;font-weight:500}.co-related p{margin:0;color:var(--co-muted);font-size:14px;line-height:1.5}.co-close{display:grid;min-height:510px;justify-items:center;align-content:center;padding-top:95px;padding-bottom:95px;text-align:center}.co-close h2{max-width:760px;margin:0 0 23px;font-size:clamp(48px,5.4vw,74px);font-weight:520;letter-spacing:-.08em;line-height:.98}.co-close>p:not(.co-label){max-width:600px;margin:0;color:var(--co-muted);font-size:17px;line-height:1.6}.co-close .co-button{margin-top:29px}@media(max-width:800px){.co-shell{width:calc(100% - 40px)}.co-hero{min-height:0;padding-top:22px;padding-bottom:73px}.co-hero-copy{padding-top:90px}.co-hero h1{font-size:clamp(43px,11vw,55px)}.co-lead{font-size:16px}.co-actions{align-items:stretch;flex-direction:column;gap:17px}.co-actions a{justify-content:center}.co-capabilities{grid-template-columns:1fr 1fr;margin-top:74px}.co-capabilities article{min-height:195px;padding:15px}.co-capabilities h2{margin-top:36px;font-size:15px}.co-capabilities p{font-size:12px}.co-signal{padding:28px 0 46px}.co-signal>div{grid-template-columns:repeat(3,1fr)}.co-signal span{min-height:66px;font-size:10px}.co-review,.co-proof,.co-faq,.co-related,.co-close{padding-top:80px;padding-bottom:82px}.co-review-intro,.co-proof,.co-faq{display:block}.co-review-intro h2,.co-proof h2,.co-faq h2,.co-related h2{margin-top:10px;font-size:43px}.co-review-intro>p:last-child,.co-proof-intro>p:not(.co-label){margin-top:22px;font-size:16px}.co-module-list,.co-audit-list{margin-left:0;margin-top:48px}.co-module-list article{min-height:116px}.co-review-second{padding-top:80px}.co-proof-grid{margin-top:45px}.co-proof-grid article{min-height:205px;padding:15px}.co-proof-grid h3{margin-top:40px;font-size:16px}.co-faq{gap:44px}.co-related header{display:block;margin-bottom:44px}.co-related>div{grid-template-columns:1fr}.co-related a{min-height:180px;border-right:0;border-bottom:1px solid var(--co-line)}.co-related a:last-child{border-bottom:0}.co-close{min-height:460px}.co-close h2{font-size:49px}}@media(max-width:380px){.co-shell{width:calc(100% - 32px)}.co-hero-copy{padding-top:70px}.co-hero h1{font-size:41px}.co-capabilities article{min-height:220px;padding:12px 10px}.co-capabilities h2{font-size:14px}.co-signal span{font-size:9px}.co-module-list p,.co-audit-list p{font-size:13px}.co-close h2{font-size:43px}}@media(prefers-reduced-motion:reduce){.co-review,.co-proof,.co-faq,.co-related,.co-close,.co-button,.co-faq summary span{transition:none!important}.co-review:not(.is-visible),.co-proof:not(.is-visible),.co-faq:not(.is-visible),.co-related:not(.is-visible),.co-close:not(.is-visible){opacity:1;transform:none}}
</style>
<style is:global>.content-optimization-page .co-review,.content-optimization-page .co-proof,.content-optimization-page .co-faq,.content-optimization-page .co-related,.content-optimization-page .co-close{opacity:1;transform:none}</style>
