---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import FeatureCardGrid from "./FeatureCardGrid";
import IconFeaturePanel from "./IconFeaturePanel";
import LinkButton from "./LinkButton";
import RelatedLinkGrid from "./RelatedLinkGrid";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const isGerman = page.lang === "de";
const siteContent = content[page.lang];
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? page.alternateDePath : page.alternateEnPath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: isGerman ? "/geo-optimierung/" : "/en/geo-optimization/" },
  { name: page.breadcrumb.current, href: canonicalPath },
];

const copy = isGerman ? {
  label: "Content Optimization / Refresh",
  title: "Bestehende Inhalte klarer, aktueller und hilfreicher machen",
  lead: "Nicht jede GEO-Maßnahme braucht eine neue Seite. Wir lesen deine Inhalte wie eine Antwort: Was ist sofort klar, was fehlt, was ist veraltet und welche Überarbeitung bringt wirklich mehr Orientierung?",
  cta: "Content-Check anfragen",
  intro: "Content-Optimierung mit einem klaren Prüfpfad",
  introLead: "Ein Refresh beginnt nicht mit blindem Umschreiben. Er beginnt mit einem Befund, einer Entscheidung pro Abschnitt und einer sichtbaren Verantwortung für die nächste Pflege.",
  audit: "Dein End-to-End-Content-Check",
  auditLead: "Bestehende Seiten werden entlang von Antwortklarheit, Aktualität, Quellen und Verbindungen gelesen.",
  proof: "Prüfen, entscheiden, pflegen",
  proofLead: "Jede Änderung erhält einen klaren Grund und eine nachvollziehbare nächste Verantwortung.",
  faq: "Fragen zur Content-Optimierung für AI-Suche",
} : {
  label: "Content Optimization / Refresh",
  title: "Make existing content clearer, current and more useful",
  lead: "Not every GEO task needs a new page. We read your content like an answer: what is immediately clear, what is missing, what has aged and which revision genuinely adds orientation?",
  cta: "Request a content check",
  intro: "Content optimization with a clear review path",
  introLead: "A refresh does not begin with blind rewriting. It begins with a finding, a decision for each section and visible ownership for later maintenance.",
  audit: "Your end-to-end content check",
  auditLead: "Existing pages are read for answer clarity, currency, sources and connections.",
  proof: "Review, decide, maintain",
  proofLead: "Every change receives a clear reason and traceable ownership for what follows.",
  faq: "Questions about content optimization for AI search",
};

const modules = isGerman ? [
  { title: "Content-Optimierungs-Vorschläge", text: "Einstieg, Überschriften und Aussagen nach Klarheit und Bedarf priorisieren." },
  { title: "AEO-optimierte FAQs", text: "Fragen aus dem Bestand in präzise, eigenständige Antworten überführen." },
  { title: "Metadaten-Optimierung", text: "Titel, Beschreibungen und interne Verweise mit dem tatsächlichen Seitenauftrag verbinden." },
  { title: "SEO & AEO Workflow", text: "Änderungen vom Befund bis zur Veröffentlichung in einem klaren Ablauf dokumentieren." },
] : [
  { title: "Content optimization suggestions", text: "Prioritise openings, headings and statements by clarity and need." },
  { title: "AEO-optimized FAQs", text: "Turn questions in the inventory into precise, self-contained answers." },
  { title: "Metadata optimization", text: "Connect titles, descriptions and internal links to the page's actual job." },
  { title: "SEO & AEO workflow", text: "Document changes from finding to publication in one clear path." },
];

const auditItems = isGerman ? [
  { title: "Benchmark", text: "Die Seite im Kontext ihrer wichtigsten Antwortfragen lesen." },
  { title: "Signale trennen", text: "Klarheit, Quellen und Aktualität als getrennte Befunde markieren." },
  { title: "Diagnose", text: "Strukturelle, redaktionelle und technische Ursachen unterscheiden." },
  { title: "Priorisieren", text: "Änderungen nach Wirkung und Aufwand ordnen." },
  { title: "Fix", text: "Prüfbare Überarbeitungen an Redaktion oder Entwicklung übergeben." },
] : [
  { title: "Benchmark", text: "Read the page around its most important answer questions." },
  { title: "Separate signals", text: "Mark clarity, sources and currency as separate findings." },
  { title: "Diagnose", text: "Separate structural, editorial and technical causes." },
  { title: "Prioritise", text: "Order changes by impact and effort." },
  { title: "Fix", text: "Hand traceable revisions to editorial or development." },
];

const proofItems = isGerman ? [
  { title: "Behalten", text: "Starke Passagen und belastbare Belege schützen." },
  { title: "Präzisieren", text: "Unklare Einstiege und Begriffe auf die Frage ausrichten." },
  { title: "Belegen", text: "Zahlen, Quellen und Zeitbezug sichtbar machen." },
  { title: "Verschieben", text: "Wiederholungen und Nebenpfade aus dem Hauptfluss nehmen." },
] : [
  { title: "Keep", text: "Protect strong passages and dependable evidence." },
  { title: "Sharpen", text: "Align unclear openings and terms with the question." },
  { title: "Support", text: "Make figures, sources and time context visible." },
  { title: "Move", text: "Remove repetition and side paths from the main flow." },
];

const schema = createServicePageSchema({ lang: page.lang, title: page.meta.title, description: page.meta.description, path: canonicalPath, serviceName: page.eyebrow, breadcrumbs: breadcrumbItems, faqs: page.faq.items });
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="content-optimization-page ui-dark-page dark">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />

  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}</nav><div class="max-w-3xl pt-12"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{copy.label}</p><h1 class="m-0 mt-6 text-display-mobile font-medium text-foreground md:text-display">{copy.title}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{copy.lead}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={copy.cta} icon="right" /><LinkButton href="#content-review" label={page.secondaryCta} variant="secondary" icon="down" /></div></div><div class="mt-20"><FeatureCardGrid items={modules} columns={4} /></div></div></section>

    <section id="content-review" class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><div><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{copy.intro}</p><h2 class="m-0 mt-6 text-section-title font-medium text-foreground">{copy.audit}</h2></div><div><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{copy.introLead}</p><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{copy.auditLead}</p></div></header><IconFeaturePanel items={auditItems} label={copy.audit} /></section>

    <section class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><h2 class="m-0 text-section-title font-medium text-foreground">{copy.proof}</h2><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{copy.proofLead}</p></header><FeatureCardGrid items={proofItems} columns={2} /></div></section>

    <section class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{page.related.eyebrow}</p><h2 class="m-0 mt-6 max-w-2xl text-section-title font-medium text-foreground">{page.related.title}</h2><div class="mt-12"><RelatedLinkGrid items={page.related.items} /></div></section>

    <section class="border-t border-solid border-border"><div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{copy.faq}</h2><FaqAccordion items={page.faq.items} theme="dark" className="lg:col-span-2" /></div></section>

    <SubpageContact lang={page.lang} source="content-optimization-service" />
  </main>

  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>
