---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const siteContent = content[page.lang];
const isGerman = page.lang === "de";
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? page.alternateDePath : page.alternateEnPath;
const hubPath = isGerman ? "/geo-optimierung/" : "/en/geo-optimization/";
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: hubPath },
  ...(page.breadcrumb.parent ? [{ name: page.breadcrumb.parent.label, href: page.breadcrumb.parent.href }] : []),
  { name: page.breadcrumb.current, href: canonicalPath }
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", name: page.eyebrow, description: page.meta.description, url: new URL(canonicalPath, "https://elbsand.studio").toString(), provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio" } },
    { "@type": "BreadcrumbList", itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: new URL(item.href, "https://elbsand.studio").toString() })) },
    { "@type": "FAQPage", mainEntity: page.faq.items.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) }
  ]
};
const sourceKinds = isGerman ? ["Eigene Website", "Fachquelle", "Verzeichnis", "Redaktion"] : ["Owned website", "Expert source", "Directory", "Editorial"];
const checkLabels = isGerman ? ["gefunden", "eingeordnet", "gewichtet", "priorisiert"] : ["found", "classified", "weighted", "prioritised"];
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="source-route">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />
  <main id="main-content" class="source-page">
    <section class="s-hero s-shell">
      <nav class="s-crumbs" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}</nav>
      <div class="s-hero-grid">
        <div class="s-hero-copy"><p class="s-kicker">{page.eyebrow}</p><h1>{page.title}</h1><p>{page.lead}</p><div class="s-actions"><a class="s-button" href={`${homePath}#ki-check`}>{page.primaryCta}</a><a class="s-link" href="#source-path">{page.secondaryCta}<span aria-hidden="true">↓</span></a></div></div>
        <div class="s-source-map" aria-label={isGerman ? "Illustrativer Quellenpfad" : "Illustrative source path"}><div class="s-map-heading"><span>{isGerman ? "Antwortquelle" : "Answer source"}</span><b>{isGerman ? "Pfad prüfen" : "Review path"}</b></div><div class="s-map-answer"><small>{isGerman ? "Antwort" : "Answer"}</small><strong>{isGerman ? "Lokales Webdesign für Dresden" : "Local web design for Dresden"}</strong><span>{isGerman ? "3 Quellen verknüpft" : "3 sources connected"}</span></div><div class="s-map-path"><i></i><i></i><i></i></div><div class="s-map-sources"><span><b>W</b>{isGerman ? "Leistungsseite" : "Service page"}</span><span><b>F</b>{isGerman ? "Fachartikel" : "Expert article"}</span><span><b>L</b>{isGerman ? "Lokales Profil" : "Local profile"}</span></div><small class="s-illustrative">{isGerman ? "Illustrative Darstellung · keine echten Zitate" : "Illustrative view · no real citations"}</small></div>
      </div>
    </section>

    <section id="source-path" class="s-path s-shell" data-s-reveal>
      <header><p class="s-kicker">{page.demo.eyebrow}</p><h2>{isGerman ? "Jede Antwort hat eine Herkunft." : "Every answer has an origin."}</h2><p>{page.demo.note}</p></header>
      <div class="s-path-stage"><div class="s-path-axis" aria-hidden="true"><i></i><i></i><i></i><i></i></div><ol>{page.method.steps.map((step, index) => <li class:list={{ "is-active": index === 0 }} data-s-source-step={index}><span>{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div><b>{checkLabels[index]}</b></li>)}</ol></div>
    </section>

    <section class="s-citation s-shell" data-s-reveal>
      <div class="s-citation-intro"><p class="s-kicker">{isGerman ? "Quellenkarte" : "Source map"}</p><h2>{isGerman ? "Belege sortieren, statt Links zu sammeln." : "Sort evidence instead of collecting links."}</h2><p>{isGerman ? "Die Analyse verbindet Zitat, Quellentyp und inhaltliche Passung. So bleibt sichtbar, wo ein Inhalt trägt und wo ein Beleg fehlt." : "The analysis connects citation, source type and editorial fit. You can see where content carries and where evidence is missing."}</p></div>
      <div class="s-citation-board"><div class="s-board-head"><span>{isGerman ? "Belegpfade" : "Evidence paths"}</span><small>{isGerman ? "Illustrative sample" : "Illustrative sample"}</small></div><div class="s-board-grid"><div class="s-board-labels"><span>{isGerman ? "Quelle" : "Source"}</span><span>{isGerman ? "Kategorie" : "Category"}</span><span>{isGerman ? "Passung" : "Fit"}</span></div>{page.demo.checks.map((check, index) => <div class="s-board-row"><span><i class:list={{ "warm": index === 0 }}></i>{check.label}</span><span>{sourceKinds[index]}</span><span><em class:list={{ "good": check.status === "clear", "warn": check.status !== "clear" }}>{check.status === "clear" ? "92%" : index === 1 ? "61%" : "34%"}</em></span></div>)}</div><div class="s-board-footer"><span>{isGerman ? "Hinweis: Werte sind bewusst illustrativ." : "Note: values are intentionally illustrative."}</span><a href="#next-step">{isGerman ? "Quelle besprechen" : "Discuss a source"} ↗</a></div></div>
    </section>

    <section class="s-signals s-shell"><div class="s-signals-heading"><p class="s-kicker">{isGerman ? "Was daraus folgt" : "What follows"}</p><h2>{isGerman ? "Quellen werden zu redaktionellen Entscheidungen." : "Sources become editorial decisions."}</h2></div><div class="s-signal-grid">{page.outcomes.map((outcome, index) => <article data-s-reveal><span>{index + 1}</span><h3>{outcome.title}</h3><p>{outcome.text}</p><div class="s-signal-line"><i style={`--signal-width:${[72,48,88][index] ?? 64}%`}></i></div></article>)}</div></section>

    <section id="next-step" class="s-faq s-shell"><div><p class="s-kicker">{page.faq.eyebrow}</p><h2>{page.faq.title}</h2></div><div>{page.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
    <SubpageContact lang={page.lang} source="source-analysis-service" />
  </main>
  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reduceSource = window.matchMedia("(prefers-reduced-motion: reduce)");
  const sourceRoot = document.querySelector(".source-page");
  if (sourceRoot && !reduceSource.matches) {
    const revealSource = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.14, rootMargin: "0px 0px -10%" });
    sourceRoot.querySelectorAll("[data-s-reveal]").forEach((el) => revealSource.observe(el));
    const rows = [...sourceRoot.querySelectorAll("[data-s-source-step]")];
    const rowObserver = new IntersectionObserver((entries) => { const active = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]; if (!active) return; const index = Number(active.target.getAttribute("data-s-source-step")); rows.forEach((row, i) => row.classList.toggle("is-active", i === index)); }, { threshold: [0.28, 0.6], rootMargin: "-22% 0px -44%" });
    rows.forEach((row) => rowObserver.observe(row));
  } else sourceRoot?.querySelectorAll("[data-s-reveal]").forEach((el) => el.classList.add("is-visible"));
</script>

<style>
  :global(body.source-route .site-header),:global(body.source-route .site-footer){background:#171715;color:#fbf8f2;border-color:rgba(255,250,244,.14)}:global(body.source-route .language-switch){background:rgba(255,250,244,.06)}:global(body.source-route .language-switch a[aria-current="page"]){background:rgba(255,250,244,.12);box-shadow:none}
  :global(body.source-route){--s-bg:#171715;--s-surface:#24221f;--s-line:rgba(255,250,244,.15);--s-ink:#fbf8f2;--s-muted:#b7b0a5;--s-accent:#b74622;background:var(--s-bg);color:var(--s-ink);font-family:Inter,system-ui,sans-serif}.source-page{overflow:hidden}.s-shell{width:min(100%,1120px);margin-inline:auto;padding-inline:32px}.s-hero{padding-top:28px}.s-crumbs{display:flex;flex-wrap:wrap;gap:8px;color:var(--s-muted);font-size:12px}.s-crumbs a:hover{color:var(--s-ink)}.s-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(350px,.78fr);gap:88px;align-items:center;padding:100px 0 120px}.s-kicker{margin:0 0 20px;color:#d37a5c;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.s-hero h1{max-width:660px;margin:0;font-size:clamp(54px,6.3vw,82px);font-weight:520;line-height:.97;letter-spacing:-.065em;text-wrap:balance}.s-hero-copy>p:not(.s-kicker){max-width:600px;margin:30px 0 0;color:var(--s-muted);font-size:18px;line-height:1.6}.s-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.s-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:8px;background:var(--s-accent);padding:0 18px;color:#fff7ed;font-size:15px;font-weight:650;text-decoration:none;transition:transform 180ms ease,background 180ms ease}.s-button:hover{background:#c9532b;transform:translateY(-2px)}.s-link{display:inline-flex;min-height:48px;align-items:center;gap:18px;border:1px solid rgba(255,250,244,.28);border-radius:8px;padding:0 18px;color:var(--s-ink);font-size:15px;font-weight:600}.s-link span{color:#d37a5c}.s-source-map{position:relative;min-height:470px;border:1px solid var(--s-line);background:#10100f;padding:20px;transform:rotate(1.4deg);box-shadow:24px 30px 80px rgba(0,0,0,.22);transition:transform 650ms cubic-bezier(.2,.7,.2,1)}.s-source-map::before{position:absolute;inset:45px 0 0;background:repeating-linear-gradient(0deg,transparent 0 51px,rgba(255,250,244,.07) 52px),repeating-linear-gradient(90deg,transparent 0 69px,rgba(255,250,244,.07) 70px);content:"";opacity:.6}.s-source-map:hover{transform:rotate(0deg) translateY(-5px)}.s-map-heading{position:relative;display:flex;justify-content:space-between;border-bottom:1px solid var(--s-line);padding-bottom:16px;color:#8e8a82;font-size:12px}.s-map-heading b{color:#d37a5c;font-weight:600}.s-map-answer{position:relative;display:grid;gap:10px;margin:58px 18px 0;border:1px solid rgba(255,250,244,.19);background:#23221f;padding:18px}.s-map-answer small{color:#8e8a82;font-size:11px;text-transform:uppercase;letter-spacing:.11em}.s-map-answer strong{font-size:19px;font-weight:570}.s-map-answer span{color:#9c958b;font-size:12px}.s-map-path{position:relative;display:grid;grid-template-columns:repeat(3,1fr);margin:0 75px;height:74px;align-items:center}.s-map-path::before{position:absolute;top:50%;right:0;left:0;height:1px;background:#b74622;content:"";opacity:.7}.s-map-path i{position:relative;z-index:1;width:13px;height:13px;border:3px solid #b74622;border-radius:50%;background:#10100f}.s-map-path i:nth-child(2){justify-self:center}.s-map-path i:last-child{justify-self:end}.s-map-sources{position:relative;display:grid;gap:9px;margin:0 18px}.s-map-sources span{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--s-line);padding:11px 0;color:#d3cbc1;font-size:13px}.s-map-sources b{display:grid;width:24px;height:24px;place-items:center;border:1px solid #746e65;border-radius:50%;color:#d37a5c;font-size:11px}.s-illustrative{position:absolute;right:20px;bottom:17px;color:#77726b;font-size:10px}.s-path{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1fr);gap:100px;border-top:1px solid var(--s-line);padding-top:130px;padding-bottom:140px}.s-path header h2{max-width:490px;margin:0;font-size:clamp(40px,4.7vw,60px);font-weight:520;line-height:1;letter-spacing:-.06em}.s-path header>p:last-child{max-width:370px;margin-top:25px;color:var(--s-muted);font-size:16px;line-height:1.6}.s-path-stage{position:relative}.s-path-axis{position:absolute;top:28px;bottom:28px;left:18px;width:1px;background:linear-gradient(#d37a5c,rgba(183,70,34,.2));content:""}.s-path-axis i{position:absolute;left:-4px;width:9px;height:9px;border-radius:50%;background:#171715;border:1px solid #d37a5c}.s-path-axis i:nth-child(1){top:0}.s-path-axis i:nth-child(2){top:33%}.s-path-axis i:nth-child(3){top:66%}.s-path-axis i:nth-child(4){bottom:0}.s-path-stage ol{position:relative;margin:0;padding:0;list-style:none}.s-path-stage li{display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:17px;min-height:192px;border-top:1px solid var(--s-line);padding:27px 0 27px 0;opacity:.36;transition:opacity 500ms ease,transform 500ms ease}.s-path-stage li.is-active{opacity:1;transform:translateX(8px)}.s-path-stage li>span{display:grid;width:36px;height:36px;place-items:center;border:1px solid #d37a5c;border-radius:50%;background:var(--s-bg);color:#d37a5c;font-size:13px}.s-path-stage h3{margin:4px 0 12px;font-size:25px;font-weight:530;letter-spacing:-.04em}.s-path-stage p{max-width:425px;margin:0;color:var(--s-muted);font-size:16px;line-height:1.58}.s-path-stage b{align-self:start;padding-top:8px;color:#d37a5c;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em}.s-citation{display:grid;grid-template-columns:minmax(0,.62fr) minmax(0,1fr);gap:80px;border-top:1px solid var(--s-line);padding-top:130px;padding-bottom:130px}.s-citation-intro h2{max-width:410px;margin:0;font-size:clamp(40px,4.5vw,58px);font-weight:520;line-height:1.01;letter-spacing:-.055em}.s-citation-intro>p:last-child{max-width:390px;margin-top:25px;color:var(--s-muted);font-size:16px;line-height:1.6}.s-citation-board{border:1px solid var(--s-line);background:#11110f}.s-board-head,.s-board-footer{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--s-line);padding:17px 20px;color:#d8d0c5;font-size:13px}.s-board-head small{color:#8f8980;font-size:11px}.s-board-grid{padding:17px 20px 0}.s-board-labels,.s-board-row{display:grid;grid-template-columns:1.4fr 1fr .6fr;gap:15px;align-items:center}.s-board-labels{padding:0 12px 12px;color:#757069;font-size:10px;letter-spacing:.11em;text-transform:uppercase}.s-board-row{min-height:60px;border-top:1px solid var(--s-line);padding:0 12px;color:#d8d0c5;font-size:13px}.s-board-row span:first-child{display:flex;align-items:center;gap:9px}.s-board-row span:first-child i{width:8px;height:8px;border-radius:50%;background:#77736c}.s-board-row span:first-child i.warm{background:#d37a5c}.s-board-row span:nth-child(2){color:#918a80}.s-board-row em{font-style:normal;color:#d37a5c}.s-board-row em.good{color:#9cb992}.s-board-row em.warn{color:#d37a5c}.s-board-footer{border-top:1px solid var(--s-line);border-bottom:0;color:#8e8880;font-size:11px}.s-board-footer a{color:#d37a5c}.s-signals{border-top:1px solid var(--s-line);padding-top:120px;padding-bottom:120px}.s-signals-heading{max-width:600px;margin-bottom:62px}.s-signals-heading h2{margin:0;font-size:clamp(40px,4.5vw,58px);font-weight:520;line-height:1.02;letter-spacing:-.055em}.s-signal-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--s-line);border-bottom:1px solid var(--s-line)}.s-signal-grid article{min-height:270px;padding:26px;border-left:1px solid var(--s-line)}.s-signal-grid article:first-child{border-left:0}.s-signal-grid article>span{color:#d37a5c;font-size:13px}.s-signal-grid h3{margin:64px 0 13px;font-size:25px;font-weight:520;letter-spacing:-.04em}.s-signal-grid p{margin:0;color:var(--s-muted);font-size:15px;line-height:1.55}.s-signal-line{height:2px;margin-top:28px;background:var(--s-line)}.s-signal-line i{display:block;width:var(--signal-width);height:100%;background:#d37a5c}.s-faq{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:90px;border-top:1px solid var(--s-line);padding-top:110px;padding-bottom:110px}.s-faq h2{max-width:400px;margin:0;font-size:clamp(38px,4vw,56px);font-weight:520;line-height:1.03;letter-spacing:-.055em}.s-faq details{border-top:1px solid var(--s-line);padding:21px 0}.s-faq details:last-child{border-bottom:1px solid var(--s-line)}.s-faq summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer;font-size:16px;font-weight:600;list-style:none}.s-faq summary::-webkit-details-marker{display:none}.s-faq summary span{color:#d37a5c;font-size:22px;font-weight:400}.s-faq details p{max-width:600px;margin:16px 0 3px;color:var(--s-muted);font-size:16px;line-height:1.6}.s-close{display:grid;justify-items:center;border-top:1px solid var(--s-line);padding-top:120px;padding-bottom:130px;text-align:center}.s-close h2{max-width:770px;margin:0;font-size:clamp(46px,5.4vw,72px);font-weight:520;line-height:1;letter-spacing:-.065em}.s-close>p:not(.s-kicker){max-width:580px;margin:24px 0;color:var(--s-muted);font-size:17px;line-height:1.6}.s-close .s-button{margin-top:8px}
  @media(max-width:860px){.s-shell{padding-inline:20px}.s-hero-grid{grid-template-columns:1fr;gap:70px;padding:82px 0 100px}.s-source-map{max-width:540px;justify-self:center;width:100%}.s-path,.s-citation,.s-faq{grid-template-columns:1fr;gap:46px}.s-path,.s-citation{padding-top:90px;padding-bottom:100px}.s-signals{padding-top:90px;padding-bottom:90px}.s-faq{padding-top:80px;padding-bottom:90px}.s-signal-grid{grid-template-columns:1fr}.s-signal-grid article{min-height:210px;border-left:0;border-top:1px solid var(--s-line)}.s-signal-grid article:first-child{border-top:0}.s-signal-grid h3{margin-top:42px}}
  @media(max-width:560px){.s-hero{padding-top:22px}.s-hero-grid{grid-template-columns:minmax(0,1fr);padding-top:76px;gap:52px;padding-bottom:80px}.s-hero-grid>*{min-width:0}.s-hero h1{font-size:50px}.s-hero-copy>p:not(.s-kicker){font-size:17px}.s-actions{display:grid}.s-actions>*{width:100%}.s-source-map{width:100%;min-height:425px;padding:15px;transform:none}.s-map-answer{margin:48px 10px 0}.s-map-path{margin:0 45px;height:66px}.s-map-sources{margin-inline:10px}.s-path header h2,.s-citation-intro h2,.s-signals-heading h2{font-size:42px}.s-path-stage li{grid-template-columns:34px minmax(0,1fr);gap:14px;min-height:0;padding:27px 0 43px}.s-path-stage li>span{width:32px;height:32px}.s-path-stage b{grid-column:2;padding-top:0}.s-path-stage h3{font-size:24px}.s-path-stage p{font-size:16px}.s-board-grid{padding-inline:10px}.s-board-head,.s-board-footer{padding-inline:13px}.s-board-labels,.s-board-row{grid-template-columns:1.3fr .85fr .55fr;gap:8px;padding-inline:7px;font-size:11px}.s-board-row{min-height:62px}.s-board-row span:nth-child(2){overflow-wrap:anywhere}.s-signal-grid article{padding-inline:0}.s-faq{gap:36px}.s-close{padding-top:80px;padding-bottom:88px}.s-close h2{font-size:48px}.s-close>p:not(.s-kicker){font-size:16px}}
  @media(prefers-reduced-motion:reduce){.s-source-map,.s-button,.s-path-stage li{transition:none}.s-source-map{transform:none}.s-path-stage li{opacity:1;transform:none}.s-button:hover{transform:none}}
</style>
