---
import { offers, type OfferId } from "../content/offers";

interface Props { lang: "de" | "en"; offer: OfferId }
const { lang, offer } = Astro.props;
const de = lang === "de";
const copy = offers[lang][offer];

// Explicit labels so a reader or an extracting agent can answer scope, deliverables,
// duration, price and limits without interpreting marketing prose.
const rows: readonly (readonly [string, string])[] = de ? [
  ["Geeignet für", copy.fitFor],
  ["Umfang", copy.scope],
  ["Sie erhalten", copy.deliverables],
  ["Dauer", copy.duration],
  ["Grenzen", copy.limits],
] : [
  ["Suited to", copy.fitFor],
  ["Scope", copy.scope],
  ["You receive", copy.deliverables],
  ["Duration", copy.duration],
  ["Limits", copy.limits],
];

// Question headings mirror researched buyer queries; the price row answers immediately.
const heading = de
  ? offer === "geo_audit" ? "Was kostet ein GEO Audit und was ist enthalten?"
    : offer === "page_sprint" ? "Was kostet ein Seiten-Sprint und was ist enthalten?"
    : "Was kostet die laufende Betreuung und was passiert monatlich?"
  : offer === "geo_audit" ? "What does a GEO audit cost and what is included?"
    : offer === "page_sprint" ? "What does a page sprint cost and what is included?"
    : "What does ongoing support cost and what happens each month?";

const priceLabel = de ? "Preis" : "Price";
const nextStepLabel = de ? "Nächster Schritt" : "Next step";

const crossLink = offer === "geo_audit"
  ? { href: de ? "/content-optimierung-ai-suche/" : "/en/content-optimization-ai-search/", label: de ? "Das Problem ist bereits klar? Zum Seiten-Sprint" : "Already know the problem? Explore the page sprint" }
  : offer === "page_sprint"
    ? { href: de ? "/geo-audit/" : "/en/geo-audit/", label: de ? "Die Ursache ist noch unklar? Zum GEO Audit" : "Cause still unclear? Explore the GEO audit" }
    : { href: de ? "/geo-audit/" : "/en/geo-audit/", label: de ? "Noch kein Ausgangsbefund? Zum GEO Audit" : "No baseline yet? Explore the GEO audit" };
---
<section class="offer-scope" aria-labelledby={`scope-${offer}`}>
  <h2 id={`scope-${offer}`}>{heading}</h2>

  <dl>
    <div class="offer-price-row">
      <dt>{priceLabel}</dt>
      <dd>
        <span class="offer-price-value">{copy.price} <span>{copy.priceSuffix}</span></span>
        <span class="offer-price-note">{copy.priceNote}</span>
      </dd>
    </div>
    {rows.map(([title, description]) => <div><dt>{title}</dt><dd>{description}</dd></div>)}
    <div>
      <dt>{nextStepLabel}</dt>
      <dd><a class="offer-next-cta" href={copy.ctaHref} data-revenue-cta="offer_scope" data-offer={offer}>{copy.cta}</a></dd>
    </div>
  </dl>

  <p><a href={crossLink.href}>{crossLink.label}</a></p>
</section>
<style>
  .offer-scope{width:min(100%,1120px);box-sizing:border-box;margin-inline:auto;padding:64px 32px;border-top:1px solid rgba(255,250,244,.15);color:#fbf8f2;font-family:var(--sans)}
  h2{margin:0 0 32px;max-width:850px;font-family:var(--sans);font-size:clamp(30px,3vw,40px);font-weight:550;line-height:1.12;letter-spacing:-.04em}
  dl{margin:0} dl>div{display:grid;grid-template-columns:200px minmax(0,1fr);gap:32px;padding:24px 0;border-top:1px solid rgba(255,250,244,.15)}
  dt{color:#fbf8f2;font-weight:650;text-transform:none;letter-spacing:normal} dd{margin:0} dd,p{color:#b9b4aa;font-size:16px;line-height:1.65} p{margin:24px 0 0}
  .offer-price-row{border-top:0}
  .offer-price-value{display:block;color:#fbf8f2;font-size:clamp(26px,2.4vw,32px);font-weight:600;letter-spacing:-.02em}
  .offer-price-value span{color:#b9b4aa;font-size:16px;font-weight:400;letter-spacing:0}
  .offer-price-note{display:block;margin-top:10px;max-width:820px;font-size:15px;line-height:1.6}
  .offer-next-cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;width:fit-content;padding:0 24px;border-radius:6px;background:#b74622;color:#fffaf4;font-size:15px;font-weight:650;text-decoration:none}
  .offer-next-cta:hover{background:#a03d1d}
  .offer-next-cta:focus-visible{outline:2px solid #e98764;outline-offset:3px}
  a{color:#e98764;text-underline-offset:4px} a:focus-visible{outline:2px solid #e98764;outline-offset:4px}
  @media(max-width:640px){
    .offer-scope{padding:48px 20px}
    dl>div{grid-template-columns:minmax(0,1fr);gap:12px}
  }
</style>
