---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";
import type { ServicePageContent } from "../content/service-pages";

interface Props { page: ServicePageContent }
const { page } = Astro.props;
const de = page.lang === "de";
const siteContent = content[page.lang];
const homePath = de ? "/" : "/en/";
const canonicalPath = de ? page.alternateDePath : page.alternateEnPath;
const breadcrumbItems = [
  { name: page.breadcrumb.home, href: homePath },
  { name: page.breadcrumb.hub, href: de ? "/geo-optimierung/" : "/en/geo-optimization/" },
  { name: page.breadcrumb.current, href: canonicalPath }
];
const text = de ? {
  heroLabel: "Prompt research / AI demand",
  heroTitle: "Welche Fragen prägen die KI-Gespräche rund um deine Marke?",
  heroLead: "Entdecke relevante Gespräche, erkenne, wie dein Unternehmen darin erscheint, und nutze die Erkenntnisse, um deine Sichtbarkeit gezielt zu verbessern.",
  cta: "Prompt-Recherche anfragen", secondary: "Methode ansehen",
  illustrative: "Illustrative Arbeitsansicht", how: "So arbeiten wir",
  hierarchy: "Fragebeziehungen sichtbar machen", hierarchyLead: "Wir verbinden Ausgangsfragen, Themen und konkrete Formulierungen zu einem Arbeitsfeld, das sich nach Bedarf filtern und priorisieren lässt.",
  report: "Eine Recherche, die in Arbeit übergeht", reportLead: "Aus dem Fragebild entsteht kein beliebiger Content-Kalender, sondern eine nachvollziehbare Auswahl für Audit, Seitenstruktur und laufende Checks.",
  intent: "Die Absicht hinter jeder Frage verstehen", intentLead: "Orientierung, Vergleich, Kauf und konkrete Umsetzung verlangen unterschiedliche Antworten. Wir ordnen Fragen nach ihrer Rolle im Entscheidungsweg.",
  competitors: "Sehen, wo andere Antworten anschlussfähiger sind", competitorsLead: "Wir prüfen, welche Themen und Quellen in relevanten Antwortbildern auftauchen und wo eine belastbare eigene Grundlage fehlt.",
  trust: "Auf echten Fragen aufbauen, sauber eingeordnet", trustLead: "Die Arbeitsansicht ist ein illustratives Modell. Keine Zahlen auf dieser Seite sind Kundenwerte oder eine Zusage für spätere KI-Antworten.",
  related: "Weiterführende Arbeit", faq: "Fragen zur Prompt-Recherche", close: "Beginne mit den Fragen, die wirklich auf dem Tisch liegen.", closeLead: "Wir machen aus diffusem Interesse ein klares Fragenbild und zeigen, welche nächste GEO-Maßnahme daraus sinnvoll folgt."
} : {
  heroLabel: "Prompt research / AI demand",
  heroTitle: "Which questions shape the AI conversations around your brand?",
  heroLead: "Explore relevant conversations, understand how your business appears within them and use those insights to improve your visibility with purpose.",
  cta: "Request prompt research", secondary: "View the method",
  illustrative: "Illustrative working view", how: "How it works",
  hierarchy: "Make question relationships visible", hierarchyLead: "We connect seed questions, topics and specific wording into a working field that can be filtered and prioritised as needed.",
  report: "Research that turns into work", reportLead: "The question map becomes more than a content calendar: it creates a traceable selection for audits, page structure and ongoing checks.",
  intent: "Understand the intent behind each question", intentLead: "Orientation, comparison, purchase and implementation require different answers. We place each question in the decision path it serves.",
  competitors: "See where other answers connect better", competitorsLead: "We review which topics and sources appear in relevant answer patterns and where a dependable foundation is missing.",
  trust: "Build on real questions, carefully framed", trustLead: "This interface is an illustrative model. No figures on this page are client results or a promise of future AI answers.",
  related: "Continue the work", faq: "Questions about prompt research", close: "Start with the questions that are genuinely on the table.", closeLead: "We turn vague interest into a clear question map and show which GEO action makes sense next."
};
const fields = de ? [
  ["Orientierung", "Welche Lösung passt zu meiner Situation?"], ["Vergleich", "Woran lassen sich Optionen prüfen?"], ["Vertrauen", "Welche Belege fehlen noch?"], ["Auswahl", "Was muss vor einer Anfrage klar sein?"]
] : [
  ["Orientation", "Which solution fits my situation?"], ["Comparison", "How can I assess the options?"], ["Trust", "Which evidence is still missing?"], ["Choice", "What needs to be clear before enquiring?"]
];
const flow = de ? [
  ["1", "Fragen entdecken", "Kundensprache und Themenfelder aus dem Angebot herausarbeiten."], ["2", "Relevanz prüfen", "Fragen nach Bedarf, Nähe zur Entscheidung und Kontext sortieren."], ["3", "Prompts verfolgen", "Die wichtigsten Formulierungen für spätere Checks festhalten."], ["4", "Arbeit starten", "Prioritäten in Audit, Content und Monitoring übergeben."]
] : [
  ["1", "Discover trends", "Uncover customer language and topic fields around your offer."], ["2", "Find prompts worth tracking", "Sort questions by need, decision proximity and context."], ["3", "Track performance", "Keep the most useful wording for repeatable future checks."], ["4", "Take action", "Hand priorities into audit, content and monitoring work."]
];
const flowVisuals = [
  "/images/prompt-research-discover-trends-v2.webp",
  "/images/prompt-research-relevance-v2.webp",
  "/images/prompt-research-track-prompts-v2.webp",
  "/images/prompt-research-action.webp"
];
const intentFields = de ? [["Informativ", "Verstehen", "Was ist wichtig, bevor ich entscheide?"], ["Vergleichend", "Abwägen", "Welche Unterschiede zählen wirklich?"], ["Konkreter Bedarf", "Handeln", "Wie löse ich dieses Problem jetzt?"], ["Lokal", "Vertrauen", "Wer kann mich in meiner Nähe unterstützen?"]] : [["Informational", "Understand", "What matters before I decide?"], ["Comparative", "Evaluate", "Which differences actually matter?"], ["Specific need", "Act", "How do I solve this problem now?"], ["Local", "Trust", "Who can support me nearby?"]];
const sourceFields = de ? [["Themen-Prompts", "Fragen mit hohem Informationsbedarf"], ["Zitationslücken", "Themen, bei denen eine Quelle fehlt"], ["Mitnennungen", "Antworten, in denen mehrere Optionen erscheinen"]] : [["Topic prompts", "Questions with a high information need"], ["Citation gaps", "Topics where a source is missing"], ["Co-mentions", "Answers where several options appear"]];
const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "Service", name: page.eyebrow, description: page.meta.description, url: new URL(canonicalPath, "https://elbsand.studio").toString(), provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio", url: "https://elbsand.studio/" }, areaServed: ["Deutschland", "DACH"] },
  { "@type": "BreadcrumbList", itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: new URL(item.href, "https://elbsand.studio").toString() })) },
  { "@type": "FAQPage", mainEntity: page.faq.items.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) }
] };
---

<BaseLayout title={page.meta.title} description={page.meta.description} lang={page.lang} canonicalPath={canonicalPath} alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} schema={schema} bodyClass="prompt-page">
  <Header lang={page.lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath={page.alternateDePath} alternateEnPath={page.alternateEnPath} />
  <main id="main-content">
    <section class="pv-hero pv-shell">
      <nav class="pv-breadcrumb" aria-label={de ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <span><span aria-hidden="true">{index ? "/" : ""}</span>{index === breadcrumbItems.length - 1 ? <b aria-current="page">{item.name}</b> : <a href={item.href}>{item.name}</a>}</span>)}</nav>
      <div class="pv-hero-copy"><p class="pv-label">{text.heroLabel}</p><h1>{text.heroTitle}</h1><p class="pv-lead">{text.heroLead}</p><div class="pv-actions"><a class="pv-button" href={`${homePath}#ki-check`}>{text.cta}</a><a class="pv-link" href="#flow">{text.secondary}<span aria-hidden="true">↓</span></a></div></div>
      <figure class="pv-dashboard" aria-labelledby="pv-dashboard-caption">
        <div class="pv-sidebar"><strong>ELBSAND</strong><span class="pv-side-active">{de ? "Fragen" : "Prompts"}</span><span>{de ? "Themen" : "Topics"}</span><span>{de ? "Intent" : "Intent"}</span><span>{de ? "Berichte" : "Reports"}</span></div>
        <div class="pv-dash-main"><div class="pv-dash-head"><span>{de ? "Prompt-Recherche" : "Prompt research"}</span><i>{text.illustrative}</i></div><div class="pv-tabs"><b>{de ? "Übersicht" : "Overview"}</b><span>{de ? "Volumen" : "Volume"}</span><span>{de ? "Intent" : "Intent"}</span><span>{de ? "Demografie" : "Demographics"}</span></div><div class="pv-query"><div><small>{de ? "Fragefeld" : "Question field"}</small><strong>{de ? "Webdesign für lokales Unternehmen" : "Web design for a local business"}</strong></div><button type="button">{de ? "Filtern" : "Filter"}</button></div><div class="pv-chart"><div class="pv-chart-title"><span>{de ? "Fragevolumen · illustrativ" : "Question volume · illustrative"}</span><strong>82.5</strong></div><svg viewBox="0 0 760 180" role="img" aria-label={de ? "Illustrative Fragevolumen-Zeitreihe" : "Illustrative question volume timeline"}><path d="M0 130 C82 118 110 142 168 116 S264 102 322 120 S414 81 475 96 S578 55 642 74 S710 50 760 40"/><path class="pv-chart-alt" d="M0 102 C84 104 122 89 168 106 S268 91 322 94 S417 112 475 96 S581 104 642 92 S710 104 760 90"/></svg><div class="pv-axis"><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span></div></div><div class="pv-dash-table"><span>{de ? "Verwandte Fragen" : "Related questions"}</span><span>{de ? "Intent" : "Intent"}</span><span>{de ? "Volumen" : "Volume"}</span><b>{de ? "Welche Website passt zu einem lokalen Unternehmen?" : "Which website fits a local business?"}</b><i>{de ? "Orientierung" : "Orientation"}</i><strong>72</strong><b>{de ? "Was sollte die Website leisten?" : "What should the website do?"}</b><i>{de ? "Kontext" : "Context"}</i><strong>48</strong></div></div>
        <figcaption id="pv-dashboard-caption">{text.illustrative} — {de ? "keine Kundenwerte oder externen Suchdaten" : "no client results or external search data"}</figcaption>
      </figure>
    </section>

    <section class="pv-flow pv-shell" id="flow"><div class="pv-flow-inner"><header><p class="pv-label">{text.how}</p><h2>{de ? "Entdecken, verfolgen, verbessern" : "Explore, track, improve"}</h2></header><div class="pv-flow-grid">{flow.map((item, index) => <article class:list={{ "flow-primary": index === 0, "flow-secondary": index > 0 }}><div class:list={["pv-flow-art", "pv-flow-reference"]} aria-hidden="true"><img src={flowVisuals[index]} alt="" width="1254" height="464" loading="lazy" decoding="async" /></div><div class="pv-flow-copy"><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></div></article>)}</div></div></section>

    <section class="pv-band pv-shell"><p>{de ? "Illustrative research system" : "Illustrative research system"}</p><span>Fragen · Themen · Intent · Quellen</span></section>

    <section class="pv-section pv-shell"><div class="pv-section-heading"><p class="pv-label">{de ? "Fragebeziehungen" : "Question relationships"}</p><h2>{text.hierarchy}</h2><p>{text.hierarchyLead}</p></div><div class="pv-grid pv-grid-four">{fields.map((field, index) => <article><span>{index + 1}</span><h3>{field[0]}</h3><p>{field[1]}</p><i class={`field-line field-line-${index + 1}`}></i></article>)}</div></section>

    <section class="pv-report pv-shell"><div><p class="pv-label">{de ? "Prompt Research Report" : "Prompt Research Report"}</p><h2>{text.report}</h2><p>{text.reportLead}</p><a class="pv-button" href={`${homePath}#kontakt`}>{de ? "Recherche besprechen" : "Discuss research"}</a></div><div class="pv-report-art" aria-label={text.illustrative}><div class="report-title">{de ? "Prioritäten" : "Priorities"}<span>{text.illustrative}</span></div><div class="report-bars"><i style="--bar:86%"><b>{de ? "Kaufentscheidung" : "Purchase decision"}</b></i><i style="--bar:68%"><b>{de ? "Vertrauen" : "Trust"}</b></i><i style="--bar:49%"><b>{de ? "Lokaler Kontext" : "Local context"}</b></i><i style="--bar:32%"><b>{de ? "Nach Betreuung" : "After launch"}</b></i></div><div class="report-foot"><span>1</span><span>2</span><span>3</span><span>4</span></div></div></section>

    <section class="pv-section pv-shell"><div class="pv-section-heading"><p class="pv-label">{de ? "Intent" : "Intent"}</p><h2>{text.intent}</h2><p>{text.intentLead}</p></div><div class="pv-grid pv-grid-four">{intentFields.map((field, index) => <article><span class="intent-dot" data-intent={index}></span><h3>{field[0]}</h3><strong>{field[1]}</strong><p>{field[2]}</p></article>)}</div></section>

    <section class="pv-section pv-section-compact pv-shell"><div class="pv-section-heading"><p class="pv-label">{de ? "Quellen und Lücken" : "Sources and gaps"}</p><h2>{text.competitors}</h2><p>{text.competitorsLead}</p></div><div class="pv-source-list">{sourceFields.map((field, index) => <article><span>{index + 1}</span><div><h3>{field[0]}</h3><p>{field[1]}</p></div><i aria-hidden="true">↗</i></article>)}</div></section>

    <section class="pv-trust pv-shell"><div class="pv-section-heading"><p class="pv-label">{de ? "Arbeitsgrundlage" : "Working basis"}</p><h2>{text.trust}</h2><p>{text.trustLead}</p></div><div class="pv-trust-grid">{(de ? ["Skalierbar", "Echte Kundensprache", "Mehrere Systeme", "Klare Einordnung", "Datensparsam", "Aktualisierbar"] : ["Scalable", "Real customer language", "Multiple systems", "Clear framing", "Data-conscious", "Refreshable"]).map((item, index) => <div><span>{index + 1}</span><strong>{item}</strong></div>)}</div></section>

    <section class="pv-related pv-shell"><header><p class="pv-label">{text.related}</p><h2>{page.related.title}</h2></header><div class="pv-related-grid">{page.related.items.map((item) => <a href={item.href}><span aria-hidden="true">↗</span><h3>{item.title}</h3><p>{item.text}</p></a>)}</div></section>

    <section class="pv-faq pv-shell" id="faq"><header><p class="pv-label">FAQ</p><h2>{text.faq}</h2></header><div>{page.faq.items.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>

    <SubpageContact lang={page.lang} source="prompt-research-service" />
  </main>
  <Footer {...siteContent.footer} lang={page.lang} />
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const reveal = () => document.querySelectorAll<HTMLElement>(".pv-section, .pv-report, .pv-related, .pv-faq, .pv-close, .pv-flow").forEach((el) => el.classList.add("is-ready"));
  if (reduce.matches) reveal();
  else {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-ready"); observer.unobserve(entry.target); } }), { rootMargin: "-12% 0px -8%", threshold: .12 });
    document.querySelectorAll<HTMLElement>(".pv-section, .pv-report, .pv-related, .pv-faq, .pv-close, .pv-flow").forEach((el) => observer.observe(el));
  }
</script>

<style is:global>
  .prompt-page { --pv-bg:#090908; --pv-ink:#f7f3eb; --pv-muted:#a4a099; --pv-dim:#6e6a63; --pv-line:rgba(247,243,235,.14); --pv-panel:#11110f; --pv-accent:#d56036; --pv-width:1056px; background:var(--pv-bg); color:var(--pv-ink); font-family:Inter,system-ui,sans-serif; }
  .prompt-page header.site-header, .prompt-page footer.site-footer { background:var(--pv-bg); color:var(--pv-ink); }
  .pv-shell { width:min(var(--pv-width), calc(100% - 40px)); margin:0 auto; }
  .pv-hero { min-height:0; padding-top:28px; padding-bottom:100px; }
  .pv-breadcrumb { display:flex; gap:10px; color:var(--pv-dim); font-size:11px; letter-spacing:.02em; }
  .pv-breadcrumb span { display:flex; gap:10px; }.pv-breadcrumb a:hover,.pv-breadcrumb b { color:var(--pv-ink); }.pv-breadcrumb b { font-weight:500; }
  .pv-hero-copy { max-width:650px; padding-top:90px; }.pv-label { margin:0 0 15px; color:var(--pv-accent); font-size:11px; font-weight:650; letter-spacing:.12em; text-transform:uppercase; }.pv-hero h1 { max-width:630px; margin:0; font-size:clamp(48px,5vw,72px); font-weight:520; letter-spacing:-.075em; line-height:.98; }.pv-lead { max-width:540px; margin:28px 0 0; color:var(--pv-muted); font-size:17px; line-height:1.55; }.pv-actions { display:flex; align-items:center; gap:22px; margin-top:30px; }.pv-button { display:inline-flex; min-height:48px; align-items:center; justify-content:center; padding:0 17px; border-radius:7px; background:#b74622; color:#fff9f3; font-size:15px; font-weight:650; text-decoration:none; transition:background 180ms ease,transform 250ms ease; }.pv-button:hover { background:#d05a32; transform:translateY(-2px); }.pv-link { display:inline-flex; align-items:center; gap:10px; color:var(--pv-ink); font-size:15px; text-decoration:none; }.pv-link span { color:var(--pv-accent); font-size:18px; transition:transform 200ms ease; }.pv-link:hover span { transform:translateY(3px); }
  .pv-dashboard { position:relative; display:grid; grid-template-columns:118px 1fr; min-height:440px; margin:72px 0 0; overflow:hidden; border:1px solid var(--pv-line); border-radius:5px; background:#0e0e0d; box-shadow:0 30px 70px rgba(0,0,0,.4); }.pv-sidebar { display:flex; flex-direction:column; gap:17px; border-right:1px solid var(--pv-line); padding:20px 14px; color:var(--pv-dim); font-size:10px; }.pv-sidebar strong { margin-bottom:28px; color:var(--pv-ink); font-size:11px; letter-spacing:.08em; }.pv-side-active { color:var(--pv-accent); }.pv-dash-main { min-width:0; padding:20px 25px; }.pv-dash-head,.pv-tabs,.pv-query,.pv-chart-title,.pv-axis,.pv-dash-table { display:flex; align-items:center; }.pv-dash-head { justify-content:space-between; font-size:13px; }.pv-dash-head i { color:var(--pv-accent); font-size:10px; font-style:normal; }.pv-tabs { gap:20px; margin:26px 0 16px; border-bottom:1px solid var(--pv-line); padding-bottom:10px; color:var(--pv-dim); font-size:11px; }.pv-tabs b { color:var(--pv-ink); }.pv-query { justify-content:space-between; border:1px solid var(--pv-line); padding:12px 14px; }.pv-query small { display:block; margin-bottom:4px; color:var(--pv-dim); font-size:10px; }.pv-query strong { font-size:13px; font-weight:500; }.pv-query button { border:1px solid var(--pv-line); border-radius:4px; background:transparent; color:var(--pv-muted); padding:7px 10px; font:inherit; font-size:10px; }.pv-chart { margin-top:20px; border-top:1px solid var(--pv-line); padding-top:16px; }.pv-chart-title { justify-content:space-between; color:var(--pv-muted); font-size:11px; }.pv-chart-title strong { color:var(--pv-ink); font-size:26px; font-weight:500; }.pv-chart svg { width:100%; height:160px; margin-top:5px; overflow:visible; }.pv-chart path { fill:none; stroke:var(--pv-accent); stroke-width:2; stroke-dasharray:900; stroke-dashoffset:900; animation:pv-draw 1.4s .25s ease forwards; }.pv-chart .pv-chart-alt { stroke:#64877a; stroke-dasharray:0; stroke-dashoffset:0; opacity:.75; }.pv-axis { justify-content:space-between; color:var(--pv-dim); font-size:9px; }.pv-dash-table { display:grid; grid-template-columns:minmax(0,1fr) 90px 50px; gap:10px; margin-top:18px; border-top:1px solid var(--pv-line); padding-top:12px; color:var(--pv-muted); font-size:10px; }.pv-dash-table > span { padding-bottom:4px; color:var(--pv-dim); }.pv-dash-table b { font-weight:450; }.pv-dash-table i { color:#8aa79c; font-style:normal; }.pv-dash-table strong { color:var(--pv-ink); font-weight:500; }.pv-dashboard figcaption { position:absolute; right:18px; bottom:12px; color:var(--pv-dim); font-size:9px; }
  .pv-flow { border-top:1px solid var(--pv-line); padding-top:110px; padding-bottom:90px; }.pv-flow header h2,.pv-section h2,.pv-report h2,.pv-related h2,.pv-faq h2 { max-width:660px; margin:0; font-size:clamp(43px,5vw,68px); font-weight:520; letter-spacing:-.075em; line-height:.98; }.pv-flow-grid { display:grid; grid-template-columns:1fr 1fr; margin-top:55px; border:1px solid var(--pv-line); }.pv-flow-grid article { min-height:300px; border-right:1px solid var(--pv-line); border-bottom:1px solid var(--pv-line); padding:22px; }.pv-flow-grid article:nth-child(2n) { border-right:0; }.pv-flow-grid article:nth-child(n+3) { border-bottom:0; }.pv-flow-art { position:relative; min-height:150px; overflow:hidden; }.flow-shape { position:absolute; display:block; background:#191a18; box-shadow:10px 12px 0 rgba(0,0,0,.4); }.flow-shape-1 { width:180px; height:44px; top:52px; left:22px; border:1px solid #77736c; border-radius:6px; transform:rotate(-25deg); }.flow-shape-1::after,.flow-shape-1::before { position:absolute; inset:10px 14px; border-top:1px solid #aaa39a; content:""; }.flow-shape-1::before { top:22px; right:34px; }.flow-shape-2 { width:90px; height:24px; top:54px; left:64px; border-radius:12px; background:#397b4b; transform:rotate(-34deg); box-shadow:22px 22px 0 #17231b,48px 35px 0 #101913; }.flow-shape-3 { width:102px; height:58px; top:34px; left:50px; border:2px solid #a745db; border-radius:5px; transform:rotate(-22deg); }.flow-shape-3::after { position:absolute; inset:12px 18px; background:#7126a4; box-shadow:inset 0 0 0 1px #ca78f1; content:""; }.flow-shape-4 { width:95px; height:95px; top:20px; left:56px; border:7px solid #394140; border-right-color:#d56036; border-radius:50%; transform:rotate(-24deg); }.pv-flow-art i { position:absolute; left:75px; top:63px; width:32px; height:32px; border-radius:50%; background:#64a59a; box-shadow:0 0 0 12px rgba(100,165,154,.08); }.pv-flow-copy { display:grid; gap:8px; }.pv-flow-copy > span { color:var(--pv-accent); font-size:11px; }.pv-flow-copy h3 { margin:0; font-size:18px; font-weight:520; letter-spacing:-.04em; }.pv-flow-copy p { max-width:380px; margin:0; color:var(--pv-muted); font-size:14px; line-height:1.5; }
  .pv-band { display:flex; justify-content:space-between; border-top:1px solid var(--pv-line); border-bottom:1px solid var(--pv-line); padding-top:20px; padding-bottom:20px; color:var(--pv-dim); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }.pv-band span { color:var(--pv-muted); }
