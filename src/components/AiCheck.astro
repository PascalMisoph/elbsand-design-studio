---
import type { Locale } from "../content/site";
import { Buffer } from "node:buffer";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isEnglish = lang === "en";
const privacyPath = isEnglish ? "/en/privacy/" : "/datenschutz/";
const copy = isEnglish
  ? {
      title: "The 21-point check: Is your website ready for ChatGPT & Co.?",
      body: "Our live scan shows how clearly your website can be reached, structured and interpreted by AI crawlers.",
      phases: ["Website", "Live scan", "Result"],
      urlLabel: "Website address",
      urlPlaceholder: "your-website.com",
      start: "Check AI readiness",
      inputNote: "We only retrieve publicly accessible website data.",
      scanningTitle: "We are checking your website live.",
      scanningBody: "This usually takes a few seconds.",
      scanItems: [
        "Checking llms.txt and robots.txt for AI crawlers",
        "Reading Schema.org, NAP and trust signals",
        "Inspecting security headers and response time",
        "Scoring all 21 findings transparently",
      ],
      preliminary: "Preliminary AI readiness score",
      scoreNote: "The score evaluates technical readiness, not guaranteed mentions in AI answers.",
      scoreLabel: "AI Readiness Score",
      resultTitle: "21 technical checks completed",
      leadTitle: "Technical scan complete",
      leadBody: "Your results and optimisation opportunities are now available.",
      firstNameLabel: "First name",
      firstNamePlaceholder: "Your first name",
      emailLabel: "Email",
      emailPlaceholder: "you@company.com",
      unlock: "View detailed results",
      privacy: "Technical live check · no automated sales sequence",
      sending: "Unlocking …",
      leadError: "The findings could not be unlocked. Please try again.",
      scanError: "We could not reliably retrieve this website. Check the address and try again.",
      unlockedEyebrow: "Analysis complete",
      unlocked: "Your findings are unlocked.",
      unlockedBody: "Your request has been saved. We have emailed your result link, and the technical details are now visible below.",
      lockedLabel: "Enter your details to reveal all 21 findings",
      grade: "Grade",
      contact: "Book a free results review",
      again: "Check another website",
      geoTitle: "Technical readiness is only the first step.",
      geoBody: "This check shows how well your website meets the technical requirements for AI search. It does not measure whether ChatGPT, Gemini or Perplexity actually mention, cite or recommend your brand.",
      geoAudit: "A complete GEO audit examines that actual AI visibility.",
      geoCta: "Learn about the GEO audit",
      categoryTitles: {
        ai: "AI readiness & crawling",
        data: "Data architecture & trust signals",
        tech: "Technical foundation & security",
      },
    }
  : {
      title: "Der 21-Punkte-Check: Ist deine Website bereit für ChatGPT & Co.?",
      body: "Erfahre mit unserem Live-Scan sofort, wie klar deine Website für KI-Crawler technisch erreichbar, strukturiert und einordenbar ist.",
      phases: ["Website", "Live-Scan", "Ergebnis"],
      urlLabel: "Website-Adresse",
      urlPlaceholder: "deine-website.de",
      start: "KI-Bereitschaft prüfen",
      inputNote: "Wir rufen ausschließlich öffentlich erreichbare Website-Daten ab.",
      scanningTitle: "Wir prüfen deine Website live.",
      scanningBody: "Das dauert in der Regel nur wenige Sekunden.",
      scanItems: [
        "llms.txt und robots.txt für KI-Crawler prüfen",
        "Schema.org, NAP und Vertrauenssignale auslesen",
        "Security-Header und Antwortzeit analysieren",
        "Alle 21 Befunde transparent bewerten",
      ],
      preliminary: "Vorläufiger KI-Readiness Score",
      scoreNote: "Der Score bewertet die technische Bereitschaft, nicht garantierte Nennungen in KI-Antworten.",
      scoreLabel: "KI-Readiness Score",
      resultTitle: "21 technische Einzelchecks abgeschlossen",
      leadTitle: "Technischer Scan abgeschlossen",
      leadBody: "Deine Ergebnisse und Optimierungspotenziale sind jetzt verfügbar.",
      firstNameLabel: "Vorname",
      firstNamePlaceholder: "Dein Vorname",
      emailLabel: "E-Mail",
      emailPlaceholder: "du@unternehmen.de",
      unlock: "Ergebnisse im Detail ansehen",
      privacy: "Technischer Live-Check · keine automatische Verkaufsserie",
      sending: "Wird freigeschaltet …",
      leadError: "Der Befund konnte nicht freigeschaltet werden. Bitte versuche es erneut.",
      scanError: "Diese Website konnte nicht zuverlässig abgerufen werden. Prüfe die Adresse und versuche es erneut.",
      unlockedEyebrow: "Analyse abgeschlossen",
      unlocked: "Dein Befund ist freigeschaltet.",
      unlockedBody: "Deine Anfrage wurde gespeichert. Wir haben dir den Ergebnis-Link per E-Mail gesendet; die technischen Details sind jetzt unten sichtbar.",
      lockedLabel: "Kontaktdaten eintragen und alle 21 Befunde ansehen",
      grade: "Note",
      contact: "Kostenlose Auswertung vereinbaren",
      again: "Weitere Website prüfen",
      geoTitle: "Technische Readiness ist nur der erste Schritt.",
      geoBody: "Dieser Check zeigt, wie gut die technischen Voraussetzungen deiner Website für AI Search sind. Er misst nicht, ob ChatGPT, Gemini oder Perplexity deine Marke tatsächlich nennen, zitieren oder empfehlen.",
      geoAudit: "Genau diese tatsächliche KI-Sichtbarkeit untersuchen wir im vollständigen GEO Audit.",
      geoCta: "GEO Audit kennenlernen",
      categoryTitles: {
        ai: "AI-Readiness & Crawling",
        data: "Daten-Architektur & Vertrauenssignale",
        tech: "Technische Basis & Security",
      },
    };
const screenConfig = Buffer.from(JSON.stringify({ lang, privacyPath, copy })).toString("base64");
---
<section class="ai-check section-shell" id="ki-check" aria-labelledby="ai-check-title">
  <header class="ai-check-heading">
    <h2 id="ai-check-title">{copy.title}</h2>
    <p>{copy.body}</p>
  </header>

  <div
    class="ai-check-tool"
    data-ai-check
    data-lang={lang}
    data-ai-screen-config={screenConfig}
  >
    <div class="ai-check-surface">
      <ol class="ai-check-phases" aria-label={isEnglish ? "Analysis progress" : "Analysefortschritt"}>
        {copy.phases.map((phase, index) => (
          <li class={index === 0 ? "is-current" : ""} data-ai-phase={index + 1} aria-current={index === 0 ? "step" : undefined}>
            <span>{index + 1}</span>{phase}
          </li>
        ))}
      </ol>

      <div class="ai-check-screen-host" data-ai-screen-host>
      <section class="ai-check-screen ai-check-start" data-ai-screen="1">
        <form data-scan-form>
          <label for={`ai-check-url-${lang}`}>{copy.urlLabel}</label>
          <div class="ai-check-url-row">
            <input
              id={`ai-check-url-${lang}`}
              name="url"
              type="text"
              inputmode="url"
              autocomplete="url"
              placeholder={copy.urlPlaceholder}
              required
            />
            <button class="button" type="submit">{copy.start}</button>
          </div>
          <small>{copy.inputNote}</small>
          <p class="ai-check-error" role="alert" data-scan-error hidden></p>
        </form>
      </section>
      </div>

    </div>

    <button class="ai-check-again" type="button" data-ai-again hidden>← {copy.again}</button>
  </div>
</section>

<script>
  import { createAiCheckScreens, type AiCheckScreenConfig } from "../lib/ai-check-screens";
  import type { ScanApiResult, ScanCategory, ScanCheck } from "../lib/ai-readiness";

  const decodeScreenConfig = (encoded: string) => {
    const binary = window.atob(encoded);
    const bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0));
    return JSON.parse(new TextDecoder().decode(bytes)) as AiCheckScreenConfig;
  };

  document.querySelectorAll<HTMLElement>("[data-ai-check]").forEach((tool) => {
    const phases = Array.from(tool.querySelectorAll<HTMLElement>("[data-ai-phase]"));
    const screenHost = tool.querySelector<HTMLElement>("[data-ai-screen-host]");
    const startScreen = screenHost?.querySelector<HTMLElement>("[data-ai-screen='1']") ?? null;
    const screenConfig = decodeScreenConfig(tool.dataset.aiScreenConfig ?? "");
    const { createScanningScreen, createResultScreen } = createAiCheckScreens(screenConfig);

    let scanForm: HTMLFormElement | null = null;
    let urlInput: HTMLInputElement | null = null;
    let scanError: HTMLElement | null = null;
    let scanItems: HTMLElement[] = [];
    let score: HTMLElement | null = null;
    let grade: HTMLElement | null = null;
    let resultHeadline: HTMLElement | null = null;
    let resultSummary: HTMLElement | null = null;
    let strengthsPanel: HTMLElement | null = null;
    let strengthsHeading: HTMLElement | null = null;
    let strengthsList: HTMLUListElement | null = null;
    let opportunitiesPanel: HTMLElement | null = null;
    let opportunitiesHeading: HTMLElement | null = null;
    let opportunitiesList: HTMLUListElement | null = null;
    let leadForm: HTMLFormElement | null = null;
    let leadGate: HTMLElement | null = null;
    let leadError: HTMLElement | null = null;
    let unlocked: HTMLElement | null = null;
    let resultChecks: HTMLElement | null = null;
    let resultGrid: HTMLElement | null = null;
    let resultLock: HTMLElement | null = null;
    let liveCta: HTMLAnchorElement | null = null;
    const again = tool.querySelector<HTMLButtonElement>("[data-ai-again]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let scanResult: ScanApiResult | null = null;

    const bindActiveScreen = () => {
      const activeScreen = screenHost?.querySelector<HTMLElement>("[data-ai-screen]");
      scanForm = activeScreen?.querySelector<HTMLFormElement>("[data-scan-form]") ?? null;
      urlInput = scanForm?.elements.namedItem("url") as HTMLInputElement | null;
      scanError = activeScreen?.querySelector<HTMLElement>("[data-scan-error]") ?? null;
      scanItems = Array.from(activeScreen?.querySelectorAll<HTMLElement>("[data-scan-item]") ?? []);
      score = activeScreen?.querySelector<HTMLElement>("[data-ai-score]") ?? null;
      grade = activeScreen?.querySelector<HTMLElement>("[data-ai-grade]") ?? null;
      resultHeadline = activeScreen?.querySelector<HTMLElement>("[data-result-headline]") ?? null;
      resultSummary = activeScreen?.querySelector<HTMLElement>("[data-result-summary]") ?? null;
      strengthsPanel = activeScreen?.querySelector<HTMLElement>("[data-strengths-panel]") ?? null;
      strengthsHeading = activeScreen?.querySelector<HTMLElement>("[data-strengths-heading]") ?? null;
      strengthsList = activeScreen?.querySelector<HTMLUListElement>("[data-strengths-list]") ?? null;
      opportunitiesPanel = activeScreen?.querySelector<HTMLElement>("[data-opportunities-panel]") ?? null;
      opportunitiesHeading = activeScreen?.querySelector<HTMLElement>("[data-opportunities-heading]") ?? null;
      opportunitiesList = activeScreen?.querySelector<HTMLUListElement>("[data-opportunities-list]") ?? null;
      leadForm = activeScreen?.querySelector<HTMLFormElement>("[data-ai-lead-form]") ?? null;
      leadGate = activeScreen?.querySelector<HTMLElement>("[data-lead-gate]") ?? null;
      leadError = activeScreen?.querySelector<HTMLElement>("[data-lead-error]") ?? null;
      unlocked = activeScreen?.querySelector<HTMLElement>("[data-ai-unlocked]") ?? null;
      resultChecks = activeScreen?.querySelector<HTMLElement>("[data-result-checks]") ?? null;
      resultGrid = activeScreen?.querySelector<HTMLElement>("[data-result-grid]") ?? null;
      resultLock = activeScreen?.querySelector<HTMLElement>("[data-result-lock]") ?? null;
      liveCta = activeScreen?.querySelector<HTMLAnchorElement>("[data-live-cta]") ?? null;
    };

    const updatePhase = (phaseNumber: number) => {
      phases.forEach((phase, index) => {
        const isCurrent = index === phaseNumber - 1;
        phase.classList.toggle("is-current", isCurrent);
        phase.classList.toggle("is-complete", index < phaseNumber - 1);
        if (isCurrent) phase.setAttribute("aria-current", "step");
        else phase.removeAttribute("aria-current");
      });
      if (again) again.hidden = phaseNumber === 1;
    };

    const showPhase = (phaseNumber: number) => {
      if (!screenHost) return;
      if (phaseNumber === 1 && startScreen) {
        screenHost.replaceChildren(startScreen);
      } else {
        const screen = phaseNumber === 2 ? createScanningScreen() : createResultScreen();
        screenHost.replaceChildren(screen);
      }
      bindActiveScreen();
      updatePhase(phaseNumber);
    };

    const resetScanItems = () => {
      scanItems.forEach((item) => {
        item.classList.remove("is-active", "is-complete");
        const state = item.querySelector<HTMLElement>("[data-scan-state]");
        if (state) state.textContent = tool.dataset.lang === "en" ? "Waiting" : "Wartet";
      });
    };

    const createStatusMarker = (status: ScanCheck["status"]) => {
      const marker = document.createElement("span");
      marker.className = "ai-audit-marker";
      marker.dataset.icon = status;
      marker.setAttribute("aria-hidden", "true");

      const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("viewBox", status === "fail" ? "0 0 24 24" : "0 0 20 20");
      svg.setAttribute("focusable", "false");
      svg.setAttribute("stroke-linecap", "round");
      svg.setAttribute("stroke-linejoin", "round");

      if (status === "pass") {
        const check = document.createElementNS("http://www.w3.org/2000/svg", "path");
        check.setAttribute("d", "M5 10.25 8.25 13.5 15.25 6.5");
        svg.append(check);
      } else if (status === "warning") {
        const line = document.createElementNS("http://www.w3.org/2000/svg", "path");
        line.setAttribute("d", "M10 5.25v6");
        const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        dot.setAttribute("cx", "10");
        dot.setAttribute("cy", "14.5");
        dot.setAttribute("r", "1");
        dot.setAttribute("fill", "currentColor");
        dot.setAttribute("stroke", "none");
        svg.append(line, dot);
      } else {
        const firstLine = document.createElementNS("http://www.w3.org/2000/svg", "line");
        firstLine.setAttribute("x1", "6");
        firstLine.setAttribute("y1", "6");
        firstLine.setAttribute("x2", "18");
        firstLine.setAttribute("y2", "18");

        const secondLine = document.createElementNS("http://www.w3.org/2000/svg", "line");
        secondLine.setAttribute("x1", "18");
        secondLine.setAttribute("y1", "6");
        secondLine.setAttribute("x2", "6");
        secondLine.setAttribute("y2", "18");
        svg.append(firstLine, secondLine);
      }

      marker.append(svg);
      return marker;
    };

    const populateFindingList = (
      list: HTMLUListElement | null,
      findings: ScanApiResult["interpretation"]["strengths"],
    ) => {
      if (!list) return;
      const rows = findings.map((finding) => {
        const item = document.createElement("li");
        item.dataset.status = finding.status;
        if (finding.kind) item.dataset.kind = finding.kind;
        const title = document.createElement("strong");
        title.textContent = finding.title;
        const body = document.createElement("span");
        body.textContent = finding.text;
        item.append(title, body);
        return item;
      });
      list.replaceChildren(...rows);
    };

    const populateResult = (result: ScanApiResult) => {
      if (score) score.textContent = String(result.score);
      if (grade) grade.textContent = result.grade;
      if (resultHeadline) resultHeadline.textContent = result.interpretation.overallHeadline;
      if (resultSummary) resultSummary.textContent = result.interpretation.overallSummary;
      if (strengthsHeading) strengthsHeading.textContent = result.interpretation.strengthsHeading;
      if (opportunitiesHeading) opportunitiesHeading.textContent = result.interpretation.opportunitiesHeading;
      if (strengthsPanel) strengthsPanel.hidden = result.interpretation.strengths.length === 0;
      if (opportunitiesPanel) opportunitiesPanel.hidden = result.interpretation.opportunities.length === 0;
      populateFindingList(strengthsList, result.interpretation.strengths);
      populateFindingList(opportunitiesList, result.interpretation.opportunities);

      (Object.entries(result.categories) as Array<[keyof ScanApiResult["categories"], ScanCategory]>).forEach(
        ([key, category]) => {
          const categoryElement = tool.querySelector<HTMLElement>(`[data-audit-category="${key}"]`);
          const list = categoryElement?.querySelector<HTMLUListElement>("[data-category-checks]");
          const categoryScore = categoryElement?.querySelector<HTMLElement>("[data-category-score]");
          if (!categoryElement || !list) return;
          categoryElement.dataset.status = category.status;
          if (categoryScore) categoryScore.textContent = `${category.score} / ${category.maxScore}`;
          const summaryCategory = tool.querySelector<HTMLElement>(`[data-summary-category="${key}"]`);
          if (summaryCategory) {
            summaryCategory.dataset.status = category.status;
            const summaryScore = summaryCategory.querySelector<HTMLElement>("strong");
            if (summaryScore) summaryScore.textContent = `${category.score}/${category.maxScore}`;
          }

          const rows = category.checks.map((check) => {
            const item = document.createElement("li");
            item.dataset.status = check.status;

            const marker = createStatusMarker(check.status);

            const content = document.createElement("div");
            const title = document.createElement("strong");
            title.textContent = check.title;
            const detail = document.createElement("p");
            detail.textContent = check.detail;
            content.append(title, detail);

            const value = document.createElement("small");
            value.textContent = `${check.score} / ${check.maxScore}`;
            item.append(marker, content, value);
            return item;
          });
          list.replaceChildren(...rows);
        },
      );
    };

    const submitScan = async (event: Event, activeForm: HTMLFormElement) => {
      event.preventDefault();
      const activeUrlInput = activeForm.elements.namedItem("url") as HTMLInputElement | null;
      if (!activeForm.reportValidity() || !activeUrlInput) return;
      if (scanError) scanError.hidden = true;
      const requestedUrl = activeUrlInput.value;
      showPhase(2);
      resetScanItems();

      const timers = scanItems.map((item, index) =>
        window.setTimeout(() => {
          scanItems[index - 1]?.classList.replace("is-active", "is-complete");
          const previousState = scanItems[index - 1]?.querySelector<HTMLElement>("[data-scan-state]");
          if (previousState) previousState.textContent = tool.dataset.lang === "en" ? "Done" : "Erledigt";
          item.classList.add("is-active");
          const state = item.querySelector<HTMLElement>("[data-scan-state]");
          if (state) state.textContent = tool.dataset.lang === "en" ? "Checking" : "Prüft";
        }, reducedMotion ? 0 : index * 700),
      );

      try {
        const request = fetch("/api/scan", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ url: requestedUrl, locale: tool.dataset.lang }),
        }).then(async (response) => {
          const result = await response.json().catch(() => null);
          if (!response.ok || !result?.ok) throw new Error(result?.error ?? "scan_failed");
          return result as ScanApiResult;
        });
        const minimumDisplay = new Promise((resolve) =>
          window.setTimeout(resolve, reducedMotion ? 0 : 2_200),
        );
        const [result] = await Promise.all([request, minimumDisplay]);
        timers.forEach(window.clearTimeout);
        scanItems.forEach((item) => {
          item.classList.remove("is-active");
          item.classList.add("is-complete");
          const state = item.querySelector<HTMLElement>("[data-scan-state]");
          if (state) state.textContent = tool.dataset.lang === "en" ? "Done" : "Erledigt";
        });
        scanResult = result;
        showPhase(3);
        populateResult(result);
        leadForm?.querySelector<HTMLInputElement>('input[type="email"]')?.focus();
      } catch {
        timers.forEach(window.clearTimeout);
        showPhase(1);
        if (scanError) {
          scanError.textContent = screenConfig.copy.scanError;
          scanError.hidden = false;
        }
        urlInput?.focus();
      }
    };

    const submitLead = async (event: Event, activeForm: HTMLFormElement) => {
      event.preventDefault();
      if (!activeForm.reportValidity() || !scanResult) return;
      const submit = activeForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const email = activeForm.elements.namedItem("email") as HTMLInputElement | null;
      const name = activeForm.elements.namedItem("name") as HTMLInputElement | null;
      if (!submit || !email || !name) return;
      const submitLabel = submit.textContent ?? "";
      const resultToken = scanResult.resultToken;
      submit.disabled = true;
      submit.textContent = screenConfig.copy.sending;
      if (leadError) leadError.hidden = true;

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({
            source: "ai-check",
            intent: "improve",
            scanToken: resultToken,
            email: email.value,
            name: name.value,
            locale: tool.dataset.lang,
            formGuard: "",
            startedAt: 0,
          }),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.ok) throw new Error(result?.error ?? "lead_failed");

        resultChecks?.classList.remove("is-locked");
        resultGrid?.removeAttribute("aria-hidden");
        if (resultLock) resultLock.hidden = true;
        if (liveCta) liveCta.hidden = false;
        if (leadGate) leadGate.hidden = true;
        if (unlocked) {
          unlocked.hidden = false;
          unlocked.focus();
        }
      } catch {
        if (leadError) {
          leadError.textContent = screenConfig.copy.leadError;
          leadError.hidden = false;
        }
      } finally {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    };

    bindActiveScreen();
    updatePhase(1);

    tool.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (form.matches("[data-scan-form]")) void submitScan(event, form);
      else if (form.matches("[data-ai-lead-form]")) void submitLead(event, form);
    });

    again?.addEventListener("click", () => {
      scanResult = null;
      scanForm?.reset();
      leadForm?.reset();
      if (leadGate) leadGate.hidden = false;
      if (unlocked) unlocked.hidden = true;
      resultChecks?.classList.add("is-locked");
      resultGrid?.setAttribute("aria-hidden", "true");
      if (resultLock) resultLock.hidden = false;
      if (liveCta) liveCta.hidden = true;
      if (leadError) leadError.hidden = true;
      resetScanItems();
      showPhase(1);
      if (scanError) scanError.hidden = true;
      urlInput?.focus();
    });
  });
</script>
