---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import SubpageContact from "./SubpageContact.astro";
import FaqAccordion from "./FaqAccordion.astro";
import CrawlabilityFeatureGrid from "./CrawlabilityFeatureGrid";
import CrawlPathPipeline from "./CrawlPathPipeline";
import DiagnosticWorkflow from "./DiagnosticWorkflow";
import LinkButton from "./LinkButton";
import { content } from "../content/site";
import { aiCrawlabilityPages } from "../content/service-pages/technical-content";
import { createServicePageSchema } from "../lib/seo";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const isGerman = lang === "de";
const siteContent = content[lang];
const homePath = isGerman ? "/" : "/en/";
const canonicalPath = isGerman ? "/ai-crawlability/" : "/en/ai-crawlability/";
const meta = aiCrawlabilityPages[lang].meta;
const t = isGerman ? {
  title: "Sieh, was Antwortsysteme erreichen können",
  description: "AI Crawlability zeigt, welche Bots deine Seiten erreichen, wo Requests scheitern und welche technischen Wege zuerst geöffnet werden sollten.",
  eyebrow: "AI Crawlability",
  lead: "Eine Website kann inhaltlich stark und trotzdem schwer erreichbar sein. Wir lesen Server- und Seitenzugriff als Ablauf – vom Bot über die Antwort bis zur Seite, die tatsächlich ankommt.",
  cta: "Crawlability-Check anfragen",
  jump: "Zugriff ansehen",
  home: "Start",
  hub: "GEO-Optimierung",
  parent: "Technische GEO-Optimierung",
  capabilities: [
    { title: "Welche Bots kommen an?", text: "Verifizierte User-Agents statt bloßer Behauptungen." },
    { title: "Warum wird gelesen?", text: "Indexierung, Training und Retrieval getrennt betrachten." },
    { title: "Was kommt zurück?", text: "Status, Latenz und Rendering auf Seitenebene prüfen." },
    { title: "Was zuerst ändern?", text: "Technische Befunde nach Wirkung und Aufwand ordnen." },
  ],
  flowEyebrow: "Page-level Crawl Path",
  flowTitle: "Ein Request ist erst dann hilfreich, wenn die richtige Seite ankommt",
  flowLead: "Wir verfolgen Zugriff, Serverantwort, Rendering und erreichbaren Inhalt als zusammenhängenden Pfad – nicht als abstrakte Punktzahl.",
  stages: [
    { title: "Bot erkannt", text: "Verifizierter Zugriff wird vom normalen Browsertraffic getrennt." },
    { title: "Server antwortet", text: "Status und Antwortzeit zeigen, ob der Weg offen und belastbar ist." },
    { title: "Inhalt erreicht", text: "Die zentrale Information kommt ohne clientseitigen Umweg an." },
    { title: "Seite priorisiert", text: "Ein konkreter Befund wird zur nächsten technischen Aktion." },
  ],
  detailTitle: "Von Bot-Signal zu sinnvoller Änderung",
  detailLead: "Crawlability endet nicht bei einer Bot-Liste. Entscheidend ist der Zusammenhang zwischen Zugriff und deiner wichtigsten Seite.",
  detail: [
    { title: "Robots & CDN", text: "Bewusst blockieren oder unbeabsichtigt aussperren?" },
    { title: "Antwort & Latenz", text: "Kommt die Seite schnell genug zurück?" },
    { title: "Rendering", text: "Ist die Antwort ohne Browser ausführbar?" },
  ],
  faqTitle: "Fragen zu AI Crawlability",
  faq: [
    { question: "Was ist der Unterschied zwischen Crawlability und Sichtbarkeit?", answer: "Crawlability beschreibt den technischen Zugang. Sichtbarkeit beschreibt, ob ein System deine Inhalte anschließend in einer Antwort verwendet." },
    { question: "Kann ein User-Agent allein einen Bot verifizieren?", answer: "Nein. User-Agent-Werte können gefälscht werden. Erst Zugriffsmuster und bekannte Bot-Informationen machen das Signal belastbar." },
    { question: "Muss ich alle AI-Bots zulassen?", answer: "Nicht pauschal. Die Entscheidung hängt von Inhalt, Geschäftsmodell und rechtlicher oder strategischer Zielsetzung ab." },
    { question: "Ersetzt Crawlability einen GEO-Audit?", answer: "Nein. Crawlability beantwortet die technische Erreichbarkeit. Ein GEO-Audit untersucht zusätzlich Antworten, Quellen, Fakten und Themenlücken." },
    { question: "Was braucht ihr und was erhalten wir?", answer: "Für den Start brauchen wir Domain, wichtige Seitentypen und bekannte CDN-, Robots- oder Rendering-Besonderheiten. Du erhältst einen priorisierten Crawlpfad mit geprüftem Zugriff, Serverantwort, Rendering-Befund und konkreter nächster technischer Aktion. Änderungen an Server, CDN oder CMS erfolgen nur nach Abstimmung." },
  ],
} : {
  title: "See what answer systems can actually reach",
  description: "AI crawlability shows which bots reach your pages, where requests fail and which technical paths deserve attention first.",
  eyebrow: "AI Crawlability",
  lead: "A website can be useful and still be difficult to reach. We read server and page access as a sequence – from bot to response to the page that actually arrives.",
  cta: "Request a crawlability check",
  jump: "See the access path",
  home: "Home",
  hub: "GEO Optimization",
  parent: "Technical GEO Optimization",
  capabilities: [
    { title: "Which bots arrive?", text: "Verified user agents instead of assumptions." },
    { title: "Why is it reading?", text: "Keep indexing, training and retrieval distinct." },
    { title: "What comes back?", text: "Review status, latency and rendering at page level." },
    { title: "What changes first?", text: "Order technical findings by impact and effort." },
  ],
  flowEyebrow: "Page-level Crawl Path",
  flowTitle: "A request only helps when the right page arrives",
  flowLead: "We follow access, server response, rendering and reachable content as one path rather than an abstract score.",
  stages: [
    { title: "Bot verified", text: "Verified access is separated from ordinary browser traffic." },
    { title: "Server responds", text: "Status and response time show whether the route is open and dependable." },
    { title: "Content reached", text: "The central information arrives without a client-side detour." },
    { title: "Page prioritised", text: "A concrete finding becomes the next technical action." },
  ],
  detailTitle: "From bot signal to useful change",
  detailLead: "Crawlability does not end with a bot list. The useful question is how access connects to your most important page.",
  detail: [
    { title: "Robots & CDN", text: "Blocked deliberately or shut out by accident?" },
    { title: "Response & latency", text: "Does the page return quickly enough?" },
    { title: "Rendering", text: "Can the response work without a browser?" },
  ],
  faqTitle: "Questions about AI crawlability",
  faq: [
    { question: "How is crawlability different from visibility?", answer: "Crawlability describes technical access. Visibility describes whether a system then uses your content in an answer." },
    { question: "Can a user agent alone verify a bot?", answer: "No. User-agent values can be spoofed. Access patterns and known bot information must support the signal." },
    { question: "Do I need to allow every AI bot?", answer: "Not as a blanket rule. The decision depends on your content, business model and legal or strategic position." },
    { question: "Does crawlability replace a GEO audit?", answer: "No. Crawlability covers technical reachability. A GEO audit also reviews answers, sources, facts and topic gaps." },
    { question: "What do you need and what do we receive?", answer: "To begin, we need the domain, priority page types and any known CDN, robots or rendering constraints. You receive a prioritised crawl path with reviewed access, server response, rendering findings and a concrete next technical action. Changes to the server, CDN or CMS are made only after agreement." },
  ],
};

const breadcrumbItems = [{ name: t.home, href: homePath }, { name: t.hub, href: isGerman ? "/geo-optimierung/" : "/en/geo-optimization/" }, { name: t.parent, href: isGerman ? "/technische-geo-optimierung/" : "/en/technical-geo-optimization/" }, { name: t.eyebrow, href: canonicalPath }];
const schema = createServicePageSchema({ lang, title: meta.title, description: meta.description, path: canonicalPath, serviceName: t.eyebrow, breadcrumbs: breadcrumbItems, faqs: t.faq });
---

<BaseLayout title={meta.title} description={meta.description} lang={lang} canonicalPath={canonicalPath} alternateDePath="/ai-crawlability/" alternateEnPath="/en/ai-crawlability/" schema={schema} bodyClass="crawl-page ui-dark-page dark">
  <Header lang={lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath="/ai-crawlability/" alternateEnPath="/en/ai-crawlability/" />
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <section class="border-b border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><nav class="flex flex-wrap gap-2 text-xs text-muted-foreground" aria-label={isGerman ? "Brotkrumen-Navigation" : "Breadcrumb"}>{breadcrumbItems.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index === breadcrumbItems.length - 1 ? <span aria-current="page">{item.name}</span> : <a class="text-inherit no-underline hover:text-foreground" href={item.href}>{item.name}</a>}</>)}</nav><div class="max-w-3xl pt-12"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.eyebrow}</p><h1 class="m-0 mt-6 text-display-mobile font-medium text-foreground md:text-display">{t.title}</h1><p class="m-0 mt-6 max-w-xl text-base leading-copy text-muted-foreground">{t.lead}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><LinkButton href={`${homePath}#kontakt`} label={t.cta} icon="right" /><LinkButton href="#crawl-path" label={t.jump} variant="secondary" icon="down" /></div></div><div class="mt-20"><CrawlabilityFeatureGrid items={t.capabilities} lang={lang} client:load /></div></div></section>
    <section id="crawl-path" class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><div class="min-w-0"><p class="m-0 text-xs font-medium uppercase tracking-wider text-primary">{t.flowEyebrow}</p><h2 class="m-0 mt-6 w-full max-w-[500px] text-section-title font-medium text-foreground">{t.flowTitle}</h2></div><p class="m-0 min-w-0 max-w-xl text-base leading-copy text-muted-foreground lg:pt-9">{t.flowLead}</p></header><CrawlPathPipeline stages={t.stages} lang={lang} client:load /></section>
    <section id="diagnostic-workflow" class="border-y border-solid border-border"><div class="mx-auto max-w-content px-5 py-section-mobile md:px-12 lg:py-section"><header class="grid grid-cols-1 gap-6 pb-12 lg:grid-cols-2 lg:pb-20"><h2 class="m-0 text-section-title font-medium text-foreground">{t.detailTitle}</h2><p class="m-0 max-w-xl text-base leading-copy text-muted-foreground">{t.detailLead}</p></header><DiagnosticWorkflow items={t.detail} lang={lang} client:load /></div></section>
    <section class="mx-auto grid max-w-content grid-cols-1 gap-12 px-5 py-section-mobile md:px-12 lg:grid-cols-3 lg:py-section"><h2 class="m-0 text-section-title font-medium text-foreground">{t.faqTitle}</h2><FaqAccordion items={t.faq} theme="dark" className="lg:col-span-2" /></section>
    <SubpageContact lang={lang} source="crawlability-service" />
  </main>
  <Footer {...siteContent.footer} lang={lang} />
</BaseLayout>
