---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SubpageContact from "./SubpageContact.astro";
import { content } from "../content/site";

interface Props { lang: "de" | "en" }
const { lang } = Astro.props;
const de = lang === "de";
const siteContent = content[lang];
const homePath = de ? "/" : "/en/";
const path = de ? "/ai-crawlability/" : "/en/ai-crawlability/";
const t = de ? {
  title: "Sieh, was Antwortsysteme erreichen können.", description: "AI Crawlability zeigt, welche Bots deine Seiten erreichen, wo Requests scheitern und welche technischen Wege zuerst geöffnet werden sollten.", eyebrow: "AI Crawlability", lead: "Eine Website kann inhaltlich stark und trotzdem schwer erreichbar sein. Wir lesen Server- und Seitenzugriff als Ablauf – vom Bot über die Antwort bis zur Seite, die tatsächlich ankommt.", cta: "Crawlability-Check anfragen", jump: "Zugriff ansehen", home: "Start", hub: "GEO-Optimierung", parent: "Technische GEO-Optimierung",
  activity: "Live-Zugriff · illustratives Beispiel", activityTitle: "Bot-Aktivität als nachvollziehbarer Weg", activityNote: "Illustrative Ansicht – keine echten Serverlogs oder Kundenwerte.", requests: "Requests", response: "Antwort", page: "Zielseite", verified: "verifiziert",
  capabilities: [["Zugriff", "Welche Bots kommen an?", "Verifizierte User-Agents statt bloßer Behauptungen."], ["Absicht", "Warum wird gelesen?", "Indexierung, Training und Retrieval getrennt betrachten."], ["Antwort", "Was kommt zurück?", "Status, Latenz und Rendering auf Seitenebene prüfen."], ["Priorität", "Was zuerst ändern?", "Technische Befunde nach Wirkung und Aufwand ordnen."]],
  flowEyebrow: "Page-level crawl path", flowTitle: "Ein Request ist erst dann hilfreich, wenn die richtige Seite ankommt.", flowLead: "Wir verfolgen den Weg nicht als abstrakte Punktzahl, sondern als Abfolge von Zugriff, Serverantwort, Rendering und erreichbarem Inhalt.", stages: [["Bot erkannt", "GPTBot · Retrieval", "Verifizierter Zugriff wird vom normalen Browsertraffic getrennt."], ["Server antwortet", "200 · 312 ms", "Status und Antwortzeit zeigen, ob der Weg offen und belastbar ist."], ["Inhalt erreicht", "HTML · 18 KB", "Die zentrale Information kommt ohne clientseitigen Umweg an."], ["Seite priorisiert", "/leistungen/", "Ein konkreter Befund wird zur nächsten technischen Aktion."]],
  detailEyebrow: "Was wir prüfen", detailTitle: "Von Bot-Signal zu sinnvoller Änderung", detailLead: "Crawlability endet nicht bei einer Bot-Liste. Entscheidend ist der Zusammenhang zwischen Zugriff und deiner wichtigsten Seite.", detail: [["Robots & CDN", "Bewusst blockieren oder unbeabsichtigt aussperren?", "robots.txt, WAF- und CDN-Regeln", "1"], ["Antwort & Latenz", "Kommt die Seite schnell genug zurück?", "Status, Redirects, TTFB", "2"], ["Rendering", "Ist die Antwort ohne Browser ausführbar?", "Server-HTML, JS-Abhängigkeiten", "3"]],
  faqTitle: "Fragen zu AI Crawlability", faq: [["Was ist der Unterschied zwischen Crawlability und Sichtbarkeit?", "Crawlability beschreibt den technischen Zugang. Sichtbarkeit beschreibt, ob ein System deine Inhalte anschließend in einer Antwort verwendet. Beides muss getrennt geprüft werden."], ["Kann ein User-Agent allein einen Bot verifizieren?", "Nein. User-Agent-Werte können gefälscht werden. Wir behandeln sie erst als belastbares Signal, wenn Zugriffsmuster und bekannte Bot-Informationen zusammenpassen."], ["Muss ich alle AI-Bots zulassen?", "Nicht pauschal. Die Entscheidung hängt von Inhalt, Geschäftsmodell und rechtlicher/strategischer Zielsetzung ab. Wichtig ist, bewusst zu wissen, was blockiert wird."], ["Ersetzt Crawlability einen GEO-Audit?", "Nein. Crawlability beantwortet die technische Erreichbarkeit. Ein GEO-Audit untersucht zusätzlich Antworten, Quellen, Fakten und Themenlücken."]],
  closeEyebrow: "Nächster Schritt", closeTitle: "Öffne den Weg zu deinen wichtigen Seiten.", closeText: "Wir prüfen einen repräsentativen Seitenpfad, markieren den Engpass und schlagen nur Änderungen vor, die sich technisch nachvollziehen lassen.", closeCta: "Crawlability-Check anfragen"
} : {
  title: "See what answer systems can actually reach.", description: "AI crawlability shows which bots reach your pages, where requests fail and which technical paths deserve attention first.", eyebrow: "AI crawlability", lead: "A website can be useful and still be difficult to reach. We read server and page access as a sequence – from bot to response to the page that actually arrives.", cta: "Request a crawlability check", jump: "See the access path", home: "Home", hub: "GEO optimisation", parent: "Technical GEO optimisation", activity: "Live access · illustrative example", activityTitle: "Bot activity as a traceable path", activityNote: "Illustrative view – not real server logs or client data.", requests: "Requests", response: "Response", page: "Target page", verified: "verified",
  capabilities: [["Access", "Which bots arrive?", "Verified user agents instead of assumptions."], ["Intent", "Why is it reading?", "Keep indexing, training and retrieval distinct."], ["Response", "What comes back?", "Review status, latency and rendering at page level."], ["Priority", "What changes first?", "Order technical findings by impact and effort."]],
  flowEyebrow: "Page-level crawl path", flowTitle: "A request only helps when the right page arrives.", flowLead: "We follow the path as access, server response, rendering and reachable content – not as an abstract score.", stages: [["Bot verified", "GPTBot · Retrieval", "Verified access is separated from ordinary browser traffic."], ["Server responds", "200 · 312 ms", "Status and response time show whether the route is open and dependable."], ["Content reached", "HTML · 18 KB", "The central information arrives without a client-side detour."], ["Page prioritised", "/services/", "A concrete finding becomes the next technical action."]], detailEyebrow: "What we review", detailTitle: "From bot signal to useful change", detailLead: "Crawlability does not end with a bot list. The useful question is how access connects to your most important page.", detail: [["Robots & CDN", "Blocked deliberately or shut out by accident?", "robots.txt, WAF and CDN rules", "1"], ["Response & latency", "Does the page return quickly enough?", "Status, redirects, TTFB", "2"], ["Rendering", "Can the response work without a browser?", "Server HTML, JS dependencies", "3"]], faqTitle: "Questions about AI crawlability", faq: [["How is crawlability different from visibility?", "Crawlability describes technical access. Visibility describes whether a system then uses your content in an answer. Both need to be reviewed separately."], ["Can a user agent alone verify a bot?", "No. User-agent values can be spoofed. We treat them as dependable only when access patterns and known bot information support them."], ["Do I need to allow every AI bot?", "Not as a blanket rule. The decision depends on your content, business model and legal or strategic position. The important part is knowing what is blocked and why."], ["Does crawlability replace a GEO audit?", "No. Crawlability answers technical reachability. A GEO audit additionally reviews answers, sources, facts and topic gaps."]], closeEyebrow: "Next step", closeTitle: "Open the path to your important pages.", closeText: "We review a representative page path, mark the bottleneck and suggest only changes that can be checked technically.", closeCta: "Request a crawlability check"
};
const crumbs = [{ name: t.home, href: homePath }, { name: t.hub, href: de ? "/geo-optimierung/" : "/en/geo-optimization/" }, { name: t.parent, href: de ? "/technische-geo-optimierung/" : "/en/technical-geo-optimization/" }, { name: t.eyebrow, href: path }];
const schema = { "@context": "https://schema.org", "@graph": [{ "@type": "Service", name: t.eyebrow, description: t.description, url: `https://elbsand.studio${path}`, provider: { "@type": "ProfessionalService", name: "ELBSAND Design Studio" } }, { "@type": "BreadcrumbList", itemListElement: crumbs.map((item, i) => ({ "@type": "ListItem", position: i + 1, name: item.name, item: `https://elbsand.studio${item.href}` })) }, { "@type": "FAQPage", mainEntity: t.faq.map((x) => ({ "@type": "Question", name: x[0], acceptedAnswer: { "@type": "Answer", text: x[1] } })) }] };
---
<BaseLayout title={`${t.eyebrow} | ELBSAND`} description={t.description} lang={lang} canonicalPath={path} alternateDePath="/ai-crawlability/" alternateEnPath="/en/ai-crawlability/" schema={schema} bodyClass="crawl-page">
  <Header lang={lang} nav={siteContent.nav} cta={siteContent.cta} page="service" alternateDePath="/ai-crawlability/" alternateEnPath="/en/ai-crawlability/" />
  <main id="main-content" class="crawl-main">
    <section class="crawl-hero crawl-shell"><nav class="crawl-crumbs" aria-label={de ? "Brotkrumen-Navigation" : "Breadcrumb"}>{crumbs.map((item, i) => <>{i > 0 && <span aria-hidden="true">/</span>}{i === crumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</>)}</nav><div class="crawl-hero-copy"><p class="crawl-eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p>{t.lead}</p><div class="crawl-actions"><a class="button" href={`${homePath}#ki-check`}>{t.cta}</a><a class="crawl-jump" href="#crawl-flow">{t.jump}<span aria-hidden="true">↓</span></a></div></div><div class="activity-artifact" aria-label={t.activityTitle}><div class="activity-top"><span>{t.activity}</span><b><i></i>{t.verified}</b></div><div class="activity-head"><strong>{t.activityTitle}</strong><small>{t.activityNote}</small></div><div class="activity-columns"><span>{t.requests}</span><span>{t.response}</span><span>{t.page}</span></div><ol class="activity-log"><li class="is-current"><span class="activity-dot"></span><div><strong>GPTBot</strong><small>{de ? "Retrieval · gerade eben" : "Retrieval · just now"}</small></div><b>200</b><em>/leistungen/</em></li><li><span class="activity-dot"></span><div><strong>ClaudeBot</strong><small>{de ? "Index · vor 4 Min." : "Index · 4 min ago"}</small></div><b>200</b><em>/ueber-uns/</em></li><li><span class="activity-dot"></span><div><strong>PerplexityBot</strong><small>{de ? "Retrieval · vor 11 Min." : "Retrieval · 11 min ago"}</small></div><b>304</b><em>/kontakt/</em></li><li class="is-warning"><span class="activity-dot"></span><div><strong>Google-Extended</strong><small>{de ? "Block · vor 18 Min." : "Blocked · 18 min ago"}</small></div><b>403</b><em>/wissen/</em></li></ol><div class="activity-footer"><span>{de ? "4 geprüfte Zugriffe" : "4 reviewed requests"}</span><span>12:48:06 CET</span></div></div></section>
    <section class="crawl-capabilities crawl-shell" aria-label={de ? "Funktionen" : "Capabilities"}>{t.capabilities.map((item) => <article><p>{item[0]}</p><h2>{item[1]}</h2><span>{item[2]}</span></article>)}</section>
    <section class="crawl-flow crawl-shell" id="crawl-flow"><header class="crawl-flow-intro"><p class="crawl-eyebrow">{t.flowEyebrow}</p><h2>{t.flowTitle}</h2><p>{t.flowLead}</p></header><div class="crawl-sequence"><ol class="crawl-stages">{t.stages.map((stage, i) => <li data-crawl-stage={i} class:list={{ "is-active": i === 0 }}><span>{i + 1}</span><div><h3>{stage[0]}</h3><strong>{stage[1]}</strong><p>{stage[2]}</p></div></li>)}</ol><div class="crawl-view" data-crawl-visual><div class="crawl-view-top"><span>ELBSAND / REQUEST TRACE</span><b><i></i><span data-crawl-status>{t.stages[0][1]}</span></b></div><div class="crawl-view-body"><div class="request-track"><i class="track-line"></i><span class="track-node node-bot">BOT</span><span class="track-node node-server">SERVER</span><span class="track-node node-page">PAGE</span><b class="track-packet"></b></div><div class="crawl-detail"><small>{t.requests}</small><strong data-crawl-metric>GPTBot</strong><span data-crawl-detail>{t.stages[0][2]}</span></div></div><div class="crawl-view-foot"><span data-crawl-count>1 / 4</span><span>{de ? "Aktiver Befund" : "Active finding"}</span></div></div></div></section>
    <section class="crawl-details crawl-shell"><header><p class="crawl-eyebrow">{t.detailEyebrow}</p><h2>{t.detailTitle}</h2><p>{t.detailLead}</p></header><div class="detail-rows">{t.detail.map((item) => <article><span>{item[3]}</span><div><h3>{item[0]}</h3><strong>{item[1]}</strong><p>{item[2]}</p></div><i aria-hidden="true">↗</i></article>)}</div></section>
    <section class="crawl-faq crawl-shell"><header><p class="crawl-eyebrow">FAQ</p><h2>{t.faqTitle}</h2></header><div>{t.faq.map((item) => <details><summary>{item[0]}<span aria-hidden="true">+</span></summary><p>{item[1]}</p></details>)}</div></section>
    <SubpageContact lang={lang} source="crawlability-service" />
  </main>
  <Footer {...siteContent.footer} lang={lang} />
</BaseLayout>
<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const sequence = document.querySelector(".crawl-sequence");
  if (sequence) { const visual = sequence.querySelector<HTMLElement>("[data-crawl-visual]"); const stages = Array.from(sequence.querySelectorAll<HTMLElement>("[data-crawl-stage]")); const status = visual?.querySelector<HTMLElement>("[data-crawl-status]"); const metric = visual?.querySelector<HTMLElement>("[data-crawl-metric]"); const detail = visual?.querySelector<HTMLElement>("[data-crawl-detail]"); const count = visual?.querySelector<HTMLElement>("[data-crawl-count]"); const labels = stages.map((s) => ({ title:s.querySelector("h3")?.textContent ?? "", metric:s.querySelector("strong")?.textContent ?? "", detail:s.querySelector("p")?.textContent ?? "" })); const set = (i:number) => { stages.forEach((s,n) => s.classList.toggle("is-active", n===i)); if (visual && status && metric && detail && count) { visual.dataset.active=String(i); status.textContent=labels[i].metric; metric.textContent=labels[i].metric; detail.textContent=labels[i].detail; count.textContent=`${i+1} / ${stages.length}`; } }; if (reduced.matches) set(0); else { const observer = new IntersectionObserver((entries) => { const active=entries.filter((e)=>e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0]; if(active) set(Number((active.target as HTMLElement).dataset.crawlStage??0)); }, {rootMargin:"-34% 0px -40%",threshold:[.2,.5,.8]}); stages.forEach((s)=>observer.observe(s)); } }
</script>
<style>
  :global(body.crawl-page) { --c-bg:#171715; --c-surface:#211f1c; --c-surface-2:#282521; --c-text:#fffaf4; --c-muted:#b9b4aa; --c-line:rgba(255,250,244,.16); --c-accent:#e98764; background:var(--c-bg); color:var(--c-text); } :global(.crawl-page .site-header),:global(.crawl-page .site-footer) { border-color:var(--c-line); background:rgba(23,23,21,.94); color:var(--c-text); } :global(.crawl-page .language-switch) { background:rgba(255,250,244,.06); } :global(.crawl-page .language-switch a[aria-current="page"]) { background:rgba(255,250,244,.12); box-shadow:none; color:var(--c-text); } :global(.crawl-page .mobile-menu nav) { background:var(--c-surface); }
  .crawl-main { overflow:hidden; } .crawl-shell { width:min(100%,calc(1120px + 96px)); margin-inline:auto; padding-inline:48px; } .crawl-hero { padding-top:28px; padding-bottom:112px; } .crawl-crumbs { display:flex; flex-wrap:wrap; gap:9px; color:var(--c-muted); font-size:12px; } .crawl-crumbs a:hover { color:var(--c-text); } .crawl-hero-copy { max-width:810px; margin-top:clamp(94px,11vw,150px); } .crawl-eyebrow { margin:0 0 17px; color:var(--c-accent); font-size:11px; font-weight:720; letter-spacing:.14em; text-transform:uppercase; } .crawl-hero h1 { max-width:830px; margin:0 0 25px; color:var(--c-text); font-family:var(--sans); font-size:clamp(55px,6.3vw,86px); font-weight:540; letter-spacing:-.06em; line-height:.95; text-wrap:balance; } .crawl-hero-copy > p:not(.crawl-eyebrow) { max-width:670px; color:var(--c-muted); font-size:19px; line-height:1.6; } .crawl-actions { display:flex; flex-wrap:wrap; gap:13px; margin-top:27px; } .crawl-jump { display:inline-flex; min-height:48px; align-items:center; gap:14px; border:1px solid rgba(255,250,244,.32); border-radius:8px; padding:0 17px; font-size:14px; font-weight:620; } .crawl-jump span { color:var(--c-accent); font-size:18px; transition:transform 180ms ease; } .crawl-jump:hover span { transform:translateY(3px); }
  .activity-artifact { position:relative; max-width:1030px; margin:90px auto 0; overflow:hidden; border:1px solid var(--c-line); border-radius:14px; background:var(--c-surface); box-shadow:0 28px 84px rgba(0,0,0,.28); } .activity-top { display:flex; min-height:51px; align-items:center; justify-content:space-between; border-bottom:1px solid var(--c-line); padding:0 21px; color:var(--c-muted); font-size:10px; letter-spacing:.11em; } .activity-top b { display:flex; align-items:center; gap:8px; color:var(--c-text); font-size:11px; font-weight:600; letter-spacing:0; } .activity-top b i { width:7px; height:7px; border-radius:50%; background:var(--c-accent); box-shadow:0 0 0 5px rgba(233,135,100,.1); animation:crawl-pulse 1.8s ease-in-out infinite alternate; } .activity-head { display:flex; align-items:baseline; justify-content:space-between; gap:20px; padding:32px 30px 22px; } .activity-head strong { font-size:26px; font-weight:520; letter-spacing:-.04em; } .activity-head small { color:var(--c-muted); font-size:11px; } .activity-columns { display:grid; grid-template-columns:minmax(180px,1.1fr) 100px minmax(160px,.8fr); gap:26px; margin:0 30px; border-bottom:1px solid var(--c-line); padding:0 18px 11px 50px; color:var(--c-muted); font-size:10px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; } .activity-log { margin:0; padding:0 30px; list-style:none; } .activity-log li { display:grid; grid-template-columns:20px minmax(180px,1.1fr) 100px minmax(160px,.8fr); gap:26px; align-items:center; min-height:86px; border-bottom:1px solid var(--c-line); padding:0 18px; color:var(--c-muted); } .activity-log li.is-current { color:var(--c-text); background:rgba(233,135,100,.05); } .activity-log li.is-warning { color:#d4a173; } .activity-dot { width:8px; height:8px; border-radius:50%; background:var(--c-muted); box-shadow:0 0 0 5px rgba(255,250,244,.05); } .is-current .activity-dot { background:var(--c-accent); box-shadow:0 0 0 6px rgba(233,135,100,.12); animation:crawl-pulse 1.4s ease-in-out infinite alternate; } .activity-log strong { display:block; font-size:15px; font-weight:600; } .activity-log small { display:block; margin-top:3px; font-size:12px; } .activity-log b { font-size:14px; font-weight:700; } .activity-log em { overflow:hidden; color:var(--c-text); font-family:ui-monospace,monospace; font-size:13px; font-style:normal; text-overflow:ellipsis; white-space:nowrap; } .activity-footer { display:flex; justify-content:space-between; padding:19px 31px; color:var(--c-muted); font-size:11px; }
  .crawl-capabilities { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--c-line); border-bottom:1px solid var(--c-line); } .crawl-capabilities article { min-height:235px; padding:28px 24px 32px; } .crawl-capabilities article + article { border-left:1px solid var(--c-line); } .crawl-capabilities p { margin:0 0 48px; color:var(--c-accent); font-size:11px; font-weight:680; letter-spacing:.1em; text-transform:uppercase; } .crawl-capabilities h2 { margin:0 0 11px; color:var(--c-text); font-family:var(--sans); font-size:22px; font-weight:520; letter-spacing:-.035em; line-height:1.1; } .crawl-capabilities span { display:block; color:var(--c-muted); font-size:16px; line-height:1.5; }
  .crawl-flow { padding-top:122px; padding-bottom:125px; } .crawl-flow-intro { display:grid; grid-template-columns:minmax(220px,.66fr) minmax(0,1.34fr); column-gap:64px; margin-bottom:70px; } .crawl-flow-intro .crawl-eyebrow { grid-row:1 / span 2; } .crawl-flow-intro h2,.crawl-details h2,.crawl-faq h2,.crawl-close h2 { max-width:740px; margin:0 0 19px; color:var(--c-text); font-family:var(--sans); font-size:clamp(41px,4.6vw,62px); font-weight:520; letter-spacing:-.055em; line-height:.98; } .crawl-flow-intro > p:last-child { grid-column:2; max-width:570px; margin:0; color:var(--c-muted); font-size:17px; line-height:1.62; } .crawl-sequence { display:grid; grid-template-columns:minmax(0,.9fr) minmax(430px,1.1fr); gap:clamp(52px,8vw,116px); align-items:start; } .crawl-stages { margin:0; padding:0; list-style:none; } .crawl-stages li { display:grid; grid-template-columns:45px 1fr; gap:22px; min-height:260px; border-top:1px solid var(--c-line); padding:34px 0 42px; opacity:.45; transition:opacity 500ms ease, transform 600ms var(--motion-ease); } .crawl-stages li:last-child { border-bottom:1px solid var(--c-line); } .crawl-stages li.is-active { opacity:1; transform:translateX(7px); } .crawl-stages li > span { display:grid; width:38px; height:38px; place-items:center; border:1px solid var(--c-line); border-radius:50%; color:var(--c-muted); font-size:13px; } .crawl-stages li.is-active > span { border-color:var(--c-accent); background:var(--c-accent); color:#fffaf4; } .crawl-stages h3 { margin:0 0 8px; color:var(--c-text); font-size:27px; font-weight:520; letter-spacing:-.045em; } .crawl-stages strong { display:block; margin-bottom:12px; color:var(--c-accent); font-family:ui-monospace,monospace; font-size:14px; font-weight:500; } .crawl-stages p { max-width:430px; margin:0; color:var(--c-muted); font-size:16px; line-height:1.6; }
  .crawl-view { position:sticky; top:104px; overflow:hidden; min-height:485px; border:1px solid var(--c-line); border-radius:14px; background:var(--c-surface); box-shadow:0 24px 66px rgba(0,0,0,.22); } .crawl-view-top { display:flex; min-height:51px; align-items:center; justify-content:space-between; border-bottom:1px solid var(--c-line); padding:0 19px; color:var(--c-muted); font-size:10px; letter-spacing:.1em; } .crawl-view-top b { display:flex; align-items:center; gap:8px; color:var(--c-text); font-size:11px; font-weight:600; letter-spacing:0; } .crawl-view-top b i { width:7px; height:7px; border-radius:50%; background:var(--c-accent); } .crawl-view-body { position:relative; min-height:382px; padding:45px 30px 30px; } .request-track { position:relative; height:206px; } .track-line { position:absolute; top:102px; right:38px; left:38px; height:1px; background:linear-gradient(90deg,var(--c-accent),rgba(233,135,100,.17)); } .track-node { position:absolute; top:77px; display:grid; width:52px; height:52px; place-items:center; border:1px solid var(--c-line); border-radius:50%; background:var(--c-surface-2); color:var(--c-muted); font-size:10px; font-weight:700; } .node-bot { left:0; border-color:var(--c-accent); color:var(--c-text); } .node-server { left:50%; transform:translateX(-50%); } .node-page { right:0; } .track-packet { position:absolute; top:98px; left:11%; width:8px; height:8px; border-radius:50%; background:var(--c-accent); box-shadow:0 0 0 7px rgba(233,135,100,.1); animation:packet-travel 4.6s var(--motion-ease) infinite; } .crawl-view[data-active="1"] .track-packet { animation-delay:.4s; } .crawl-view[data-active="2"] .track-packet { animation-delay:.8s; } .crawl-view[data-active="3"] .track-packet { animation-delay:1.2s; } .crawl-detail { display:grid; grid-template-columns:auto 1fr; gap:7px 18px; border-top:1px solid var(--c-line); padding-top:23px; } .crawl-detail small { color:var(--c-muted); font-size:10px; letter-spacing:.1em; text-transform:uppercase