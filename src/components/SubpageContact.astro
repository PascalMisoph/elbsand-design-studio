---
import Contact from "./Contact.astro";
import { content, type Locale } from "../content/site";

interface Props {
  lang: Locale;
  source?: string;
}

const { lang, source = "service-page-contact" } = Astro.props;
const contact = content[lang].contact;
---

<div class="subpage-contact">
  <Contact {...contact} source={source} />
</div>

<style>
  .subpage-contact {
    --paper: #0a0a09;
    --paper-soft: #171715;
    --ink: #fffaf4;
    --muted: #b9b4aa;
    --line: rgba(255, 250, 244, .15);
    --control-line: rgba(255, 250, 244, .34);
    --surface: #24231f;
    --accent-dark: #e47b57;
    background: #0a0a09;
    color: var(--ink);
  }
  :global(.subpage-contact .contact-section) {
    padding-top: 120px;
    padding-bottom: 120px;
    border-color: var(--line);
  }
  :global(.subpage-contact .contact-copy) { margin-bottom: 14px; }
  :global(.subpage-contact .contact-copy h2) {
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 520;
    letter-spacing: -.055em;
  }
  :global(.subpage-contact .contact-copy .eyebrow) { color: #e98764; }
  :global(.subpage-contact .contact-value-line) {
    margin-bottom: 34px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 17px;
    text-align: left;
  }
  :global(.subpage-contact .contact-path) {
    min-height: 280px;
    font-family: var(--sans);
    font-weight: 520;
    letter-spacing: -.04em;
  }
  :global(.subpage-contact .contact-flow) {
    border-color: var(--line);
    background: #151513;
    color: var(--ink);
    box-shadow: 0 20px 54px rgba(0, 0, 0, .24);
  }
  :global(.subpage-contact .contact-choice) {
    border-color: var(--control-line);
    background: rgba(255, 250, 244, .045);
    color: var(--ink);
  }
  :global(.subpage-contact .contact-flow-input input),
  :global(.subpage-contact .contact-flow-input textarea) { color: var(--ink); }
  @media (max-width: 640px) {
    :global(.subpage-contact .contact-section) { padding-top: 84px; padding-bottom: 84px; }
    :global(.subpage-contact .contact-copy h2) { white-space: normal; }
    :global(.subpage-contact .contact-path) { min-height: 220px; }
  }
</style>
