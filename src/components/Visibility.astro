---
import googleLogo from "@lobehub/icons-static-svg/icons/google-color.svg?url";
import openAiLogo from "@lobehub/icons-static-svg/icons/openai.svg?url";
import claudeLogo from "@lobehub/icons-static-svg/icons/claude-color.svg?url";
import perplexityLogo from "@lobehub/icons-static-svg/icons/perplexity-color.svg?url";

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  perspectives: readonly {
    title: string;
    lead: string;
    text: string;
  }[];
  systemsIntro: string;
  systemsLabel: string;
}
const { eyebrow, title, body, perspectives, systemsIntro, systemsLabel } = Astro.props;
const systems = [
  { name: "Google", logo: googleLogo },
  { name: "ChatGPT", logo: openAiLogo },
  { name: "Claude", logo: claudeLogo },
  { name: "Perplexity", logo: perplexityLogo }
];
---
<section class="visibility-band" id="seo-geo" aria-labelledby="visibility-title">
  <div class="visibility-inner">
    <header class="visibility-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="visibility-title">{title}</h2>
      <p>{body}</p>
    </header>

    <div class="visibility-perspectives">
      {perspectives.slice(0, 3).map((perspective) => (
        <article class="visibility-perspective">
          <h3>{perspective.title}</h3>
          <p class="visibility-perspective-lead">{perspective.lead}</p>
          <p>{perspective.text}</p>
        </article>
      ))}
    </div>

    <div class="visibility-systems" aria-label={systemsLabel}>
      <p>{systemsIntro}</p>
      <ul>
        {systems.map((system) => (
          <li>
            <img src={system.logo} alt="" width="28" height="28" loading="lazy" />
            <span>{system.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
