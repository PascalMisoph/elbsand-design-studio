---
interface Props {
  eyebrow: string;
  title: string;
  auditLabel: string;
  auditBody: string;
  calendarLabel: string;
  calendarBody: string;
  valueLine: string;
  disclaimerTitle: string;
  disclaimer: string;
}

const { eyebrow, title, auditLabel, calendarLabel, valueLine, disclaimerTitle, disclaimer } = Astro.props;
---

<section class="geo-cta section-shell" id="geo-anfrage" aria-labelledby="geo-cta-title">
  <header class="geo-cta-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="geo-cta-title">{title}</h2>
  </header>
  <div class="contact-paths geo-choice-grid">
    <a class="contact-path contact-path--form" href={`mailto:pascal.misoph@gmail.com?subject=${encodeURIComponent("GEO-Audit · ELBSAND")}`}>
      <span>{auditLabel}</span><span class="contact-path-arrow" aria-hidden="true">→</span>
    </a>
    <button class="contact-path contact-path--calendar" type="button" aria-expanded="false" aria-controls="geo-calendly" data-geo-calendar-open>
      <span>{calendarLabel}</span><span class="contact-path-arrow" aria-hidden="true">→</span>
    </button>
  </div>
  <p class="geo-cta-value">{valueLine}</p>
  <div class="geo-calendly-panel" id="geo-calendly" hidden data-geo-calendar-panel aria-label={calendarLabel}>
    <div class="calendly-inline-widget" data-url="https://calendly.com/pascal-misoph/erstgespraech" style="min-width:320px;height:700px;"></div>
  </div>
  <aside class="geo-disclaimer-note" aria-label={disclaimerTitle}>
    <strong>{disclaimerTitle}</strong>
    <span>{disclaimer}</span>
  </aside>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".geo-cta").forEach((section) => {
    const button = section.querySelector<HTMLButtonElement>("[data-geo-calendar-open]");
    const panel = section.querySelector<HTMLElement>("[data-geo-calendar-panel]");
    button?.addEventListener("click", () => {
      if (!panel) return;
      panel.hidden = false;
      button.setAttribute("aria-expanded", "true");
      if (!document.querySelector("script[data-calendly-loader]")) {
        const script = document.createElement("script");
        script.src = "https://assets.calendly.com/assets/external/widget.js";
        script.async = true;
        script.dataset.calendlyLoader = "true";
        document.head.append(script);
      }
      panel.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    });
  });
</script>
