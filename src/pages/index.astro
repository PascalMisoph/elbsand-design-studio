---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import AiCheck from "../components/AiCheck.astro";
import Offer from "../components/Offer.astro";
import References from "../components/References.astro";
import Visibility from "../components/Visibility.astro";
import Process from "../components/Process.astro";
import EditorialSupport from "../components/EditorialSupport.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { content } from "../content/site";
const t = content.de;
---
<BaseLayout title={t.meta.title} description={t.meta.description} lang="de" criticalImage="/video/paternoga-search-shift-poster-de.png" bodyClass="home-page">
  <Header lang="de" nav={t.nav} cta={t.cta} />
  <main id="main-content"><Hero {...t.hero} cta={t.cta} secondaryCta={t.secondaryCta} /><ProofStrip {...t.proof} /><AiCheck lang="de" /><Offer {...t.offer} /><References {...t.references} /><Visibility {...t.visibility} /><Process {...t.process} /><EditorialSupport {...t.editorialSupport} /><Contact {...t.contact} /></main>
  <Footer {...t.footer} lang="de" />
</BaseLayout>
