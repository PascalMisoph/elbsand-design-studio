# Resend - server-side secret; never expose it through PUBLIC_*.
RESEND_API_KEY=re_your_api_key_here

# Contact form / AI check
CONTACT_FROM_EMAIL=mailer@example.com
CONTACT_TO_EMAIL=recipient@example.com
CONTACT_REPLY_TO_EMAIL=kontakt@paternoga-seo-geo.de

# Signs PII-free AI-check result snapshots. Use an independent random secret.
SCAN_RESULT_SIGNING_SECRET=replace_with_at_least_32_random_characters

# Google Analytics 4 - public measurement identifier
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
